	local function fetchStockAndProfile(forceRefreshStock)
		local mods = getGameMods()
		if not mods or not mods.Net then
			return nil, nil, nil
		end
		local okP, profile = pcall(mods.Net.getProfile)
		if not okP or type(profile) ~= "table" then
			profile = nil
		end
		if forceRefreshStock or not ShopSniper.Stock then
			local okS, stock = pcall(function()
				return mods.Net.func("GetShopStock"):InvokeServer()
			end)
			if okS and type(stock) == "table" and type(stock.entries) == "table" then
				ShopSniper.Stock = stock
			end
		end
		updateHeaderBanner(mods, profile)
		return mods, profile, ShopSniper.Stock
	end

	local function buyEntry(mods, defId)
		if LocalPlayer:GetAttribute("InRun") == true then
			setSniperStatus("BLOCKED · IN RUN")
			return false
		end
		mods.Net.fireServer("BuyItem", { defId = defId, count = 1 })
		ShopSniper.LastBoughtAt = os.clock()
		return true
	end

	local function runSniper(silent)
		if ShopSniper.Busy or not State.Alive then
			return 0
		end
		if LocalPlayer:GetAttribute("InRun") == true then
			if not silent then
				setSniperStatus("CLOSED WHILE IN RUN")
			end
			return 0
		end
		ShopSniper.Busy = true
		local bought = 0
		pcall(function()
			local mods, profile, stock = fetchStockAndProfile(true)
			if not mods or not profile or not stock then
				if not silent then
					setSniperStatus("ERR · NO STOCK/PROFILE")
				end
				return
			end
			local goldLeft = tonumber(profile.gold) or 0
			local gemsLeft = tonumber(profile.metaCurrency) or 0
			local analyzed = analyzeEntries(mods, profile, stock)
			for _, rec in ipairs(analyzed) do
				if not State.Alive or LocalPlayer:GetAttribute("InRun") == true then
					break
				end
				local e = rec.entry
				local rem = tonumber(e.remaining) or 0
				local price = tonumber(e.price) or 0
				local cur = e.currency or "Gold"
				local affordable = (cur == "Gems") and (gemsLeft >= price) or (goldLeft >= price)
				if rem > 0
					and price > 0
					and (not ShopSniper.SkipOwned or not rec.owned)
					and matchesShopSelection(e, ShopSniper.ShopsFilter)
					and matchesCurrencyMode(e, ShopSniper.BudgetMode)
					and matchesSnipeRule(rec, ShopSniper.SnipeRule)
					and affordable
				then
					if buyEntry(mods, e.defId) then
						bought += 1
						if cur == "Gems" then
							gemsLeft -= price
						else
							goldLeft -= price
						end
						if AutoLock.Enabled and AutoLock.Run then
							task.delay(0.35, function()
								if State.Alive and AutoLock.Enabled then
									pcall(AutoLock.Run, true, setGearStatus)
								end
							end)
						end
						task.wait(0.08)
					end
				end
			end
			if bought > 0 then
				task.wait(0.18)
				fetchStockAndProfile(true)
			end
			if bought > 0 or not silent then
				setSniperStatus(bought > 0 and ("SNIPED · " .. tostring(bought) .. " ITEMS") or "NO NEW MATCHES")
			end
		end)
		ShopSniper.Busy = false
		if renderFeed then
			task.spawn(renderFeed, false)
		end
		return bought
	end

