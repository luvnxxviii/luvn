local AutoLock = {
	Enabled = Config.Get("AutoLock", false),
	Rarity = Config.Get("AutoLockRarity", "Rare+"),
	LockBuildSpares = Config.Get("AutoLock_BuildSpares", true),
	Options = { "Uncommon+", "Rare+", "Epic+", "Legendary+", "Mythic+", "Divine+", "Exotic Only", "All Gears" },
	MinRankMap = {
		["All Gears"] = 1,
		["Uncommon+"] = 2,
		["Rare+"] = 3,
		["Epic+"] = 4,
		["Legendary+"] = 5,
		["Mythic+"] = 6,
		["Divine+"] = 7,
		["Exotic Only"] = 8,
	},
	Busy = false,
	LastRunAt = 0,
	LockedCache = {},
}
if not AutoLock.MinRankMap[AutoLock.Rarity] then
	AutoLock.Rarity = "Rare+"
end

function AutoLock.GetRarityRank(mods, defOrRarity)
	local rName = type(defOrRarity) == "table" and (defOrRarity.rarity or "Common") or tostring(defOrRarity or "Common")
	local rarityTable = mods and mods.Constants and mods.Constants.RARITY
	local rInfo = rarityTable and rarityTable[rName]
	return (type(rInfo) == "table" and tonumber(rInfo.order)) or RARITY_ORDER_FALLBACK[rName] or 1
end

function AutoLock.Run(silent, statusFn)
	if AutoLock.Busy or not State.Alive then
		return 0
	end
	local mods = getGameMods()
	if not mods or not mods.Inventory or not mods.Items or not mods.Net then
		return 0
	end

	AutoLock.Busy = true
	local lockedCount = 0
	local okRun = pcall(function()
		local okProf, profile = pcall(mods.Net.getProfile)
		if not okProf or type(profile) ~= "table" then
			if not silent and statusFn then
				statusFn("ERR · NO PROFILE")
			end
			return
		end

		local minRank = AutoLock.MinRankMap[AutoLock.Rarity] or 3
		local mergeProtectDefIds = {}
		local upgradeEvalCache = {}
		if AutoLock.LockBuildSpares then
			local eqMap = profile.equipped or {}
			for _, wSlot in ipairs({ "Weapon", "Offhand" }) do
				local eqUid = eqMap[wSlot]
				local eqIt = eqUid and mods.Inventory.find(profile, eqUid)
				if eqIt and eqIt.defId and mods.WeaponUpgrade and mods.WeaponUpgrade.needsSpare then
					-- Protect spare copies of equipped Weapon/Offhand for Tier 6 merge unless already merged/maxed
					local curWpnTier = (mods.WeaponUpgrade.tierOf and mods.WeaponUpgrade.tierOf(eqIt)) or ((eqIt.tier or 0) + 1)
					if curWpnTier < ((mods.Constants and mods.Constants.WEAPON_UPGRADE and mods.Constants.WEAPON_UPGRADE.MAX) or 6) then
						mergeProtectDefIds[eqIt.defId] = true
					end
				end
			end
		end

		for _, item in ipairs(profile.inventory or {}) do
			if not State.Alive then
				break
			end
			if type(item) == "table" and item.uid and item.defId then
				if mods.Inventory.isLocked(item) then
					AutoLock.LockedCache[item.uid] = true
				elseif not AutoLock.LockedCache[item.uid] and mods.Inventory.lockable(item.defId) then
					local def = mods.Items[item.defId]
					local rank = AutoLock.GetRarityRank(mods, def)
					local shouldLock = (rank >= minRank)
					if not shouldLock and AutoLock.LockBuildSpares and def then
						if mergeProtectDefIds[item.defId] then
							shouldLock = true
						elseif rank >= 2 and def.slot and def.slot ~= "Mount" and AutoEquip and AutoEquip.EvaluateDefForBuild then
							local ev = upgradeEvalCache[item.defId]
							if ev == nil then
								local okE, resE = pcall(AutoEquip.EvaluateDefForBuild, mods, profile, item.defId, def)
								ev = (okE and type(resE) == "table" and resE.isUpgrade == true) or false
								upgradeEvalCache[item.defId] = ev
							end
							if ev then
								shouldLock = true
							end
						end
					end
					if shouldLock then
						local okLock, res = pcall(function()
							return mods.Net.func("LockItem"):InvokeServer({ uid = item.uid, locked = true })
						end)
						if okLock and type(res) == "table" and res.ok == true then
							AutoLock.LockedCache[item.uid] = true
							lockedCount += 1
						end
						task.wait(0.04)
					end
				end
			end
		end

		if statusFn and (lockedCount > 0 or not silent) then
			statusFn(lockedCount > 0 and ("LOCKED · " .. tostring(lockedCount) .. " GEARS") or "LOCK · ALL MATCHED")
		end
	end)
	AutoLock.LastRunAt = os.clock()
	AutoLock.Busy = false
	if not okRun and not silent and statusFn then
		statusFn("AUTO-LOCK ERR")
	end
	return lockedCount
end

local function runQuickSellTrash(silent, statusFn)
	if quickSellBusy or not State.Alive then
		return 0
	end
	if LocalPlayer:GetAttribute("InCombat") == true then
		return 0
	end
	if LocalPlayer:GetAttribute("InRun") == true then
		if not silent and statusFn then
			statusFn("SELL · EXIT RUN FOR SHOPS")
		end
		return 0
	end
	local mods = getGameMods()
	if not mods then
		return 0
	end
	quickSellBusy = true
	DungeonAuto.LastQuickSellAt = os.clock()
	local sold = 0
	local okRun = pcall(function()
		-- Lock matching high-rarity drops before sweeping unequipped gear
		if AutoLock.Enabled then
			pcall(AutoLock.Run, true, nil)
		end

		local ok, profile = pcall(mods.Net.getProfile)
		if not ok or type(profile) ~= "table" then
			if not silent and statusFn then
				statusFn("ERR · NO PROFILE")
			end
			return
		end

		local equippedUids = {}
		for _, uid in pairs(profile.equipped or {}) do
			equippedUids[uid] = true
		end

		local maxRank = QUICKSELL_TIER_MAX_RANK[sellRarityMode] or 1
		local reserveFuelUids = {}
		if DungeonAuto.ReserveUpgradeFuel and mods.Upgrade and mods.Upgrade.tierOf and mods.Upgrade.fuelCost then
			-- Keep enough unlocked fuel items for any non-maxed equipped armor/offhand/charm/pet upgrade
			local neededFuel = 0
			for _, eqUid in pairs(profile.equipped or {}) do
				local eqIt = mods.Inventory.find(profile, eqUid)
				local eqDef = eqIt and mods.Items[eqIt.defId]
				if eqIt and eqDef and eqDef.slot ~= "Weapon" and not eqDef.exotic then
					local curT = mods.Upgrade.tierOf(eqIt)
					local maxT = (mods.Constants and mods.Constants.UPGRADE and mods.Constants.UPGRADE.MAX_TIER) or 5
					if curT < maxT then
						neededFuel += mods.Upgrade.fuelCost(curT)
					end
				end
			end
			if neededFuel > 0 and mods.Upgrade.isValidFuel then
				local fuelCands = {}
				for _, fIt in ipairs(profile.inventory or {}) do
					if type(fIt) == "table" and fIt.uid and fIt.defId and (fIt.tier or 0) == 0 and mods.Upgrade.isValidFuel(profile, fIt, "") then
						local fDef = mods.Items[fIt.defId]
						local fRank = fDef and AutoLock.GetRarityRank(mods, fDef) or 1
						if fRank <= 2 and fDef.slot ~= "Pet" and fDef.slot ~= "Mount" then
							table.insert(fuelCands, { item = fIt, rank = fRank, sell = (mods.Shop and mods.Shop.sellPrice and mods.Shop.sellPrice(fIt.defId)) or 0 })
						end
					end
				end
				table.sort(fuelCands, function(a, b)
					if a.rank ~= b.rank then
						return a.rank < b.rank
					end
					return a.sell < b.sell
				end)
				local held = 0
				for _, fc in ipairs(fuelCands) do
					if held >= neededFuel then
						break
					end
					reserveFuelUids[fc.item.uid] = true
					held += (mods.Upgrade.fuelValue and mods.Upgrade.fuelValue(fc.item)) or 1
				end
			end
		end

		local byKind = { Weapon = {}, Accessory = {} }
		local attemptedUids = {}
		local totalTargets = 0

		for _, item in ipairs(profile.inventory or {}) do
			if not State.Alive or LocalPlayer:GetAttribute("InCombat") == true or LocalPlayer:GetAttribute("InRun") == true then
				break
			end
			if type(item) == "table" and item.defId and item.uid then
				local def = mods.Items[item.defId]
				local rank = def and AutoLock.GetRarityRank(mods, def) or 99
				local sellUnit = (mods.Shop and mods.Shop.sellPrice) and mods.Shop.sellPrice(item.defId) or 0
				local inVanity = mods.Inventory and mods.Inventory.vanitySlotOf and mods.Inventory.vanitySlotOf(profile, item.uid) ~= nil
				local isLocked = (mods.Inventory and mods.Inventory.isLocked and mods.Inventory.isLocked(item)) or item.locked == true or AutoLock.LockedCache[item.uid] == true
				if def
					and sellUnit > 0
					and not equippedUids[item.uid]
					and not inVanity
					and not isLocked
					and not reserveFuelUids[item.uid]
					and not item.expiresAt
					and (item.tier or 0) == 0
					and def.slot
					and def.slot ~= "Pet"
					and def.slot ~= "Mount"
					and rank <= maxRank
				then
					local shopKind = (mods.Shop and mods.Shop.kindOf) and mods.Shop.kindOf(item.defId) or nil
					if shopKind ~= "Weapon" and shopKind ~= "Accessory" then
						shopKind = (def.slot == "Weapon" or def.slot == "Offhand") and "Weapon" or "Accessory"
					end
					table.insert(byKind[shopKind], item)
					totalTargets += 1
				end
			end
		end

		if totalTargets == 0 then
			if not silent and statusFn then
				statusFn("SELL · NONE MATCHING")
			end
			return
		end

		local SHOP_CFG = {
			Weapon = { attr = "Blacksmith", doorObj = "Blacksmith" },
			Accessory = { attr = "MerchantShop", doorObj = "Accessory Shop" },
		}
		local INDOORS_DOOR_OBJ = {
			Blacksmith = "Blacksmith",
			MerchantShop = "Accessory Shop",
			SpellShop = "Bank",
			PetShop = "Pet Shop",
		}

		local function findLobbyPrompt(actionText, objectText)
			local roots = {}
			local camp = workspace:FindFirstChild("CampaignLobby")
			local inter = workspace:FindFirstChild("LobbyInteriors")
			if actionText == "Enter" and camp then
				table.insert(roots, camp)
			elseif actionText == "Leave" and inter then
				table.insert(roots, inter)
			end
			table.insert(roots, workspace)
			for _, root in ipairs(roots) do
				for _, d in ipairs(root:GetDescendants()) do
					if d:IsA("ProximityPrompt") and d.ActionText == actionText then
						if not objectText or d.ObjectText == objectText then
							return d
						end
					end
				end
			end
			return nil
		end

		local function triggerDoorPrompt(prompt)
			if not prompt or not prompt.Parent then
				return false
			end
			local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if not hrp then
				return false
			end
			local p = prompt.Parent
			local cf = nil
			if p:IsA("BasePart") then
				cf = p.CFrame
			elseif p:IsA("Attachment") then
				cf = p.WorldCFrame
			end
			if not cf then
				return false
			end
			hrp.CFrame = cf + Vector3.new(0, 3, 0)
			task.wait(0.15)
			if type(fireproximityprompt) == "function" then
				pcall(fireproximityprompt, prompt)
			else
				pcall(function()
					prompt:InputHoldBegin()
					task.wait((prompt.HoldDuration or 0) + 0.1)
					prompt:InputHoldEnd()
				end)
			end
			return true
		end

		local startIndoors = LocalPlayer:GetAttribute("Indoors")
		local hrp0 = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		local savedCF = (not startIndoors and hrp0) and hrp0.CFrame or nil
		local movedPlayer = false

		-- If player is already standing inside Blacksmith or MerchantShop, clear that shop first
		local kindOrder = (startIndoors == "MerchantShop") and { "Accessory", "Weapon" } or { "Weapon", "Accessory" }
		local shopEntered = false

		for _, kind in ipairs(kindOrder) do
			local itemsForKind = byKind[kind]
			local cfg = SHOP_CFG[kind]
			if #itemsForKind > 0 and cfg and State.Alive and LocalPlayer:GetAttribute("InCombat") ~= true and LocalPlayer:GetAttribute("InRun") ~= true then
				if LocalPlayer:GetAttribute("Indoors") ~= cfg.attr then
					local curInd = LocalPlayer:GetAttribute("Indoors")
					if curInd then
						local exitObj = INDOORS_DOOR_OBJ[curInd]
						local exitPrompt = findLobbyPrompt("Leave", exitObj) or findLobbyPrompt("Leave", nil)
						if exitPrompt and triggerDoorPrompt(exitPrompt) then
							movedPlayer = true
							for _ = 1, 25 do
								if not LocalPlayer:GetAttribute("Indoors") or not State.Alive then
									break
								end
								task.wait(0.08)
							end
							task.wait(0.1)
						end
					end
					if not LocalPlayer:GetAttribute("Indoors") then
						if not savedCF then
							local hrpOut = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
							savedCF = hrpOut and hrpOut.CFrame or nil
						end
						local enterPrompt = findLobbyPrompt("Enter", cfg.doorObj)
						if enterPrompt and triggerDoorPrompt(enterPrompt) then
							movedPlayer = true
							for _ = 1, 25 do
								if LocalPlayer:GetAttribute("Indoors") == cfg.attr or not State.Alive then
									break
								end
								task.wait(0.08)
							end
						end
					end
				end

				if LocalPlayer:GetAttribute("Indoors") == cfg.attr then
					shopEntered = true
					for i = 1, #itemsForKind, 25 do
						if not State.Alive or LocalPlayer:GetAttribute("InCombat") == true or LocalPlayer:GetAttribute("InRun") == true then
							break
						end
						local batch = {}
						for j = i, math.min(#itemsForKind, i + 24) do
							local it = itemsForKind[j]
							attemptedUids[it.uid] = true
							table.insert(batch, { defId = it.defId, count = it.count or 1, uid = it.uid })
						end
						pcall(function()
							mods.Net.fireServer("SellMany", { items = batch })
						end)
						task.wait(0.16)
					end
				end
			end
		end

		if movedPlayer then
			local curInd = LocalPlayer:GetAttribute("Indoors")
			if curInd then
				local exitPrompt = findLobbyPrompt("Leave", INDOORS_DOOR_OBJ[curInd]) or findLobbyPrompt("Leave", nil)
				if exitPrompt and triggerDoorPrompt(exitPrompt) then
					for _ = 1, 25 do
						if not LocalPlayer:GetAttribute("Indoors") or not State.Alive then
							break
						end
						task.wait(0.08)
					end
				end
			end
			if savedCF then
				task.wait(0.12)
				local hrpEnd = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if hrpEnd then
					hrpEnd.CFrame = savedCF
				end
			end
		end

		local attemptedCount = 0
		for _ in pairs(attemptedUids) do
			attemptedCount += 1
		end

		if attemptedCount > 0 then
			for _ = 1, 5 do
				task.wait(0.15)
				local okAfter, profAfter = pcall(mods.Net.getProfile)
				if okAfter and type(profAfter) == "table" and type(profAfter.inventory) == "table" then
					local stillThere = {}
					for _, it in ipairs(profAfter.inventory) do
						if it.uid and attemptedUids[it.uid] then
							stillThere[it.uid] = true
						end
					end
					sold = 0
					for uid in pairs(attemptedUids) do
						if not stillThere[uid] then
							sold += 1
						end
					end
					if sold >= attemptedCount then
						break
					end
				end
			end
		end

		if statusFn and (sold > 0 or not silent) then
			if sold > 0 then
				statusFn("SOLD · " .. tostring(sold) .. " items")
			elseif not shopEntered then
				statusFn("SELL · SHOP DOOR NOT FOUND")
			else
				statusFn("SOLD · 0 items")
			end
		end
	end)
	DungeonAuto.LastQuickSellAt = os.clock()
	quickSellBusy = false
	if not okRun and not silent and statusFn then
		statusFn("QUICK-SELL ERR")
	end
	return sold
end

function DungeonAuto.SetAutoQuickSell(enabled, statusFn)
	DungeonAuto.AutoQuickSell = enabled == true
	Config.Set("Dungeon_AutoQuickSell", DungeonAuto.AutoQuickSell)
	for _, tg in ipairs(DungeonAuto.QuickSellToggles) do
		if tg:Get() ~= DungeonAuto.AutoQuickSell then
			tg:Set(DungeonAuto.AutoQuickSell, true)
		end
	end
	if DungeonAuto.AutoQuickSell and LocalPlayer:GetAttribute("InCombat") ~= true and State.Alive then
		task.spawn(runQuickSellTrash, true, statusFn or setDungeonStatus)
	end
end

