				Size = UDim2.fromOffset(11, 11),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(pct, 0.5),
				BackgroundColor3 = Theme.Accent,
				BorderSizePixel = 0,
				Parent = trackBg,
			}, {
				create("UICorner", { CornerRadius = UDim.new(1, 0) }),
