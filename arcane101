function AutoEquip.EvaluateDefForBuild(mods, profile, defId, def)
	if not mods or not mods.Inventory or not mods.Items or not def then
		return { score = 0, stats = {}, hp = 0, summary = "", isUpgrade = false, canWear = false, fitSlot = nil }
	end
	local Inventory = mods.Inventory
	local mySchool = profile and profile.primarySchool
	local buildSpec = resolveAutoBuildProfile(mods, profile)
	local targetSchool = buildSpec.school or mySchool
	local schoolDef = targetSchool and mods.Schools and mods.Schools.defs[targetSchool]
	local playerLevel = (profile and profile.level) or 1
	local equipped = (profile and profile.equipped) or {}

	local fitSlot = nil
	if def.slot == "Pet" then
		fitSlot = "Pet"
	elseif def.slot then
		for _, s in ipairs(EQUIP_SLOTS_ORDER) do
			if Inventory.fits(def, s) then
				fitSlot = s
				break
			end
		end
	end

	local fakeItem = { uid = "__shop_sim", defId = defId, count = 1 }
	local st, hp = def.stats or {}, 0
	local potScore = nil
	if fitSlot then
		local simProf = {
			inventory = { fakeItem },
			equipped = { [fitSlot] = "__shop_sim" },
			level = playerLevel,
			primarySchool = targetSchool or mySchool,
		}
		local okS, sRes = pcall(Inventory.equippedStats, simProf)
		local okH, hRes = pcall(Inventory.equippedMaxHp, simProf)
		if okS and type(sRes) == "table" then
			st = sRes
		end
		if okH and type(hRes) == "number" then
			hp = hRes
		end
		-- Compare Shop items at Max Blacksmith Potential so T0 Shop BiS pieces still flag as Upgrades over T3-T5 filler
		local maxShopItem = makeBlacksmithMaxCopy(mods, fakeItem, def, true)
		local potSt, potHp, potIncHp = deriveBuildTotals(mods, profile, { maxShopItem }, { [fitSlot] = maxShopItem.uid }, targetSchool, false)
		local potSame = getItemElementMatch(mods, defId, potSt, targetSchool, schoolDef)
		local potQual = (AutoLock.GetRarityRank(mods, def) * 0.4) + ((maxShopItem.tier or 0) * 1.2)
		potScore = scoreBuildStats(mods, potSt, potHp, targetSchool, schoolDef, buildSpec, potSame and 1 or 0, potQual, potIncHp)
	end

	local isSame = getItemElementMatch(mods, defId, st, targetSchool, schoolDef)
	local rarityRank = AutoLock.GetRarityRank(mods, def)
	local quality = rarityRank * 0.4
	local itemScore = scoreBuildStats(mods, st, hp, targetSchool, schoolDef, buildSpec, isSame and 1 or 0, quality)

	local okSchool, schoolOk = pcall(Inventory.schoolCanWear, mySchool, defId)
	local LevelGate = mods.LevelGate
	local canWearLv = (LevelGate and LevelGate.canWear and LevelGate.canWear(playerLevel, defId)) or ((def.minLevel or 1) <= playerLevel)
	local canWear = (def.slot ~= nil)
		and (def.slot ~= "Mount")
		and (not okSchool or schoolOk)
		and canWearLv

	local isUpgrade = false
	local currentSlotScore = 0
	if fitSlot and canWear then
		local bestExistingScore = 0
		local bestExistingPot = 0
		local slotsToCheck = (fitSlot == "Pet") and { "Pet" } or {}
		if #slotsToCheck == 0 then
			for _, s in ipairs(EQUIP_SLOTS_ORDER) do
				if Inventory.fits(def, s) then
					table.insert(slotsToCheck, s)
				end
			end
		end
		for i, s in ipairs(slotsToCheck) do
			local eqUid = equipped[s]
			local slotScore = 0
			local slotPotScore = 0
			if eqUid and profile and type(profile.inventory) == "table" then
				for _, invItem in ipairs(profile.inventory) do
					if invItem.uid == eqUid then
						local eqDef = mods.Items[invItem.defId]
						if eqDef then
							local eqProf = {
								inventory = { invItem },
								equipped = { [s] = invItem.uid },
								level = playerLevel,
								primarySchool = targetSchool or mySchool,
							}
							local okES, eqSt = pcall(Inventory.equippedStats, eqProf)
							local okEH, eqHp = pcall(Inventory.equippedMaxHp, eqProf)
							eqSt = (okES and type(eqSt) == "table") and eqSt or (eqDef.stats or {})
							eqHp = (okEH and type(eqHp) == "number") and eqHp or 0
							local eqSame = getItemElementMatch(mods, invItem.defId, eqSt, targetSchool, schoolDef)
							local eqQual = (AutoLock.GetRarityRank(mods, eqDef) * 0.4) + ((invItem.tier or 0) * 0.8)
							slotScore = scoreBuildStats(mods, eqSt, eqHp, targetSchool, schoolDef, buildSpec, eqSame and 1 or 0, eqQual)

							local maxEqItem = makeBlacksmithMaxCopy(mods, invItem, eqDef, true)
							local eqPotSt, eqPotHp, eqPotIncHp = deriveBuildTotals(mods, profile, { maxEqItem }, { [s] = maxEqItem.uid }, targetSchool, false)
							local eqPotSame = getItemElementMatch(mods, invItem.defId, eqPotSt, targetSchool, schoolDef)
							local eqPotQual = (AutoLock.GetRarityRank(mods, eqDef) * 0.4) + ((maxEqItem.tier or 0) * 1.2)
							slotPotScore = scoreBuildStats(mods, eqPotSt, eqPotHp, targetSchool, schoolDef, buildSpec, eqPotSame and 1 or 0, eqPotQual, eqPotIncHp)
						end
						break
					end
				end
			end
			if i == 1 or slotScore < bestExistingScore then
				bestExistingScore = slotScore
			end
			if i == 1 or slotPotScore < bestExistingPot then
				bestExistingPot = slotPotScore
			end
		end
		currentSlotScore = bestExistingScore
		isUpgrade = (itemScore > (currentSlotScore + 0.05)) or (potScore ~= nil and potScore > (bestExistingPot + 0.05))
	end

	-- Format concise readable stat highlights
	local parts = {}
	local statEntries = {}
	for k, v in pairs(st) do
		if type(v) == "number" and math.abs(v) > 0.0001 then
			local label = k
			label = string.gsub(label, "Damage$", "Dmg")
			label = string.gsub(label, "Resistance$", "Res")
			label = string.gsub(label, "PowerPipChance", "Pip")
			label = string.gsub(label, "HealingBonus", "Heal")
			label = string.gsub(label, "CritChance", "Crit")
			label = string.gsub(label, "CritDamage", "CritDmg")
			label = string.gsub(label, "BlockChance", "Blk")
			label = string.gsub(label, "MaxHealth", "HP")
			label = string.gsub(label, "Accuracy", "Acc")
			local isShare = (mods.StatsMod and mods.StatsMod.isShare and mods.StatsMod.isShare(k)) or (math.abs(v) < 1 and k ~= "MaxHealth")
			local valText = isShare and string.format("+%d%%", math.floor(v * 100 + 0.5)) or string.format("+%d", math.floor(v + 0.5))
			local prio = (k == "AllDamage" or (schoolDef and k == schoolDef.damageBonus) or k == "HealingBonus") and 3
				or (k == "PowerPipChance" or k == "AllResistance" or k == "CritChance" or k == "Pierce") and 2 or 1
			table.insert(statEntries, { text = valText .. " " .. label, prio = prio, mag = math.abs(v) })
		end
	end
	if hp > 0 then
		table.insert(statEntries, { text = string.format("+%d HP", math.floor(hp + 0.5)), prio = 1, mag = hp })
	end
	table.sort(statEntries, function(a, b)
		if a.prio ~= b.prio then
			return a.prio > b.prio
		end
		return a.mag > b.mag
	end)
	for i = 1, math.min(3, #statEntries) do
		table.insert(parts, statEntries[i].text)
	end

	return {
		score = itemScore,
		delta = itemScore - currentSlotScore,
		stats = st,
		hp = hp,
		summary = table.concat(parts, " · "),
		isUpgrade = isUpgrade,
		canWear = canWear,
		fitSlot = fitSlot,
		sameElement = isSame,
	}
end

function AutoEquip.ScoreUpgradeDelta(mods, profile, slot, item, nextTier)
	if not mods or not profile or not item then
		return 0
	end
	local buildSpec = resolveAutoBuildProfile(mods, profile)
	local targetSchool = buildSpec.school or profile.primarySchool
	local schoolDef = targetSchool and mods.Schools and mods.Schools.defs[targetSchool]
	local baseSt, baseHp, baseInc = deriveBuildTotals(mods, profile, { item }, { [slot] = item.uid }, targetSchool, false)
	local upgraded = {}
	for k, v in pairs(item) do
		upgraded[k] = v
	end
	upgraded.tier = nextTier or ((item.tier or 0) + 1)
	local nextSt, nextHp, nextInc = deriveBuildTotals(mods, profile, { upgraded }, { [slot] = upgraded.uid }, targetSchool, false)
	local same = getItemElementMatch(mods, item.defId, baseSt, targetSchool, schoolDef) and 1 or 0
	local s0 = scoreBuildStats(mods, baseSt, baseHp, targetSchool, schoolDef, buildSpec, same, 0, baseInc)
	local s1 = scoreBuildStats(mods, nextSt, nextHp, targetSchool, schoolDef, buildSpec, same, 0, nextInc)
	return math.max(0, s1 - s0)
end

task.spawn(function()
	local mods = getGameMods()
	if mods and State.Alive and mods.Schools and type(mods.Schools.order) == "table" then
		local opts = { "Auto (My School)" }
		for _, s in ipairs(mods.Schools.order) do
			table.insert(opts, s)
		end
		elementDropdown:SetOptions(opts, elementDropdown:Get())
	end

	if mods and State.Alive then
		local function onLootOrProfile()
			if not State.Alive then
				return
			end
			if AutoLock.Enabled and not AutoLock.Busy and (os.clock() - AutoLock.LastRunAt) >= 1.5 then
				task.delay(0.2, function()
					if State.Alive and AutoLock.Enabled and not AutoLock.Busy then
						AutoLock.Run(true, setGearStatus)
					end
				end)
			end
			if AutoEquip.Enabled and (os.clock() - AutoEquip.LastRunAt) >= 1.2 then
				task.delay(0.35, function()
					if State.Alive and AutoEquip.Enabled then
						runSmartAutoEquip(true)
					end
				end)
			end
			if DungeonAuto.AutoQuickSell and not quickSellBusy and LocalPlayer:GetAttribute("InCombat") ~= true and (os.clock() - DungeonAuto.LastQuickSellAt) >= 4.0 then
				task.delay(0.65, function()
					if State.Alive and DungeonAuto.AutoQuickSell and not quickSellBusy and LocalPlayer:GetAttribute("InCombat") ~= true then
						runQuickSellTrash(true, setGearStatus)
					end
				end)
			end
		end
		trackConnection(mods.Net.onClientEvent("ProfileChanged", onLootOrProfile))
		trackConnection(mods.Net.onClientEvent("ChestOpened", onLootOrProfile))
	end
end)

