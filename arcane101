local function queueTeleportAutoExec()
	if env.__MonochromeTeleportQueued then
		return true
	end
	local qfn = (typeof(queue_on_teleport) == "function" and queue_on_teleport)
		or (typeof(queueonteleport) == "function" and queueonteleport)
		or (type(syn) == "table" and typeof(syn.queue_on_teleport) == "function" and syn.queue_on_teleport)
	if not qfn then
		return false
	end

	local payload = [[
repeat task.wait(0.25) until game:IsLoaded()
task.wait(1)
local env = (typeof(getgenv) == "function" and getgenv()) or _G
if env.__MonochromeBooted then return end
env.__MonochromeBooted = true
local isFn = typeof(isfile) == "function" and isfile
local readFn = typeof(readfile) == "function" and readfile
if not isFn or not readFn then return end
if isFn("MonochromeHub/arcane101_config.json") then
	local ok, cfg = pcall(function()
		return game:GetService("HttpService"):JSONDecode(readfile("MonochromeHub/arcane101_config.json"))
	end)
	if ok and type(cfg) == "table" and cfg.AutoExecute == false then
		return
	end
end
local path = isFn("Arcane101.lua") and "Arcane101.lua" or (isFn("MonochromeHub/Arcane101.lua") and "MonochromeHub/Arcane101.lua")
if path then
	local src = readFn(path)
	if type(src) == "string" and #src > 0 then
		loadstring(src)()
	end
end
]]

	local ok = pcall(qfn, payload)
	if ok then
		env.__MonochromeTeleportQueued = true
	end
	return ok
end

if Config.Get("AutoExecute", true) then
	queueTeleportAutoExec()
end

