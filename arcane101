-- Assesses each enemy's real threat: impactful team healers > high DPS / AoE nukers & dangerous debuffers > weak healers / tanks
function CombatAuto.AnnotateEnemyThreats(mods, state, me, enemies)
	if type(enemies) ~= "table" or #enemies == 0 then
		return enemies
	end

	local Abilities = mods and mods.Abilities or {}
	local Statuses = mods and mods.Statuses or {}
	local CombatSim = mods and mods.CombatSim
	local myTeam = me and me.team

	local partyCount = 0
	if state and type(state.combatants) == "table" then
		for _, c in pairs(state.combatants) do
			if c.team == myTeam and not c.isPet and (not CombatSim or CombatSim.isAlive(c)) then
				partyCount += 1
			end
		end
	end
	partyCount = math.max(1, partyCount)

	local enemyCount = #enemies
	local damagedEnemyCount = 0
	local enemyTeamHasDebuffs = false
	local killableCount = 0
	local nonBossHpSum, nonBossCount = 0, 0
	local allHpSum = 0
	local hasActiveBinder = false

	local function statusHasTag(st, tag)
		if not st or type(st.tags) ~= "table" then
			return false
		end
		for _, t in ipairs(st.tags) do
			if t == tag then
				return true
			end
		end
		return false
	end

	local function isBinderCombatant(c)
		return type(c) == "table" and (c.binds == true or c.enemyId == "WardenLeftHand" or c.enemyId == "WardenRightHand")
	end

	local function hasBoundImmunityStatus(c)
		if type(c) ~= "table" then
			return false
		end
		for _, stEntry in ipairs(c.statuses or {}) do
			local sid = (type(stEntry) == "table" and stEntry.id) or stEntry
			local st = type(sid) == "string" and Statuses[sid]
			if sid == "Bound" or (st and st.uncapped == true and st.cleanseProof == true and type(st.damageTakenMultiplier) == "number" and st.damageTakenMultiplier <= 0.1) then
				return true
			end
		end
		return false
	end

	for _, e in ipairs(enemies) do
		if isBinderCombatant(e.combatant) then
			hasActiveBinder = true
			break
		end
	end

	for _, e in ipairs(enemies) do
		local c = e.combatant or {}
		local mHp = math.max(1, e.maxHp or (c.derived and c.derived.maxHp) or c.maxHp or e.hp or 100)
		local isBinder = isBinderCombatant(c)
		local isBound = hasBoundImmunityStatus(c) or (hasActiveBinder and type(c.bound) == "table")
		e.isAbyssFist = isBinder
		e._hasBoundStatus = isBound
		allHpSum += mHp
		if not e.isBoss then
			nonBossHpSum += mHp
			nonBossCount += 1
		end
		if (e.hp or mHp) < mHp * 0.92 then
			damagedEnemyCount += 1
		end
		if not (c.immortal == true or c.unkillable == true or isBound) then
			killableCount += 1
		end
		for _, stEntry in ipairs(c.statuses or {}) do
			local sid = (type(stEntry) == "table" and stEntry.id) or stEntry
			local st = type(sid) == "string" and Statuses[sid]
			if st and not st.cleanseProof and (st.isDot or st.turnsNext or st.missesNext or statusHasTag(st, "Debuff") or statusHasTag(st, "Curse") or statusHasTag(st, "Control") or statusHasTag(st, "DoT")) then
				enemyTeamHasDebuffs = true
				break
			end
		end
	end

	local refMobHp = math.max(45, (nonBossCount > 0) and (nonBossHpSum / nonBossCount) or (allHpSum / math.max(1, enemyCount)))

	local function collectEnemyAbilities(c)
		local seen = {}
		local list = {}
		local function push(aid, sourceKind, powerScale, procWeight)
			if type(aid) == "string" and aid ~= "" then
				if not seen[aid] then
					local entry = {
						id = aid,
						sourceKind = sourceKind,
						powerScale = powerScale or 1,
						procWeight = procWeight or 1,
					}
					seen[aid] = entry
					table.insert(list, entry)
				elseif sourceKind == "deck" and seen[aid].sourceKind ~= "deck" then
					-- Regular deck copy supersedes cinematic weighting
					seen[aid].sourceKind = "deck"
					seen[aid].powerScale = 1
					seen[aid].procWeight = 1
				end
			end
		end
		for _, aid in ipairs(c.abilityIds or {}) do
			push(aid, "deck", 1, 1)
		end
		for _, aid in ipairs(c.hand or {}) do
			push(aid, "deck", 1, 1)
		end
		if type(c.deckCards) == "table" then
			for aid, cnt in pairs(c.deckCards) do
				if (tonumber(cnt) or 0) > 0 then
					push(aid, "deck", 1, 1)
				end
			end
		end
		if type(c.cleanse) == "table" then
			push(c.cleanse.abilityId, "deck", 1, 1)
		end
		if type(c.cinematics) == "table" then
			local cinPow = tonumber(c.cinematics.power) or 1
			local cinChance = math.clamp(tonumber(c.cinematics.chance) or 0.25, 0.08, 1.0)
			local cinGap = math.max(0, math.min(6, tonumber(c.cinematics.gap) or 0))
			local cinProc = cinChance / (1 + cinGap * 0.55)
			for _, aid in ipairs(c.cinematics.abilityIds or {}) do
				push(aid, "cinematic", cinPow, cinProc)
			end
		end
		if type(c.cinematic) == "table" then
			local cinChance = math.clamp(tonumber(c.cinematic.chance) or 1.0, 0.10, 1.0)
			push(c.cinematic.abilityId, "cinematic", 1, 0.25 * cinChance)
		end
		if type(c.lastStand) == "table" then
			push(c.lastStand.abilityId, "cinematic", 1, 0.20)
		end
		return list
	end

	local function scoreSingleEnemy(e)
		local c = e.combatant or {}
		local cMaxHp = math.max(1, e.maxHp or (c.derived and c.derived.maxHp) or c.maxHp or e.hp or 100)
		local hp = math.max(0, e.hp or cMaxHp)
		local hpRatio = hp / cMaxHp
		local healScale = tonumber(c.healScale) or 1
		local dmgMult = tonumber(c.damageMultiplier) or 1
		local critChance = (c.derived and c.derived.scaling and tonumber(c.derived.scaling.CritChance)) or 0
		local activeDmgBuff = 1.0
		local isCurrentlyCtrl = false

		for _, stEntry in ipairs(c.statuses or {}) do
			local sid = (type(stEntry) == "table" and stEntry.id) or stEntry
			local st = type(sid) == "string" and Statuses[sid]
			if st then
				if type(st.damageDealtMultiplier) == "number" then
					if st.damageDealtMultiplier > 1 then
						activeDmgBuff *= st.damageDealtMultiplier
					elseif st.damageDealtMultiplier <= 0 then
						isCurrentlyCtrl = true
					end
				end
				if st.skipsTurn == true or sid == "Stunned" or sid == "Frozen" then
					isCurrentlyCtrl = true
				end
			end
		end
		if c.enraged == true then
			activeDmgBuff *= 1.25
		end
		local effDmgScale = dmgMult * activeDmgBuff * (1 + math.clamp(critChance, 0, 0.75) * 0.5)
		local pipReadiness = 1 + math.min(0.25, ((tonumber(c.energy) or 0) + (tonumber(c.powerPips) or 0)) * 0.04)

		local peakAllyHealImpact = 0
		local peakAllyHealScore = 0
		local extraAllyHealSum = 0
		local peakSelfHealScore = 0
		local peakDpsScore = 0
		local extraDpsSum = 0
		local peakCtrlScore = 0
		local extraCtrlSum = 0
		local cleanUtil = 0

		for _, abEntry in ipairs(collectEnemyAbilities(c)) do
			local aid = abEntry.id
			local ab = Abilities[aid]
			if type(ab) == "table" then
				local usedOnce = ab.oncePerFight and type(c.usedOnce) == "table" and c.usedOnce[aid] == true
				if not usedOnce then
					local cinPower = abEntry.powerScale or 1
					local cd = tonumber(ab.cooldown) or 0
					local cadence = (1 / (1 + cd * 0.55)) * (abEntry.procWeight or 1)
					if ab.oncePerFight then
						cadence *= 0.50
					end
					if type(ab.whenHurt) == "number" then
						cadence *= (hpRatio < ab.whenHurt) and 1.15 or 0.40
					end
					if CombatSim and type(CombatSim.cooling) == "function" then
						local okCd, isCooling = pcall(CombatSim.cooling, c, ab)
						if okCd and isCooling == true then
							cadence *= 0.50
						end
					end
					local cost = math.max(0, tonumber(ab.energyCost) or 0)
					local costFactor = 1 / (0.80 + cost * 0.25)
					if abEntry.sourceKind == "deck" and (tonumber(c.energy) or 0) >= cost then
						costFactor *= 1.10
					end

					local tk = ab.targetKind or "SingleEnemy"
					local abAllyHealImpact = 0
					local abAllyHealScore = 0
					local abSelfHealScore = 0
					local abDpsScore = 0
					local abCtrlScore = 0

					for _, eff in ipairs(ab.effects or {}) do
						local kind = eff.kind
						if kind == "Heal" or kind == "HealPercent" or kind == "Revive" then
							local rawH = 0
							if tonumber(eff.base) then
								rawH = eff.base * cinPower * healScale
							elseif tonumber(eff.share) then
								rawH = eff.share * cMaxHp
							elseif tonumber(eff.percent) then
								rawH = eff.percent * refMobHp
							elseif kind == "Revive" then
								rawH = refMobHp * 0.65
							end
							local isSelfOnly = (tk == "SelfOnly" or eff.target == "Self")
							if isSelfOnly then
								abSelfHealScore += rawH * cadence * costFactor * 0.30
							else
								local allyReach = (tk == "AllAllies") and math.max(1, enemyCount) or 1
								local rawImpact = rawH * allyReach * ((cd >= 3 or ab.oncePerFight) and 0.60 or 1.0) * (abEntry.sourceKind == "cinematic" and (abEntry.procWeight or 0.25) or 1)
								if enemyCount >= 2 then
									local teamMult = (tk == "AllAllies") and (enemyCount * 0.85) or 1.05
									local hurtBoost = (damagedEnemyCount > 0) and 1.25 or 1.0
									abAllyHealImpact = math.max(abAllyHealImpact, rawImpact)
									abAllyHealScore += rawH * teamMult * cadence * costFactor * hurtBoost
								else
									-- Last enemy standing: team heals only sustain itself
									abSelfHealScore += rawH * cadence * costFactor * 0.35
								end
							end
						elseif kind == "Cleanse" then
							if enemyCount >= 2 or enemyTeamHasDebuffs then
								cleanUtil = math.max(cleanUtil, enemyTeamHasDebuffs and 45 or 25)
							end
						elseif kind == "Damage" then
							local dBase = (tonumber(eff.base) or 0) * cinPower * math.max(1, tonumber(eff.hits) or 1)
							local reach = (tk == "AllEnemies") and math.max(1, partyCount * 0.85) or 1
							abDpsScore += dBase * effDmgScale * reach * cadence * costFactor * pipReadiness
						elseif kind == "ApplyStatus" and type(eff.statusId) == "string" then
							local sid = eff.statusId
							local st = Statuses[sid]
							local stacks = math.max(1, tonumber(eff.stacks) or 1)
							local isAoe = (tk == "AllEnemies" or tk == "AllAllies")
							local enemyReach = (tk == "AllEnemies") and math.max(1, partyCount * 0.85) or 1
							if st and (st.isHot == true or statusHasTag(st, "HoT")) then
								local hotH = (tonumber(st.healPerStack) or tonumber(st.base) or 14) * stacks * cinPower * healScale
								local isSelfOnly = (tk == "SelfOnly" or eff.target == "Self")
								if isSelfOnly or enemyCount <= 1 then
									abSelfHealScore += hotH * cadence * costFactor * 0.25
								else
									local allyReach = (tk == "AllAllies") and math.max(1, enemyCount) or 1
									local cinW = (abEntry.sourceKind == "cinematic") and (abEntry.procWeight or 0.25) or 1
									abAllyHealImpact = math.max(abAllyHealImpact, hotH * allyReach * 0.70 * cinW)
									abAllyHealScore += hotH * (tk == "AllAllies" and (enemyCount * 0.65) or 0.80) * cadence * costFactor
								end
							elseif st and (st.isDot == true or statusHasTag(st, "DoT")) then
								local dotD = (tonumber(st.damagePerStack) or tonumber(st.base) or 12) * stacks * dmgMult
								abDpsScore += dotD * enemyReach * cadence * costFactor * 0.80
							elseif sid == "Beguiled" or (st and st.turnsNext == true) then
								abCtrlScore += 85 * enemyReach * cadence * costFactor
							elseif sid == "Stunned" or sid == "Frozen" or (st and st.skipsTurn == true) then
								abCtrlScore += 65 * enemyReach * cadence * costFactor
							elseif sid == "Blinded" or (st and st.missesNext == true) then
								abCtrlScore += 42 * enemyReach * cadence * costFactor
							elseif sid == "MortalWound" or sid == "Vulnerable" or sid == "Hexed" or sid == "Chilled" or sid == "Nailed" or (st and (statusHasTag(st, "Debuff") or statusHasTag(st, "Curse"))) then
								abCtrlScore += 24 * enemyReach * cadence * costFactor
							elseif isAoe and tk == "AllAllies" then
								cleanUtil = math.max(cleanUtil, 20)
							end
						elseif kind == "Summon" then
							abCtrlScore += (enemyCount <= 2 and 60 or 40) * cadence
						end
					end

					if abAllyHealImpact > peakAllyHealImpact then
						peakAllyHealImpact = abAllyHealImpact
					end
					if abAllyHealScore > 0 then
						if abAllyHealScore > peakAllyHealScore then
							extraAllyHealSum += peakAllyHealScore
							peakAllyHealScore = abAllyHealScore
						else
							extraAllyHealSum += abAllyHealScore
						end
					end
					if abSelfHealScore > peakSelfHealScore then
						peakSelfHealScore = abSelfHealScore
					end
					if abDpsScore > 0 then
						if abDpsScore > peakDpsScore then
							extraDpsSum += peakDpsScore
							peakDpsScore = abDpsScore
						else
							extraDpsSum += abDpsScore
						end
					end
					if abCtrlScore > 0 then
						if abCtrlScore > peakCtrlScore then
							extraCtrlSum += peakCtrlScore
							peakCtrlScore = abCtrlScore
						else
							extraCtrlSum += abCtrlScore
						end
					end
				end
			end
		end

		if type(c.summon) == "table" and not c.hasSummoned then
			peakCtrlScore = math.max(peakCtrlScore, 45)
		end
		if type(c.cleanse) == "table" and (enemyCount >= 2 or enemyTeamHasDebuffs) then
			cleanUtil = math.max(cleanUtil, enemyTeamHasDebuffs and 45 or 25)
		end

		local allyHealScore = peakAllyHealScore + extraAllyHealSum * 0.30
		local dpsScore = peakDpsScore + extraDpsSum * 0.35
		local ctrlScore = peakCtrlScore + extraCtrlSum * 0.30 + (cleanUtil * 0.45)

		if isCurrentlyCtrl then
			dpsScore *= 0.80
			ctrlScore *= 0.80
		end

		return {
			allyHealImpact = peakAllyHealImpact,
			allyHealScore = allyHealScore,
			selfHealScore = peakSelfHealScore,
			dpsScore = dpsScore,
			ctrlScore = ctrlScore,
			cleanUtil = cleanUtil,
			rawBase = allyHealScore + peakSelfHealScore + dpsScore + ctrlScore,
		}
	end

	local maxPackDps = 0
	local maxRawBase = 0
	for _, e in ipairs(enemies) do
		local metrics = scoreSingleEnemy(e)
		e._threatMetrics = metrics
		if metrics.dpsScore > maxPackDps then
			maxPackDps = metrics.dpsScore
		end
		if metrics.rawBase > maxRawBase then
			maxRawBase = metrics.rawBase
		end
	end

	local hasMajorHealer = false
	local maxEffectiveThreat = 0
	for _, e in ipairs(enemies) do
		local m = e._threatMetrics
		local healVsRef = m.allyHealImpact / math.max(45, refMobHp)
		local healVsDps = m.allyHealScore / math.max(25, maxPackDps)
		-- Healer priority ONLY activates when enemy team has >=2 targets and healing is genuinely impactful
		local isMajorHealer = (enemyCount >= 2)
			and (m.allyHealScore >= math.max(24, refMobHp * 0.14))
			and (healVsRef >= 0.20 or (m.allyHealImpact >= 45 and healVsDps >= 0.45))

		local effectiveThreat = m.rawBase
		if isMajorHealer then
			effectiveThreat = math.max(m.rawBase, (maxRawBase * 1.35) + m.allyHealScore)
			hasMajorHealer = true
		end
		local c = e.combatant or {}
		local isBoundProtected = (e._hasBoundStatus == true) and killableCount > 0
		local isImmortal = (c.immortal == true or c.unkillable == true or isBoundProtected) and killableCount > 0
		if isImmortal then
			effectiveThreat *= (isBoundProtected and 0.02 or 0.15)
		elseif hasActiveBinder and e.isAbyssFist then
			local hpRatio = math.clamp((e.hp or 1) / math.max(1, e.maxHp or 1), 0, 1)
			effectiveThreat = math.max(effectiveThreat, maxRawBase * 1.45) + (1 - hpRatio) * 180
		end

		local role
		if isImmortal and isBoundProtected then
			role = "Bound"
		elseif hasActiveBinder and e.isAbyssFist then
			role = "Fist (Priority)"
		elseif isMajorHealer then
			role = "Healer"
		elseif m.ctrlScore >= m.dpsScore * 0.90 and m.ctrlScore >= 38 then
			role = "Debuffer"
		elseif m.dpsScore >= 30 then
			role = "Damage"
		else
			role = "Support"
		end

		e.isMajorHealer = isMajorHealer
		e.isBoundProtected = isBoundProtected
		e.isImmortal = isImmortal
		e._hasBoundStatus = nil
		e.threatRole = role
		e.allyHealScore = m.allyHealScore
		e.dpsScore = m.dpsScore
		e.ctrlScore = m.ctrlScore
		e.threatScore = effectiveThreat
		e._threatMetrics = nil
		if effectiveThreat > maxEffectiveThreat then
			maxEffectiveThreat = effectiveThreat
		end
	end

	for _, e in ipairs(enemies) do
		local ratio = (maxEffectiveThreat > 0) and (e.threatScore / maxEffectiveThreat) or 1
		e.threatRatio = ratio
		e.isTopThreat = (not e.isImmortal) and ((ratio >= 0.98) or (hasActiveBinder and e.isAbyssFist == true))
		local mult = 0.90 + ratio * 0.65
		if e.isImmortal then
			mult = e.isBoundProtected and 0.02 or 0.25
		elseif hasActiveBinder and e.isAbyssFist then
			local hpRatio = math.clamp((e.hp or 1) / math.max(1, e.maxHp or 1), 0, 1)
			mult = 2.60 + (1 - hpRatio) * 0.40
		elseif e.isTopThreat then
			mult = e.isMajorHealer and 1.95 or 1.75
		elseif e.isMajorHealer then
			mult = 1.80
		end
		if e.isBoss and not hasMajorHealer and not e.isImmortal and not hasActiveBinder then
			mult += 0.15
		end
		e.threatFocusMult = mult
	end

	return enemies
end

