					})

					optionBtns[opt] = optBtn

					trackConnection(optBtn.MouseEnter:Connect(function()
						if current ~= opt then
							tween(optBtn, { BackgroundTransparency = 0, TextColor3 = Theme.TextPrimary })
						end
					end))
					trackConnection(optBtn.MouseLeave:Connect(function()
						if current ~= opt then
							tween(optBtn, { BackgroundTransparency = 0.35, TextColor3 = Theme.TextSecondary })
						end
					end))
					trackConnection(optBtn.MouseButton1Click:Connect(function()
						selectValue(opt, false)
						setExpanded(false)
					end))
				end

				if expanded then
					card.Size = UDim2.new(1, 0, 0, expandedHeight)
				end
			end

			rebuildOptions(options)

			trackConnection(topBtn.MouseEnter:Connect(function()
				tween(card, { BackgroundColor3 = Theme.SurfaceHover })
			end))
			trackConnection(topBtn.MouseLeave:Connect(function()
				tween(card, { BackgroundColor3 = Theme.Surface })
			end))
			trackConnection(topBtn.MouseButton1Click:Connect(function()
				setExpanded(not expanded)
			end))

			selectValue(current, true)

			return {
				Set = function(_, opt, silent)
					selectValue(opt, silent)
				end,
				SetOptions = function(_, newOptions, newDefault)
					rebuildOptions(newOptions)
					local target = newDefault
					if not target or not optionBtns[target] then
						target = optionBtns[current] and current or newOptions[1]
					end
					if target ~= nil then
						selectValue(target, true)
					end
				end,
				Get = function()
					return current
				end,
			}
		end

		return tabObj
	end

	return Window
end

--// Shared Arcane 101 Module Loader (Auto-Discovers Live Game Data)
local GameMods
local GameModsError = nil
local LiveBossIds = {}

local function safeRequire(inst)
	if not inst then
		return nil
	end
	local ok, mod = pcall(require, inst)
	if ok then
		return mod
	end
	return nil
end

local function countKeys(tbl)
	local n = 0
	if type(tbl) == "table" then
		for _ in pairs(tbl) do
			n += 1
		end
	end
	return n
end

local function getGameMods(forceReload)
	if GameMods and not forceReload then
		return GameMods
	end
	local ok, result = pcall(function()
		local Campaign = ReplicatedStorage:WaitForChild("Campaign", 5)
		local playerScripts = LocalPlayer:WaitForChild("PlayerScripts", 5)
		local client = playerScripts:WaitForChild("CampaignClient", 5)

		local Areas = safeRequire(Campaign.Data:FindFirstChild("Areas")) or {}
		local Enemies = safeRequire(Campaign.Data:FindFirstChild("Enemies"))
		local Carnival = safeRequire(Campaign.Data:FindFirstChild("Carnival")) or {}
		local Version = safeRequire(Campaign.Shared:FindFirstChild("Version"))
		local Build = safeRequire(Campaign.Shared:FindFirstChild("Build"))

		local bossEnemyIds = {}
		for k, v in pairs(LiveBossIds) do
			bossEnemyIds[k] = v
		end
		for _, area in pairs(Areas) do
			if type(area) == "table" and type(area.boss) == "table" then
				if type(area.boss.enemyId) == "string" then
					bossEnemyIds[area.boss.enemyId] = true
				end
				if type(area.boss.with) == "table" then
					for _, subId in ipairs(area.boss.with) do
						if type(subId) == "string" then
							bossEnemyIds[subId] = true
						end
					end
				end
			end
		end
		if type(Enemies) == "table" then
			for id, e in pairs(Enemies) do
				if type(e) == "table" and (e.isBoss == true or e.boss == true or e.kind == "Boss" or e.tier == "Boss") then
					bossEnemyIds[id] = true
				end
			end
		end

		local Abilities = require(Campaign.Data.Abilities)
		local Statuses = require(Campaign.Data.Statuses)
		local Items = safeRequire(Campaign.Data:FindFirstChild("Items")) or {}
		local Encounters = safeRequire(Campaign.Data:FindFirstChild("Encounters")) or {}
		local Trivia = safeRequire(Campaign.Data:FindFirstChild("Trivia")) or {}
		local NewLandsSpots = safeRequire(Campaign.Data:FindFirstChild("NewLandsSpots")) or {}

		return {
			Campaign = Campaign,
			Net = require(Campaign.Shared.Net),
			Enums = require(Campaign.Shared.Enums),
			Abilities = Abilities,
			Statuses = Statuses,
			Items = Items,
			Encounters = Encounters,
			Trivia = Trivia,
			Carnival = Carnival,
			NewLandsSpots = NewLandsSpots,
			BossEnemyIds = bossEnemyIds,
			VersionId = (type(Version) == "table" and Version.id) or (Build and tostring(Build)) or "?",
			Stats = {
				Abilities = countKeys(Abilities),
				Bosses = countKeys(bossEnemyIds),
				Trivia = #Trivia,
				Encounters = countKeys(Encounters),
				Items = countKeys(Items),
			},
			CombatSim = require(Campaign.Systems.CombatSim),
			CombatMath = safeRequire(Campaign.Systems:FindFirstChild("CombatMath")),
			Inventory = safeRequire(Campaign.Systems:FindFirstChild("Inventory")),
			Schools = safeRequire(Campaign.Shared:FindFirstChild("Schools")),
			Constants = safeRequire(Campaign.Shared:FindFirstChild("Constants")),
			MinigamesSys = safeRequire(Campaign.Systems:FindFirstChild("Minigames")),
			CombatUI = require(client.UI.CombatUI),
			Place = safeRequire(client:FindFirstChild("Place")),
			Vfx = safeRequire(client.Effects and client.Effects:FindFirstChild("Vfx")),
			Cinema = safeRequire(client.Effects and client.Effects:FindFirstChild("Cinema")),
		}
	end)
	if ok and result then
		GameMods = result
		GameModsError = nil
		return GameMods
	end
	GameModsError = tostring(result)
	return nil
end

local function teleportToPosition(pos)
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		root.CFrame = CFrame.new(pos + Vector3.new(0, 3.5, 0))
		return true
	end
	return false
end

