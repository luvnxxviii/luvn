local function detectProfilePathId(mods, profile)
	if type(profile) ~= "table" then
		return nil
	end
	if mods and mods.Talents and type(mods.Talents.pathOf) == "function" then
		local okP, pid = pcall(mods.Talents.pathOf, profile)
		if okP and type(pid) == "string" and pid ~= "" then
			return pid
		end
	end
	if type(profile.talents) == "table" then
		for _, tId in ipairs(profile.talents) do
			if type(tId) == "string" then
				local baseId = string.match(tId, "^([A-Za-z]+)%d*$")
				if baseId and TALENT_PATH_PROFILES[baseId] then
					return baseId
				end
			end
		end
	end
	return nil
end

local function resolveAutoBuildProfile(mods, profile, schoolOverride, roleOverride)
	local mySchool = profile and profile.primarySchool
	local targetSchool = schoolOverride
	if not targetSchool or targetSchool == "" then
		targetSchool = (AutoEquip.Element == "Auto (My School)" or AutoEquip.Element == "") and mySchool or AutoEquip.Element
	end
	local pathId = detectProfilePathId(mods, profile)
	local pathInfo = pathId and TALENT_PATH_PROFILES[pathId] or nil
	local grants = {}
	if mods and mods.Talents and type(mods.Talents.grants) == "function" and type(profile) == "table" then
		local okG, gTbl = pcall(mods.Talents.grants, profile)
		if okG and type(gTbl) == "table" then
			grants = gTbl
		end
	end

	local modeChoice = (roleOverride and roleOverride ~= "Auto") and roleOverride or ((not roleOverride) and AutoEquip.BuildMode or "Auto")
	local resolvedMode
	if modeChoice == "Support" or modeChoice == "Damage" then
		resolvedMode = modeChoice
	elseif roleOverride == "Auto" and targetSchool ~= mySchool then
		resolvedMode = (targetSchool == "Light" or targetSchool == "Nature" or targetSchool == "Frost") and "Support" or "Damage"
	else
		resolvedMode = (pathInfo and pathInfo.mode) or "Damage"
	end

	local effPathInfo = (not schoolOverride or schoolOverride == "" or schoolOverride == mySchool) and pathInfo or nil
	local archetype
	local label
	if resolvedMode == "Support" then
		if effPathInfo and effPathInfo.mode == "Support" then
			archetype = effPathInfo.archetype
			label = effPathInfo.label
		elseif targetSchool == "Frost" then
			archetype = "ShieldTank"
			label = "Tank/Shield"
		elseif targetSchool == "Nature" then
			archetype = "NatureHeal"
			label = "Heal/Sup"
		elseif targetSchool == "Light" then
			archetype = "LightHeal"
			label = "Heal/Sup"
		else
			archetype = "GeneralSup"
			label = "Support"
		end
	else
		if effPathInfo and effPathInfo.mode == "Damage" then
			archetype = effPathInfo.archetype
			label = effPathInfo.label
		else
			archetype = (targetSchool == "Storm" and "StormCrit")
				or (targetSchool == "Wind" and "HasteTempo")
				or ((targetSchool == "Flame" or targetSchool == "Shadow" or targetSchool == "Nature" or targetSchool == "Frost") and "DoTDamage")
				or (targetSchool == "Steel" and "TankBruiser")
				or (targetSchool == "Light" and "LightCritHeal")
				or "RawDamage"
			label = effPathInfo and (effPathInfo.label .. " (DMG)") or ((targetSchool or "Auto") .. " DPS")
		end
	end

	return {
		mode = resolvedMode,
		archetype = archetype,
		label = label,
		pathId = pathId,
		school = targetSchool,
		grants = grants,
	}
end

local function getItemElementMatch(mods, defId, statsTbl, targetSchool, schoolDef)
	if not targetSchool then
		return false
	end
	local okNamed, named = pcall(mods.Inventory.namesSchool, defId, targetSchool)
	if okNamed and named then
		return true
	end
	if schoolDef and type(statsTbl) == "table" and (
		(statsTbl[schoolDef.damageBonus] or 0) > 0
		or (statsTbl[schoolDef.pierce] or 0) > 0
		or (statsTbl[schoolDef.resistance] or 0) > 0
	) then
		return true
	end
	return false
end

local function getBlacksmithMaxTier(mods, def)
	if not def or not def.slot or def.exotic then
		return nil
	end
	if mods and mods.Inventory and mods.Inventory.isStackable and mods.Inventory.isStackable(def.id or "") then
		return nil
	end
	local c = mods and mods.Constants
	if def.slot == "Weapon" then
		-- WeaponUpgrade uses tierOf(item) = (item.tier or 0) + 1 up to MAX (6), so stored tier max is MAX - 1 (5)
		return math.max(1, ((c and c.WEAPON_UPGRADE and c.WEAPON_UPGRADE.MAX) or 6) - 1)
	end
	return (c and c.UPGRADE and c.UPGRADE.MAX_TIER) or 5
end

local function makeBlacksmithMaxCopy(mods, item, def, includeReforge)
	if type(item) ~= "table" then
		return item
	end
	def = def or (mods and mods.Items and mods.Items[item.defId])
	if not def then
		return item
	end
	local copyItem = {}
	for k, v in pairs(item) do
		copyItem[k] = v
	end
	local maxTier = getBlacksmithMaxTier(mods, def)
	if maxTier and (copyItem.tier or 0) < maxTier then
		copyItem.tier = maxTier
	end
	if includeReforge ~= false and mods and mods.Inventory and mods.Inventory.rolls and mods.Inventory.rolls(item.defId) and type(def.stats) == "table" then
		local spread = (mods.Constants and mods.Constants.GEAR_ROLL and mods.Constants.GEAR_ROLL.SPREAD) or 0.10
		local roundFn = mods.Inventory.roundRoll
		local existing = type(item.rolledStats) == "table" and item.rolledStats or {}
		local bestRolls = {}
		for statKey, baseVal in pairs(def.stats) do
			if type(baseVal) == "number" and baseVal ~= 0 then
				local targetRoll = math.abs(baseVal) * spread
				if roundFn then
					targetRoll = roundFn(statKey, targetRoll)
				end
				local curRoll = tonumber(existing[statKey]) or -math.huge
				if curRoll > targetRoll then
					targetRoll = curRoll
				end
				if targetRoll ~= 0 then
					bestRolls[statKey] = targetRoll
				end
			end
		end
		copyItem.rolledStats = bestRolls
	end
	return copyItem
end

local function getBlacksmithEnhanceCounts(mods, plan, slotsOrder)
	local upgLeft, rollLeft = 0, 0
	if not mods or type(plan) ~= "table" then
		return upgLeft, rollLeft
	end
	local spread = (mods.Constants and mods.Constants.GEAR_ROLL and mods.Constants.GEAR_ROLL.SPREAD) or 0.10
	local inv = mods.Inventory
	for _, slot in ipairs(slotsOrder) do
		local rec = plan[slot]
		if rec and rec.item and rec.def and rec.def.exotic ~= true then
			local item = rec.item
			local def = rec.def
			local maxTier = getBlacksmithMaxTier(mods, def)
			if maxTier and (item.tier or 0) < maxTier then
				upgLeft += 1
			end
			local canRoll = (mods.Reforge and mods.Reforge.canReforge and mods.Reforge.canReforge(item.defId))
				or (inv and inv.rolls and inv.rolls(item.defId))
			if canRoll and type(def.stats) == "table" then
				local rolled = type(item.rolledStats) == "table" and item.rolledStats or nil
				if not rolled or next(rolled) == nil then
					rollLeft += 1
				elseif inv and inv.rollOf then
					local sumRatio, statCnt = 0, 0
					for sk, bv in pairs(def.stats) do
						if type(bv) == "number" and bv > 0 then
							local rVal = tonumber(rolled[sk]) or 0
							local rawAmt = inv.rollOf(def, sk, rVal)
							sumRatio += (rawAmt / bv)
							statCnt += 1
						end
					end
					if statCnt > 0 and (sumRatio / statCnt) < (spread * 0.60) then
						rollLeft += 1
					end
				end
			end
		end
	end
	return upgLeft, rollLeft
end

local function deriveBuildTotals(mods, profile, invList, eqMap, targetSchool, forceBlacksmithMax)
	local evalInv = invList
	if forceBlacksmithMax and type(invList) == "table" then
		evalInv = {}
		for _, it in ipairs(invList) do
			table.insert(evalInv, makeBlacksmithMaxCopy(mods, it, nil, true))
		end
	end
	local planProfile = {
		inventory = evalInv,
		equipped = eqMap,
		level = profile and profile.level or 1,
		primarySchool = targetSchool or (profile and profile.primarySchool),
		talents = profile and profile.talents or nil,
	}
	if mods and mods.CharacterStats and type(mods.CharacterStats.derive) == "function" then
		local okD, derived = pcall(mods.CharacterStats.derive, planProfile)
		if okD and type(derived) == "table" then
			local st = type(derived.stats) == "table" and derived.stats or (type(derived.scaling) == "table" and derived.scaling or nil)
			if st then
				return st, tonumber(derived.maxHp) or 0, true
			end
		end
	end
	local okS, st = pcall(mods.Inventory.equippedStats, planProfile)
	local okH, hp = pcall(mods.Inventory.equippedMaxHp, planProfile)
	return (okS and type(st) == "table") and st or {}, (okH and type(hp) == "number") and hp or 0, false
end

local ARCHETYPE_SYNERGY = {
	StormCrit = { crit = 250, critDmg = 110, critPipBoost = 0.10, pierce = 40 },
	CritExecute = { crit = 180, critDmg = 115, pierce = 130 },
	LightCritHeal = { crit = 185, heal = 260, critDmg = 45 },
	DoTDamage = { statusPow = 320, crit = 35 },
	DrainBruiser = { hp = 0.45, allRes = 170, statusPow = 150 },
	TankBruiser = { block = 350, blockStr = 130, hp = 0.35, allRes = 120 },
	TankCounter = { block = 520, blockStr = 220, allRes = 240, hp = 0.50 },
	CritTempo = { crit = 120, haste = 260 },
	HasteTempo = { haste = 560, crit = 40 },
	RawDamage = { dmg = 45, pierce = 35 },
}

local function scoreBuildStats(mods, stats, bonusHp, targetSchool, schoolDef, buildSpecOrMode, elementMatchCount, gearQualitySum, includesTotalHp)
	local buildMode = (type(buildSpecOrMode) == "table") and buildSpecOrMode.mode or ((buildSpecOrMode == "Support") and "Support" or "Damage")
	local archetype = (type(buildSpecOrMode) == "table") and buildSpecOrMode.archetype or nil
	local grants = (type(buildSpecOrMode) == "table" and type(buildSpecOrMode.grants) == "table") and buildSpecOrMode.grants or nil
	local isSupport = (buildMode == "Support")
	local caps = (AutoEquip.RespectCaps and mods and mods.Constants and (mods.Constants.CAPS or mods.Constants.STAT_CAPS)) or nil
	local critConst = (mods and mods.Constants and mods.Constants.CRIT) or nil
	local baseCritMult = (critConst and tonumber(critConst.BASE_DAMAGE)) or 1.5
	local critChanceCap = (caps and tonumber(caps.CritChance)) or (critConst and tonumber(critConst.CHANCE_CAP)) or 0.6
	local critMultCap = (caps and tonumber(caps.CritDamage)) or (critConst and tonumber(critConst.DAMAGE_CAP)) or 3.0

	local function eff(statKey, rawVal)
		rawVal = tonumber(rawVal) or 0
		if rawVal <= 0 or not caps then
			return rawVal
		end
		local cap = caps[statKey]
		if type(cap) == "number" and cap > 0 and rawVal > cap then
			return cap + (rawVal - cap) * 0.01
		end
		return rawVal
	end

	local totalHp = includesTotalHp and math.max(tonumber(bonusHp) or 0, tonumber(stats.MaxHealth) or 0) or ((tonumber(stats.MaxHealth) or 0) + (tonumber(bonusHp) or 0))
	local healBonus = eff("HealingBonus", stats.HealingBonus)
	local powerPip = eff("PowerPipChance", stats.PowerPipChance)
	local allRes = tonumber(stats.AllResistance) or 0
	local statusRes = eff("StatusResistance", stats.StatusResistance)
	local blockChc = eff("BlockChance", stats.BlockChance)
	local blockStr = eff("BlockStrength", stats.BlockStrength)
	local haste = eff("Haste", stats.Haste)
	local acc = eff("Accuracy", stats.Accuracy)
	local rawCritChc = math.max(0, tonumber(stats.CritChance) or 0)
	local critChc = caps and math.min(critChanceCap, rawCritChc) or rawCritChc
	local excessCritChc = caps and math.max(0, rawCritChc - critChanceCap) or 0
	local rawCritBonus = math.max(0, tonumber(stats.CritDamage) or 0)
	local critMult = caps and math.min(critMultCap, baseCritMult + rawCritBonus) or (baseCritMult + rawCritBonus)
	local excessCritMult = caps and math.max(0, (baseCritMult + rawCritBonus) - critMultCap) or 0
	local statusPow = eff("StatusPower", stats.StatusPower)

	local schDmg = (schoolDef and (tonumber(stats[schoolDef.damageBonus]) or 0) or 0) + (tonumber(stats.AllDamage) or 0) + (tonumber(stats.OwnDamage) or 0)
	local schPierce = schoolDef and (tonumber(stats[schoolDef.pierce]) or 0) or 0
	local totalPierce = caps and math.min(caps.Pierce or 0.4, (tonumber(stats.Pierce) or 0) + schPierce) or ((tonumber(stats.Pierce) or 0) + schPierce)
	local schRes = schoolDef and (tonumber(stats[schoolDef.resistance]) or 0) or 0
	local resCap = (caps and schoolDef and caps[schoolDef.resistance]) or 0.6
	local totalSchRes = caps and math.min(resCap, allRes + schRes) or (allRes + schRes)

	local score = 0
	if isSupport then
		-- Support Build: Verdant (Nature) & Sanctuary (Light) prioritize 100% Heal * 100% PowerPip -> Resist/HP -> Offense once capped;
		-- Glacier (Frost Tank) balances HealingBonus (shield growth) + MaxHP + Resists + Block + FrostDamage
		local isTankSup = (archetype == "ShieldTank")
		local healMult = 1 + healBonus
		local pipFactor = 1 + math.min(1, powerPip) * (isTankSup and 0.45 or 0.55)
		score += (healMult * pipFactor) * (isTankSup and 1200 or 2300)
		score += totalHp * (isTankSup and 2.8 or 2.2)
		score += (math.min(caps and (caps.StatusResistance or 0.7) or 0.7, statusRes) + allRes) * (isTankSup and 580 or 540)
		score += totalSchRes * (isTankSup and 420 or 380)
		score += blockChc * (isTankSup and 480 or 420) + blockStr * (isTankSup and 180 or 160)
		score += haste * 380
		score += acc * 260
		score += schDmg * (isTankSup and 420 or 240) + totalPierce * (isTankSup and 200 or 140)
		score += critChc * 110 + statusPow * 110
	else
		-- Damage Build: true multiplicative (1 + SchoolDmg) * ((1 - Crit) + Crit * CritMult) + PowerPip & talent-path synergies
		local syn = (archetype and ARCHETYPE_SYNERGY[archetype]) or {}
		local critPipBoost = syn.critPipBoost or (grants and grants.energyOnCrit and 0.10 or 0)
		local expectedHitMult = (1 + schDmg) * ((1 - critChc) + critChc * critMult)
		local pipFactor = 1 + math.min(1, powerPip + critChc * critPipBoost) * 0.40
		local pierceMult = 1 + totalPierce * 0.65

		local schoolSynergy = 0
		schoolSynergy += critChc * (syn.crit or 0)
		schoolSynergy += (critMult - baseCritMult) * (syn.critDmg or 0)
		schoolSynergy += totalPierce * (syn.pierce or 0)
		schoolSynergy += haste * (syn.haste or 0)
		schoolSynergy += statusPow * (syn.statusPow or 0)
		schoolSynergy += blockChc * (syn.block or 0) + blockStr * (syn.blockStr or 0)
		schoolSynergy += healBonus * (syn.heal or 0)
		schoolSynergy += schDmg * (syn.dmg or 0)
		schoolSynergy += allRes * (syn.allRes or 0)
		schoolSynergy += totalHp * (syn.hp or 0)

		if targetSchool == "Nature" and archetype == "DoTDamage" then
			-- Wild Growth step 4 grants +8% HealingBonus and bleeds
			schoolSynergy += healBonus * 140
		end
		if grants and grants.healOnDamage and (syn.heal or 0) == 0 then
			schoolSynergy += healBonus * 180
		end

		score += (expectedHitMult * pipFactor * pierceMult) * 1000
		score += acc * 280
		score += haste * 210
		score += schoolSynergy
		score += healBonus * ((targetSchool == "Light" or targetSchool == "Nature") and 110 or 35)
		score += totalSchRes * 130 + allRes * 160 + statusRes * 80
		score += blockChc * 95 + blockStr * 35
		score += statusPow * 65
		score += totalHp * 0.75
		score += (excessCritChc + excessCritMult) * 12

		for statName, val in pairs(stats) do
			if type(val) == "number" and val > 0 then
				if string.find(statName, "Damage$") and statName ~= "AllDamage" and statName ~= "OwnDamage" and statName ~= "CritDamage" and (not schoolDef or statName ~= schoolDef.damageBonus) then
					score += val * 25
				elseif string.find(statName, "Pierce$") and statName ~= "Pierce" and (not schoolDef or statName ~= schoolDef.pierce) then
					score += val * 18
				elseif string.find(statName, "Resistance$") and statName ~= "AllResistance" and statName ~= "StatusResistance" and (not schoolDef or statName ~= schoolDef.resistance) then
					score += val * 10
				end
			end
		end
	end

	-- Soft element compatibility & gear tier tiebreakers
	score += (elementMatchCount or 0) * (isSupport and 6 or 65)
	score += (gearQualitySum or 0)
	return score
end

local function evaluatePlanLoadout(mods, profile, chosenItems, slotsOrder, targetSchool, schoolDef, buildSpec)
	local fakeInv = {}
	local fakeEq = {}
	local elemMatches = 0
	local qualitySum = 0

	for _, slot in ipairs(slotsOrder) do
		local rec = chosenItems[slot]
		if rec and rec.item then
			table.insert(fakeInv, rec.item)
			fakeEq[slot] = rec.item.uid
			if rec.sameElement then
				elemMatches += 1
			end
			qualitySum += rec.quality
		end
	end

	local stats, bonusHp, includesTotalHp = deriveBuildTotals(mods, profile, fakeInv, fakeEq, targetSchool, AutoEquip.BlacksmithPotential)
	local totalScore = scoreBuildStats(mods, stats, bonusHp, targetSchool, schoolDef, buildSpec, elemMatches, qualitySum, includesTotalHp)

	-- Deck & granted equipment ability compatibility via Loadout.gearFor / Loadout.meets
	if AutoEquip.DeckAware and mods.Loadout and mods.Abilities then
		local okGear, gearInfo = pcall(mods.Loadout.gearFor, fakeEq, fakeInv)
		if okGear and type(gearInfo) == "table" then
			if type(profile.deck) == "table" then
				for cardId, cnt in pairs(profile.deck) do
					if (tonumber(cnt) or 0) > 0 then
						local ab = mods.Abilities[cardId]
						if ab and ab.requires and mods.Loadout.meets then
							local okMeet, canUse = pcall(mods.Loadout.meets, ab, gearInfo)
							if okMeet and not canUse then
								totalScore -= 450 * (tonumber(cnt) or 1)
							end
						end
					end
				end
			end
			if type(gearInfo.grants) == "table" then
				local isSupport = (type(buildSpec) == "table" and buildSpec.mode == "Support") or (buildSpec == "Support")
				for cardId, cnt in pairs(gearInfo.grants) do
					local ab = mods.Abilities[cardId]
					local c = math.min(3, tonumber(cnt) or 1)
					if ab and not ab.hidden then
						local kind = tostring(ab.kind or "")
						if isSupport and (kind == "Heal" or kind == "Shield" or kind == "Ward" or kind == "Cleanse" or kind == "Utility") then
							totalScore += 32 * c
						elseif not isSupport and (kind == "Attack" or kind == "Blade" or kind == "Trap" or kind == "Global") then
							totalScore += 22 * c
						else
							totalScore += 8 * c
						end
					end
				end
			end
		end
	end

	return totalScore, stats, bonusHp, includesTotalHp
end

function AutoEquip.ApplySavedVanity(mods, profile, silent)
	if not AutoEquip.KeepVanity or type(AutoEquip.SavedVanity) ~= "table" or not mods or not mods.Inventory then
		return 0
	end
	local currentProf = profile
	if not currentProf then
		local okP, p = pcall(mods.Net.getProfile)
		if not okP or type(p) ~= "table" then
			return 0
		end
		currentProf = p
	end
	local applied = 0
	local vanityNow = currentProf.vanityLooks or {}
	local eqNow = currentProf.equipped or {}
	for slot, savedUid in pairs(AutoEquip.SavedVanity) do
		if type(savedUid) == "string" and vanityNow[slot] ~= savedUid then
			local savedItem = mods.Inventory.find(currentProf, savedUid)
			local savedDef = savedItem and mods.Items[savedItem.defId]
			if savedItem and savedDef then
				local okFit = true
				if mods.Inventory.HELD_LOOK_SLOTS and mods.Inventory.HELD_LOOK_SLOTS[slot] then
					local eqItem = eqNow[slot] and mods.Inventory.find(currentProf, eqNow[slot])
					local eqDef = eqItem and mods.Items[eqItem.defId]
					okFit = mods.Inventory.lookMatches(slot, savedDef, eqDef)
				end
				if okFit and eqNow[slot] ~= savedUid then
					pcall(function()
						mods.Net.fireServer("SetVanity", { slot = slot, uid = savedUid })
					end)
					applied += 1
					task.wait(0.05)
				end
			end
		end
	end
	if applied > 0 and not silent then
		setGearStatus("APPLIED · " .. tostring(applied) .. " VANITY")
	end
	return applied
end

local function optimizeSlotPlanSeed(mods, profile, slotCandidates, slotsOrder, targetSchool, schoolDef, buildSpec, seedField)
	local plan = {}
	local usedUids = {}
	for _, slot in ipairs(slotsOrder) do
		local list = slotCandidates[slot]
		if #list > 0 then
			local chosen = nil
			if seedField then
				local bestVal = -math.huge
				for _, rec in ipairs(list) do
					if not usedUids[rec.item.uid] then
						local v = tonumber(rec[seedField]) or 0
						if v > bestVal then
							bestVal = v
							chosen = rec
						end
					end
				end
			end
			if not chosen then
				for _, rec in ipairs(list) do
					if not usedUids[rec.item.uid] then
						chosen = rec
						break
					end
				end
			end
			if chosen then
				plan[slot] = chosen
				usedUids[chosen.item.uid] = true
			end
		end
	end

	local bestPlanScore, bestStats, bestHp, bestIncludesHp = evaluatePlanLoadout(mods, profile, plan, slotsOrder, targetSchool, schoolDef, buildSpec)
	for _ = 1, 3 do
		local improved = false
		for _, slot in ipairs(slotsOrder) do
			local prevRec = plan[slot]
			for _, cand in ipairs(slotCandidates[slot]) do
				if not prevRec or cand.item.uid ~= prevRec.item.uid then
					local otherSlot = nil
					if usedUids[cand.item.uid] then
						for _, s2 in ipairs(slotsOrder) do
							if s2 ~= slot and plan[s2] and plan[s2].item.uid == cand.item.uid then
								otherSlot = s2
								break
							end
						end
					end
					local canPlace = (not otherSlot) or (not prevRec) or mods.Inventory.fits(prevRec.def, otherSlot)
					if canPlace then
						local otherPrev = otherSlot and plan[otherSlot] or nil
						plan[slot] = cand
						if otherSlot then
							plan[otherSlot] = prevRec
						end
						local sc, stTbl, hpVal, incHp = evaluatePlanLoadout(mods, profile, plan, slotsOrder, targetSchool, schoolDef, buildSpec)
						if sc > (bestPlanScore + 0.0005) then
							bestPlanScore, bestStats, bestHp, bestIncludesHp = sc, stTbl, hpVal, incHp
							if prevRec and not otherSlot then
								usedUids[prevRec.item.uid] = nil
							end
							usedUids[cand.item.uid] = true
							prevRec = cand
							improved = true
						else
							plan[slot] = prevRec
							if otherSlot then
								plan[otherSlot] = otherPrev
							end
						end
					end
				end
			end
		end
		if not improved then
			break
		end
	end
	return plan, bestPlanScore, bestStats, bestHp, bestIncludesHp
end

local function runSmartAutoEquip(silentNoChange)
	if AutoEquip.Busy then
		return
	end
	local mods = getGameMods()
	if not mods or not mods.Inventory or not mods.Schools then
		return
	end
	if mods.Place and mods.Place.loadoutLocked() then
		if not silentNoChange then
			setGearStatus("EQUIP LOCKED IN RUN")
		end
		return
	end

	AutoEquip.Busy = true
	local ok, resultText = pcall(function()
		local okProf, profile = pcall(mods.Net.getProfile)
		if not okProf or type(profile) ~= "table" then
			return "ERR · NO PROFILE"
		end

		local Inventory = mods.Inventory
		local mySchool = profile.primarySchool
		local buildSpec = resolveAutoBuildProfile(mods, profile)
		local targetSchool = buildSpec.school or mySchool
		local schoolDef = targetSchool and mods.Schools.defs[targetSchool]
		local playerLevel = profile.level or 1
		local equipped = profile.equipped or {}

		local slotsOrder = {}
		if mods.Enums and type(mods.Enums.EquipSlotOrder) == "table" and #mods.Enums.EquipSlotOrder > 0 then
			for _, s in ipairs(mods.Enums.EquipSlotOrder) do
				if s ~= "Mount" and (s ~= "Pet" or AutoEquip.IncludePet) then
					table.insert(slotsOrder, s)
				end
			end
		end
		if #slotsOrder == 0 then
			for _, s in ipairs(EQUIP_SLOTS_ORDER) do
				table.insert(slotsOrder, s)
			end
			if AutoEquip.IncludePet then
				table.insert(slotsOrder, "Pet")
			end
		end

		-- Step 1: Score every legal gear piece per slot & keep build-defining outliers (Crit / Heal / Pip / Dmg / Defense / Equipped)
		local LevelGate = mods.LevelGate
		local slotCandidates = {}
		local currentBySlot = {}
		for _, slot in ipairs(slotsOrder) do
			local cands = {}
			local bestSpecial = {}
			for _, item in ipairs(profile.inventory or {}) do
				local def = mods.Items[item.defId]
				local canWearLv = LevelGate and LevelGate.canWear and LevelGate.canWear(playerLevel, item.defId) or ((def and def.minLevel or 1) <= playerLevel)
				if def
					and def.category ~= "Card"
					and Inventory.fits(def, slot)
					and Inventory.schoolCanWear(mySchool, item.defId)
					and not Inventory.expired(item)
					and canWearLv
				then
					local usePotential = AutoEquip.BlacksmithPotential
					local evalItem = usePotential and makeBlacksmithMaxCopy(mods, item, def, true) or item
					local singleSt, singleHp, singleIncludesHp = deriveBuildTotals(mods, profile, { evalItem }, { [slot] = evalItem.uid }, targetSchool, false)
					local okRaw, rawSt = pcall(Inventory.equippedStats, { inventory = { evalItem }, equipped = { [slot] = evalItem.uid }, level = playerLevel, primarySchool = targetSchool or mySchool })
					local rawCheck = (okRaw and type(rawSt) == "table") and rawSt or singleSt
					local okRawHp, rawHpVal = pcall(Inventory.equippedMaxHp, { inventory = { evalItem }, equipped = { [slot] = evalItem.uid }, level = playerLevel, primarySchool = targetSchool or mySchool })
					local itemHpVal = (okRawHp and type(rawHpVal) == "number") and rawHpVal or (tonumber(rawCheck.MaxHealth) or 0)

					local isSame = getItemElementMatch(mods, item.defId, rawCheck, targetSchool, schoolDef)
					local rarityVal = RARITY_WEIGHT[def.rarity] or 1
					-- Include actual tier, weapon attack tier power, and positive Reforge share as tiebreakers (plus small Blacksmith-enhanceable nudge)
					local rollQual = 0
					if mods.Reforge and mods.Reforge.shares and type(item.rolledStats) == "table" then
						local okSh, shTbl = pcall(mods.Reforge.shares, item.defId, item.rolledStats)
						if okSh and type(shTbl) == "table" then
							for _, rv in pairs(shTbl) do
								rollQual += (tonumber(rv) or 0)
							end
						end
					end
					local canEnhanceBs = (getBlacksmithMaxTier(mods, def) ~= nil) and 0.15 or 0
					local wpnPwr = (def.slot == "Weapon" and mods.WeaponUpgrade and mods.WeaponUpgrade.power and select(2, pcall(mods.WeaponUpgrade.power, item.defId, (item.tier or 0) + 1, profile, def.rarity))) or 0
					local quality = (rarityVal * 0.4) + ((item.tier or 0) * 1.2) + (rollQual * 2.5) + ((tonumber(wpnPwr) or 0) * 0.05) + canEnhanceBs + ((equipped[slot] == item.uid) and 0.002 or 0)
					local itemScore = scoreBuildStats(mods, singleSt, singleHp, targetSchool, schoolDef, buildSpec, isSame and 1 or 0, quality, singleIncludesHp)
					if AutoEquip.DeckAware and (slot == "Weapon" or slot == "Offhand") and mods.Loadout and type(profile.deck) == "table" and mods.Abilities then
						local okG, gInfo = pcall(mods.Loadout.gearFor, { [slot] = item.uid }, { item })
						if okG and type(gInfo) == "table" then
							for cardId, cnt in pairs(profile.deck) do
								if (tonumber(cnt) or 0) > 0 then
									local ab = mods.Abilities[cardId]
									if ab and ab.requires and ((slot == "Weapon" and (ab.requires.weaponKind or ab.requires.weaponId or ab.requires.weaponElement or ab.requires.weight or ab.requires.blunt ~= nil or ab.requires.gun ~= nil))
										or (slot == "Offhand" and ab.requires.offhandKind))
									then
										local okM, m = pcall(mods.Loadout.meets, ab, gInfo)
										if okM and not m then
											itemScore -= 450 * (tonumber(cnt) or 1)
										end
									end
								end
							end
						end
					end
					local schDmgRaw = (schoolDef and (tonumber(rawCheck[schoolDef.damageBonus]) or 0) or 0) + (tonumber(rawCheck.AllDamage) or 0) + (tonumber(rawCheck.OwnDamage) or 0)
					local rec = {
						item = item,
						def = def,
						sameElement = isSame,
						quality = quality,
						score = itemScore,
						critVal = (tonumber(rawCheck.CritChance) or 0) * 2 + (tonumber(rawCheck.CritDamage) or 0),
						healVal = (tonumber(rawCheck.HealingBonus) or 0) * 2 + (tonumber(rawCheck.PowerPipChance) or 0),
						pipVal = (tonumber(rawCheck.PowerPipChance) or 0),
						dmgVal = schDmgRaw,
						defVal = (tonumber(rawCheck.AllResistance) or 0) * 300 + (tonumber(rawCheck.BlockChance) or 0) * 200 + (tonumber(rawCheck.Haste) or 0) * 180 + itemHpVal * 0.5,
					}
					table.insert(cands, rec)
					for _, key in ipairs({ "critVal", "healVal", "pipVal", "dmgVal", "defVal" }) do
						if rec[key] > 0 and (not bestSpecial[key] or rec[key] > bestSpecial[key][key]) then
							bestSpecial[key] = rec
						end
					end
					if equipped[slot] == item.uid then
						currentBySlot[slot] = rec
					end
				end
			end
			table.sort(cands, function(a, b)
				return a.score > b.score
			end)
			local trimmed = {}
			local keptUids = {}
			for i = 1, math.min(12, #cands) do
				table.insert(trimmed, cands[i])
				keptUids[cands[i].item.uid] = true
			end
			for _, key in ipairs({ "critVal", "healVal", "pipVal", "dmgVal", "defVal" }) do
				local spRec = bestSpecial[key]
				if spRec and not keptUids[spRec.item.uid] then
					table.insert(trimmed, spRec)
					keptUids[spRec.item.uid] = true
				end
			end
			if currentBySlot[slot] and not keptUids[currentBySlot[slot].item.uid] then
				table.insert(trimmed, currentBySlot[slot])
			end
			slotCandidates[slot] = trimmed
		end

		-- Step 2 & 3: Multi-seed whole-loadout coordinate ascent to avoid local optima around Crit/Heal caps
		local seeds = { nil }
		if buildSpec.mode == "Support" then
			table.insert(seeds, "healVal")
			table.insert(seeds, "dmgVal")
		else
			table.insert(seeds, "critVal")
			table.insert(seeds, "dmgVal")
		end
		local plan, bestPlanScore, bestStats, bestHp, bestIncludesHp = nil, -math.huge, {}, 0, false
		for _, seedField in ipairs(seeds) do
			local pSeed, scSeed, stSeed, hpSeed, incSeed = optimizeSlotPlanSeed(mods, profile, slotCandidates, slotsOrder, targetSchool, schoolDef, buildSpec, seedField)
			if not plan or scSeed > bestPlanScore then
				plan, bestPlanScore, bestStats, bestHp, bestIncludesHp = pSeed, scSeed, stSeed, hpSeed, incSeed
			end
		end

		-- Step 4: Apply the planned loadout changes
		local changes = 0
		for _, slot in ipairs(slotsOrder) do
			local chosen = plan[slot] and plan[slot].item or nil
			if chosen and equipped[slot] ~= chosen.uid then
				mods.Net.fireServer("EquipItem", { uid = chosen.uid, slot = slot })
				changes += 1
				task.wait(0.06)
			end
		end

		if changes > 0 and AutoEquip.KeepVanity then
			task.wait(0.15)
			local okNew, newProf = pcall(mods.Net.getProfile)
			AutoEquip.ApplySavedVanity(mods, okNew and newProf or profile, true)
		end

		local upgLeft, rollLeft = getBlacksmithEnhanceCounts(mods, plan, slotsOrder)
		local bsTag = ""
		if upgLeft > 0 or rollLeft > 0 then
			local bParts = {}
			if upgLeft > 0 then
				table.insert(bParts, tostring(upgLeft) .. " Upg")
			end
			if rollLeft > 0 then
				table.insert(bParts, tostring(rollLeft) .. " Roll")
			end
			bsTag = " · BS: " .. table.concat(bParts, "/")
		else
			bsTag = " · BS Max"
		end

		local dmgPct = ((schoolDef and bestStats[schoolDef.damageBonus] or 0) + (bestStats.AllDamage or 0) + (bestStats.OwnDamage or 0)) * 100
		local critPct = math.min(60, math.max(0, (bestStats.CritChance or 0) * 100))
		local critMultDisp = math.min(3.0, 1.5 + (bestStats.CritDamage or 0))
		local healPct = math.min(100, (bestStats.HealingBonus or 0) * 100)
		local pipPct = math.min(100, (bestStats.PowerPipChance or 0) * 100)
		local dispHp = bestIncludesHp and math.max(tonumber(bestHp) or 0, tonumber(bestStats.MaxHealth) or 0) or ((tonumber(bestStats.MaxHealth) or 0) + (tonumber(bestHp) or 0))
		local summaryNote = (buildSpec.mode == "Support")
			and string.format("+%d%% Heal · %d%% Pip · %d HP%s", math.floor(healPct + 0.5), math.floor(pipPct + 0.5), math.floor(dispHp + 0.5), bsTag)
			or string.format("+%d%% Dmg · %d%% Crit (%.2fx) · %d%% Pip%s", math.floor(dmgPct + 0.5), math.floor(critPct + 0.5), critMultDisp, math.floor(pipPct + 0.5), bsTag)
		local tagText = string.upper(tostring(targetSchool or "?")) .. "·" .. tostring(buildSpec.label or buildSpec.mode) .. (AutoEquip.BlacksmithPotential and "[BS]" or "")

		if changes > 0 then
			return string.format("%s · %d slots (%s)", tagText, changes, summaryNote)
		end
		if not silentNoChange then
			return string.format("BEST %s (%s)", tagText, summaryNote)
		end
		return nil
	end)
	AutoEquip.LastRunAt = os.clock()
	AutoEquip.Busy = false

	if ok then
		if resultText then
			setGearStatus(resultText)
		end
	else
		setGearStatus("EQUIP ERR")
	end
end

