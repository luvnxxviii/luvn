function CombatAuto.PlanSmartDeck(mods, profile)
	if not mods or type(profile) ~= "table" then
		return nil, "Profile or modules unavailable"
	end
	local Abilities = mods.Abilities or {}
	local Statuses = mods.Statuses or {}
	local Deck = mods.Deck
	local CardTiers = mods.CardTiers
	local LevelGate = mods.LevelGate
	local Loadout = mods.Loadout
	local Constants = mods.Constants
	if not Deck or not CardTiers or not LevelGate then
		return nil, "Deck/CardTiers modules missing"
	end

	local deckMin = (Constants and Constants.DECK and Constants.DECK.MIN) or 20
	local deckMax = (Constants and Constants.DECK and Constants.DECK.MAX) or 64
	local targetSize = 22
	if CombatAuto.Deck.SizePreset == "24-30 (Balanced)" then
		targetSize = 27
	elseif CombatAuto.Deck.SizePreset == "30-36 (Extended)" then
		targetSize = 33
	end
	targetSize = math.clamp(targetSize, deckMin, deckMax)

	local mySchool = profile.primarySchool or "Storm"
	local level = tonumber(profile.level) or 1
	local derivedStats = profile.derived and profile.derived.stats or nil
	local maxHp = math.max(100, tonumber(profile.derived and profile.derived.maxHp) or (300 + level * 15))
	local gear = (Loadout and type(Loadout.gearFor) == "function") and Loadout.gearFor(profile.equipped, profile.inventory) or {}
	local owned = type(profile.cardCopies) == "table" and profile.cardCopies or nil
	local cardTiers = type(profile.cardTiers) == "table" and profile.cardTiers or {}

	local pathId = nil
	if mods.Talents and type(mods.Talents.pathOf) == "function" then
		local okP, pid = pcall(mods.Talents.pathOf, profile)
		if okP and type(pid) == "string" then
			pathId = pid
		end
	end
	local mode = CombatAuto.Deck.Mode
	local isSupport = false
	if mode == "Support / Heal Focus" then
		isSupport = true
	elseif mode == "Damage Focus" then
		isSupport = false
	else
		isSupport = (pathId == "Sanctuary" or pathId == "Verdant" or pathId == "Glacier")
	end

	-- Origins immune check (matching CampDeck logic)
	local originExempt = nil
	if profile.originId and mods.Campaign then
		local okO, Origins = pcall(require, mods.Campaign.Data:FindFirstChild("Origins"))
		if okO and type(Origins) == "table" and type(Origins.list) == "table" and Origins.list[profile.originId] then
			originExempt = Origins.list[profile.originId].abilityId
		end
	end

	local function isSingleElementWardOnly(ab)
		if not ab or type(ab.effects) ~= "table" or #ab.effects == 0 then
			return false
		end
		local sawWard = false
		for _, ef in ipairs(ab.effects) do
			if ef.kind == "Damage" or ef.kind == "Heal" or ef.kind == "Shield" or ef.kind == "Cleanse" or ef.kind == "GainEnergy" then
				return false
			elseif ef.kind == "ApplyStatus" and ef.statusId then
				local st = Statuses[ef.statusId]
				if st and st.schoolTaken ~= nil and (ab.targetKind == "SelfOnly" or ef.target == "Self") then
					sawWard = true
				else
					return false
				end
			else
				return false
			end
		end
		return sawWard
	end

	-- Collect all owned/learned choosable cards AND gear cards
	local gearCards = Deck.gearCards(gear)
	local learnedSet = {}
	for _, aid in ipairs(profile.learnedAbilities or {}) do
		if type(aid) == "string" then
			learnedSet[aid] = true
		end
	end
	for _, aid in ipairs(profile.knownAbilities or {}) do
		if type(aid) == "string" then
			learnedSet[aid] = true
		end
	end

	local candidates = {}
	local excludedGear = {}

	local function scoreCardCandidate(aid, isFromGear)
		local ab = Abilities[aid]
		if not ab or ab.retired or ab.hidden then
			return nil
		end
		if isSingleElementWardOnly(ab) then
			if isFromGear then
				excludedGear[aid] = 0
			end
			return nil
		end

		local maxAllowed
		if isFromGear then
			maxAllowed = gearCards[aid] or 0
		else
			if not Deck.choosable(aid) then
				return nil
			end
			if not LevelGate.canDeck(level, aid) then
				return nil
			end
			if aid ~= originExempt and not LevelGate.statsAllow(derivedStats, aid) then
				return nil
			end
			maxAllowed = Deck.limit(aid, owned)
			if Deck.otherSchool(aid, mySchool) then
				local otherCap = (Constants and Constants.DECK and Constants.DECK.OTHER_SCHOOL_COPIES) or 1
				maxAllowed = math.min(maxAllowed, otherCap)
			end
		end
		if maxAllowed <= 0 then
			return nil
		end

		local cost = math.max(0, tonumber(ab.energyCost) or 0)
		local tk = ab.targetKind or "SingleEnemy"
		local isAoeEnemy = (tk == "AllEnemies")
		local isAoeAlly = (tk == "AllAllies")
		local tier = isFromGear and (CardTiers.heldOf(aid, gear) or 1) or CardTiers.of(cardTiers, aid)
		local abSchool = ab.school or ab.cardSchool
		local sameSchool = (abSchool == mySchool) or ab.anySchool == true or ab.neutral == true

		local dmgTotal = 0
		local healTotal = 0
		local shieldTotal = 0
		local dotTotal = 0
		local hotTotal = 0
		local gainEnergy = 0
		local payHpShare = 0
		local hasCleanse = false
		local hasShatter = false
		local hasSchoolBuff = false
		local buffSchoolMatch = false
		local hasMitigation = false
		local mitigationAoe = false
		local hasStunOrFreeze = false
		local hasBlind = false
		local hasVuln = false
		local hasBeguile = false

		for _, ef in ipairs(ab.effects or {}) do
			local kind = ef.kind
			local pw = 1
			local okPw, resPw = pcall(CardTiers.power, tier, ef, aid, level)
			if okPw and type(resPw) == "number" then
				pw = resPw
			end
			if isFromGear and CardTiers.isHeldCard(aid) and type(CardTiers.weaponPower) == "function" then
				local wTier, wRar, wId = CardTiers.heldOf(aid, gear)
				local okWp, wp = pcall(CardTiers.weaponPower, wRar or "Common", wTier or 1, ef, wId)
				if okWp and type(wp) == "number" and wp > 0 then
					pw = wp
				end
			end

			if kind == "Damage" then
				dmgTotal += (tonumber(ef.base) or 0) * math.max(1, tonumber(ef.hits) or 1) * pw
			elseif kind == "Detonate" or kind == "ConsumeDot" then
				dmgTotal += 38 * pw
			elseif kind == "Heal" then
				if tonumber(ef.base) then
					healTotal += ef.base * pw
				elseif tonumber(ef.share) then
					healTotal += ef.share * maxHp
				else
					healTotal += 30 * pw
				end
			elseif kind == "Shield" then
				-- Direct HP shields (e.g. Light's Dawnward, AegisOfDawn, Benediction) are neutral HP shields
				shieldTotal += (tonumber(ef.base) or 28) * pw
			elseif kind == "Cleanse" then
				hasCleanse = true
			elseif kind == "Shatter" then
				hasShatter = true
			elseif kind == "GainEnergy" then
				gainEnergy += (tonumber(ef.amount) or 0)
			elseif kind == "PayHealth" then
				local pVal = tonumber(ef.share) or ((tonumber(ef.amount) or 0) / maxHp)
				payHpShare += math.max(0, pVal)
			elseif kind == "ApplyStatus" and ef.statusId then
				local sid = ef.statusId
				local st = Statuses[sid]
				local stacks = math.max(1, tonumber(ef.stacks) or 1)
				if st then
					if st.isHot or (type(st.tags) == "table" and table.find(st.tags, "HoT")) then
						hotTotal += (tonumber(st.healPerStack) or 14) * stacks * pw
					elseif st.isDot or (type(st.tags) == "table" and table.find(st.tags, "DoT")) then
						dotTotal += (tonumber(st.damagePerStack) or 10) * stacks * pw
					elseif st.schoolDealt ~= nil or (type(st.damageDealtMultiplier) == "number" and st.damageDealtMultiplier > 1) then
						hasSchoolBuff = true
						if st.school == mySchool or ab.school == mySchool then
							buffSchoolMatch = true
						end
					elseif type(st.damageTakenMultiplier) == "number" and st.damageTakenMultiplier < 1 and st.schoolTaken == nil then
						hasMitigation = true
						if isAoeAlly then
							mitigationAoe = true
						end
					elseif st.preventsAction then
						hasStunOrFreeze = true
					elseif st.missesNext then
						hasBlind = true
					elseif st.turnsNext then
						hasBeguile = true
					elseif sid == "Vulnerable" or (type(st.damageTakenMultiplier) == "number" and st.damageTakenMultiplier > 1) then
						hasVuln = true
					end
				end
			end
		end

		local effDmg = dmgTotal * (isAoeEnemy and 2.25 or 1.0) + (dotTotal * 0.60 * (isAoeEnemy and 2.1 or 1.0))
		local effHeal = healTotal * (isAoeAlly and 2.25 or 1.0) + (hotTotal * 0.70 * (isAoeAlly and 2.1 or 1.0))
		local effShield = shieldTotal * (isAoeAlly and 2.25 or 1.0) + (hasMitigation and (mitigationAoe and 135 or 65) or 0)
		local pipDenom = math.max(0.85, cost)
		local dmgPerPip = effDmg / pipDenom
		local supPerPip = (effHeal + effShield * 0.90) / pipDenom

		-- Utility bonus from effects
		local utilValue = 0
		if hasVuln then
			utilValue += isAoeEnemy and 150 or 70
		end
		if hasStunOrFreeze then
			utilValue += isAoeEnemy and 130 or 60
		end
		if hasBlind then
			utilValue += isAoeEnemy and 95 or 40
		end
		if hasBeguile then
			utilValue += 55
		end
		if hasShatter then
			utilValue += isAoeEnemy and 80 or 45
		end
		if hasCleanse then
			utilValue += (isAoeAlly or tk == "SingleAny") and 85 or 45
		end
		if ab.spendAll then
			utilValue -= 15
		end

		-- Assign archetype category & compute worth-it score
		local roleBucket = "Filler"
		local valueScore = 0
		local recCap = maxAllowed

		if isFromGear and aid ~= originExempt and not hasCleanse and effHeal == 0 and effDmg <= 45 and not hasVuln and not hasBlind and not hasStunOrFreeze then
			-- Prune weak filler gear cards (Bolt/Shot/Strike/Cleave/Volley/Bash) to keep deck tight
			excludedGear[aid] = 0
			return nil
		end

		if aid == "Sacrifice" or (cost == 0 and gainEnergy > 0 and payHpShare > 0) then
			if not CombatAuto.Deck.AllowSacrifice or maxHp < 320 then
				return nil
			end
			roleBucket = isSupport and "SupportUtility" or "AttackUtility"
			valueScore = 115
			recCap = math.min(maxAllowed, 1)
		elseif hasSchoolBuff then
			if not buffSchoolMatch then
				-- Skip off-school damage buffs
				return nil
			end
			roleBucket = isSupport and "SupportUtility" or "AttackUtility"
			valueScore = 165
			recCap = math.min(maxAllowed, isSupport and 2 or 3)
		elseif hasCleanse and dmgTotal == 0 and healTotal == 0 and shieldTotal == 0 then
			-- Pure Cleanse (0 pips): keep 1-2 copies depending on role
			roleBucket = isSupport and "SupportUtility" or "AttackUtility"
			valueScore = isSupport and 175 or 130
			recCap = math.min(maxAllowed, isSupport and 2 or 1)
		elseif isSupport and (healTotal > 0 or hotTotal > 0) and dmgTotal == 0 then
			if isAoeAlly then
				roleBucket = "TeamHeal"
			else
				roleBucket = "FastHeal"
			end
			valueScore = supPerPip * (sameSchool and 1.25 or 0.90) + (utilValue * 0.55)
			if cost <= 2 then
				valueScore += 22
			end
			recCap = math.min(maxAllowed, cost >= 4 and 2 or (sameSchool and 4 or 1))
		elseif isSupport and (shieldTotal > 0 or hasMitigation) and dmgTotal == 0 then
			-- Support shields: Light's neutral HP shields (Dawnward, AegisOfDawn, Benediction) & Nature's EarthenWall/Oakhide
			roleBucket = "NeutralShield"
			valueScore = supPerPip * ((abSchool == "Light" or abSchool == mySchool) and 1.22 or 0.85) + (utilValue * 0.50)
			if cost <= 2 then
				valueScore += 18
			end
			recCap = math.min(maxAllowed, 2)
		elseif dmgTotal > 0 then
			if payHpShare >= 0.18 then
				-- High-HP self-sacrifice nukes like SeraphsSiphon/Immolate: keep at most 1 (or skip if fragile)
				valueScore = dmgPerPip * 0.65 - 50
				recCap = math.min(maxAllowed, 1)
			end
			if isAoeEnemy then
				roleBucket = isSupport and "SupportOffense" or "AoeClear"
			elseif cost >= 3 then
				roleBucket = isSupport and "SupportOffense" or "BigFinisher"
			else
				roleBucket = isSupport and "SupportOffense" or "CheapAttack"
			end

			local schoolMult = sameSchool and 1.32 or 0.72
			local costSmooth = (cost <= 3 and 1.08 or (cost >= 6 and 0.72 or 0.94))
			if isSupport then
				-- Support mode prizes healing/blinding/debuff hybrids heavily
				local hybridSupportBonus = (effHeal * 1.15) + (utilValue * 0.95)
				valueScore = ((dmgPerPip * 0.75) + (hybridSupportBonus / pipDenom)) * schoolMult * costSmooth
			else
				valueScore = (dmgPerPip + (utilValue / pipDenom) + (effHeal * 0.45 / pipDenom)) * schoolMult * costSmooth
			end

			if cost >= 5 then
				recCap = math.min(maxAllowed, cost >= 6 and 1 or 2)
			elseif isFromGear then
				recCap = math.min(maxAllowed, 1)
			elseif not sameSchool and (aid ~= "Sunder") then
				recCap = math.min(maxAllowed, 1)
			else
				-- Cap copies cleanly so deck doesn't flood on one card
				recCap = math.min(maxAllowed, cost <= 1 and 4 or (cost <= 2 and 3 or 2))
			end
		elseif hasBlind or hasVuln or hasBeguile or hasStunOrFreeze then
			roleBucket = isSupport and "SupportOffense" or "AttackUtility"
			valueScore = (utilValue / pipDenom) * (sameSchool and 1.20 or 0.95)
			recCap = math.min(maxAllowed, 1)
		else
			return nil
		end

		if valueScore <= 22 then
			if isFromGear then
				excludedGear[aid] = 0
			end
			return nil
		end

		-- If card comes from gear, only include in lean deck if it's genuinely high-tier/impactful
		if isFromGear and valueScore < 72 then
			excludedGear[aid] = 0
			return nil
		end

		return {
			id = aid,
			name = ab.name or aid,
			school = abSchool or "?",
			cost = cost,
			bucket = roleBucket,
			score = valueScore,
			dmgPerPip = dmgPerPip,
			supPerPip = supPerPip,
			maxCopies = recCap,
			isFromGear = isFromGear,
			tier = tier,
		}
	end

	for aid in pairs(gearCards) do
		local c = scoreCardCandidate(aid, true)
		if c then
			table.insert(candidates, c)
		end
	end
	for aid in pairs(learnedSet) do
		if not gearCards[aid] then
			local c = scoreCardCandidate(aid, false)
			if c then
				table.insert(candidates, c)
			end
		end
	end

	table.sort(candidates, function(a, b)
		if a.score ~= b.score then
			return a.score > b.score
		end
		if a.cost ~= b.cost then
			return a.cost < b.cost
		end
		return tostring(a.id) < tostring(b.id)
	end)

	-- Role quotas calibrated for lean targetSize (~22)
	local scaleF = targetSize / 22
	local quotas
	if isSupport then
		quotas = {
			FastHeal = math.max(3, math.floor(5 * scaleF + 0.5)),
			TeamHeal = math.max(3, math.floor(5 * scaleF + 0.5)),
			NeutralShield = math.max(2, math.floor(3 * scaleF + 0.5)),
			SupportUtility = math.max(2, math.floor(4 * scaleF + 0.5)),
			SupportOffense = math.max(3, math.floor(5 * scaleF + 0.5)),
		}
	else
		quotas = {
			CheapAttack = math.max(4, math.floor(7 * scaleF + 0.5)),
			AoeClear = math.max(4, math.floor(6 * scaleF + 0.5)),
			BigFinisher = math.max(2, math.floor(4 * scaleF + 0.5)),
			AttackUtility = math.max(2, math.floor(4 * scaleF + 0.5)),
		}
	end

	local chosenCounts = {}
	local totalSelected = 0
	local highCostSelected = 0
	local bucketCounts = {}
	local byBucket = {}
	for _, c in ipairs(candidates) do
		byBucket[c.bucket] = byBucket[c.bucket] or {}
		table.insert(byBucket[c.bucket], c)
	end

	local function tryAddCopy(c)
		if totalSelected >= targetSize then
			return false
		end
		local cur = chosenCounts[c.id] or 0
		if cur >= c.maxCopies then
			return false
		end
		if c.cost >= 5 and highCostSelected >= math.max(2, math.floor(targetSize * 0.22)) then
			return false
		end
		chosenCounts[c.id] = cur + 1
		totalSelected += 1
		bucketCounts[c.bucket] = (bucketCounts[c.bucket] or 0) + 1
		if c.cost >= 5 then
			highCostSelected += 1
		end
		return true
	end

	-- Pass 1: Round-robin top cards inside each role quota so we get strong variety + low bricking
	local progress = true
	while totalSelected < targetSize and progress do
		progress = false
		for bName, qCap in pairs(quotas) do
			if totalSelected >= targetSize then
				break
			end
			if (bucketCounts[bName] or 0) < qCap then
				local bList = byBucket[bName] or {}
				for _, c in ipairs(bList) do
					if tryAddCopy(c) then
						progress = true
						break
					end
				end
			end
		end
	end

	-- Pass 2: Fill up to deckMin (20) / targetSize with top value-per-pip cards (never leaving below legal minimum 20!)
	for _, c in ipairs(candidates) do
		if totalSelected >= targetSize then
			break
		end
		while (chosenCounts[c.id] or 0) < c.maxCopies and totalSelected < targetSize do
			if not tryAddCopy(c) then
				break
			end
		end
	end

	-- Ensure every excluded gear card explicitly maps to 0 so Deck.cards disables weak filler gear cards
	local finalMap = {}
	for aid in pairs(gearCards) do
		finalMap[aid] = chosenCounts[aid] or 0
	end
	for aid, cnt in pairs(chosenCounts) do
		if cnt > 0 then
			finalMap[aid] = cnt
		end
	end

	-- Compute real expected totals with Deck.cards (fallback fill if account has very few learned cards)
	if totalSelected < deckMin then
		for aid in pairs(learnedSet) do
			if totalSelected >= deckMin then
				break
			end
			local cur = finalMap[aid] or 0
			local lim = Deck.choosable(aid) and LevelGate.canDeck(level, aid) and Deck.limit(aid, owned) or 0
			if Deck.otherSchool(aid, mySchool) then
				lim = math.min(lim, 1)
			end
			if cur < lim then
				local add = math.min(lim - cur, deckMin - totalSelected)
				finalMap[aid] = cur + add
				totalSelected += add
			end
		end
	end

	-- Collect chosen breakdown for readout/preview
	local pickedSummary = {}
	for _, c in ipairs(candidates) do
		local cnt = finalMap[c.id] or 0
		if cnt > 0 then
			table.insert(pickedSummary, string.format("%s x%d (%dp, %.0f)", c.name, cnt, c.cost, c.score))
		end
	end

	return {
		school = mySchool,
		path = pathId or "?",
		role = isSupport and "Support" or "Damage",
		total = totalSelected,
		plan = finalMap,
		gearCards = gearCards,
		summary = pickedSummary,
	}, nil
end

function CombatAuto.ApplySmartDeck(mods, silent)
	if CombatAuto.Deck.Busy then
		return false, "Deck builder busy"
	end
	if LocalPlayer:GetAttribute("InRun") == true then
		return false, "Only usable in Lobby"
	end
	if not mods or not mods.Net or not mods.Deck then
		return false, "Game modules unavailable"
	end
	CombatAuto.Deck.Busy = true
	local okRun, appliedOk, msg = pcall(function()
		local okP, profile = pcall(mods.Net.getProfile)
		if not okP or type(profile) ~= "table" then
			return false, "Failed to read profile"
		end
		local result, planErr = CombatAuto.PlanSmartDeck(mods, profile)
		if not result then
			return false, planErr or "Deck plan failed"
		end

		local Deck = mods.Deck
		local activeIdx = tonumber(profile.activeDeck) or 1
		local rawCur = (type(profile.decks) == "table" and type(profile.decks[activeIdx]) == "table" and profile.decks[activeIdx].cards)
			or profile.deck or {}
		local gear = (mods.Loadout and type(mods.Loadout.gearFor) == "function")
			and mods.Loadout.gearFor(profile.equipped, profile.inventory) or {}

		-- Build exact current state as seen by Deck.cards (includes active gear defaults)
		local curEffective = Deck.cards(rawCur, gear)
		local seq = (tonumber(profile.deckSeq) or 0) + 1
		local deckMin = (mods.Constants and mods.Constants.DECK and mods.Constants.DECK.MIN) or 20
		local deckMax = (mods.Constants and mods.Constants.DECK and mods.Constants.DECK.MAX) or 64

		local allIds = {}
		local seen = {}
		for k in pairs(curEffective) do
			if not seen[k] then
				seen[k] = true
				table.insert(allIds, k)
			end
		end
		for k in pairs(result.plan) do
			if not seen[k] then
				seen[k] = true
				table.insert(allIds, k)
			end
		end
		table.sort(allIds)

		local curTotal = Deck.total(curEffective)
		local changes = 0
		-- Legal interleaved apply: add toward targets whenever curTotal < deckMax, remove excess whenever curTotal > deckMin
		for _pass = 1, 20 do
			local progressed = false
			for _, aid in ipairs(allIds) do
				local cVal = curEffective[aid] or 0
				local tVal = result.plan[aid] or 0
				if cVal < tVal and curTotal < deckMax then
					local step = math.min(tVal - cVal, deckMax - curTotal)
					local nextVal = cVal + step
					mods.Net.fireServer("SetDeckCard", { abilityId = aid, count = nextVal, seq = seq, deck = activeIdx })
					seq += 1
					curEffective[aid] = nextVal
					curTotal += step
					changes += 1
					progressed = true
					task.wait(0.05)
				end
			end
			for _, aid in ipairs(allIds) do
				local cVal = curEffective[aid] or 0
				local tVal = result.plan[aid] or 0
				if cVal > tVal and curTotal > deckMin then
					local step = math.min(cVal - tVal, curTotal - deckMin)
					local nextVal = cVal - step
					mods.Net.fireServer("SetDeckCard", { abilityId = aid, count = nextVal, seq = seq, deck = activeIdx })
					seq += 1
					curEffective[aid] = nextVal > 0 and nextVal or nil
					curTotal -= step
					changes += 1
					progressed = true
					task.wait(0.05)
				end
			end
			if not progressed then
				break
			end
		end

		local summaryTxt = string.format("DECK %s (%s:%s) · %dc · %d edits", result.role, result.school, result.path, curTotal, changes)
		return true, summaryTxt, result
	end)
	CombatAuto.Deck.Busy = false
	if not okRun then
		return false, tostring(appliedOk)
	end
	return appliedOk, msg
end

function CombatAuto.UpgradeOwnedCards(mods, silent)
	if LocalPlayer:GetAttribute("InRun") == true then
		return 0, "Only usable in Lobby"
	end
	if not mods or not mods.Net or not mods.CardTiers or not mods.Abilities then
		return 0, "Modules missing"
	end
	local okP, profile = pcall(mods.Net.getProfile)
	if not okP or type(profile) ~= "table" then
		return 0, "Failed to read profile"
	end

	local CardTiers = mods.CardTiers
	local Abilities = mods.Abilities
	local SeraphTrade = mods.SeraphTrade
	local allowGems = (CombatAuto.Deck.TierMode == "Include Gems (Up to Max)")
	local gold = tonumber(profile.gold) or 0
	local gems = tonumber(profile.metaCurrency) or 0
	local lv = tonumber(profile.level) or 1
	local school = profile.primarySchool or "Storm"
	local cardTiers = type(profile.cardTiers) == "table" and table.clone(profile.cardTiers) or {}

	-- Build trainer map per ability from Loadout.lessons + ability school fallback
	local lessonTrainer = {}
	if mods.Loadout and type(mods.Loadout.lessons) == "function" then
		local okL, list = pcall(mods.Loadout.lessons)
		if okL and type(list) == "table" then
			for _, entry in ipairs(list) do
				if type(entry) == "table" and type(entry.abilityId) == "string" and type(entry.trainerId) == "string" then
					lessonTrainer[entry.abilityId] = entry.trainerId
				end
			end
		end
	end

	local activeIdx = tonumber(profile.activeDeck) or 1
	local rawDeck = (type(profile.decks) == "table" and type(profile.decks[activeIdx]) == "table" and profile.decks[activeIdx].cards)
		or profile.deck or {}

	-- Gather owned active cards ONLY (in deck + learnedAbilities + talent skills), prioritized by deck membership
	local targetIds = {}
	local seen = {}
	for aid, cnt in pairs(rawDeck) do
		if type(aid) == "string" and (tonumber(cnt) or 0) > 0 and not seen[aid] then
			seen[aid] = true
			table.insert(targetIds, { id = aid, inDeck = true })
		end
	end
	for _, aid in ipairs(profile.learnedAbilities or {}) do
		if type(aid) == "string" and not seen[aid] then
			seen[aid] = true
			table.insert(targetIds, { id = aid, inDeck = false })
		end
	end
	if mods.Talents and type(mods.Talents.skillsOf) == "function" then
		local okS, sks = pcall(mods.Talents.skillsOf, profile)
		if okS and type(sks) == "table" then
			for _, aid in ipairs(sks) do
				if type(aid) == "string" and not seen[aid] then
					seen[aid] = true
					table.insert(targetIds, { id = aid, inDeck = true })
				end
			end
		end
	end

	local upgrades = 0
	for _, item in ipairs(targetIds) do
		if LocalPlayer:GetAttribute("InRun") == true or not State.Alive then
			break
		end
		local aid = item.id
		local ab = Abilities[aid]
		local isSeraphCard = SeraphTrade and type(SeraphTrade.teaches) == "function" and SeraphTrade.teaches(aid)
		if ab and not CardTiers.isHeldCard(aid) and not isSeraphCard and CardTiers.tierable(aid) then
			local trainerId = lessonTrainer[aid] or ab.school
			if type(trainerId) == "string" and trainerId ~= "" then
				for _step = 1, 6 do
					local curTier = CardTiers.of(cardTiers, aid)
					local can, _ = CardTiers.canRaise(aid, curTier, lv, gold, gems, school)
					if not can then
						break
					end
					local price = CardTiers.price(curTier, aid)
					local gCost = (price and tonumber(price.gold)) or 0
					local mCost = (price and tonumber(price.gems)) or 0
					if mCost > 0 and not allowGems then
						break
					end
					if gold < gCost or gems < mCost then
						break
					end
					mods.Net.fireServer("UpgradeCard", { abilityId = aid, trainerId = trainerId, tier = curTier })
					gold -= gCost
					gems -= mCost
					cardTiers[aid] = curTier + 1
					upgrades += 1
					task.wait(0.16)
				end
			end
		end
	end
	CombatAuto.Deck.LastUpgradeAt = os.clock()
	return upgrades, (upgrades > 0 and ("UPGRADED · " .. tostring(upgrades) .. " CARD TIERS") or "NO AFFORDABLE CARD UPGRADES")
end

