	local function updateHeaderBanner(mods, profile)
		local goldText, gemsText = "?", "?"
		if type(profile) == "table" then
			goldText = formatGold(profile.gold or 0) .. "g"
			gemsText = tostring(math.floor((profile.metaCurrency or 0) + 0.5)) .. " Gems"
		end
		local restockText = "--:--"
		if ShopSniper.Stock and type(ShopSniper.Stock.restockAt) == "number" then
			restockText = formatCountdown(ShopSniper.Stock.restockAt - os.time())
		end
		restockCard:Set(string.format("%s · %s · %s", restockText, goldText, gemsText))
	end

	local function matchesShopSelection(entry, selection)
		if selection == "Blacksmith (Weapons/Shields)" then
			return entry.kind == "Weapon" and entry.category ~= "Materials"
		elseif selection == "Accessory (Armor/Cosmetics)" then
			return entry.kind == "Accessory"
		elseif selection == "Pet Shop (Pets/Mounts/Eggs)" then
			return entry.kind == "Pet"
		elseif selection == "Cosmetics (Looks/Mounts/Pets)" then
			return COSMETIC_CATEGORIES[entry.category] == true
		end
		return entry.kind == "Weapon" or entry.kind == "Accessory" or entry.kind == "Pet"
	end

	local function matchesCurrencyMode(entry, mode)
		local cur = entry.currency or "Gold"
		if mode == "Gold Only (Save Gems)" or mode == "Gold Only" then
			return cur == "Gold"
		elseif mode == "Gems Only" then
			return cur == "Gems"
		end
		return true
	end

	local function matchesSnipeRule(rec, rule)
		local e = rec.entry
		local rank = rec.rarityRank
		if e.category == "Materials" or e.kind == "Snacks" then
			return false
		end
		if rule == "Stat Upgrades Only" then
			return rec.eval.isUpgrade == true
		elseif rule == "Cosmetics (Looks/Mounts/Pets)" then
			return COSMETIC_CATEGORIES[e.category] == true or COSMETIC_SLOTS[rec.def and rec.def.slot or ""] == true
		elseif rule == "Rare+" then
			return rank >= 3
		elseif rule == "Epic+" then
			return rank >= 4
		elseif rule == "Legendary+" then
			return rank >= 5
		elseif rule == "Good Pets & Mounts" then
			return e.kind == "Pet" and (e.category == "Pets" or e.category == "Mounts") and (rec.eval.isUpgrade or rank >= 2 or e.category == "Mounts")
		else
			-- "Upgrades + Rare+"
			return rec.eval.isUpgrade or rank >= 3
		end
	end

	local function analyzeEntries(mods, profile, stock)
		local out = {}
		if not mods or not stock or type(stock.entries) ~= "table" then
			return out
		end
		local ownedCounts = {}
		if type(profile) == "table" and type(profile.inventory) == "table" then
			for _, inv in ipairs(profile.inventory) do
				if inv.defId then
					ownedCounts[inv.defId] = (ownedCounts[inv.defId] or 0) + (inv.count or 1)
				end
			end
		end
		local rarityTable = mods.Constants and mods.Constants.RARITY
		for _, e in ipairs(stock.entries) do
			if type(e) == "table" and e.defId then
				local def = mods.Items and mods.Items[e.defId]
				local rName = (def and def.rarity) or "Common"
				local rRank = AutoLock.GetRarityRank(mods, rName)
				local rInfo = rarityTable and rarityTable[rName]
				local rColor = (type(rInfo) == "table" and typeof(rInfo.color) == "Color3") and rInfo.color or Theme.Border
				local eval = AutoEquip.EvaluateDefForBuild(mods, profile, e.defId, def)
				local owned = (ownedCounts[e.defId] or 0) > 0
				local isCosmetic = COSMETIC_CATEGORIES[e.category] == true or (def and COSMETIC_SLOTS[def.slot] == true)
				table.insert(out, {
					entry = e,
					def = def,
					rarityName = rName,
					rarityRank = rRank,
					rarityColor = rColor,
					eval = eval,
					owned = owned,
					isCosmetic = isCosmetic,
				})
			end
		end
		table.sort(out, function(a, b)
			local aRem = (a.entry.remaining or 0) > 0 and 1 or 0
			local bRem = (b.entry.remaining or 0) > 0 and 1 or 0
			if aRem ~= bRem then
				return aRem > bRem
			end
			local aUpg = a.eval.isUpgrade and 1 or 0
			local bUpg = b.eval.isUpgrade and 1 or 0
			if aUpg ~= bUpg then
				return aUpg > bUpg
			end
			if a.rarityRank ~= b.rarityRank then
				return a.rarityRank > b.rarityRank
			end
			if math.abs(a.eval.score - b.eval.score) > 0.01 then
				return a.eval.score > b.eval.score
			end
			return (a.entry.name or a.entry.defId) < (b.entry.name or b.entry.defId)
		end)
		return out
	end

