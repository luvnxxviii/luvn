GearTab:AddSection("Upgrades & Reforge")

(function()
	local upgradeReadyCard = GearTab:AddStatusCard({
		Title = "Blacksmith Plan",
		Value = "Click Scan to check Weapon, Armor & Rolls",
	})

	local UPGRADE_SLOTS = { "Outfit", "Helmet", "Backpack", "Charm1", "Charm2", "Charm3", "Offhand", "Pet" }
	local REFORGE_SLOTS = { "Weapon", "Offhand", "Helmet", "Outfit", "Backpack", "Charm1", "Charm2", "Charm3" }

	local function getMatCount(profile, itemId)
		local cnt = 0
		for _, it in ipairs((profile and profile.inventory) or {}) do
			if type(it) == "table" and it.defId == itemId then
				cnt += tonumber(it.count) or 1
			end
		end
		return cnt
	end

	local function scanEquippedWeaponPlan(mods, profile)
		if not mods or not mods.WeaponUpgrade or not profile then
			return nil
		end
		local equipped = profile.equipped or {}
		local bestWpn = nil
		for _, slot in ipairs({ "Weapon", "Offhand" }) do
			local uid = equipped[slot]
			local item = uid and mods.Inventory.find(profile, uid)
			local def = item and mods.Items[item.defId]
			if item and def and mods.WeaponUpgrade.isWeapon(item.defId) then
				local curTier = mods.WeaponUpgrade.tierOf(item)
				local maxTier = (mods.Constants and mods.Constants.WEAPON_UPGRADE and mods.Constants.WEAPON_UPGRADE.MAX) or 6
				local nextTier = curTier + 1
				local spare = (nextTier <= maxTier) and mods.WeaponUpgrade.spareFor(profile.inventory, {}, item) or nil
				local isFree = mods.Quests and mods.Quests.freeWeaponUpgrade and mods.Quests.freeWeaponUpgrade(profile)
				local canUp, reason = mods.WeaponUpgrade.canRaise(
					item,
					profile.level or 1,
					profile.gold or 0,
					profile.metaCurrency or 0,
					spare,
					function(matId) return getMatCount(profile, matId) end,
					isFree == true
				)
				local price = (nextTier <= maxTier) and mods.WeaponUpgrade.price(item.defId, nextTier) or nil
				local entry = {
					slot = slot,
					item = item,
					def = def,
					curTier = curTier,
					nextTier = nextTier,
					maxTier = maxTier,
					canUp = canUp == true,
					reason = reason,
					price = price,
					spare = spare,
					needsSpare = (nextTier <= maxTier) and mods.WeaponUpgrade.needsSpare(nextTier) ~= nil,
				}
				if slot == "Weapon" or not bestWpn then
					bestWpn = entry
				end
			end
		end
		return bestWpn
	end

	local function findBestUpgradePlan(mods, profile)
		if not mods or not mods.Upgrade or not profile then
			return nil, nil
		end
		local equipped = profile.equipped or {}
		local bestCandidate, bestPlan, bestWeight = nil, nil, -math.huge
		for _, slot in ipairs(UPGRADE_SLOTS) do
			local uid = equipped[slot]
			if uid then
				local item = mods.Inventory.find(profile, uid)
				local def = item and mods.Items[item.defId]
				if item and def and def.slot ~= "Weapon" and not def.exotic then
					local okSug, fuel = pcall(mods.Upgrade.suggestFuel, profile, uid)
					local okPlan, plan = pcall(mods.Upgrade.plan, profile, uid, okSug and fuel or {})
					if okPlan and type(plan) == "table" and plan.ok then
						local rarityRank = AutoLock.GetRarityRank(mods, def)
						local buildGain = AutoEquip.ScoreUpgradeDelta(mods, profile, slot, item, plan.nextTier)
						local weight = (buildGain * 10) + (rarityRank * 5) - ((plan.goldCost or 0) * 0.005)
						if not bestCandidate or weight > bestWeight then
							bestCandidate = { slot = slot, item = item, def = def, rank = rarityRank, gain = buildGain }
							bestPlan = plan
							bestWeight = weight
						end
					end
				end
			end
		end
		return bestCandidate, bestPlan
	end

	local function scanEquippedReforgeRolls(mods, profile, goldOnly)
		if not mods or not mods.Inventory or not mods.Items or not profile then
			return {}
		end
		local spread = (mods.Constants and mods.Constants.GEAR_ROLL and mods.Constants.GEAR_ROLL.SPREAD) or 0.10
		local equipped = profile.equipped or {}
		local list = {}
		for _, slot in ipairs(REFORGE_SLOTS) do
			local uid = equipped[slot]
			local item = uid and mods.Inventory.find(profile, uid)
			local def = item and mods.Items[item.defId]
			if item and def and mods.Inventory.rolls(item.defId) and type(def.stats) == "table" then
				local rolled = type(item.rolledStats) == "table" and item.rolledStats or nil
				local sumRatio, statCnt, negCnt = 0, 0, 0
				for sk, bv in pairs(def.stats) do
					if type(bv) == "number" and bv > 0 then
						local rv = rolled and tonumber(rolled[sk]) or 0
						local amt = mods.Inventory.rollOf(def, sk, rv)
						local ratio = amt / bv
						sumRatio += ratio
						statCnt += 1
						if amt < 0 then
							negCnt += 1
						end
					end
				end
				local avgRatio = (statCnt > 0) and (sumRatio / statCnt) or 0
				local price = mods.Reforge and mods.Reforge.price and mods.Reforge.price(item.defId) or nil
				local isGems = price and mods.Enums and mods.Enums.Currency and price.currency == mods.Enums.Currency.Gems
				local plan = mods.Reforge and mods.Reforge.plan and mods.Reforge.plan(profile, item.uid) or nil
				if not goldOnly or not isGems then
					table.insert(list, {
						slot = slot,
						item = item,
						def = def,
						name = tostring(def.name or item.defId),
						avgRatio = avgRatio,
						avgPctOfMax = math.floor((avgRatio / spread) * 100 + 0.5),
						unrolled = (rolled == nil or next(rolled) == nil),
						negCnt = negCnt,
						price = price,
						isGems = isGems == true,
						canPay = (plan and plan.ok == true) or false,
						reason = plan and plan.reason or nil,
					})
				end
			end
		end
		table.sort(list, function(a, b)
			if a.negCnt ~= b.negCnt then
				return a.negCnt > b.negCnt
			end
			return a.avgRatio < b.avgRatio
		end)
		return list
	end

	GearTab:AddButton({
		Title = "Scan Weapon, Upgrades & Rolls",
		Callback = function()
			local mods = getGameMods()
			if not mods or not mods.Inventory or not mods.Items then
				return
			end
			local okP, profile = pcall(mods.Net.getProfile)
			if not okP or type(profile) ~= "table" then
				return
			end
			local parts = {}
			local wpn = scanEquippedWeaponPlan(mods, profile)
			if wpn then
				local wName = tostring(wpn.def.name or wpn.item.defId)
				if wpn.curTier >= wpn.maxTier then
					table.insert(parts, "Wpn: " .. wName .. " MAX")
				elseif wpn.canUp then
					table.insert(parts, string.format("Wpn READY: %s T%d→T%d", wName, wpn.curTier, wpn.nextTier))
				else
					table.insert(parts, string.format("Wpn T%d (%s)", wpn.curTier, tostring(wpn.reason or "Locked")))
				end
			end
			local cand, plan = findBestUpgradePlan(mods, profile)
			if cand and plan then
				table.insert(parts, string.format("Gear: %s T%d→T%d (%dg)", tostring(cand.def.name or cand.item.defId), plan.tier, plan.nextTier, plan.goldCost))
			else
				table.insert(parts, "Gear: none ready")
			end
			local rolls = scanEquippedReforgeRolls(mods, profile, false)
			local weak = {}
			for _, r in ipairs(rolls) do
				if r.negCnt > 0 or r.unrolled or r.avgPctOfMax < 40 then
					table.insert(weak, string.format("%s(%s%d%%)", r.slot, r.unrolled and "0" or (r.avgPctOfMax >= 0 and "+" or ""), r.unrolled and 0 or r.avgPctOfMax))
				end
			end
			table.insert(parts, #weak > 0 and ("Rolls: " .. table.concat(weak, ", ")) or "Rolls: Clean (+)")
			upgradeReadyCard:Set(table.concat(parts, " | "))
			setGearStatus(#weak > 0 and ("BS SCAN · " .. #weak .. " WEAK ROLLS") or "BS SCAN · CLEAN")
		end,
	})

	GearTab:AddButton({
		Title = "Upgrade Equipped Weapon",
		Callback = function()
			if LocalPlayer:GetAttribute("InRun") == true then
				setGearStatus("EXIT RUN TO UPGRADE")
				return
			end
			local mods = getGameMods()
			if not mods or not mods.WeaponUpgrade then
				return
			end
			local okP, profile = pcall(mods.Net.getProfile)
			if not okP or type(profile) ~= "table" then
				setGearStatus("ERR · NO PROFILE")
				return
			end
			local wpn = scanEquippedWeaponPlan(mods, profile)
			if not wpn then
				upgradeReadyCard:Set("No upgradeable equipped Weapon")
				setGearStatus("NO WEAPON FOUND")
				return
			end
			local wName = tostring(wpn.def.name or wpn.item.defId)
			if wpn.curTier >= wpn.maxTier then
				upgradeReadyCard:Set(wName .. " is already Tier " .. tostring(wpn.maxTier))
				setGearStatus("WEAPON MAXED")
				return
			end
			if not wpn.canUp then
				upgradeReadyCard:Set(string.format("%s T%d→T%d: %s", wName, wpn.curTier, wpn.nextTier, tostring(wpn.reason or "Blocked")))
				setGearStatus("WPN BLOCKED · " .. tostring(wpn.reason or "?"))
				return
			end
			pcall(function()
				mods.Net.fireServer("UpgradeWeapon", { uid = wpn.item.uid, tier = wpn.curTier })
			end)
			upgradeReadyCard:Set(string.format("Weapon: %s T%d→T%d!", wName, wpn.curTier, wpn.nextTier))
			setGearStatus("WPN UPGRADED · " .. wName .. " T" .. tostring(wpn.nextTier))
		end,
	})

	GearTab:AddButton({
		Title = "Upgrade Best Armor/Charm (Path)",
		Callback = function()
			if LocalPlayer:GetAttribute("InRun") == true then
