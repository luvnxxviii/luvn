--// Lifecycle & State
local State = {
	Alive = true,
	Connections = {},
	Threads = {},
	RestoreHooks = {},
	Gui = nil,
}

local function trackConnection(conn)
	table.insert(State.Connections, conn)
	return conn
end

local function trackThread(fn)
	local thread = task.spawn(fn)
	table.insert(State.Threads, thread)
	return thread
end

local function trackRestore(fn)
	table.insert(State.RestoreHooks, fn)
end

function State.DestroyGuis()
	if State.Gui then
		pcall(function()
			State.Gui:Destroy()
		end)
		State.Gui = nil
	end
	local containers = {}
	if typeof(gethui) == "function" then
		local ok, hui = pcall(gethui)
		if ok and typeof(hui) == "Instance" then
			table.insert(containers, hui)
		end
	end
	pcall(function()
		if CoreGui and CoreGui.Name then
			table.insert(containers, CoreGui)
		end
	end)
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if pg then
		table.insert(containers, pg)
	end
	for _, root in ipairs(containers) do
		pcall(function()
			for _, child in ipairs(root:GetChildren()) do
				if child:IsA("ScreenGui") and child.Name == "MonochromeHub" then
					child:Destroy()
				end
			end
		end)
	end
end

local function cleanup()
	if not State.Alive then
		State.DestroyGuis()
		return
	end
	State.Alive = false

	-- Clear global re-execution guards immediately so a fresh execute works right away
	if env.__MonochromeCleanup == cleanup then
		env.__MonochromeCleanup = nil
	end
	env.__MonochromeBooted = nil
	if _G.__MonochromeCleanup == cleanup then
		_G.__MonochromeCleanup = nil
	end
	_G.__MonochromeBooted = nil

	-- Destroy hub UI immediately before tearing down hooks & threads
	State.DestroyGuis()

	for _, conn in ipairs(State.Connections) do
		pcall(function()
			if conn and conn.Disconnect then
				conn:Disconnect()
			end
		end)
	end
	table.clear(State.Connections)

	local currentThread = pcall(coroutine.running) and coroutine.running() or nil
	for _, thread in ipairs(State.Threads) do
		if typeof(thread) == "thread" and thread ~= currentThread then
			local okSt, st = pcall(coroutine.status, thread)
			if okSt and st ~= "dead" then
				pcall(task.cancel, thread)
			end
		end
	end
	table.clear(State.Threads)

	for _, restoreFn in ipairs(State.RestoreHooks) do
		pcall(restoreFn)
	end
	table.clear(State.RestoreHooks)

	if type(State.StatusFlushers) == "table" then
		table.clear(State.StatusFlushers)
	end
end

env.__MonochromeCleanup = cleanup
if env ~= _G then
	_G.__MonochromeCleanup = cleanup
end

--// Persistent Config & Auto-Execute on Server Join (Per-Account Isolated)
local CONFIG_DIR = "MonochromeHub"
local LEGACY_CONFIG_PATH = CONFIG_DIR .. "/arcane101_config.json"
local accountKey = (LocalPlayer and LocalPlayer.UserId and LocalPlayer.UserId > 0) and tostring(LocalPlayer.UserId) or (LocalPlayer and LocalPlayer.Name or "default")
accountKey = string.gsub(accountKey, "[^%w_%-]", "_")
local CONFIG_PATH = CONFIG_DIR .. "/arcane101_config_" .. accountKey .. ".json"

local Config = {
	Data = {},
	Loading = true,
}

local function fsReady()
	return typeof(readfile) == "function" and typeof(writefile) == "function" and typeof(isfile) == "function"
end

function Config.Load()
	if not fsReady() then
		Config.Loading = false
		return
	end
	local loadedFromAccountFile = false
	pcall(function()
		local loadPath = isfile(CONFIG_PATH) and CONFIG_PATH or (isfile(LEGACY_CONFIG_PATH) and LEGACY_CONFIG_PATH or nil)
		if loadPath then
			loadedFromAccountFile = (loadPath == CONFIG_PATH)
			local raw = readfile(loadPath)
			local decoded = HttpService:JSONDecode(raw)
			if type(decoded) == "table" then
				Config.Data = decoded
			end
		end
	end)
	Config.Loading = false
	-- Migrate legacy shared config into this account's own file once so accounts diverge cleanly
	if not loadedFromAccountFile and next(Config.Data) ~= nil then
		Config.Save()
	end
end

function Config.Save()
	if Config.Loading or not fsReady() then
		return
	end
	pcall(function()
		if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(CONFIG_DIR) then
			makefolder(CONFIG_DIR)
		end
		writefile(CONFIG_PATH, HttpService:JSONEncode(Config.Data))
	end)
end

function Config.Get(key, default)
	local v = Config.Data[key]
	if v == nil then
		return default
	end
	return v
end

function Config.Set(key, val)
	Config.Data[key] = val
	Config.Save()
end

Config.Load()

