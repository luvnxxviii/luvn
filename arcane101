local function tryVoteReplay(forceFire, ignoreDelay)
	if not State.Alive or not DungeonAuto.AutoReplay then
		return
	end
	local mods = getGameMods()
	if not mods then
		return
	end
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local summaryGui = pg and pg:FindFirstChild("RunSummary")
	if not summaryGui then
		DungeonAuto.VotedSummaryGui = nil
		DungeonAuto.SeenSummaryGui = nil
		DungeonAuto.SeenSummaryAt = nil
		if forceFire and not DungeonAuto.VotedCurrentSummary then
			DungeonAuto.VotedCurrentSummary = true
			DungeonAuto.LastReplayAttemptAt = os.clock()
			DungeonAuto.ReplayAttempts = (DungeonAuto.ReplayAttempts or 0) + 1
			pcall(function()
				mods.Net.fireServer("RequestReplay")
			end)
			setDungeonStatus("REPLAY REQUESTED")
		end
		return
	end

	if DungeonAuto.SeenSummaryGui ~= summaryGui then
		DungeonAuto.SeenSummaryGui = summaryGui
		DungeonAuto.SeenSummaryAt = os.clock()
		if not ignoreDelay then
			setDungeonStatus(string.format("REPLAY IN %.1fs", REPLAY_DELAY_SECONDS))
		end
	end

	if not ignoreDelay and DungeonAuto.SeenSummaryAt and (os.clock() - DungeonAuto.SeenSummaryAt) < REPLAY_DELAY_SECONDS then
		return
	end

	local replayBtn = findSummaryButton(summaryGui, "Replay")
	if not replayBtn then
		if findSummaryButton(summaryGui, "Continue") then
			DungeonAuto.VotedSummaryGui = summaryGui
			setDungeonStatus("RUN ENDED (NO REPLAY)")
		end
		return
	end

	-- Initial vote on this RunSummary UI
	if DungeonAuto.VotedSummaryGui ~= summaryGui then
		DungeonAuto.VotedSummaryGui = summaryGui
		DungeonAuto.LastReplayAttemptAt = os.clock()
		DungeonAuto.ReplayAttempts = 1
		if replayBtn.Text ~= "Replaying" then
			fireGuiButton(replayBtn)
		end
		if replayBtn.Text ~= "Replaying" and not DungeonAuto.VotedCurrentSummary then
			pcall(function()
				mods.Net.fireServer("RequestReplay")
			end)
		end
		DungeonAuto.VotedCurrentSummary = true
		setDungeonStatus("REPLAY VOTED")
		return
	end

	-- If UI says "Replaying" but server RunReplayVotes has NOT confirmed our vote yet, retry up to 3 times safely
	if not DungeonAuto.ServerConfirmedReplayVote
		and (DungeonAuto.ReplayAttempts or 0) < 3
		and (os.clock() - (DungeonAuto.LastReplayAttemptAt or 0)) >= 2.0
	then
		DungeonAuto.LastReplayAttemptAt = os.clock()
		DungeonAuto.ReplayAttempts = (DungeonAuto.ReplayAttempts or 0) + 1
		pcall(function()
			mods.Net.fireServer("RequestReplay")
		end)
		setDungeonStatus(string.format("REPLAY RETRY (%d/3)", DungeonAuto.ReplayAttempts))
	end
end

local DEATH_CONTINUE_DELAY = 1.2

local function tryContinueAfterDeath(ignoreDelay)
	if not State.Alive or (not DungeonAuto.AutoReplay and not CombatAuto.Enabled) then
		return
	end
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local combatGui = pg and pg:FindFirstChild("CombatUI")
	local fallen = combatGui and combatGui:FindFirstChild("Fallen")
	if not fallen or not fallen:IsA("GuiObject") or not fallen.Visible then
		DungeonAuto.SeenFallenAt = nil
		DungeonAuto.DeclineAttempts = 0
		DungeonAuto.LastDeclineReviveAt = 0
		return
	end

	local now = os.clock()
	if not DungeonAuto.SeenFallenAt then
		DungeonAuto.SeenFallenAt = now
		if not ignoreDelay then
			setDungeonStatus("FALLEN · CONTINUE IN 1.2s")
			return
		end
	end
	if not ignoreDelay and (now - DungeonAuto.SeenFallenAt) < DEATH_CONTINUE_DELAY then
		return
	end

	local attempts = DungeonAuto.DeclineAttempts or 0
	local lastAt = DungeonAuto.LastDeclineReviveAt or 0
	if attempts >= 3 or (now - lastAt) < 3.0 then
		return
	end

	DungeonAuto.LastDeclineReviveAt = now
	DungeonAuto.DeclineAttempts = attempts + 1

	local continueBtn = nil
	for _, d in ipairs(fallen:GetDescendants()) do
		if d:IsA("GuiButton") and d.Name == "Continue" then
			continueBtn = d
			break
		end
	end

	local firedUi = continueBtn and fireGuiButton(continueBtn) or false
	if fallen.Visible or not firedUi then
		local mods = getGameMods()
		if mods then
			pcall(function()
				mods.Net.fireServer("DeclineRevive")
			end)
		end
	end
	setDungeonStatus("DEATH CONTINUE · WAIT REPLAY")
end

