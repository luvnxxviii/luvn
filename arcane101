-- Combat Helper Functions
local function hasStatusTag(statusDef, tag)
	if not statusDef or type(statusDef.tags) ~= "table" then
		return false
	end
	return table.find(statusDef.tags, tag) ~= nil
end

local LiveCombat = {
	State = nil,
	MyId = nil,
	TurnActorId = nil,
	BossCombatantId = nil,
	LastGcScan = 0,
	BusySince = nil,
	ConsumedCounts = {},
}

local DeckStrategy = {
	LastFetchAt = 0,
	Signature = "",
	RawCards = {},
	CardTiers = {},
	TotalCards = 0,
	PrimarySchool = nil,
	DamageBySchool = {},
	Finishers = {},
	StrongestFinisher = nil,
	StrongestHeal = nil,
	HasStrongHeal = false,
	TinyHealOnly = false,
	SummaryText = "SCANNING DECK...",
}

local function findMyCombatantId(state)
	if type(state) ~= "table" or type(state.combatants) ~= "table" then
		return nil
	end
	for id, c in pairs(state.combatants) do
		if c.userId == LocalPlayer.UserId and c.hand ~= nil then
			return id
		end
	end
	for id, c in pairs(state.combatants) do
		if c.userId == LocalPlayer.UserId then
			return id
		end
	end
	return nil
end

local function extractStateFromUpvalues(fn)
	if type(fn) ~= "function" then
		return nil, nil
	end
	local getUpv = (type(debug) == "table" and type(debug.getupvalues) == "function" and debug.getupvalues)
		or (typeof(getupvalues) == "function" and getupvalues)
	if not getUpv then
		return nil, nil
	end
	local ok, uvs = pcall(getUpv, fn)
	if not ok or type(uvs) ~= "table" then
		return nil, nil
	end
	local state, myId
	for _, val in pairs(uvs) do
		if type(val) == "table" and type(val.combatants) == "table" and type(val.turnOrder) == "table" then
			state = val
		elseif type(val) == "string" then
			myId = val
		end
	end
	if state and (not myId or not state.combatants[myId]) then
		myId = findMyCombatantId(state)
	end
	return state, myId
end

local function scanGcCombatState()
	if typeof(getgc) ~= "function" then
		return nil, nil
	end
	if (os.clock() - LiveCombat.LastGcScan) < 1.5 then
		return nil, nil
	end
	LiveCombat.LastGcScan = os.clock()

	local ok, gcList = pcall(getgc, true)
	if not ok or type(gcList) ~= "table" then
		return nil, nil
	end

	local bestState, bestMyId = nil, nil
	for _, v in ipairs(gcList) do
		if type(v) == "table"
			and rawget(v, "isOver") == false
			and type(rawget(v, "combatants")) == "table"
			and type(rawget(v, "turnOrder")) == "table"
			and type(rawget(v, "turnIndex")) == "number"
		then
			local myId = findMyCombatantId(v)
			if myId then
				bestState = v
				bestMyId = myId
				if v.turnOrder[v.turnIndex] == myId then
					break
				end
			end
		end
	end
	if bestState and bestMyId then
		LiveCombat.State = bestState
		LiveCombat.MyId = bestMyId
	end
	return bestState, bestMyId
end

local function getCombatSnapshot(mods)
	local CombatUI = mods.CombatUI
	if CombatUI.isAiming() then
		return nil, nil, "AIMING"
	end

	local uiState, uiMyId = extractStateFromUpvalues(CombatUI.canAct)
	local state, myId = uiState, uiMyId
	if not state or not myId then
		state, myId = extractStateFromUpvalues(CombatUI.dealHand)
	end
	if not state or not myId then
		state, myId = extractStateFromUpvalues(CombatUI.render)
	end
	if not state or not myId then
		state, myId = extractStateFromUpvalues(CombatUI.passTurn)
	end
	if (not state or not myId) and LiveCombat.State then
		state = LiveCombat.State
		myId = LiveCombat.MyId or findMyCombatantId(state)
	end

	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	local combatGui = playerGui and playerGui:FindFirstChild("CombatUI")
	local guiVisible = combatGui and combatGui:IsA("ScreenGui") and combatGui.Enabled

	if (not state or not myId or state.isOver) and guiVisible then
		local gcState, gcMyId = scanGcCombatState()
		if gcState and gcMyId then
			state, myId = gcState, gcMyId
		end
	end

	-- If CombatUI has live state attached, trust CombatUI.canAct(); if split-VM (uiState == nil), evaluate turn from state + guiVisible
	local canActNow = CombatUI.canAct()
	if not canActNow and not uiState and guiVisible and state and myId and not state.isOver then
		local me = state.combatants and state.combatants[myId]
		local actorId = (state.turnOrder and state.turnIndex and state.turnOrder[state.turnIndex]) or LiveCombat.TurnActorId
		if me and not me.isIncapacitated and (me.hp or 0) > 0 and actorId == myId then
			canActNow = true
		end
	end

	if not canActNow then
		if state and not state.isOver then
			local actorId = (state.turnOrder and state.turnIndex and state.turnOrder[state.turnIndex]) or LiveCombat.TurnActorId
			if actorId and myId and actorId ~= myId then
				return nil, nil, "ENEMY TURN"
			end
			return nil, nil, "BUSY / ANIM"
		end
		return nil, nil, "WAITING"
	end

	if not state or not myId or not state.combatants or not state.combatants[myId] then
		return nil, nil, "SYNCING"
	end
	return state, myId, "ACT"
end

local function getEffectCastScale(mods, abilityId, ef, me, cardTiersFallback)
	local CardTiers = mods and mods.CardTiers
	if not CardTiers then
		return 1
	end
	if me and type(CardTiers.powerFor) == "function" then
		local ok, p = pcall(CardTiers.powerFor, me, abilityId, ef)
		if ok and type(p) == "number" and p > 0 then
			return p
		end
	end
	if cardTiersFallback and type(CardTiers.of) == "function" and type(CardTiers.power) == "function" then
		local okT, tier = pcall(CardTiers.of, cardTiersFallback, abilityId)
		if okT and type(tier) == "number" then
			local okP, p = pcall(CardTiers.power, tier, ef, abilityId)
			if okP and type(p) == "number" and p > 0 then
				return p
			end
		end
	end
	return 1
end

local function computeEffectAmount(mods, ability, ef, me, castScale)
	if me and type(me.scaling) == "table" and mods.CombatMath and type(mods.CombatMath.shownAmount) == "function" then
		local ok, amt = pcall(mods.CombatMath.shownAmount, ef, me, ability.school or me.school, castScale)
		if ok and type(amt) == "number" then
			return amt
		end
	end
	return (ef.base or 0) * (castScale or 1)
end

local function analyzeAbility(mods, ability, energy, me, cardTiersFallback)
	local Statuses = mods.Statuses
	local directDamage = 0
	local isAttackPowerUp = false
	local powerUpSchool = nil
	local powerUpStatusId = nil
	local healScore = 0
	local healsSelf = false
	local healsTeammates = false
	local shieldScore = 0
	local hasCleanse = false
	local cleanseStatuses = nil
	local hasDefenseBuff = false
	local hasEnergyGain = false
	local gainEnergyAmount = 0
	local hasSummon = false
	local appliesEnemyDebuff = false
	local buffStatusIds = {}
	local enemyStatusIds = {}
	local wardSchool = nil
	local revivesAlly = false
	local preventsAction = false
	local appliesControl = false
	local appliesHardControl = false
	local appliesVulnerable = false
	local appliesBlind = false
	local appliesWeaken = false
	local hasShatter = false
	local abId = ability.id or ""
	local tiers = cardTiersFallback or DeckStrategy.CardTiers

	for _, ef in ipairs(ability.effects or {}) do
		local kind = ef.kind
		if kind == "Damage" then
			local castScale = getEffectCastScale(mods, abId, ef, me, tiers)
			local mult = ability.spendAll and math.max(1, energy or 1) or 1
			local perHit = computeEffectAmount(mods, ability, ef, me, castScale)
			directDamage += (perHit * (ef.hits or 1) * mult)
		elseif kind == "Detonate" or kind == "ConsumeDot" then
			directDamage += 25
		elseif kind == "Heal" then
			local castScale = getEffectCastScale(mods, abId, ef, me, tiers)
			local hAmt = ef.base and computeEffectAmount(mods, ability, ef, me, castScale) or (30 * castScale)
			healScore += math.max(1, hAmt)
			if ef.target == "Self" or ability.targetKind == "SelfOnly" then
				healsSelf = true
			elseif ef.target == "Allies" or ability.targetKind == "AllAllies" or ability.targetKind == "SingleAlly" then
				healsSelf = true
				healsTeammates = true
			end
			if ef.target ~= "Self" and (ability.targetKind == "SingleAlly" or ability.targetKind == "AllAllies") then
				revivesAlly = true
			end
		elseif kind == "Shield" then
			local castScale = getEffectCastScale(mods, abId, ef, me, tiers)
			local sAmt = ef.base and computeEffectAmount(mods, ability, ef, me, castScale) or (25 * castScale)
			shieldScore += math.max(1, sAmt)
		elseif kind == "Cleanse" then
			hasCleanse = true
			if type(ef.statuses) == "table" and #ef.statuses > 0 then
				cleanseStatuses = ef.statuses
			end
		elseif kind == "Shatter" then
			hasShatter = true
		elseif kind == "GainEnergy" then
			hasEnergyGain = true
			gainEnergyAmount += (ef.amount or 1)
		elseif kind == "Summon" then
			hasSummon = true
		elseif kind == "ApplyStatus" and ef.statusId then
			local st = Statuses[ef.statusId]
			if st then
				local appliesToSelf = (ef.target == "Self") or (ability.targetKind == "SelfOnly" and ef.target ~= "Enemies")
				local targetsEnemies = (not appliesToSelf) and (
					ef.target == "Enemies"
					or ef.target == "Enemy"
					or ability.targetKind == "SingleEnemy"
					or ability.targetKind == "AllEnemies"
				)
				if st.preventsAction then
					if appliesToSelf then
						preventsAction = true
					else
						appliesControl = true
					end
				end
				if targetsEnemies then
					appliesEnemyDebuff = true
					table.insert(enemyStatusIds, { id = ef.statusId, st = st })
					if st.preventsAction == true or st.turnsNext == true or ef.statusId == "Stunned" or ef.statusId == "Frozen" or ef.statusId == "Beguiled" then
						appliesHardControl = true
					end
					if (type(st.damageTakenMultiplier) == "number" and st.damageTakenMultiplier > 1) or ef.statusId == "Vulnerable" then
						appliesVulnerable = true
					end
					if st.missesNext == true then
						appliesBlind = true
					end
					if type(st.damageDealtMultiplier) == "number" and st.damageDealtMultiplier < 1 then
						appliesWeaken = true
					end
				end
				if st.schoolDealt ~= nil or (st.damageDealtMultiplier and st.damageDealtMultiplier > 1) or (st.damageDealtPerStack and st.damageDealtPerStack > 0) then
					if not (st.preventsAction and appliesToSelf) then
						isAttackPowerUp = true
						powerUpSchool = st.school or ability.school
						powerUpStatusId = ef.statusId
					end
				end
				if hasStatusTag(st, "Buff") and not st.preventsAction and not targetsEnemies then
					if st.schoolTaken ~= nil and st.school then
						wardSchool = st.school
					end
					if st.damageTakenMultiplier or st.schoolTaken or st.evadesNext or st.reprisal or ef.statusId == "Regrowth" then
						hasDefenseBuff = true
						table.insert(buffStatusIds, { id = ef.statusId, st = st, target = ef.target })
					end
					if ef.statusId == "Regrowth" then
						healScore += 24
						if ability.targetKind == "SelfOnly" then
							healsSelf = true
						else
							healsSelf = true
							healsTeammates = true
						end
					end
				end
			end
		end
	end

	local targetsAllyOrSelf = (
		ability.targetKind == "SelfOnly"
		or ability.targetKind == "SingleAlly"
		or ability.targetKind == "AllAllies"
		or ability.ally == true
		or (ability.targetKind == "SingleAny" and directDamage == 0)
	)

	local isSupport = directDamage == 0 and not preventsAction and (
		(targetsAllyOrSelf and (
			healScore > 0
			or shieldScore > 0
			or hasCleanse
			or hasDefenseBuff
			or hasEnergyGain
			or isAttackPowerUp
			or hasSummon
		))
		or appliesVulnerable
		or appliesBlind
		or appliesWeaken
		or appliesControl
		or appliesEnemyDebuff
	)

	return {
		directDamage = directDamage,
		scaledByCaster = (me ~= nil and type(me.scaling) == "table" and mods.CombatMath ~= nil),
		isAttackPowerUp = isAttackPowerUp,
		powerUpSchool = powerUpSchool,
		powerUpStatusId = powerUpStatusId,
		isSupport = isSupport,
		healScore = healScore,
		healsSelf = healsSelf,
		healsTeammates = healsTeammates,
		shieldScore = shieldScore,
		hasCleanse = hasCleanse,
		cleanseStatuses = cleanseStatuses,
		hasDefenseBuff = hasDefenseBuff,
		hasSummon = hasSummon,
		buffStatusIds = buffStatusIds,
		enemyStatusIds = enemyStatusIds,
		wardSchool = wardSchool,
		hasEnergyGain = hasEnergyGain,
		gainEnergyAmount = gainEnergyAmount,
		revivesAlly = revivesAlly,
		preventsAction = preventsAction,
		appliesControl = appliesControl,
		appliesHardControl = appliesHardControl,
		appliesVulnerable = appliesVulnerable,
		appliesBlind = appliesBlind,
		appliesWeaken = appliesWeaken,
		hasShatter = hasShatter,
		appliesEnemyDebuff = appliesEnemyDebuff,
	}
end

local function normalizeDeckCardMap(tbl)
	local out = {}
	if type(tbl) ~= "table" then
		return out
	end
	if #tbl > 0 then
		for _, id in ipairs(tbl) do
			if type(id) == "string" and id ~= "" then
				out[id] = (out[id] or 0) + 1
			end
		end
	else
		for id, cnt in pairs(tbl) do
			local n = tonumber(cnt) or 0
			if type(id) == "string" and n > 0 then
				out[id] = math.floor(n)
			end
		end
	end
	return out
end

local function readLiveDeckCards(mods, forceProfile, me, nonBlocking)
	if me and type(me.deckCards) == "table" and next(me.deckCards) ~= nil then
		if type(me.cardTiers) == "table" then
			DeckStrategy.CardTiers = me.cardTiers
		end
		return normalizeDeckCardMap(me.deckCards)
	end
	if not forceProfile and next(DeckStrategy.RawCards) ~= nil and (os.clock() - DeckStrategy.LastFetchAt) < 8.0 then
		return DeckStrategy.RawCards
	end
	local ok, prof = false, nil
	if nonBlocking then
		-- Never block runCombatStep() on a RemoteFunction call; use cached profile or trigger async fetch
		if type(mods.Net.peekProfile) == "function" then
			prof = mods.Net.peekProfile()
			ok = type(prof) == "table"
		end
		if not ok then
			if next(DeckStrategy.RawCards) ~= nil then
				return DeckStrategy.RawCards
			end
			if me then
				local fb = {}
				for _, id in ipairs(me.abilityIds or {}) do
					if type(id) == "string" then
						fb[id] = math.max(1, fb[id] or 0)
					end
				end
				for _, id in ipairs(me.hand or {}) do
					if type(id) == "string" then
						fb[id] = math.max(1, (fb[id] or 0))
					end
				end
				return fb
			end
			return DeckStrategy.RawCards
		end
		DeckStrategy.LastFetchAt = os.clock()
	else
		DeckStrategy.LastFetchAt = os.clock()
		ok, prof = pcall(mods.Net.getProfile)
		if not ok or type(prof) ~= "table" then
			return DeckStrategy.RawCards
		end
	end
	if type(prof.cardTiers) == "table" then
		DeckStrategy.CardTiers = prof.cardTiers
	end
	local activeIdx = tonumber(prof.activeDeck) or 1
	local deckSrc = (type(prof.decks) == "table" and type(prof.decks[activeIdx]) == "table" and prof.decks[activeIdx].cards)
		or prof.deck
		or {}
	local gear = nil
	if mods.Loadout and type(mods.Loadout.gearFor) == "function" then
		local okG, g = pcall(mods.Loadout.gearFor, prof.equipped or {}, prof.inventory or {})
		if okG and type(g) == "table" then
			gear = g
		end
	end
	if mods.Deck and type(mods.Deck.cards) == "function" then
		local okD, cards = pcall(mods.Deck.cards, deckSrc, gear)
		if okD and type(cards) == "table" then
			return normalizeDeckCardMap(cards)
		end
	end
	return normalizeDeckCardMap(deckSrc)
end

local function refreshDeckStrategy(mods, forceProfile, me, nonBlocking)
	if not mods or not mods.Abilities then
		return DeckStrategy
	end
	local cards = readLiveDeckCards(mods, forceProfile, me, nonBlocking)
	local keys = {}
	for id, cnt in pairs(cards) do
		if cnt > 0 then
			table.insert(keys, id .. ":" .. tostring(cnt))
		end
	end
	table.sort(keys)
	local sig = table.concat(keys, "|")
	if sig == DeckStrategy.Signature and sig ~= "" then
		return DeckStrategy
	end

	DeckStrategy.Signature = sig
	DeckStrategy.RawCards = cards
	DeckStrategy.TotalCards = 0
	DeckStrategy.DamageBySchool = {}
	DeckStrategy.Finishers = {}
	DeckStrategy.StrongestFinisher = nil
	DeckStrategy.StrongestHeal = nil
	DeckStrategy.HasStrongHeal = false
	DeckStrategy.TinyHealOnly = false

	local schoolDamageWeight = {}
	local anyHealCount = 0
	for id, cnt in pairs(cards) do
		DeckStrategy.TotalCards += cnt
		local ab = mods.Abilities[id]
		if ab then
			local cost = ab.energyCost or 0
			local info = analyzeAbility(mods, ab, math.max(99, cost), me, DeckStrategy.CardTiers)
			if info.directDamage > 0 and not info.preventsAction then
				local sc = ab.school or "Neutral"
				DeckStrategy.DamageBySchool[sc] = (DeckStrategy.DamageBySchool[sc] or 0) + cnt
				schoolDamageWeight[sc] = (schoolDamageWeight[sc] or 0) + (info.directDamage * cnt)
				if cost >= CombatAuto.SavePipMinCost then
					local fin = {
						id = id,
						name = ab.name or id,
						cost = cost,
						dmg = info.directDamage,
						school = ab.school,
						isAoe = (ab.targetKind == "AllEnemies"),
						count = cnt,
					}
					table.insert(DeckStrategy.Finishers, fin)
					if not DeckStrategy.StrongestFinisher or fin.dmg > DeckStrategy.StrongestFinisher.dmg then
						DeckStrategy.StrongestFinisher = fin
					end
				end
			end
			if info.healScore > 0 then
				anyHealCount += cnt
				if cost >= 2 or info.healScore >= 80 then
					DeckStrategy.HasStrongHeal = true
				end
				if not DeckStrategy.StrongestHeal or info.healScore > DeckStrategy.StrongestHeal.healScore then
					DeckStrategy.StrongestHeal = {
						id = id,
						name = ab.name or id,
						cost = cost,
						healScore = info.healScore,
					}
				end
			end
		end
	end

	table.sort(DeckStrategy.Finishers, function(a, b)
		if a.dmg ~= b.dmg then
			return a.dmg > b.dmg
		end
		return a.cost < b.cost
	end)

	local bestSchool, bestWeight = nil, 0
	for sc, w in pairs(schoolDamageWeight) do
		if w > bestWeight then
			bestWeight = w
			bestSchool = sc
		end
	end
	DeckStrategy.PrimarySchool = bestSchool
	DeckStrategy.TinyHealOnly = (anyHealCount > 0 and not DeckStrategy.HasStrongHeal)

	if DeckStrategy.TotalCards == 0 then
		DeckStrategy.SummaryText = "EMPTY DECK"
	else
		local topNote = DeckStrategy.StrongestFinisher
			and string.format("Top: %s (%dp)", DeckStrategy.StrongestFinisher.name, DeckStrategy.StrongestFinisher.cost)
			or "No 4p+ Nuke"
		DeckStrategy.SummaryText = string.format("%dc · %s · %s", DeckStrategy.TotalCards, tostring(bestSchool or "Mixed"), topNote)
	end
	setDeckStrategyStatus(DeckStrategy.SummaryText)
	return DeckStrategy
end

local function getDeckRemainingSummary(mods, state, me)
	refreshDeckStrategy(mods, false, me, true)
	local handCounts = normalizeDeckCardMap(me and me.hand)
	local drawCounts
	if me and type(me.drawPile) == "table" and (#me.drawPile > 0 or #(me.discardPile or {}) > 0) then
		drawCounts = normalizeDeckCardMap(me.drawPile)
	else
		drawCounts = {}
		for id, fullCnt in pairs(DeckStrategy.RawCards) do
			local rem = fullCnt - (handCounts[id] or 0) - (LiveCombat.ConsumedCounts[id] or 0)
			if rem > 0 then
				drawCounts[id] = rem
			end
		end
	end

	local maxCap = (me and mods.CombatSim.maxEnergy(me)) or 99
	local drawLeftCount = 0
	local remDamageBySchool = {}
	local drawDamageBySchool = {}
	local bestFinisher = nil
	local hasStrongHealRemaining = false

	local function scanPool(pool, inHand)
		for id, cnt in pairs(pool) do
			if cnt > 0 then
				if not inHand then
					drawLeftCount += cnt
				end
				local ab = mods.Abilities[id]
				if ab then
					local cost = ab.energyCost or 0
					local info = analyzeAbility(mods, ab, math.max(99, cost), me, DeckStrategy.CardTiers)
					if info.directDamage > 0 and not info.preventsAction then
						local sc = ab.school or "Neutral"
						remDamageBySchool[sc] = (remDamageBySchool[sc] or 0) + cnt
						if not inHand then
							drawDamageBySchool[sc] = (drawDamageBySchool[sc] or 0) + cnt
						end
						if cost >= CombatAuto.SavePipMinCost and cost <= maxCap then
							if not bestFinisher or info.directDamage > bestFinisher.dmg or (info.directDamage == bestFinisher.dmg and inHand and not bestFinisher.inHand) then
								bestFinisher = {
									id = id,
									name = ab.name or id,
									cost = cost,
									dmg = info.directDamage,
									school = ab.school,
									isAoe = (ab.targetKind == "AllEnemies"),
									inHand = inHand,
								}
							end
						end
					end
					if info.healScore > 0 and (cost >= 2 or info.healScore >= 80) then
						hasStrongHealRemaining = true
					end
				end
			end
		end
	end

	scanPool(handCounts, true)
	scanPool(drawCounts, false)

	local topLive = bestFinisher and string.format("%s %s", bestFinisher.inHand and "Hand:" or "Draw:", bestFinisher.name) or "No 4p+ left"
	setDeckStrategyStatus(string.format("%dc (%d draw) · %s · %s", DeckStrategy.TotalCards, drawLeftCount, tostring(DeckStrategy.PrimarySchool or "Mixed"), topLive))

	return {
		drawLeftCount = drawLeftCount,
		drawCounts = drawCounts,
		handCounts = handCounts,
		remainingDamageBySchool = remDamageBySchool,
		drawDamageBySchool = drawDamageBySchool,
		bestRemainingFinisher = bestFinisher,
		hasStrongHealRemaining = hasStrongHealRemaining,
	}
end

local function isBossCombatant(mods, c, combatantId)
	if not c then
		return false
	end
	if c.isBoss == true or c.boss == true then
		return true
	end
	if combatantId and LiveCombat.BossCombatantId and combatantId == LiveCombat.BossCombatantId then
		return true
	end
	local bossIds = mods.BossEnemyIds
	if bossIds then
		local eid = c.enemyId or c.defId
		if type(eid) == "string" and (bossIds[eid] or LiveBossIds[eid]) then
			return true
		end
	end
	return false
end

local function hasAliveBoss(mods, state, me)
	for id, c in pairs(state.combatants) do
		if c.team ~= me.team and not c.isPet and mods.CombatSim.isAlive(c) and isBossCombatant(mods, c, id) then
			return true
		end
	end
	return false
end

local function collectEntries(mods, state, me, includeUnaffordable)
	local entries = {}
	local CombatSim = mods.CombatSim
	local Abilities = mods.Abilities

	for slot, abilityId in ipairs(me.hand or {}) do
		local ab = Abilities[abilityId]
		if ab and CombatSim.ready(state.combatants, me, ab) and (includeUnaffordable or CombatSim.canPay(me, ab)) then
			table.insert(entries, {
				id = abilityId,
				slot = slot,
				ability = ab,
				payable = CombatSim.canPay(me, ab),
				info = analyzeAbility(mods, ab, me.energy or 0, me, DeckStrategy.CardTiers),
			})
		end
	end

	for _, abilityId in ipairs(me.talentCards or {}) do
		local used = me.talentCardsUsed and me.talentCardsUsed[abilityId]
		local ab = not used and Abilities[abilityId]
		if ab and CombatSim.ready(state.combatants, me, ab) and (includeUnaffordable or CombatSim.canPay(me, ab)) then
			table.insert(entries, {
				id = abilityId,
				slot = -1,
				ability = ab,
				payable = CombatSim.canPay(me, ab),
				info = analyzeAbility(mods, ab, me.energy or 0, me, DeckStrategy.CardTiers),
			})
		end
	end

	return entries
end

local function getAttackerStatusMult(mods, attackSchool, me)
	if not me or type(me.statuses) ~= "table" then
		return 1
	end
	local atkSchool = attackSchool or me.school
	local addBonus = 0
	local mulFactor = 1
	for _, entry in ipairs(me.statuses) do
		local sid = (type(entry) == "table" and entry.id) or entry
		local st = type(sid) == "string" and mods.Statuses[sid]
		if st and not st.preventsAction then
			local stacks = (type(entry) == "table" and tonumber(entry.stacks)) or 1
			if type(st.schoolDealt) == "number" and (not st.school or st.school == atkSchool) then
				addBonus += st.schoolDealt * stacks
			elseif type(st.damageDealtPerStack) == "number" and (not st.school or st.school == atkSchool) then
				addBonus += st.damageDealtPerStack * stacks
			elseif type(st.damageDealtMultiplier) == "number" and (not st.school or st.school == atkSchool) then
				mulFactor *= st.damageDealtMultiplier
			end
		end
	end
	return math.max(0.05, (1 + addBonus) * mulFactor)
end

local function getElementMultiplier(mods, attackSchool, defender, me, directAlreadyScaled, ignoreShatterBuffs)
	if not defender then
		return 1
	end
	local mult = 1
	local atkSchool = attackSchool or (me and me.school)

	-- 1. Defender resistance vs attacker pierce via live CombatMath.schoolFactor
	local CombatMath = mods.CombatMath
	local Schools = mods.Schools
	if CombatMath and type(CombatMath.schoolFactor) == "function" and atkSchool and type(defender.scaling) == "table" then
		local ok, factor = pcall(CombatMath.schoolFactor, defender, atkSchool, nil, me)
		if ok and type(factor) == "number" then
			mult *= factor
		end
	else
		local schoolDef = atkSchool and Schools and Schools.defs and Schools.defs[atkSchool]
		local statsTbl = defender.scaling or defender.derived
		if type(statsTbl) == "table" then
			local res = (statsTbl.AllResistance or statsTbl.allResistance or 0)
			if schoolDef and type(statsTbl[schoolDef.resistance]) == "number" then
				res += statsTbl[schoolDef.resistance]
			end
			mult *= math.clamp(1 - res, 0.2, 2.5)
		end
	end

	-- Apply attacker offensiveMultiplier ONLY if directDamage was NOT already scaled by CombatMath.shownAmount
	if not directAlreadyScaled and CombatMath and type(CombatMath.offensiveMultiplier) == "function" and me and type(me.scaling) == "table" and atkSchool then
		local okOff, offMult = pcall(CombatMath.offensiveMultiplier, me, atkSchool)
		if okOff and type(offMult) == "number" then
			mult *= offMult
		end
	end

	-- 2. Attacker active combat buffs/debuffs (e.g. +40% StormBuff, -20% Weaken)
	mult *= getAttackerStatusMult(mods, atkSchool, me)

	-- 3. Defender damageModifiers + active wards/shields/Vulnerable
	local defWardFactor = 1
	local dmgMods = defender.damageModifiers
	if type(dmgMods) == "table" and atkSchool then
		local hitType = (Schools and type(Schools.hitType) == "function" and Schools.hitType(nil, atkSchool)) or atkSchool
		local dm = dmgMods[hitType] or dmgMods[atkSchool]
		if type(dm) == "number" then
			defWardFactor *= dm
		end
	end

	local evades = false
	local hasUncappedMod = false
	for _, entry in ipairs(defender.statuses or {}) do
		local sid = (type(entry) == "table" and entry.id) or entry
		local st = type(sid) == "string" and mods.Statuses[sid]
		if st then
			if st.evadesNext then
				evades = true
			elseif type(st.damageTakenMultiplier) == "number" then
				if not (ignoreShatterBuffs and st.damageTakenMultiplier < 1 and not st.cleanseProof) then
					defWardFactor *= st.damageTakenMultiplier
					if st.uncapped == true and st.damageTakenMultiplier < 1 then
						hasUncappedMod = true
					end
				end
			elseif atkSchool and st.school == atkSchool and type(st.schoolTaken) == "number" then
				defWardFactor *= math.max(0.1, 1 - st.schoolTaken)
			elseif sid == "Vulnerable" then
				defWardFactor *= 1.25
			end
		end
	end

	local minIncoming = hasUncappedMod and 0.01 or ((mods.Constants and mods.Constants.MAX_DAMAGE_REDUCTION) and (1 - mods.Constants.MAX_DAMAGE_REDUCTION) or 0.1)
	mult *= evades and 0.05 or math.max(minIncoming, defWardFactor)

	return math.clamp(mult, 0.01, 15.0)
end

local function getAliveEnemies(mods, state, me)
	local enemies = {}
	for id, c in pairs(state.combatants) do
		if c.team ~= me.team and not c.isPet and mods.CombatSim.isAlive(c) then
			local hp = c.hp or 0
			local shield = tonumber(c.shield) or 0
			local ehp = math.max(1, hp + shield)
			local isBoss = isBossCombatant(mods, c, id)
			local evades = false
			local isVulnerable = false
			local isBlinded = false
			local hasDefenseMitigation = false
			local isControlLocked = false
			local reprisal = 0
			for _, stEntry in ipairs(c.statuses or {}) do
				local sid = (type(stEntry) == "table" and stEntry.id) or stEntry
				local stDef = type(sid) == "string" and mods.Statuses[sid]
				if stDef then
					if stDef.evadesNext then
						evades = true
					end
					if (type(stDef.damageTakenMultiplier) == "number" and stDef.damageTakenMultiplier > 1) or sid == "Vulnerable" then
						isVulnerable = true
					elseif type(stDef.damageTakenMultiplier) == "number" and stDef.damageTakenMultiplier < 1 and not stDef.cleanseProof then
						hasDefenseMitigation = true
					end
					if stDef.missesNext == true then
						isBlinded = true
					end
					if stDef.preventsAction == true or stDef.turnsNext == true or sid == "Stunned" or sid == "Frozen" or sid == "Beguiled" or sid == "StunImmune" then
						isControlLocked = true
					end
					if type(stDef.reprisal) == "number" then
						reprisal += stDef.reprisal * ((type(stEntry) == "table" and tonumber(stEntry.power)) or 1)
					end
				end
			end
			local repCap = (mods.Constants and mods.Constants.REPRISAL_MAX) or 0.75
			table.insert(enemies, {
				id = id,
				combatant = c,
				name = c.name or c.enemyId or id,
				hp = hp,
				maxHp = math.max(1, (c.derived and c.derived.maxHp) or c.maxHp or hp),
				shield = shield,
				effectiveHp = ehp,
				isBoss = isBoss,
				evades = evades,
				isVulnerable = isVulnerable,
				isBlinded = isBlinded,
				hasDefenseMitigation = hasDefenseMitigation,
				isControlLocked = isControlLocked,
				reprisal = math.min(reprisal, repCap),
			})
		end
	end
	return CombatAuto.AnnotateEnemyThreats(mods, state, me, enemies)
end

local function evaluateAttackEntry(mods, state, me, entry, aliveEnemies)
	local base = entry.info.directDamage or 0
	if base <= 0 then
		return {
			totalDamage = 0,
			tacticalScore = 0,
			bossDamage = 0,
			killCount = 0,
			wipesAll = false,
			killsBoss = false,
			killsMajorHealer = false,
			killsTopThreat = false,
			bestEnemy = nil,
			bestEnemyDamage = 0,
			bestMult = 1,
		}
	end

	local atkSchool = entry.ability.school or me.school
	local isAoe = (entry.ability.targetKind == "AllEnemies")
	local totalEnemies = #aliveEnemies
	local directScaled = entry.info.scaledByCaster == true
	local bossFocusMult = (CombatAuto.TargetPriority == "Boss First") and 1.65 or 1.25
	local grants = CombatAuto.GetPathGrants(mods, me)
	local execThresh = tonumber(grants.execute) or 0
	local execBonus = tonumber(grants.executeBonus) or 0
	local killPips = tonumber(grants.killPips) or 0
	local energyOnCrit = (tonumber(grants.energyOnCrit) or 0) > 0
	local critBolt = tonumber(grants.critBolt) or 0
	local myCrit = math.min(0.60, math.max(0, (me.scaling and tonumber(me.scaling.CritChance)) or 0))
	local critMultEst = math.min(3.0, 1.5 + ((me.scaling and tonumber(me.scaling.CritDamage)) or 0))
	local expectedCritScale = 1 + myCrit * (critMultEst - 1)

	local function projectEnemyDmgAndKill(e, mult)
		local eMaxHp = e.maxHp or math.max(1, e.hp)
		local belowHalfMult = (execBonus > 0 and (e.hp / eMaxHp) < 0.50) and (1 + execBonus) or 1
		local rawDmg = base * mult * belowHalfMult
		local dmg = rawDmg * expectedCritScale
		if isAoe == false and totalEnemies >= 2 and critBolt > 0 and myCrit > 0 then
			dmg += rawDmg * myCrit * critMultEst * critBolt * 0.65
		end
		local remainingHpAfterHit = e.hp - math.max(0, rawDmg - e.shield)
		local autoExecKill = (not e.isBoss) and execThresh > 0 and (remainingHpAfterHit <= eMaxHp * execThresh)
		local canKill = (not e.evades) and ((rawDmg >= e.effectiveHp * 0.99) or autoExecKill)
		return dmg, canKill
	end

	if isAoe then
		local totalDmg = 0
		local tactical = 0
		local bossDamage = 0
		local killCount = 0
		local killsBoss = false
		local killsMajorHealer = false
		local killsTopThreat = false
		local overkill = 0
		local isSmart = (CombatAuto.TargetPriority == "Smart Effective")
		for _, e in ipairs(aliveEnemies) do
			local mult = getElementMultiplier(mods, atkSchool, e.combatant, me, directScaled, entry.info.hasShatter)
			local dmg, canKill = projectEnemyDmgAndKill(e, mult)
			local eff = math.min(dmg, e.effectiveHp)
			local okAmt = math.max(0, dmg - e.effectiveHp)
			local threatMult = isSmart and math.max(0.85, (e.threatFocusMult or 1) * 0.85) or (e.isBoss and bossFocusMult or 1)
			totalDmg += eff
			overkill += okAmt
			if e.isBoss and eff > bossDamage then
				bossDamage = eff
			end
			tactical += eff * threatMult
			if canKill then
				killCount += 1
				local killThreatBonus = isSmart and (e.isMajorHealer and 320 or math.floor((e.threatRatio or 0) * 160)) or 0
				tactical += (e.isBoss and 380 or 120) + killThreatBonus + (killPips * 55)
				if e.isBoss then
					killsBoss = true
				end
				if e.isMajorHealer then
					killsMajorHealer = true
				end
				if e.isTopThreat then
					killsTopThreat = true
				end
			else
				local highThreat = (e.isBoss or e.isMajorHealer or e.isTopThreat) and not e.isBoundProtected
				if not e.isBoundProtected then
					if entry.info.hasShatter and e.hasDefenseMitigation then
						tactical += (highThreat and 240 or 140)
					end
					if entry.info.appliesControl and not e.evades and not e.isControlLocked then
						tactical += highThreat and 130 or 85
					end
					if not e.evades then
						if entry.info.appliesVulnerable and not e.isVulnerable and dmg < e.effectiveHp then
							tactical += (highThreat and 220 or 85)
						end
						if entry.info.appliesBlind and not e.isBlinded and not e.isControlLocked then
							tactical += (highThreat and 140 or 65)
						elseif entry.info.appliesWeaken then
							tactical += (highThreat and 90 or 35)
						end
					end
				end
			end
		end
		if energyOnCrit and totalEnemies >= 2 and (me.energy or 0) <= 3 then
			-- Multi-target hit gives multiple crit rolls to refund +1 pip via Tempest energyOnCrit
			tactical += 75
		end
		tactical -= (overkill * 0.3)
		return {
			totalDamage = totalDmg > 0 and totalDmg or base,
			tacticalScore = tactical,
			bossDamage = bossDamage,
			killCount = killCount,
			wipesAll = (totalEnemies > 0 and killCount >= totalEnemies),
			killsBoss = killsBoss,
			killsMajorHealer = killsMajorHealer,
			killsTopThreat = killsTopThreat,
			bestEnemy = aliveEnemies[1],
			bestEnemyDamage = totalDmg,
			bestMult = 1,
			enemyCount = totalEnemies,
		}
	end

	local bestScore = -math.huge
	local bestEnemy = nil
	local bestDmg = 0
	local bestMult = 1
	local bossDamage = 0
	local anyKill = false
	local killsBoss = false
	local killsMajorHealer = false
	local killsTopThreat = false
	local isSmart = (CombatAuto.TargetPriority == "Smart Effective")

	for _, e in ipairs(aliveEnemies) do
		local mult = getElementMultiplier(mods, atkSchool, e.combatant, me, directScaled, entry.info.hasShatter)
		local dmg, canKill = projectEnemyDmgAndKill(e, mult)
		local eff = math.min(dmg, e.effectiveHp)
		local focusMult = isSmart and (e.threatFocusMult or (e.isBoss and bossFocusMult or 1)) or (e.isBoss and bossFocusMult or 1)
		if e.isBoss and eff > bossDamage then
			bossDamage = eff
		end
		if canKill then
			anyKill = true
			if e.isBoss then
				killsBoss = true
			end
			if e.isMajorHealer then
				killsMajorHealer = true
			end
			if e.isTopThreat then
				killsTopThreat = true
			end
		end

		local overkill = math.max(0, dmg - e.effectiveHp)
		local s = (eff * focusMult) - (overkill * 0.65) - (eff * (e.reprisal or 0) * 0.85)
		local highThreat = (e.isBoss or e.isMajorHealer or e.isTopThreat) and not e.isBoundProtected
		if e.isBoundProtected then
			s *= 0.02
		elseif e.isAbyssFist then
			local hpFrac = math.clamp((e.hp or 1) / math.max(1, e.maxHp or 1), 0, 1)
			s += 320 + math.floor((1 - hpFrac) * 180)
		end
		if canKill then
			local killThreatBonus = isSmart and (e.isMajorHealer and 360 or math.floor((e.threatRatio or 0) * 180)) or 0
			s += (e.isBoss and 420 or 120) + killThreatBonus + (killPips * 55)
		elseif not e.isBoundProtected then
			if entry.info.hasShatter and e.hasDefenseMitigation then
				s += (highThreat and 260 or 150)
			end
			if entry.info.appliesControl and not e.evades and not e.isControlLocked then
				s += highThreat and 130 or 85
			end
			if not e.evades then
				if entry.info.appliesVulnerable and not e.isVulnerable and dmg < e.effectiveHp then
					s += (highThreat and 240 or 90)
				end
				if entry.info.appliesBlind and not e.isBlinded and not e.isControlLocked then
					s += (highThreat and 140 or 65)
				elseif entry.info.appliesWeaken then
					s += (highThreat and 90 or 35)
				end
			end
		end
		if (e.evades or (e.reprisal or 0) > 0) and (entry.ability.energyCost or 0) <= 1 and not canKill then
			s += e.evades and 30 or -15
		end
		if s > bestScore then
			bestScore = s
			bestEnemy = e
			bestDmg = dmg
			bestMult = mult
		end
	end

	return {
		totalDamage = bestDmg > 0 and bestDmg or base,
		tacticalScore = bestEnemy and bestScore or base,
		bossDamage = bossDamage,
		killCount = anyKill and 1 or 0,
		wipesAll = (totalEnemies == 1 and anyKill),
		killsBoss = killsBoss,
		killsMajorHealer = killsMajorHealer,
		killsTopThreat = killsTopThreat,
		bestEnemy = bestEnemy,
		bestEnemyDamage = bestDmg,
		bestMult = bestMult,
		enemyCount = totalEnemies,
	}
end

local function pickCheapestLethal(list)
	table.sort(list, function(a, b)
		local ca = a.entry.ability.energyCost or 0
		local cb = b.entry.ability.energyCost or 0
		if ca ~= cb then
			return ca < cb
		end
		return a.eval.tacticalScore > b.eval.tacticalScore
	end)
	return list[1].entry
end

local function combatantHasStatus(c, statusId)
	if not c or not statusId then
		return false
	end
	for _, stEntry in ipairs(c.statuses or {}) do
		local sid = (type(stEntry) == "table" and stEntry.id) or stEntry
		if sid == statusId then
			return true
		end
	end
	return false
end

local function getCombatantSchool(mods, c)
	if not c then
		return nil
	end
	if type(c.school) == "string" and c.school ~= "" then
		return c.school
	end
	if mods and mods.Schools and type(mods.Schools.strongestOf) == "function" then
		return mods.Schools.strongestOf(c.scaling, c.school)
	end
	return nil
end

local function pickBuffAllyTarget(mods, state, me, powerUpSchool, powerUpStatusId)
	local CombatSim = mods.CombatSim
	local Schools = mods.Schools
	local schoolDef = powerUpSchool and Schools and Schools.defs and Schools.defs[powerUpSchool]
	local bestId = nil
	local bestScore = -math.huge

	for id, c in pairs(state.combatants) do
		if c.team == me.team and not c.isPet and CombatSim.isAlive(c) then
			local allySchool = getCombatantSchool(mods, c)
			local scaling = type(c.scaling) == "table" and c.scaling or {}
			local score = 0

			if powerUpSchool then
				local bonusStat = schoolDef and (tonumber(scaling[schoolDef.damageBonus]) or 0) or 0
				if allySchool == powerUpSchool then
					score += 10000
				elseif bonusStat > 0 or (Schools and type(Schools.strongestOf) == "function" and Schools.strongestOf(scaling, c.school) == powerUpSchool) then
					score += 4000
				else
					score -= 5000
				end
				score += bonusStat * 600
			else
				local sDef = allySchool and Schools and Schools.defs and Schools.defs[allySchool]
				local mainDmgStat = sDef and (tonumber(scaling[sDef.damageBonus]) or 0) or 0
				score += 500 + (tonumber(scaling.AllDamage) or 0) * 600 + mainDmgStat * 500 + (tonumber(scaling.CritChance) or 0) * 200
			end

			score += (tonumber(scaling.AllDamage) or 0) * 300
			if powerUpStatusId and combatantHasStatus(c, powerUpStatusId) then
				score -= 800
			end

			local maxHp = (c.derived and c.derived.maxHp) or c.maxHp or 100
			local hpRatio = (c.hp or maxHp) / math.max(1, maxHp)
			score += hpRatio * 20
			local mySchool = getCombatantSchool(mods, me)
			if id == me.id and (not powerUpSchool or mySchool == powerUpSchool) then
				-- Always prioritize buffing yourself with your own element
				score += 500
			end

			if score > bestScore then
				bestScore = score
				bestId = id
			end
		end
	end

	return bestId, bestScore
end

local function isUsefulPowerUp(mods, state, me, pu, handDamageSchools, targetSchool, deckRem)
	local s = pu.info.powerUpSchool
	if not s then
		return true
	end
	if targetSchool and s == targetSchool then
		return true
	end
	if handDamageSchools[s] == true then
		return true
	end
	if deckRem and (deckRem.remainingDamageBySchool[s] or 0) > 0 then
		return true
	end
	local tk = pu.ability.targetKind
	if tk == "SingleAlly" or tk == "AllAllies" or tk == "SingleAny" or (tk == "SelfOnly" and pu.ability.ally == true) then
		local _, matchScore = pickBuffAllyTarget(mods, state, me, s, pu.info.powerUpStatusId)
		return matchScore and matchScore >= 4000
	end
	return false
end

local function isZeroCostDefense(ability, info)
	if not ability or not info then
		return false
	end
	local cost = ability.energyCost or 0
	return cost <= 0 and not info.preventsAction and (info.directDamage or 0) == 0 and (info.shieldScore > 0 or info.hasDefenseBuff)
end

local function pickBestFreeShield(freeShields, aliveEnemies, me)
	if #freeShields == 0 then
		return nil
	end
	local enemySchools = {}
	for _, e in ipairs(aliveEnemies) do
		local sc = e.combatant and e.combatant.school
		if sc then
			enemySchools[sc] = true
		end
	end

	local bestEntry, bestScore = nil, -math.huge
	for _, entry in ipairs(freeShields) do
		local ab = entry.ability
		local info = entry.info
		local s = (info.shieldScore or 0)
		local wardSchool = nil
		local dupStatus = false
		for _, ef in ipairs(ab.effects or {}) do
			if ef.kind == "ApplyStatus" and ef.statusId then
				if combatantHasStatus(me, ef.statusId) then
					dupStatus = true
				end
				wardSchool = ab.school
			end
		end

		if info.shieldScore > 0 then
			s += 1000
		elseif wardSchool and enemySchools[wardSchool] then
			s += 700
		else
			s += 300
		end
		if ab.targetKind == "AllAllies" then
			s += 80
		end
		if dupStatus and info.shieldScore == 0 then
			s -= 500
		end
		if s > bestScore then
			bestScore = s
			bestEntry = entry
		end
	end
	return bestEntry
end

local function getCasterRedirectInfo(Statuses, me)
	local hasRedirect = false
	local redirectName = nil
	local isBlinded = false
	for _, entry in ipairs(me and me.statuses or {}) do
		local sid = (type(entry) == "table" and entry.id) or entry
		local st = type(sid) == "string" and Statuses[sid]
		if st then
			if st.turnsNext == true then
				hasRedirect = true
				redirectName = st.name or sid
			end
			if st.missesNext == true then
				isBlinded = true
			end
		end
	end
	return {
		hasRedirect = hasRedirect,
		redirectName = redirectName,
		isBlinded = isBlinded,
	}
end

local function pickAttackEntry(mods, state, me, usableEntries, deckRem)
	local powerUps = {}
	local freeShields = {}
	local damagers = {}
	local handDamageSchools = {}
	local aliveEnemies = getAliveEnemies(mods, state, me)

	for _, entry in ipairs(usableEntries) do
		if entry.info.directDamage > 0 and not entry.info.preventsAction then
			entry._eval = evaluateAttackEntry(mods, state, me, entry, aliveEnemies)
			table.insert(damagers, entry)
			if entry.ability.school then
				handDamageSchools[entry.ability.school] = true
			end
		end
		if entry.info.isAttackPowerUp then
			table.insert(powerUps, entry)
		end
		if isZeroCostDefense(entry.ability, entry.info) then
			table.insert(freeShields, entry)
		end
	end

	-- 1. Lethal Finish Override: immediately cast any playable card that kills (prioritizing wipes > boss/major healer/top threat)
	local bossAlive = hasAliveBoss(mods, state, me)
	if #damagers > 0 then
		local wipes, bossKills, healerKills, singleKills = {}, {}, {}, {}
		for _, d in ipairs(damagers) do
			if d._eval.wipesAll then
				table.insert(wipes, { entry = d, eval = d._eval })
			elseif d._eval.killsBoss then
				table.insert(bossKills, { entry = d, eval = d._eval })
			elseif d._eval.killsMajorHealer or d._eval.killsTopThreat then
				table.insert(healerKills, { entry = d, eval = d._eval })
			elseif d._eval.killCount > 0 then
				table.insert(singleKills, { entry = d, eval = d._eval })
			end
		end
		if #wipes > 0 then
			return pickCheapestLethal(wipes), nil
		end
		if #bossKills > 0 then
			return pickCheapestLethal(bossKills), nil
		end
		if #healerKills > 0 then
			return pickCheapestLethal(healerKills), nil
		end
		if #singleKills > 0 then
			return pickCheapestLethal(singleKills), nil
		end
	end

	local function scoreCombatAttack(e)
		local ev = e._eval
		if not ev then
			return e.info.directDamage or 0
		end
		local lethalBonus = ev.wipesAll and 5000
			or (ev.killsBoss and 4000
			or (ev.killsMajorHealer and 2600
			or (ev.killsTopThreat and 1900
			or (ev.killCount > 0 and 1500 or 0))))
		return ((ev.bossDamage or 0) * 0.35) + (ev.tacticalScore or e.info.directDamage) + lethalBonus
	end

	table.sort(damagers, function(a, b)
		local sa, sb = scoreCombatAttack(a), scoreCombatAttack(b)
		if math.abs(sa - sb) > 0.5 then
			return sa > sb
		end
		return (a.ability.energyCost or 0) < (b.ability.energyCost or 0)
	end)

	-- 2. Save Pips for Stronger / Lethal Higher-Pip Card Already in Hand (e.g. 4-pip vs 2-pip when 2-pip won't kill)
	local allReady = collectEntries(mods, state, me, true)
	local maxCap = mods.CombatSim.maxEnergy(me) or 99
	local bestInHand = nil
	local bestInHandScore = -1
	for _, entry in ipairs(allReady) do
		local cost = entry.ability.energyCost or 0
		if entry.info.directDamage > 0 and not entry.info.preventsAction and cost <= maxCap then
			entry._eval = entry._eval or evaluateAttackEntry(mods, state, me, entry, aliveEnemies)
			local s = scoreCombatAttack(entry)
			if not bestInHand or s > bestInHandScore or (math.abs(s - bestInHandScore) < 0.5 and cost < (bestInHand.ability.energyCost or 99)) then
				bestInHand = entry
				bestInHandScore = s
			end
		end
	end

	if bestInHand and not bestInHand.payable then
		local bestPayable = damagers[1]
		local bestPayableScore = bestPayable and scoreCombatAttack(bestPayable) or 0
		local bestPayableCost = bestPayable and math.max(0, (bestPayable.ability.energyCost or 0) - (bestPayable.info.gainEnergyAmount or 0)) or 0
		local targetCost = bestInHand.ability.energyCost or 0
		local myEnergy = me.energy or 0
		local targetEval = bestInHand._eval
		local targetKills = targetEval and (targetEval.wipesAll or targetEval.killsBoss or targetEval.killCount > 0)
		local worthSaving = (#damagers == 0) or targetKills or (bestInHandScore >= bestPayableScore * 1.25)
		local wouldDelay = (#damagers == 0) or (bestPayableCost > 0 and (myEnergy - bestPayableCost) < targetCost)
		local meMaxHp = (me.derived and me.derived.maxHp) or me.maxHp or 100
		local meRatio = (me.hp or meMaxHp) / math.max(1, meMaxHp)
		local safeToWait = (#damagers == 0) or (meRatio > 0.25) or ((targetCost - myEnergy) <= 1)

		if worthSaving and wouldDelay and safeToWait then
			local safePowerUps = {}
			for _, pu in ipairs(powerUps) do
				if isUsefulPowerUp(mods, state, me, pu, handDamageSchools, bestInHand.ability.school, deckRem) then
					local netCost = (pu.ability.energyCost or 0) - (pu.info.gainEnergyAmount or 0)
					if netCost <= 0 or (myEnergy - netCost) >= targetCost then
						table.insert(safePowerUps, pu)
					end
				end
			end
			if #safePowerUps > 0 then
				table.sort(safePowerUps, function(a, b)
					local aMatch = (a.info.powerUpSchool == bestInHand.ability.school) and 1 or 0
					local bMatch = (b.info.powerUpSchool == bestInHand.ability.school) and 1 or 0
					if aMatch ~= bMatch then
						return aMatch > bMatch
					end
					return (a.ability.energyCost or 0) < (b.ability.energyCost or 0)
				end)
				return safePowerUps[1], nil
			end

			local bestShield = pickBestFreeShield(freeShields, aliveEnemies, me)
			if bestShield then
				return bestShield, nil
			end

			return nil, bestInHand
		end
	end

	-- 3. Stack 0-pip shields/wards or matching 0-1 pip power-up buffs before firing our best playable attack
	local bestFreeShield = pickBestFreeShield(freeShields, aliveEnemies, me)
	if bestFreeShield then
		return bestFreeShield, nil
	end

	local usefulPowerUps = {}
	local topPlayable = damagers[1]
	local topPlayableCost = topPlayable and (topPlayable.ability.energyCost or 0) or 0
	for _, pu in ipairs(powerUps) do
		local puNet = (pu.ability.energyCost or 0) - (pu.info.gainEnergyAmount or 0)
		local keepsTopPlayable = (not topPlayable) or (puNet <= 0) or (((me.energy or 0) - puNet) >= topPlayableCost)
		if isUsefulPowerUp(mods, state, me, pu, handDamageSchools, topPlayable and topPlayable.ability.school, deckRem)
			and ((pu.ability.energyCost or 0) <= 1 or #damagers == 0)
			and keepsTopPlayable
		then
			table.insert(usefulPowerUps, pu)
		end
	end
	if #usefulPowerUps > 0 then
		table.sort(usefulPowerUps, function(a, b)
			local aPure = (a.info.directDamage == 0) and 1 or 0
			local bPure = (b.info.directDamage == 0) and 1 or 0
			if aPure ~= bPure then
				return aPure > bPure
			end
			local aMatch = (a.info.powerUpSchool and (handDamageSchools[a.info.powerUpSchool] or (deckRem and (deckRem.remainingDamageBySchool[a.info.powerUpSchool] or 0) > 0))) and 1 or 0
			local bMatch = (b.info.powerUpSchool and (handDamageSchools[b.info.powerUpSchool] or (deckRem and (deckRem.remainingDamageBySchool[b.info.powerUpSchool] or 0) > 0))) and 1 or 0
			if aMatch ~= bMatch then
				return aMatch > bMatch
			end
			return (a.ability.energyCost or 0) < (b.ability.energyCost or 0)
		end)
		return usefulPowerUps[1], nil
	end

	-- 4. Cast the best damage-dealing card currently payable! (If Blinded or top target has Mirage evade, spend a 0-1 pip poke first before burning a 2+ pip finisher)
	if #damagers > 0 then
		local rInfo = getCasterRedirectInfo(mods.Statuses, me)
		local topAtk = damagers[1]
		local topEval = topAtk._eval
		local topEvades = topEval and topEval.bestEnemy and topEval.bestEnemy.evades
		local allEvade = (#aliveEnemies > 0)
		for _, e in ipairs(aliveEnemies) do
			if not e.evades then
				allEvade = false
				break
			end
		end
		local shouldPokeFirst = rInfo.isBlinded or allEvade or (topAtk.ability.targetKind ~= "AllEnemies" and topEvades)
		if shouldPokeFirst and #damagers >= 2 and (topAtk.ability.energyCost or 0) >= 2 then
			for _, d in ipairs(damagers) do
				if (d.ability.energyCost or 0) <= 1 then
					return d, nil
				end
			end
		end
		return damagers[1], nil
	end

	return nil, nil
end

local function getCombatantDebuffCount(Statuses, c, filterIds)
	local count = 0
	local hasSevere = false
	local hasRedirect = false
	for _, entry in ipairs(c and c.statuses or {}) do
		local sid = (type(entry) == "table" and entry.id) or entry
		local st = type(sid) == "string" and Statuses[sid]
		if st and not st.cleanseProof then
			local isDebuff = (
				st.isDot == true
				or st.turnsNext == true
				or st.missesNext == true
				or st.cleansable == true
				or hasStatusTag(st, "Debuff")
				or hasStatusTag(st, "Curse")
				or hasStatusTag(st, "DoT")
				or hasStatusTag(st, "Control")
				or (type(st.damageDealtMultiplier) == "number" and st.damageDealtMultiplier < 1)
				or (type(st.damageTakenMultiplier) == "number" and st.damageTakenMultiplier > 1)
				or st.debuff == true
			)
			if isDebuff and (not filterIds or table.find(filterIds, sid) ~= nil) then
				count += 1
				if st.turnsNext == true then
					hasRedirect = true
				end
				if st.isDot == true
					or st.turnsNext == true
					or st.missesNext == true
					or (type(st.damageDealtMultiplier) == "number" and st.damageDealtMultiplier < 1)
					or (type(st.damageTakenMultiplier) == "number" and st.damageTakenMultiplier > 1)
					or sid == "MortalWound"
				then
					hasSevere = true
				end
			end
		end
	end
	return count, hasSevere, hasRedirect
end

local function getTeamHealthInfo(mods, state, me, lowThreshold)
	local CombatSim = mods.CombatSim
	local Statuses = mods.Statuses
	local lowestRatio = 1
	local lowestId = nil
	local lowestMaxHp = 100
	local hurtCount = 0
	local multiHurtCount = 0
	local lowCount = 0
	local revivableCount = 0
	local hasDebuff = false
	local debuffedId = nil
	local bestDebuffScore = -1
	local debuffedCount = 0
	local unshieldedId = nil
	local bestShieldScore = math.huge
	local threshold = lowThreshold or 0.50

	for id, c in pairs(state.combatants) do
		if c.team == me.team and not c.isPet then
			if CombatSim.revivable(c) then
				revivableCount += 1
			elseif CombatSim.isAlive(c) then
				local maxHp = (c.derived and c.derived.maxHp) or c.maxHp or 100
				local ratio = (c.hp or maxHp) / math.max(1, maxHp)
				if ratio < lowestRatio or (ratio == lowestRatio and id == me.id) then
					lowestRatio = ratio
					lowestId = id
					lowestMaxHp = math.max(1, maxHp)
				end
				if ratio < 0.99 then
					hurtCount += 1
				end
				if ratio < 0.85 then
					multiHurtCount += 1
				end
				if ratio <= threshold then
					lowCount += 1
				end

				local shieldVal = tonumber(c.shield) or 0
				local allySchool = getCombatantSchool(mods, c)
				local sDef = allySchool and mods.Schools and mods.Schools.defs and mods.Schools.defs[allySchool]
				local schoolDefense = (sDef and tonumber(sDef.defense)) or 3
				-- Prioritize unshielded squishy carries (low school defense / lower HP) before tanks
				local shieldRank = shieldVal * 1000 + ratio * 100 + schoolDefense * 5 + (maxHp / 5000)
				if shieldRank < bestShieldScore then
					bestShieldScore = shieldRank
					unshieldedId = id
				end

				local debuffs = getCombatantDebuffCount(Statuses, c)
				if debuffs > 0 then
					hasDebuff = true
					debuffedCount += 1
					local debuffScore = debuffs * 10 + (1 - ratio) + (id == me.id and 0.01 or 0)
					if debuffScore > bestDebuffScore then
						bestDebuffScore = debuffScore
						debuffedId = id
					end
				end
			end
		end
	end

	return {
		lowestRatio = lowestRatio,
		lowestId = lowestId,
		lowestMaxHp = lowestMaxHp,
		hurtCount = hurtCount,
		multiHurtCount = multiHurtCount,
		lowCount = lowCount,
		revivableCount = revivableCount,
		hasDebuff = hasDebuff,
		debuffedId = debuffedId,
		debuffedCount = debuffedCount,
		unshieldedId = unshieldedId,
	}
end

local function effectiveHealTotal(entry, healthInfo, forEmergency)
	local info = entry.info
	if (info.healScore or 0) <= 0 then
		return 0
	end
	local mult = 1
	if entry.ability.targetKind == "AllAllies" then
		local count = forEmergency and math.max(1, math.max(healthInfo.lowCount or 0, healthInfo.hurtCount or 0)) or math.max(1, healthInfo.hurtCount or 0)
		mult = count
	end
	local bonus = (info.directDamage == 0) and 1.15 or 0.85
	return info.healScore * mult * bonus
end

local function findStrongHealToSave(mods, state, me, entries, healthInfo, threshold, deckRem)
	if (deckRem and not deckRem.hasStrongHealRemaining) or (not deckRem and DeckStrategy.TinyHealOnly) then
		return nil
	end
	local maxCap = mods.CombatSim.maxEnergy(me) or 99
	local myEnergy = me.energy or 0
	local needTeammate = (healthInfo.lowestId ~= nil and healthInfo.lowestId ~= me.id)
	local forEmergency = (threshold ~= nil)
	local needsHeal = (healthInfo.revivableCount > 0)
		or (forEmergency and healthInfo.lowestRatio <= threshold)
		or (not forEmergency and (healthInfo.lowestRatio <= 0.92 or healthInfo.hurtCount >= 2))
	if not needsHeal then
		return nil
	end

	-- Don't hold back if someone is downed & revivable right now, or critical (<= 25% HP) with an affordable save in hand
	local bestPlayableScore = 0
	local hasCriticalSave = false
	for _, entry in ipairs(entries) do
		local info = entry.info
		if info.healScore > 0 then
			local usableNeed = (healthInfo.revivableCount > 0 and info.revivesAlly)
				or (healthInfo.revivableCount == 0 and (not needTeammate or info.healsTeammates))
			if usableNeed then
				if healthInfo.revivableCount > 0 and info.revivesAlly then
					return nil
				end
				if healthInfo.lowestRatio <= 0.25 then
					hasCriticalSave = true
				end
				local tot = effectiveHealTotal(entry, healthInfo, forEmergency)
				if tot > bestPlayableScore then
					bestPlayableScore = tot
				end
			end
		end
	end
	if hasCriticalSave then
		return nil
	end

	-- Check all ready heals (including 2+ pip unaffordable heals in hand/talents)
	local allReady = collectEntries(mods, state, me, true)
	local bestSaveEntry = nil
	local bestSaveScore = bestPlayableScore
	for _, entry in ipairs(allReady) do
		local ab = entry.ability
		local info = entry.info
		local cost = ab.energyCost or 0
		if info.healScore > 0 and cost >= 2 and cost <= maxCap and cost > myEnergy then
			local usableNeed = (not needTeammate or info.healsTeammates or ab.targetKind == "AllAllies")
			if usableNeed then
				local tot = effectiveHealTotal(entry, healthInfo, forEmergency)
				-- Save for 2+ pip heal when no 1-pip heal is playable, or the 2+ pip heal is noticeably stronger (>= 1.4x)
				if tot > bestSaveScore and (bestPlayableScore == 0 or tot >= bestPlayableScore * 1.4) then
					bestSaveScore = tot
					bestSaveEntry = entry
				end
			end
		end
	end

	return bestSaveEntry
end

local function findImmediateLethalEntry(mods, state, me, entries)
	local aliveEnemies = getAliveEnemies(mods, state, me)
	if #aliveEnemies == 0 then
		return nil
	end
	local healthInfo = getTeamHealthInfo(mods, state, me, CombatAuto.HealThreshold)
	if healthInfo.revivableCount > 0 then
		return nil
	end

	local wipes, bossKills, healerKills, singleKills = {}, {}, {}, {}
	local bossAlive = hasAliveBoss(mods, state, me)
	for _, entry in ipairs(entries) do
		if entry.info.directDamage > 0 and not entry.info.preventsAction then
			local ev = evaluateAttackEntry(mods, state, me, entry, aliveEnemies)
			entry._eval = ev
			if ev.wipesAll then
				table.insert(wipes, { entry = entry, eval = ev })
			elseif ev.killsBoss and healthInfo.lowestRatio > 0.15 then
				table.insert(bossKills, { entry = entry, eval = ev })
			elseif (ev.killsMajorHealer or (ev.killCount > 0 and (not bossAlive or ev.killsTopThreat))) and healthInfo.lowestRatio > 0.25 then
				if ev.killsMajorHealer or ev.killsTopThreat then
					table.insert(healerKills, { entry = entry, eval = ev })
				else
					table.insert(singleKills, { entry = entry, eval = ev })
				end
			end
		end
	end
	if #wipes > 0 then
		return pickCheapestLethal(wipes)
	end
	if #bossKills > 0 then
		return pickCheapestLethal(bossKills)
	end
	if #healerKills > 0 then
		return pickCheapestLethal(healerKills)
	end
	if #singleKills > 0 then
		return pickCheapestLethal(singleKills)
	end
	return nil
end

local function pickEmergencyHealEntry(mods, state, me, entries, threshold, deckRem)
	local healthInfo = getTeamHealthInfo(mods, state, me, threshold)
	if healthInfo.revivableCount == 0 and healthInfo.lowestRatio > threshold then
		return nil, nil
	end

	local strongHeal = findStrongHealToSave(mods, state, me, entries, healthInfo, threshold, deckRem)
	if strongHeal then
		return nil, strongHeal
	end

	local needTeammate = (healthInfo.lowestId ~= nil and healthInfo.lowestId ~= me.id)
	local candidates = {}

	for _, entry in ipairs(entries) do
		local info = entry.info
		if info.healScore > 0 then
			local canTargetNeed = false
			if healthInfo.revivableCount > 0 then
				canTargetNeed = info.revivesAlly == true
			elseif needTeammate then
				canTargetNeed = info.healsTeammates == true
			else
				canTargetNeed = info.healsSelf == true
			end

			if canTargetNeed then
				local score = info.healScore
				score += (info.directDamage == 0) and 2000 or 500
				if entry.ability.targetKind == "AllAllies" and (healthInfo.lowCount >= 2 or healthInfo.hurtCount >= 2) then
					score += 600
				end
				if healthInfo.revivableCount > 0 and info.revivesAlly then
					score += 5000
				end
				table.insert(candidates, { entry = entry, score = score })
			end
		end
	end

	if #candidates == 0 then
		return nil, nil
	end
	table.sort(candidates, function(a, b)
		return a.score > b.score
	end)

	local bestHeal = candidates[1].entry
	-- Avoid an endless tiny-heal loop (e.g. 1-pip +33 Blessing at 40% HP) when a strong 3+ pip nuke is ready and no one is critical
	if healthInfo.revivableCount == 0 and CombatAuto.Style == "Attack" and healthInfo.lowestRatio > 0.25 then
		local bestHealFrac = effectiveHealTotal(bestHeal, healthInfo, true) / math.max(1, healthInfo.lowestMaxHp or 100)
		if bestHealFrac < 0.18 then
			for _, entry in ipairs(entries) do
				if entry.info.directDamage > 0 and not entry.info.preventsAction and ((entry.ability.energyCost or 0) >= 3 or entry.info.directDamage >= 250) then
					return nil, nil
				end
			end
		end
	end

	return bestHeal, nil
end

local function getStatusStackCount(c, statusId)
	if not c or not statusId then
		return 0
	end
	local count = 0
	for _, stEntry in ipairs(c.statuses or {}) do
		local sid = (type(stEntry) == "table" and stEntry.id) or stEntry
		if sid == statusId then
			count += (type(stEntry) == "table" and tonumber(stEntry.stacks)) or 1
		end
	end
	return count
end

local function pickSupportEntry(mods, state, me, entries, deckRem)
	local healthInfo = getTeamHealthInfo(mods, state, me, CombatAuto.HealThreshold)
	local needsHeal = (healthInfo.lowestRatio < 0.99)
	local urgentHeal = (healthInfo.revivableCount > 0) or (healthInfo.lowestRatio <= math.max(0.70, CombatAuto.HealThreshold))
	local strongHeal = urgentHeal and findStrongHealToSave(mods, state, me, entries, healthInfo, nil, deckRem) or nil
	local strongHealCost = strongHeal and (strongHeal.ability.energyCost or 2) or 0
	local myEnergy = me.energy or 0

	local aliveEnemies = getAliveEnemies(mods, state, me)
	local enemySchools = {}
	local bossAlive = false
	local totalEnemyHp = 0
	for _, e in ipairs(aliveEnemies) do
		totalEnemyHp += e.effectiveHp
		if e.isBoss then
			bossAlive = true
		end
		local sc = e.combatant and e.combatant.school
		if sc then
			enemySchools[sc] = true
		end
	end

	local aliveAllies = {}
	local teamMaxHpSum = 0
	local unshieldedCarryExists = false
	for _, c in pairs(state.combatants) do
		if c.team == me.team and not c.isPet and mods.CombatSim.isAlive(c) then
			table.insert(aliveAllies, c)
			local maxHp = (c.derived and c.derived.maxHp) or c.maxHp or 100
			teamMaxHpSum += maxHp
			if (tonumber(c.shield) or 0) <= 0 and ((c.hp or maxHp) / math.max(1, maxHp)) < 0.92 then
				unshieldedCarryExists = true
			end
		end
	end
	local teamAvgMaxHp = math.max(100, teamMaxHpSum / math.max(1, #aliveAllies))
	-- Only hold back costly defensive walls/debuffs if the fight is almost over (1 weak non-boss mob about to drop)
	local fightDangerous = bossAlive or (#aliveEnemies >= 2) or (totalEnemyHp >= teamAvgMaxHp * 0.45)

	local function buffBenefitCount(ab, buffList)
		local benefited = 0
		local pool = (ab.targetKind == "SelfOnly" and not ab.ally) and { me } or aliveAllies
		for _, b in ipairs(buffList) do
			local maxSt = (b.st and tonumber(b.st.maxStacks)) or 1
			local targetPool = (b.target == "Self") and { me } or pool
			local missingOnPool = 0
			for _, ally in ipairs(targetPool) do
				if getStatusStackCount(ally, b.id) < maxSt then
					missingOnPool += 1
				end
			end
			benefited = math.max(benefited, missingOnPool)
		end
		return benefited
	end

	local function enemyDebuffTargetsMissing(ab, enemyStList)
		if #enemyStList == 0 then
			return 0, false
		end
		local missingTotal = 0
		local missingOnBoss = false
		for _, e in ipairs(aliveEnemies) do
			local anyMissing = false
			for _, ds in ipairs(enemyStList) do
				local isCtrlSt = (ds.st and (ds.st.preventsAction == true or ds.st.turnsNext == true))
					or ds.id == "Stunned" or ds.id == "Frozen" or ds.id == "Beguiled"
				if not (isCtrlSt and e.isControlLocked) then
					local maxSt = (ds.st and tonumber(ds.st.maxStacks)) or 1
					if getStatusStackCount(e.combatant, ds.id) < maxSt then
						anyMissing = true
						break
					end
				end
			end
			if anyMissing then
				missingTotal += 1
				if e.isBoss or e.isMajorHealer or e.isTopThreat then
					missingOnBoss = true
				end
			end
		end
		return missingTotal, missingOnBoss
	end

	local candidates = {}

	for _, entry in ipairs(entries) do
		if entry.info.isSupport then
			local info = entry.info
			local ab = entry.ability
			local netCost = (ab.energyCost or 0) - (info.gainEnergyAmount or 0)
			local isTeamWallOrCleanse = (info.hasCleanse and healthInfo.hasDebuff)
				or (info.hasDefenseBuff and healthInfo.lowestRatio > 0.55)
				or info.hasSummon
			local safeForHealSave = (not strongHeal)
				or (netCost <= 0)
				or ((myEnergy - netCost) >= strongHealCost)
				or (isTeamWallOrCleanse and healthInfo.lowestRatio > 0.60)

			if safeForHealSave then
				local score = 0

				-- 1. Revive downed party members first
				if healthInfo.revivableCount > 0 and info.revivesAlly then
					score += 20000
				end

				-- 2. Cleanse whenever self or any teammate has a debuff
				if info.hasCleanse and healthInfo.hasDebuff then
					score += 8000
					if ab.targetKind == "AllAllies" and healthInfo.debuffedCount >= 2 then
						score += 600
					end
				end

				-- 3. Heal when allies need healing OR when Verdant/Sanctuary shields + Regrowth convert overheals safely
				local supGrants = CombatAuto.GetPathGrants(mods, me)
				local healConvertsToShield = (tonumber(supGrants.overhealShield) or 0) > 0 or (tonumber(supGrants.healShieldShare) or 0) > 0
				local healAddsRegrow = (tonumber(supGrants.regrowOnHeal) or 0) > 0
				if info.healScore > 0 then
					if needsHeal then
						local urgencyBonus = (healthInfo.lowestRatio <= CombatAuto.HealThreshold) and 2200 or 0
						score += 4000 + urgencyBonus + info.healScore + ((healConvertsToShield or healAddsRegrow) and 450 or 0)
						if ab.targetKind == "AllAllies" and (healthInfo.multiHurtCount >= 2 or healthInfo.hurtCount >= 2) then
							score += 500
						end
					elseif fightDangerous and (healConvertsToShield or healAddsRegrow) and unshieldedCarryExists and (ab.energyCost or 0) <= 3 then
						score += 1100 + info.healScore * 0.35
					end
				end

				-- 4. Team-advantage defensive buffs (Earthen Wall, Rootbound Grove, Frost Aegis, Gale Barrier, Wards) — ONLY when not already active & worth using!
				if info.hasDefenseBuff then
					if info.wardSchool and not enemySchools[info.wardSchool] then
						score += 0
					else
						local benefited = buffBenefitCount(ab, info.buffStatusIds or {})
						if benefited > 0 and (fightDangerous or (ab.energyCost or 0) <= 0 or unshieldedCarryExists) then
							local strongMitigation = false
							for _, b in ipairs(info.buffStatusIds or {}) do
								local mult = b.st and b.st.damageTakenMultiplier
								if (type(mult) == "number" and mult <= 0.80) or (b.st and b.st.evadesNext) then
									strongMitigation = true
									break
								end
							end
							local baseBuffVal = strongMitigation and 2800 or 1900
							local multiScale = (ab.targetKind == "AllAllies") and (benefited * 260) or 150
							score += baseBuffVal + multiScale
						end
					end
				end

				-- 5. Shields (worth casting if fight is dangerous, 0-pip, or an ally is injured/unshielded)
				if info.shieldScore > 0 then
					local hasDefenseUpgrade = (score > 0 and info.hasDefenseBuff)
					if fightDangerous or (ab.energyCost or 0) <= 0 or unshieldedCarryExists or healthInfo.lowestRatio < 0.85 or hasDefenseUpgrade then
						score += (fightDangerous and 2300 or 900) + info.shieldScore
					end
				end

				-- 6. Beneficial Summons (e.g. Nature's Call of the Grove Unicorn)
				if info.hasSummon and fightDangerous then
					score += 2700
				end

				-- 7. Team-Advantage Enemy Debuffs (Vulnerable: Hex / Gorgon Hiss; Beguiled; Blinded; Chilled)
				if info.appliesEnemyDebuff and #aliveEnemies > 0 then
					local missCnt, missBoss = enemyDebuffTargetsMissing(ab, info.enemyStatusIds or {})
					if missCnt > 0 and (fightDangerous or (ab.energyCost or 0) <= 0) then
						if info.appliesVulnerable then
							score += (missBoss and 3100 or 2200) + (missCnt * 180)
						elseif info.appliesControl then
							score += (#aliveEnemies >= 2 and 2600 or 1000) + (missBoss and 300 or 0)
						elseif info.appliesBlind or info.appliesWeaken then
							score += (missBoss and 2200 or 1700) + (missCnt * 140)
						else
							score += 1100 + (missCnt * 100)
						end
					end
				end

				if isZeroCostDefense(ab, info) and score > 0 then
					score += 450
				end

				-- 8. Energy & elemental power-up buffs (matched to self or teammates who use that element)
				if info.hasEnergyGain then
					score += 1200 + ((ab.targetKind == "AllAllies") and (#aliveAllies * 200) or 0)
				end
				if info.isAttackPowerUp then
					if ab.targetKind == "SelfOnly" and not ab.ally then
						local mySchool = getCombatantSchool(mods, me)
						if not info.powerUpSchool or mySchool == info.powerUpSchool then
							score += 900
						end
					else
						local buffTargetId, matchScore = pickBuffAllyTarget(mods, state, me, info.powerUpSchool, info.powerUpStatusId)
						if buffTargetId and (not info.powerUpSchool or (matchScore and matchScore >= 4000)) then
							score += 1500 + (((ab.energyCost or 0) <= 0) and 250 or 0)
						end
					end
				end

				if ab.targetKind == "AllAllies" and score > 0 then
					score += 40
				end

				-- Do not waste cards that provide zero benefit right now
				if score > 0 then
					table.insert(candidates, { entry = entry, score = score })
				end
			end
		end
	end

	if #candidates == 0 then
		return nil, strongHeal
	end
	table.sort(candidates, function(a, b)
		if math.abs(a.score - b.score) > 1 then
			return a.score > b.score
		end
		return (a.entry.ability.energyCost or 0) < (b.entry.ability.energyCost or 0)
	end)
	return candidates[1].entry, nil
end

local function pickTargetId(mods, state, me, ability, info, preferMode, evalResult)
	local CombatSim = mods.CombatSim
	local targetKind = ability.targetKind
	local mode = preferMode or CombatAuto.Style

	if targetKind == "SingleEnemy" or (targetKind == "SingleAny" and mode == "Attack") then
		local directScaled = info and info.scaledByCaster == true
		if CombatAuto.TargetPriority == "Smart Effective" and evalResult and evalResult.bestEnemy and evalResult.bestEnemy.id then
			local be = evalResult.bestEnemy
			local c = state.combatants[be.id]
			if c and CombatSim.isAlive(c) then
				return be.id, {
					name = be.name or c.name or be.id,
					mult = evalResult.bestMult or 1,
					isKill = (evalResult.killCount or 0) > 0,
					threatRole = be.threatRole,
				}
			end
		end

		local aliveMap = {}
		for _, ae in ipairs(getAliveEnemies(mods, state, me)) do
			aliveMap[ae.id] = ae
		end

		local bestEnemy = nil
		local bestScore = nil
		local bestMeta = nil
		local atkSchool = ability.school or me.school
		local directDmg = (info and info.directDamage) or 0
		local tGrants = CombatAuto.GetPathGrants(mods, me)
		local tExecThresh = tonumber(tGrants.execute) or 0
		local tExecBonus = tonumber(tGrants.executeBonus) or 0
		for id, c in pairs(state.combatants) do
			if c.team ~= me.team and not c.isPet and CombatSim.isAlive(c) then
				local hp = c.hp or 0
				local shield = tonumber(c.shield) or 0
				local ehp = math.max(1, hp + shield)
				local maxHp = math.max(1, (c.derived and c.derived.maxHp) or c.maxHp or hp)
				local isBoss = isBossCombatant(mods, c, id)
				local eInfo = aliveMap[id]
				local mult = getElementMultiplier(mods, atkSchool, c, me, directScaled, info and info.hasShatter)
				if tExecBonus > 0 and (hp / maxHp) < 0.50 then
					mult *= (1 + tExecBonus)
				end
				local projDmg = directDmg * mult
				local autoExec = (not isBoss) and tExecThresh > 0 and ((hp - math.max(0, projDmg - shield)) <= maxHp * tExecThresh)
				local canKill = (directDmg > 0) and ((projDmg >= ehp * 0.99) or autoExec)
				local isBoundProtected = (eInfo and eInfo.isBoundProtected == true) or false
				local isAbyssFist = (eInfo and eInfo.isAbyssFist == true) or (c.binds == true) or (c.enemyId == "WardenLeftHand" or c.enemyId == "WardenRightHand")
				local score
				if directDmg <= 0 then
					-- Non-damage support debuff (Hex, Beguile, Blind, Stun, MortalWound): prioritize top-threat enemy missing it & not StunImmune/CC-locked
					local alreadyDebuffed = true
					local appliesMortalWound = false
					local ccBlocked = (info and (info.appliesHardControl or info.appliesControl) and eInfo and eInfo.isControlLocked == true) or false
					if info and info.enemyStatusIds and #info.enemyStatusIds > 0 then
						for _, ds in ipairs(info.enemyStatusIds) do
							if ds.id == "MortalWound" then
								appliesMortalWound = true
							end
							if getStatusStackCount(c, ds.id) < ((ds.st and tonumber(ds.st.maxStacks)) or 1) then
								alreadyDebuffed = false
							end
						end
					else
						alreadyDebuffed = false
					end
					if ccBlocked then
						alreadyDebuffed = true
					end
					local threatWeight = ((eInfo and eInfo.threatScore) or 0) * 1500
						+ ((appliesMortalWound and eInfo and eInfo.isMajorHealer) and 400000 or 0)
					score = (alreadyDebuffed and 10000000 or 0) + (isBoundProtected and 50000000 or 0) - (isAbyssFist and 2000000 or 0) - threatWeight - ((isBoss and not isBoundProtected) and 150000 or 0) - ehp
				elseif CombatAuto.TargetPriority == "Highest HP" then
					score = (isBoundProtected and 50000000 or 0) - (isAbyssFist and 2000000 or 0) - (ehp / math.max(0.05, mult))
				elseif CombatAuto.TargetPriority == "Boss First" then
					score = (isBoundProtected and 50000000 or 0) - (isAbyssFist and 2000000 or 0) + ((isBoss and not isBoundProtected) and -10000000 or 0) - (canKill and 500000 or 0) - maxHp + (ehp / math.max(0.05, mult) * 0.01)
				elseif CombatAuto.TargetPriority == "Lowest HP" then
					score = (isBoundProtected and 50000000 or 0) - (isAbyssFist and 2000000 or 0) + ehp
				else
					-- Smart Effective: Abyss Fists / Major Healer / Top DPS > Tank / Bound Head
					local eff = math.min(projDmg, ehp)
					local okAmt = math.max(0, projDmg - ehp)
					local fMult = (eInfo and eInfo.threatFocusMult) or (isBoss and 1.25 or 1.0)
					local killThreatBonus = (eInfo and eInfo.isMajorHealer and 350000) or ((eInfo and eInfo.isTopThreat) and 220000) or 0
					score = (isBoundProtected and 50000000 or 0) - (isAbyssFist and (2000000 - ehp * 0.5) or 0) - (eff * fMult) + (okAmt * 0.65) - (canKill and ((isBoss and 500000 or 100000) + killThreatBonus) or 0)
				end
				if not bestScore or score < bestScore then
					bestScore = score
					bestEnemy = id
					bestMeta = {
						name = c.name or c.enemyId or id,
						mult = mult,
						isKill = canKill,
						threatRole = eInfo and eInfo.threatRole,
					}
				end
			end
		end
		return bestEnemy, bestMeta
	end

	if targetKind == "SingleAlly" or (targetKind == "SelfOnly" and ability.ally == true) or (targetKind == "SingleAny" and mode == "Support") then
		local healthInfo = getTeamHealthInfo(mods, state, me)
		local pickedId = nil
		if info.revivesAlly and healthInfo.revivableCount > 0 then
			for id, c in pairs(state.combatants) do
				if c.team == me.team and not c.isPet and CombatSim.revivable(c) then
					pickedId = id
					break
				end
			end
		elseif info.hasCleanse and healthInfo.debuffedId and (info.healScore == 0 or healthInfo.lowestRatio >= 0.99) then
			pickedId = healthInfo.debuffedId
		elseif info.healScore > 0 and healthInfo.lowestRatio < 0.99 and healthInfo.lowestId then
			pickedId = healthInfo.lowestId
		elseif info.isAttackPowerUp then
			pickedId = pickBuffAllyTarget(mods, state, me, info.powerUpSchool, info.powerUpStatusId) or me.id
		elseif info.hasDefenseBuff and info.buffStatusIds and #info.buffStatusIds > 0 then
			local bestAlly, bestRank = nil, math.huge
			for id, c in pairs(state.combatants) do
				if c.team == me.team and not c.isPet and CombatSim.isAlive(c) then
					local hasAll = true
					for _, b in ipairs(info.buffStatusIds) do
						local maxSt = (b.st and tonumber(b.st.maxStacks)) or 1
						if getStatusStackCount(c, b.id) < maxSt then
							hasAll = false
							break
						end
					end
					if not hasAll then
						local maxHp = (c.derived and c.derived.maxHp) or c.maxHp or 100
						local ratio = (c.hp or maxHp) / math.max(1, maxHp)
						local allySc = getCombatantSchool(mods, c)
						local sDef = allySc and mods.Schools and mods.Schools.defs and mods.Schools.defs[allySc]
						local scDef = (sDef and tonumber(sDef.defense)) or 3
						local rank = (tonumber(c.shield) or 0) * 100 + ratio * 50 + scDef * 5 + (maxHp / 5000)
						if rank < bestRank then
							bestRank = rank
							bestAlly = id
						end
					end
				end
			end
			pickedId = bestAlly or healthInfo.unshieldedId or healthInfo.lowestId or me.id
		elseif info.shieldScore > 0 and (healthInfo.unshieldedId or healthInfo.lowestId) then
			pickedId = healthInfo.unshieldedId or healthInfo.lowestId
		else
			pickedId = healthInfo.lowestId or me.id
		end
		local ally = pickedId and state.combatants[pickedId]
		local allyName = (pickedId == me.id and "me") or (ally and ally.name) or pickedId
		return pickedId, { name = allyName, mult = 1, isKill = false }
	end

	return nil, nil
end

local function scoreDiscardBrick(mods, state, me, ab, info, enemySchools, deckRem)
	if not ab or not info then
		return -1000
	end
	local cost = ab.energyCost or 0
	local maxCap = mods.CombatSim.maxEnergy(me) or 99
	if cost > maxCap then
		return 1000
	end

	-- Keep high-impact finishers & multi-target nukes
	if info.directDamage > 0 and cost >= CombatAuto.SavePipMinCost then
		return -1000
	end

	-- Check elemental wards vs alive enemies: useless ward in a non-matching fight is high-priority discard cycling fodder
	local hasWardEffect = false
	for _, ef in ipairs(ab.effects or {}) do
		if ef.kind == "ApplyStatus" and ef.statusId and info.shieldScore == 0 and info.directDamage == 0 then
			hasWardEffect = true
			break
		end
	end
	if hasWardEffect and info.hasDefenseBuff and ab.school then
		if enemySchools[ab.school] then
			return -200
		end
		return 850
	end

	-- Keep useful power-ups for remaining deck/hand damage
	if info.isAttackPowerUp then
		if isUsefulPowerUp(mods, state, me, { ability = ab, info = info }, {}, nil, deckRem) then
			return -400
		end
		return 750
	end

	if info.hasCleanse then
		if getCombatantDebuffCount(mods.Statuses, me, info.cleanseStatuses) > 0 then
			return -600
		end
		if CombatAuto.Style == "Support" or ab.targetKind == "AllAllies" then
			local hInfo = getTeamHealthInfo(mods, state, me)
			if hInfo.hasDebuff then
				return -600
			end
		end
	end

	if info.healScore > 0 then
		local meMaxHp = (me.derived and me.derived.maxHp) or me.maxHp or 100
		local meRatio = (me.hp or meMaxHp) / math.max(1, meMaxHp)
		if meRatio <= 0.65 or info.revivesAlly or (CombatAuto.Style == "Support" and ab.targetKind == "AllAllies") then
			return -500
		end
		return (CombatAuto.Style == "Attack" and cost <= 1 and info.healScore < (meMaxHp * 0.18)) and 520 or 100
	end

	if CombatAuto.Style == "Attack" then
		if info.directDamage == 0 and not isZeroCostDefense(ab, info) then
			return 600
		end
		return -100
	else
		if not info.isSupport then
			return 600
		end
		return -100
	end
end

local function tryAutoDiscard(mods, state, me, deckRem, minScore)
	local turnKey = tostring(state.round or 0) .. ":" .. tostring(state.turnIndex or 0)
	if CombatAuto.LastDiscardTurnKey == turnKey then
		return false
	end
	local hand = me.hand or {}
	if #hand == 0 then
		return false
	end

	local enemySchools = {}
	for _, e in ipairs(getAliveEnemies(mods, state, me)) do
		local sc = e.combatant and e.combatant.school
		if sc then
			enemySchools[sc] = true
		end
	end

	local ranked = {}
	local cutoff = minScore or 1
	for slot, abilityId in ipairs(hand) do
		local ab = mods.Abilities[abilityId]
		if ab then
			local info = analyzeAbility(mods, ab, me.energy or 0, me, DeckStrategy.CardTiers)
			local s = scoreDiscardBrick(mods, state, me, ab, info, enemySchools, deckRem)
			if s >= cutoff then
				table.insert(ranked, { abilityId = abilityId, slot = slot, score = s })
			end
		end
	end

	if #ranked == 0 then
		return false
	end
	table.sort(ranked, function(a, b)
		if a.score ~= b.score then
			return a.score > b.score
		end
		return a.slot < b.slot
	end)

	local toDiscard = {}
	for i = 1, math.min(2, #ranked) do
		table.insert(toDiscard, { abilityId = ranked[i].abilityId, slot = ranked[i].slot })
	end

	CombatAuto.LastDiscardTurnKey = turnKey
	for _, item in ipairs(toDiscard) do
		LiveCombat.ConsumedCounts[item.abilityId] = (LiveCombat.ConsumedCounts[item.abilityId] or 0) + 1
	end
	mods.Net.fireServer("SubmitAction", {
		kind = mods.Enums.ActionKind.Discard,
		cards = toDiscard,
		targetIds = {},
		seen = mods.CombatUI.shownHandVersion(),
	})
	setCombatStatus("DISCARD · " .. tostring(#toDiscard) .. " BRICKS")
	return true
end

local function pickCleanseEntry(mods, state, me, entries)
	local Statuses = mods.Statuses
	local CombatSim = mods.CombatSim
	local meMaxHp = (me.derived and me.derived.maxHp) or me.maxHp or 100
	local meRatio = (me.hp or meMaxHp) / math.max(1, meMaxHp)

	local bestEntry, bestTargetId, bestTargetName = nil, nil, nil
	local bestScore = -math.huge

	for _, entry in ipairs(entries) do
		local info = entry.info
		local ab = entry.ability
		if info.hasCleanse and not info.preventsAction and ab.targetKind ~= "SingleEnemy" then
			local cost = ab.energyCost or 0
			local myCnt, mySevere, myRedirect = getCombatantDebuffCount(Statuses, me, info.cleanseStatuses)
			local targetId, targetName, targetCnt, targetSevere, targetRedirect = nil, nil, 0, false, false

			if myCnt > 0 then
				targetId, targetName, targetCnt, targetSevere, targetRedirect = me.id, "me", myCnt, mySevere, myRedirect
			elseif ab.targetKind == "SingleAlly" or ab.targetKind == "AllAllies" or ab.targetKind == "SingleAny" then
				for id, c in pairs(state.combatants) do
					if id ~= me.id and c.team == me.team and not c.isPet and CombatSim.isAlive(c) then
						local cnt, sev, redir = getCombatantDebuffCount(Statuses, c, info.cleanseStatuses)
						if cnt > targetCnt or (cnt == targetCnt and (redir and not targetRedirect or (sev and not targetSevere))) then
							targetId = id
							targetName = c.name or id
							targetCnt = cnt
							targetSevere = sev
							targetRedirect = redir
						end
					end
				end
			end

			if targetCnt > 0 then
				local shouldCast = targetRedirect
					or (targetId == me.id and (cost <= 1 or targetCnt >= 2 or targetSevere or meRatio <= 0.70))
					or (targetId ~= me.id and (cost <= 0 or CombatAuto.Style == "Support"))
				if shouldCast then
					local score = (targetRedirect and 12000 or (targetId == me.id and 5000 or 2000)) + (targetCnt * 400) + (targetSevere and 600 or 0) - (cost * 300) + (info.healScore or 0)
					if ab.targetKind == "AllAllies" then
						score += 150
					end
					if score > bestScore then
						bestScore = score
						bestEntry = entry
						bestTargetId = targetId
						bestTargetName = targetName
					end
				end
			end
		end
	end

	return bestEntry, bestTargetId, bestTargetName
end

local function pickFreeUtilityCard(mods, state, me, entries, savingForCard, deckRem)
	local healthInfo = getTeamHealthInfo(mods, state, me)
	local aliveEnemies = getAliveEnemies(mods, state, me)
	local freeShields = {}
	local targetSchool = savingForCard and savingForCard.ability and savingForCard.ability.school or nil
	local savingForAttack = savingForCard and savingForCard.info and (savingForCard.info.directDamage or 0) > 0

	local energyEntry, buffEntry, cleanseEntry = nil, nil, nil
	for _, entry in ipairs(entries) do
		local info = entry.info
		local cost = entry.ability.energyCost or 0
		local netCost = cost - (info.gainEnergyAmount or 0)
		if info.hasEnergyGain and netCost <= 0 and (not energyEntry or (info.gainEnergyAmount or 0) > (energyEntry.info.gainEnergyAmount or 0)) then
			energyEntry = entry
		elseif savingForAttack and cost <= 0 and info.isAttackPowerUp and isUsefulPowerUp(mods, state, me, entry, {}, targetSchool, deckRem) then
			if not buffEntry or (info.powerUpSchool == targetSchool and buffEntry.info.powerUpSchool ~= targetSchool) then
				buffEntry = entry
			end
		elseif isZeroCostDefense(entry.ability, info) then
			table.insert(freeShields, entry)
		elseif cost <= 0 and info.hasCleanse and healthInfo.hasDebuff and not cleanseEntry then
			cleanseEntry = entry
		end
	end

	return energyEntry or buffEntry or pickBestFreeShield(freeShields, aliveEnemies, me) or cleanseEntry
end

local function runCombatStep()
	if not CombatAuto.Enabled or CombatAuto.Busy then
		return
	end
	if (os.clock() - CombatAuto.LastActionAt) < 0.45 then
		return
	end

	local mods = getGameMods()
	if not mods then
		setCombatStatus("ERR · " .. tostring(GameModsError or "MODS"))
		return
	end

	local state, myId, snapStatus = getCombatSnapshot(mods)
	if not state or not myId then
		if snapStatus == "AIMING" then
			CombatAuto.AimingSince = CombatAuto.AimingSince or os.clock()
			if (os.clock() - CombatAuto.AimingSince) >= 1.2 and mods.CombatUI and type(mods.CombatUI.stopAiming) == "function" then
				pcall(mods.CombatUI.stopAiming)
				CombatAuto.AimingSince = nil
				setCombatStatus("RECOVERED · AIM")
			else
				setCombatStatus("WAIT · AIMING")
			end
			return
		end
		CombatAuto.AimingSince = nil
		if snapStatus == "ENEMY TURN" then
			LiveCombat.BusySince = nil
			setCombatStatus("WAIT · ENEMY TURN")
		elseif snapStatus == "BUSY / ANIM" then
			LiveCombat.BusySince = LiveCombat.BusySince or os.clock()
			local liveMyId = LiveCombat.MyId or (LiveCombat.State and findMyCombatantId(LiveCombat.State))
			if liveMyId and LiveCombat.TurnActorId == liveMyId
				and (os.clock() - LiveCombat.BusySince) >= 6.0
				and mods.CombatUI and type(mods.CombatUI.setBusy) == "function"
			then
				pcall(mods.CombatUI.setBusy, false)
				LiveCombat.BusySince = nil
				setCombatStatus("RECOVERED · BUSY")
			else
				setCombatStatus("WAIT · ANIMATING")
			end
		elseif snapStatus == "SYNCING" then
			LiveCombat.BusySince = nil
			setCombatStatus("WAIT · SYNCING STATE")
		else
			LiveCombat.BusySince = nil
		end
		return
	end
	CombatAuto.AimingSince = nil
	LiveCombat.BusySince = nil

	local me = state.combatants[myId]
	CombatAuto.RefreshResolvedStyle(mods)
	local entries = collectEntries(mods, state, me, false)
	local deckRem = getDeckRemainingSummary(mods, state, me)
	local casterFlags = getCasterRedirectInfo(mods.Statuses, me)

	local chosen
	local savingForCard = nil
	local usedEmergencyHeal = false
	local cleanseTargetId = nil
	local cleanseTargetName = nil
	local safeRedirectPass = false
	if casterFlags.hasRedirect then
		-- Under Beguiled / turn-redirect debuff: NEVER target enemies! Try Cleanse -> Safe Heal -> 0-pip utility -> Safe Skip
		chosen, cleanseTargetId, cleanseTargetName = pickCleanseEntry(mods, state, me, entries)
		if not chosen and CombatAuto.AutoHeal then
			chosen, savingForCard = pickEmergencyHealEntry(mods, state, me, entries, CombatAuto.HealThreshold, deckRem)
			if chosen then
				if (chosen.info.directDamage or 0) > 0 then
					chosen = nil
				else
					usedEmergencyHeal = true
				end
			end
		end
		if not chosen then
			chosen = pickFreeUtilityCard(mods, state, me, entries, { ability = { school = DeckStrategy.PrimarySchool }, info = { directDamage = 1 } }, deckRem)
			if chosen and ((chosen.info.directDamage or 0) > 0 or chosen.ability.targetKind == "SingleEnemy" or chosen.ability.targetKind == "AllEnemies") then
				chosen = nil
			end
		end
		if not chosen then
			safeRedirectPass = true
		end
	else
		if CombatAuto.Style == "Attack" then
			chosen = findImmediateLethalEntry(mods, state, me, entries)
		end
		if not chosen and CombatAuto.AutoHeal then
			local hi = getTeamHealthInfo(mods, state, me, CombatAuto.HealThreshold)
			if hi.revivableCount > 0 or hi.lowestRatio <= 0.25 then
				chosen, savingForCard = pickEmergencyHealEntry(mods, state, me, entries, CombatAuto.HealThreshold, deckRem)
				if chosen then
					usedEmergencyHeal = true
				end
			end
		end
		if not chosen and not savingForCard and CombatAuto.AutoCleanse then
			chosen, cleanseTargetId, cleanseTargetName = pickCleanseEntry(mods, state, me, entries)
		end
		if not chosen and not savingForCard and CombatAuto.AutoHeal then
			chosen, savingForCard = pickEmergencyHealEntry(mods, state, me, entries, CombatAuto.HealThreshold, deckRem)
			if chosen then
				usedEmergencyHeal = true
			end
		end

		if not chosen and not savingForCard then
			if CombatAuto.Style == "Attack" then
				chosen, savingForCard = pickAttackEntry(mods, state, me, entries, deckRem)
			else
				chosen, savingForCard = pickSupportEntry(mods, state, me, entries, deckRem)
				if not chosen and not savingForCard and CombatAuto.SupportAttackWhenHealthy then
					local supportHealth = getTeamHealthInfo(mods, state, me, CombatAuto.HealThreshold)
					if not supportHealth.hasDebuff and supportHealth.revivableCount == 0 and supportHealth.lowestRatio >= math.max(0.80, CombatAuto.HealThreshold) then
						local atkCandidate, atkSave = pickAttackEntry(mods, state, me, entries, deckRem)
						if atkCandidate and not atkSave then
							local strongHeal = findStrongHealToSave(mods, state, me, entries, supportHealth, nil, deckRem)
							local reservePips = strongHeal and math.min(2, strongHeal.ability.energyCost or 2) or ((supportHealth.lowestRatio < 0.95) and 2 or 0)
							local netCost = math.max(0, (atkCandidate.ability.energyCost or 0) - (atkCandidate.info.gainEnergyAmount or 0))
							local atkEval = atkCandidate._eval
							local keepsReserve = ((me.energy or 0) - netCost) >= reservePips
							local highTeamValue = (atkEval and (atkEval.wipesAll or atkEval.killsBoss or atkEval.killCount > 0))
								or (atkCandidate.info.healScore or 0) > 0
								or atkCandidate.info.appliesVulnerable
								or atkCandidate.info.appliesBlind
							if keepsReserve or highTeamValue then
								chosen = atkCandidate
							end
						end
					end
				end
			end
		end

		if not chosen and savingForCard then
			chosen = pickFreeUtilityCard(mods, state, me, entries, savingForCard, deckRem)
		end
	end

	CombatAuto.Busy = true
	local ok, err = pcall(function()
		local CombatUI = mods.CombatUI
		if chosen then
			if chosen.slot and chosen.slot > 0 then
				LiveCombat.ConsumedCounts[chosen.id] = (LiveCombat.ConsumedCounts[chosen.id] or 0) + 1
			end
			local targetMode = (usedEmergencyHeal or chosen.info.isSupport) and "Support" or CombatAuto.Style
			local targetId, targetMeta
			if cleanseTargetId then
				targetId = cleanseTargetId
				targetMeta = { name = cleanseTargetName or "me", mult = 1, isKill = false }
			else
				targetId, targetMeta = pickTargetId(mods, state, me, chosen.ability, chosen.info, targetMode, chosen._eval)
			end
			local used = CombatUI.use(chosen.id, chosen.slot)
			if used and CombatUI.isAiming() then
				if targetId then
					pcall(CombatUI.aimAt, targetId)
				end
				if CombatUI.isAiming() then
					local aimable = CombatUI.aimableNow()
					if aimable and aimable[1] then
						pcall(CombatUI.aimAt, aimable[1])
					end
				end
				if CombatUI.isAiming() then
					pcall(CombatUI.stopAiming)
					used = false
				end
			end
			if not used then
				-- Direct SubmitAction fallback if CombatUI.use refused due to UI/split-VM state
				local tk = chosen.ability.targetKind
				local needsTarget = (tk == "SingleEnemy" or tk == "SingleAlly" or tk == "SingleAny" or (tk == "SelfOnly" and chosen.ability.ally == true))
				local targets = (needsTarget and targetId) and { targetId } or {}
				mods.Net.fireServer("SubmitAction", {
					kind = mods.Enums.ActionKind.Ability,
					abilityId = chosen.id,
					slot = (chosen.slot and chosen.slot > 0) and chosen.slot or nil,
					fromTalents = (chosen.slot == -1) and true or nil,
					targetIds = targets,
				})
				CombatAuto.LastActionAt = os.clock() + 0.85
			end
			local cardName = chosen.ability.name or chosen.id
			local ev = chosen._eval
			if usedEmergencyHeal then
				local who = (targetMeta and targetMeta.name) and (" -> " .. tostring(targetMeta.name)) or ""
				setCombatStatus("HEAL · " .. cardName .. who)
			elseif cleanseTargetId then
				local who = (targetMeta and targetMeta.name) and (" -> " .. tostring(targetMeta.name)) or ""
				setCombatStatus("CLEANSE · " .. cardName .. who)
			elseif chosen.ability.targetKind == "AllEnemies" then
				local cnt = (ev and ev.enemyCount) or 1
				local tag = (ev and ev.wipesAll) and "KILL AOE · " or "AOE · "
				setCombatStatus(string.format("%s%s (x%d)", tag, cardName, cnt))
			elseif targetMeta and targetMeta.name then
				local tag = targetMeta.isKill and "KILL · " or "CAST · "
				local roleNote = targetMeta.threatRole and (" [" .. tostring(targetMeta.threatRole) .. "]") or ""
				local multNote = ""
				if targetMeta.mult and math.abs(targetMeta.mult - 1) >= 0.05 then
					multNote = string.format(" (%.2fx)", targetMeta.mult)
				end
				setCombatStatus(tag .. cardName .. " -> " .. tostring(targetMeta.name) .. roleNote .. multNote)
			else
				setCombatStatus("CAST · " .. cardName)
			end
		elseif safeRedirectPass then
			if mods.CombatSim.mayPass(me) then
				CombatUI.passTurn()
				if CombatUI.canAct() then
					mods.Net.fireServer("SubmitAction", { kind = mods.Enums.ActionKind.Pass, targetIds = {} })
				end
				setCombatStatus("SKIP · " .. string.upper(tostring(casterFlags.redirectName or "BEGUILED")))
			else
				setCombatStatus("WAIT · " .. string.upper(tostring(casterFlags.redirectName or "BEGUILED")))
			end
		elseif savingForCard then
			if mods.CombatSim.mayPass(me) then
				CombatUI.passTurn()
				if CombatUI.canAct() then
					mods.Net.fireServer("SubmitAction", { kind = mods.Enums.ActionKind.Pass, targetIds = {} })
				end
				setCombatStatus("SAVING PIPS · " .. (savingForCard.ability.name or savingForCard.id))
			else
				setCombatStatus("SAVING PIPS · WAIT")
			end
		elseif CombatAuto.AutoDiscard and tryAutoDiscard(mods, state, me, deckRem, 1) then
			return
		elseif CombatAuto.AutoPass and mods.CombatSim.mayPass(me) then
			CombatUI.passTurn()
			if CombatUI.canAct() then
				mods.Net.fireServer("SubmitAction", { kind = mods.Enums.ActionKind.Pass, targetIds = {} })
			end
			setCombatStatus("PASSED · NO MATCH")
		else
			setCombatStatus("WAITING · NO MATCH")
		end
	end)
	if CombatAuto.LastActionAt < os.clock() then
		CombatAuto.LastActionAt = os.clock()
	end
	CombatAuto.Busy = false

	if not ok then
		setCombatStatus("ERR · " .. tostring(err))
	end
end

-- Auto Trivia Solver, Live Combat State & Boss Discovery Hooks
local triviaLookup = {}
local function rebuildTriviaLookup(mods)
	table.clear(triviaLookup)
	for _, entry in ipairs(mods.Trivia or {}) do
		if type(entry.q) == "string" and type(entry.a) == "string" then
			triviaLookup[entry.q] = entry.a
			triviaLookup[string.lower((string.gsub(entry.q, "%s+", " ")))] = entry.a
		end
	end
end

task.spawn(function()
	local mods = getGameMods()
	if not mods or not State.Alive then
		return
	end

	rebuildTriviaLookup(mods)
	refreshDeckStrategy(mods, true)

	trackConnection(mods.Net.onClientEvent("ProfileChanged", function()
		if State.Alive then
			task.delay(0.2, function()
				if State.Alive then
					refreshDeckStrategy(mods, true)
				end
			end)
		end
	end))

	trackConnection(mods.Net.onClientEvent("CombatStarted", function(data)
		if not State.Alive or type(data) ~= "table" then
			return
		end
		table.clear(LiveCombat.ConsumedCounts)
		LiveCombat.BossCombatantId = nil
		if type(data.state) == "table" then
			LiveCombat.State = data.state
			LiveCombat.MyId = findMyCombatantId(data.state)
			local me = LiveCombat.MyId and data.state.combatants and data.state.combatants[LiveCombat.MyId]
			refreshDeckStrategy(mods, true, me, true)
		end
		if type(data.boss) == "table" then
			if type(data.boss.id) == "string" then
				LiveCombat.BossCombatantId = data.boss.id
			end
			local bossTmplId = data.boss.enemyId or data.boss.defId
			if type(bossTmplId) == "string" then
				LiveBossIds[bossTmplId] = true
				if mods.BossEnemyIds then
					mods.BossEnemyIds[bossTmplId] = true
				end
			end
		end
	end))

	trackConnection(mods.Net.onClientEvent("CombatEvents", function(data)
		if not State.Alive or type(data) ~= "table" then
			return
		end
		if type(data.state) == "table" then
			LiveCombat.State = data.state
			LiveCombat.MyId = LiveCombat.MyId or findMyCombatantId(data.state)
			local me = LiveCombat.MyId and data.state.combatants and data.state.combatants[LiveCombat.MyId]
			if me then
				getDeckRemainingSummary(mods, data.state, me)
			end
		end
		if data.ended then
			LiveCombat.State = nil
			LiveCombat.TurnActorId = nil
			LiveCombat.BossCombatantId = nil
			table.clear(LiveCombat.ConsumedCounts)
			setDeckStrategyStatus(DeckStrategy.SummaryText)
		end
	end))

	trackConnection(mods.Net.onClientEvent("HandDealt", function(data)
		if not State.Alive or type(data) ~= "table" or not LiveCombat.State then
			return
		end
		if data.reshuffled then
			table.clear(LiveCombat.ConsumedCounts)
		end
		local myId = LiveCombat.MyId or findMyCombatantId(LiveCombat.State)
		local me = myId and LiveCombat.State.combatants and LiveCombat.State.combatants[myId]
		if me and type(data.hand) == "table" then
			me.hand = table.clone(data.hand)
			getDeckRemainingSummary(mods, LiveCombat.State, me)
		end
	end))

	trackConnection(mods.Net.onClientEvent("TurnChanged", function(data)
		if not State.Alive or type(data) ~= "table" then
			return
		end
		LiveCombat.TurnActorId = data.secondsRemaining and data.actorId or nil
		LiveCombat.BusySince = nil
	end))

	local function clearLiveCombat()
		LiveCombat.State = nil
		LiveCombat.MyId = nil
		LiveCombat.TurnActorId = nil
		LiveCombat.BossCombatantId = nil
		LiveCombat.BusySince = nil
		table.clear(LiveCombat.ConsumedCounts)
		setDeckStrategyStatus(DeckStrategy.SummaryText)
	end
	trackConnection(mods.Net.onClientEvent("CombatEnded", clearLiveCombat))
	trackConnection(mods.Net.onClientEvent("ArenaCleared", clearLiveCombat))
	trackConnection(mods.Net.onClientEvent("ArenaExited", clearLiveCombat))

	trackConnection(mods.Net.onClientEvent("TriviaAsk", function(payload)
		if not State.Alive or not CombatAuto.AutoTrivia or type(payload) ~= "table" then
			return
		end
		task.delay(0.35, function()
			if not State.Alive or not CombatAuto.AutoTrivia then
				return
			end
			if payload.choosing then
				pcall(function()
					mods.Net.fireServer("TriviaVote", { choice = 1 })
				end)
				setCombatStatus("TRIVIA · VOTED TOPIC")
				return
			end
			local q = tostring(payload.question or "")
			local answer = triviaLookup[q] or triviaLookup[string.lower((string.gsub(q, "%s+", " ")))]
			if answer and type(payload.options) == "table" then
				for idx, opt in ipairs(payload.options) do
					if opt == answer or string.lower(tostring(opt)) == string.lower(answer) then
						pcall(function()
							mods.Net.fireServer("TriviaVote", { choice = idx })
						end)
						setCombatStatus("TRIVIA · " .. tostring(answer))
						return
					end
				end
			end
		end)
	end))
end)

trackThread(function()
	while State.Alive do
		task.wait(0.2)
		if not State.Alive then
			break
		end
		if State.StatusFlushers then
			for _, flush in ipairs(State.StatusFlushers) do
				flush()
			end
		end
		if CombatAuto.Enabled then
			local okStep, stepErr = pcall(runCombatStep)
			if not okStep then
				CombatAuto.Busy = false
				setCombatStatus("ERR · " .. tostring(stepErr))
			end
		end
	end
end)

