local origCinemaRemaining = nil
local lastSyncedCombatSpeed = nil
local function applyFastPlayback(enabled, syncSpeedSetting)
	local mods = getGameMods()
	if not mods then
		return
	end
	if mods.Vfx and type(mods.Vfx.hurryDeaths) == "function" then
		pcall(function()
			mods.Vfx.hurryDeaths(enabled)
		end)
	end
	if mods.Cinema then
		if enabled then
			if not origCinemaRemaining and type(mods.Cinema.remaining) == "function" then
				origCinemaRemaining = mods.Cinema.remaining
			end
			mods.Cinema.remaining = function()
				return 0
			end
		elseif origCinemaRemaining then
			mods.Cinema.remaining = origCinemaRemaining
		end
	end
	if syncSpeedSetting then
		local speedVal = enabled and 1 or 0
		if lastSyncedCombatSpeed ~= speedVal then
			lastSyncedCombatSpeed = speedVal
			pcall(function()
				mods.Net.fireServer("SetSetting", { key = "combatSpeed", value = speedVal })
			end)
		end
	end
end

trackRestore(function()
	if origCinemaRemaining then
		local mods = getGameMods()
		if mods and mods.Cinema then
			mods.Cinema.remaining = origCinemaRemaining
		end
		if mods and mods.Vfx then
			pcall(mods.Vfx.hurryDeaths, false)
		end
	end
end)

