local function discoverLobbyTargets(mods)
	table.clear(lobbyPositions)
	local names = {}
	local seen = {}

	local function addSpot(label, pos)
		if label and pos and not seen[label] then
			seen[label] = true
			lobbyPositions[label] = pos
			table.insert(names, label)
		end
	end

	-- Discover all Gates in Workspace (AbyssGate + any future update gates)
	for _, child in ipairs(workspace:GetChildren()) do
		if (child:IsA("Model") or child:IsA("BasePart")) and string.find(child.Name, "Gate") then
			addSpot(child.Name, child:GetPivot().Position)
		end
	end

	-- Carnival Plaza from live NewLandsSpots if available
	if mods and mods.NewLandsSpots and mods.NewLandsSpots.carnivalSign and mods.NewLandsSpots.carnivalSign.p then
		addSpot("Carnival Plaza", mods.NewLandsSpots.carnivalSign.p + Vector3.new(0, -8, 35))
	else
		addSpot("Carnival Plaza", Vector3.new(0, 4, 360))
	end

	-- Discover all Plots & Trainers in CampaignLobby dynamically
	local lobby = workspace:FindFirstChild("CampaignLobby")
	if lobby then
		local plots = lobby:FindFirstChild("Plots")
		if plots then
			local plotList = {}
			for _, m in ipairs(plots:GetChildren()) do
				table.insert(plotList, m)
			end
			table.sort(plotList, function(a, b) return a.Name < b.Name end)
			for _, m in ipairs(plotList) do
				addSpot("Plot · " .. m.Name, m:GetPivot().Position)
			end
		end

		local trainers = lobby:FindFirstChild("Trainers")
		if trainers then
			local trainerList = {}
			for _, t in ipairs(trainers:GetChildren()) do
				table.insert(trainerList, t)
			end
			table.sort(trainerList, function(a, b) return a.Name < b.Name end)
			for _, t in ipairs(trainerList) do
				addSpot("Trainer · " .. t.Name, t:GetPivot().Position)
			end
		end
	end

	if #names == 0 then
		addSpot("Lobby Center", Vector3.new(0, 6, 450))
	end
	return names
end

