local AutoEquip = {
	Enabled = Config.Get("AutoEquip", false),
	Element = Config.Get("AutoEquipElement", "Auto (My School)"),
	Busy = false,
	LastRunAt = 0,
}

local EQUIP_SLOTS_ORDER = { "Weapon", "Offhand", "Helmet", "Outfit", "Backpack", "Charm1", "Charm2", "Charm3" }
local RARITY_WEIGHT = { Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5, Mythic = 6 }

local function scoreGearForSchool(mods, profile, item, def, slot, targetSchool)
	local Inventory = mods.Inventory
	local schoolDef = targetSchool and mods.Schools.defs[targetSchool]

	local fakeProfile = {
		inventory = { item },
		equipped = { [slot] = item.uid },
		level = profile.level or 1,
		primarySchool = targetSchool or profile.primarySchool,
	}

	local okStats, stats = pcall(Inventory.equippedStats, fakeProfile)
	local okHp, bonusHp = pcall(Inventory.equippedMaxHp, fakeProfile)
	if not okStats or type(stats) ~= "table" then
		stats = def.stats or {}
	end
	if not okHp or type(bonusHp) ~= "number" then
		bonusHp = 0
	end

	local sameElement = false
	if targetSchool then
		local okNamed, named = pcall(Inventory.namesSchool, item.defId, targetSchool)
		if okNamed and named then
			sameElement = true
		elseif schoolDef and (
			(stats[schoolDef.damageBonus] or 0) > 0
			or (stats[schoolDef.pierce] or 0) > 0
			or (stats[schoolDef.resistance] or 0) > 0
		) then
			sameElement = true
		end
	end

	local score = 0
	if schoolDef then
		score += (stats[schoolDef.damageBonus] or 0) * 1200
		score += (stats[schoolDef.pierce] or 0) * 700
		score += (stats[schoolDef.resistance] or 0) * 260
	end

	score += ((stats.AllDamage or 0) + (stats.OwnDamage or 0)) * 1050
	score += (stats.Pierce or 0) * 600
	score += (stats.PowerPipChance or 0) * 550
	score += (stats.CritChance or 0) * 480
	score += (stats.Accuracy or 0) * 320
	score += (stats.CritDamage or 0) * 260
	score += (stats.AllResistance or 0) * 240
	score += (stats.Haste or 0) * 200
	score += (stats.BlockChance or 0) * 180
	score += (stats.StatusResistance or 0) * 160
	local healWeight = (targetSchool == "Light" or targetSchool == "Nature") and 450 or 180
	score += (stats.HealingBonus or 0) * healWeight
	score += ((stats.MaxHealth or 0) + bonusHp) * 1.4

	-- Small fallback credit for off-element stats only when no same-element/universal stat exists
	for statName, val in pairs(stats) do
		if type(val) == "number" and val > 0 then
			if string.find(statName, "Damage$") and statName ~= "AllDamage" and statName ~= "OwnDamage" and statName ~= "CritDamage" and (not schoolDef or statName ~= schoolDef.damageBonus) then
				score += val * 30
			elseif string.find(statName, "Pierce$") and statName ~= "Pierce" and (not schoolDef or statName ~= schoolDef.pierce) then
				score += val * 20
			elseif string.find(statName, "Resistance$") and statName ~= "AllResistance" and statName ~= "StatusResistance" and (not schoolDef or statName ~= schoolDef.resistance) then
				score += val * 15
			end
		end
	end

	local rarityVal = RARITY_WEIGHT[def.rarity] or 1
	score += (rarityVal * 0.25) + ((item.tier or 0) * 0.6)

	return sameElement, score
end

local function runSmartAutoEquip(silentNoChange)
	if AutoEquip.Busy then
		return
	end
	local mods = getGameMods()
	if not mods or not mods.Inventory or not mods.Schools then
		return
	end
	if mods.Place and mods.Place.loadoutLocked() then
		if not silentNoChange then
			setLobbyStatus("EQUIP LOCKED IN RUN")
		end
		return
	end

	AutoEquip.Busy = true
	local ok, resultText = pcall(function()
		local okProf, profile = pcall(mods.Net.getProfile)
		if not okProf or type(profile) ~= "table" then
			return "ERR · NO PROFILE"
		end

		local mySchool = profile.primarySchool
		local targetSchool = (AutoEquip.Element == "Auto (My School)" or AutoEquip.Element == "") and mySchool or AutoEquip.Element
		local playerLevel = profile.level or 1
		local equipped = profile.equipped or {}
		local usedUids = {}
		local changes = 0

		for _, slot in ipairs(EQUIP_SLOTS_ORDER) do
			local bestSame, bestSameScore = nil, -math.huge
			local bestAny, bestAnyScore = nil, -math.huge

			for _, item in ipairs(profile.inventory or {}) do
				if not usedUids[item.uid] then
					local def = mods.Items[item.defId]
					if def
						and mods.Inventory.fits(def, slot)
						and mods.Inventory.schoolCanWear(mySchool, item.defId)
						and not mods.Inventory.expired(item)
						and (def.minLevel or 1) <= playerLevel
					then
						local isSame, score = scoreGearForSchool(mods, profile, item, def, slot, targetSchool)
						local isCurrentlyEquipped = (equipped[slot] == item.uid) and 0.001 or 0
						if isSame and (score + isCurrentlyEquipped) > bestSameScore then
							bestSameScore = score + isCurrentlyEquipped
							bestSame = item
						end
						if (score + isCurrentlyEquipped) > bestAnyScore then
							bestAnyScore = score + isCurrentlyEquipped
							bestAny = item
						end
					end
				end
			end

			local chosen = bestSame or bestAny
			if chosen then
				usedUids[chosen.uid] = true
				if equipped[slot] ~= chosen.uid then
					mods.Net.fireServer("EquipItem", { uid = chosen.uid, slot = slot })
					changes += 1
					task.wait(0.06)
				end
			end
		end

		if changes > 0 then
			return string.format("EQUIPPED · %d slots (%s)", changes, tostring(targetSchool or "Any"))
		end
		return nil
	end)
	AutoEquip.LastRunAt = os.clock()
	AutoEquip.Busy = false

	if ok then
		if resultText then
			setLobbyStatus(resultText)
		elseif not silentNoChange then
			setLobbyStatus("BEST GEAR EQUIPPED")
		end
	else
		setLobbyStatus("EQUIP ERR")
	end
end

