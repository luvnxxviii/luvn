-- Combat Helper Functions
local function hasStatusTag(statusDef, tag)
	if not statusDef or type(statusDef.tags) ~= "table" then
		return false
	end
	return table.find(statusDef.tags, tag) ~= nil
end

local LiveCombat = {
	State = nil,
	MyId = nil,
	TurnActorId = nil,
	LastGcScan = 0,
}

local function findMyCombatantId(state)
	if type(state) ~= "table" or type(state.combatants) ~= "table" then
		return nil
	end
	for id, c in pairs(state.combatants) do
		if c.userId == LocalPlayer.UserId and c.hand ~= nil then
			return id
		end
	end
	for id, c in pairs(state.combatants) do
		if c.userId == LocalPlayer.UserId then
			return id
		end
	end
	return nil
end

local function extractStateFromUpvalues(fn)
	if type(fn) ~= "function" then
		return nil, nil
	end
	local getUpv = (type(debug) == "table" and type(debug.getupvalues) == "function" and debug.getupvalues)
		or (typeof(getupvalues) == "function" and getupvalues)
	if not getUpv then
		return nil, nil
	end
	local ok, uvs = pcall(getUpv, fn)
	if not ok or type(uvs) ~= "table" then
		return nil, nil
	end
	local state, myId
	for _, val in pairs(uvs) do
		if type(val) == "table" and type(val.combatants) == "table" and type(val.turnOrder) == "table" then
			state = val
		elseif type(val) == "string" then
			myId = val
		end
	end
	if state and (not myId or not state.combatants[myId]) then
		myId = findMyCombatantId(state)
	end
	return state, myId
end

local function scanGcCombatState()
	if typeof(getgc) ~= "function" then
		return nil, nil
	end
	if (os.clock() - LiveCombat.LastGcScan) < 1.5 then
		return nil, nil
	end
	LiveCombat.LastGcScan = os.clock()

	local ok, gcList = pcall(getgc, true)
	if not ok or type(gcList) ~= "table" then
		return nil, nil
	end

	local bestState, bestMyId = nil, nil
	for _, v in ipairs(gcList) do
		if type(v) == "table"
			and rawget(v, "isOver") == false
			and type(rawget(v, "combatants")) == "table"
			and type(rawget(v, "turnOrder")) == "table"
			and type(rawget(v, "turnIndex")) == "number"
		then
			local myId = findMyCombatantId(v)
			if myId then
				bestState = v
				bestMyId = myId
				if v.turnOrder[v.turnIndex] == myId then
					break
				end
			end
		end
	end
	if bestState and bestMyId then
		LiveCombat.State = bestState
		LiveCombat.MyId = bestMyId
	end
	return bestState, bestMyId
end

local function getCombatSnapshot(mods)
	local CombatUI = mods.CombatUI
	if CombatUI.isAiming() then
		return nil, nil, "AIMING"
	end

	local uiState, uiMyId = extractStateFromUpvalues(CombatUI.canAct)
	local state, myId = uiState, uiMyId
	if not state or not myId then
		state, myId = extractStateFromUpvalues(CombatUI.dealHand)
	end
	if not state or not myId then
		state, myId = extractStateFromUpvalues(CombatUI.render)
	end
	if not state or not myId then
		state, myId = extractStateFromUpvalues(CombatUI.passTurn)
	end
	if (not state or not myId) and LiveCombat.State then
		state = LiveCombat.State
		myId = LiveCombat.MyId or findMyCombatantId(state)
	end

	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	local combatGui = playerGui and playerGui:FindFirstChild("CombatUI")
	local guiVisible = combatGui and combatGui:IsA("ScreenGui") and combatGui.Enabled

	if (not state or not myId or state.isOver) and guiVisible then
		local gcState, gcMyId = scanGcCombatState()
		if gcState and gcMyId then
			state, myId = gcState, gcMyId
		end
	end

	-- If CombatUI has live state attached, trust CombatUI.canAct(); if split-VM (uiState == nil), evaluate turn from state + guiVisible
	local canActNow = CombatUI.canAct()
	if not canActNow and not uiState and guiVisible and state and myId and not state.isOver then
		local me = state.combatants and state.combatants[myId]
		local actorId = (state.turnOrder and state.turnIndex and state.turnOrder[state.turnIndex]) or LiveCombat.TurnActorId
		if me and not me.isIncapacitated and (me.hp or 0) > 0 and actorId == myId then
			canActNow = true
		end
	end

	if not canActNow then
		if state and not state.isOver then
			local actorId = (state.turnOrder and state.turnIndex and state.turnOrder[state.turnIndex]) or LiveCombat.TurnActorId
			if actorId and myId and actorId ~= myId then
				return nil, nil, "ENEMY TURN"
			end
			return nil, nil, "BUSY / ANIM"
		end
		return nil, nil, "WAITING"
	end

	if not state or not myId or not state.combatants or not state.combatants[myId] then
		return nil, nil, "SYNCING"
	end
	return state, myId, "ACT"
end

local function analyzeAbility(mods, ability, energy)
	local Statuses = mods.Statuses
	local directDamage = 0
	local isAttackPowerUp = false
	local powerUpSchool = nil
	local healScore = 0
	local healsSelf = false
	local healsTeammates = false
	local shieldScore = 0
	local hasCleanse = false
	local hasDefenseBuff = false
	local hasEnergyGain = false
	local gainEnergyAmount = 0
	local revivesAlly = false
	local preventsAction = false

	for _, ef in ipairs(ability.effects or {}) do
		local kind = ef.kind
		if kind == "Damage" then
			local mult = ability.spendAll and math.max(1, energy or 1) or 1
			directDamage += ((ef.base or 0) * (ef.hits or 1) * mult)
		elseif kind == "Detonate" or kind == "ConsumeDot" then
			directDamage += 25
		elseif kind == "Heal" then
			healScore += (ef.base or 30)
			if ef.target == "Self" or ability.targetKind == "SelfOnly" then
				healsSelf = true
			elseif ef.target == "Allies" or ability.targetKind == "AllAllies" or ability.targetKind == "SingleAlly" then
				healsSelf = true
				healsTeammates = true
			end
			if ef.target ~= "Self" and (ability.targetKind == "SingleAlly" or ability.targetKind == "AllAllies") then
				revivesAlly = true
			end
		elseif kind == "Shield" then
			shieldScore += (ef.base or 25)
		elseif kind == "Cleanse" then
			hasCleanse = true
		elseif kind == "GainEnergy" then
			hasEnergyGain = true
			gainEnergyAmount += (ef.amount or 1)
		elseif kind == "ApplyStatus" and ef.statusId then
			local st = Statuses[ef.statusId]
			if st then
				if st.preventsAction then
					preventsAction = true
				end
				if st.schoolDealt ~= nil or (st.damageDealtMultiplier and st.damageDealtMultiplier > 1) or (st.damageDealtPerStack and st.damageDealtPerStack > 0) then
					if not st.preventsAction then
						isAttackPowerUp = true
						powerUpSchool = st.school or ability.school
					end
				end
				if hasStatusTag(st, "Buff") and not st.preventsAction then
					if st.damageTakenMultiplier or st.schoolTaken or st.evadesNext or st.reprisal or ef.statusId == "Regrowth" then
						hasDefenseBuff = true
					end
				end
			end
		end
	end

	local targetsAllyOrSelf = (
		ability.targetKind == "SelfOnly"
		or ability.targetKind == "SingleAlly"
		or ability.targetKind == "AllAllies"
		or ability.ally == true
		or (ability.targetKind == "SingleAny" and directDamage == 0)
	)

	local isSupport = targetsAllyOrSelf and directDamage == 0 and not preventsAction and (
		healScore > 0
		or shieldScore > 0
		or hasCleanse
		or hasDefenseBuff
		or hasEnergyGain
		or isAttackPowerUp
	)

	return {
		directDamage = directDamage,
		isAttackPowerUp = isAttackPowerUp,
		powerUpSchool = powerUpSchool,
		isSupport = isSupport,
		healScore = healScore,
		healsSelf = healsSelf,
		healsTeammates = healsTeammates,
		shieldScore = shieldScore,
		hasCleanse = hasCleanse,
		hasDefenseBuff = hasDefenseBuff,
		hasEnergyGain = hasEnergyGain,
		gainEnergyAmount = gainEnergyAmount,
		revivesAlly = revivesAlly,
		preventsAction = preventsAction,
	}
end

local function isBossCombatant(mods, c, combatantId)
	if not c then
		return false
	end
	if c.isBoss == true or c.boss == true then
		return true
	end
	if combatantId and LiveBossIds[combatantId] then
		return true
	end
	local bossIds = mods.BossEnemyIds
	if bossIds then
		local eid = c.enemyId or c.defId or c.id
		if type(eid) == "string" and (bossIds[eid] or LiveBossIds[eid]) then
			return true
		end
	end
	return false
end

local function hasAliveBoss(mods, state, me)
	for id, c in pairs(state.combatants) do
		if c.team ~= me.team and not c.isPet and mods.CombatSim.isAlive(c) and isBossCombatant(mods, c, id) then
			return true
		end
	end
	return false
end

local function collectEntries(mods, state, me, includeUnaffordable)
	local entries = {}
	local CombatSim = mods.CombatSim
	local Abilities = mods.Abilities

	for slot, abilityId in ipairs(me.hand or {}) do
		local ab = Abilities[abilityId]
		if ab and CombatSim.ready(state.combatants, me, ab) and (includeUnaffordable or CombatSim.canPay(me, ab)) then
			table.insert(entries, {
				id = abilityId,
				slot = slot,
				ability = ab,
				payable = CombatSim.canPay(me, ab),
				info = analyzeAbility(mods, ab, me.energy or 0),
			})
		end
	end

	for _, abilityId in ipairs(me.talentCards or {}) do
		local used = me.talentCardsUsed and me.talentCardsUsed[abilityId]
		local ab = not used and Abilities[abilityId]
		if ab and CombatSim.ready(state.combatants, me, ab) and (includeUnaffordable or CombatSim.canPay(me, ab)) then
			table.insert(entries, {
				id = abilityId,
				slot = -1,
				ability = ab,
				payable = CombatSim.canPay(me, ab),
				info = analyzeAbility(mods, ab, me.energy or 0),
			})
		end
	end

	return entries
end

local function getElementMultiplier(mods, attackSchool, defender, me)
	if not defender then
		return 1
	end
	local mult = 1
	local atkSchool = attackSchool or (me and me.school)

	-- 1. Live CombatMath.schoolFactor (uses defender.scaling[resistance] & attacker pierce)
	local CombatMath = mods.CombatMath
	local Schools = mods.Schools
	if CombatMath and type(CombatMath.schoolFactor) == "function" and atkSchool and type(defender.scaling) == "table" then
		local ok, factor = pcall(CombatMath.schoolFactor, defender, atkSchool, nil, me)
		if ok and type(factor) == "number" then
			mult *= factor
		end
		if me and type(me.scaling) == "table" and type(CombatMath.offensiveMultiplier) == "function" then
			local okOff, offMult = pcall(CombatMath.offensiveMultiplier, me, atkSchool)
			if okOff and type(offMult) == "number" then
				mult *= offMult
			end
		end
	else
		local schoolDef = atkSchool and Schools and Schools.defs and Schools.defs[atkSchool]
		local statsTbl = defender.scaling or defender.derived
		if type(statsTbl) == "table" then
			local res = (statsTbl.AllResistance or statsTbl.allResistance or 0)
			if schoolDef and type(statsTbl[schoolDef.resistance]) == "number" then
				res += statsTbl[schoolDef.resistance]
			end
			mult *= math.clamp(1 - res, 0.2, 2.5)
		end
	end

	-- 2. Enemy damageModifiers (wards / elemental intake modifiers on defender)
	local dmgMods = defender.damageModifiers
	if type(dmgMods) == "table" and atkSchool then
		local hitType = (Schools and type(Schools.hitType) == "function" and Schools.hitType(nil, atkSchool)) or atkSchool
		local dm = dmgMods[hitType] or dmgMods[atkSchool]
		if type(dm) == "number" then
			mult *= dm
		end
	end

	-- 3. Active defender statuses (wards, shields/armor, Mirage evade, Vulnerable)
	for _, entry in ipairs(defender.statuses or {}) do
		local sid = (type(entry) == "table" and entry.id) or entry
		local st = type(sid) == "string" and mods.Statuses[sid]
		if st then
			if st.evadesNext then
				mult *= 0.05
			elseif type(st.damageTakenMultiplier) == "number" then
				mult *= st.damageTakenMultiplier
			elseif atkSchool and st.school == atkSchool and type(st.schoolTaken) == "number" then
				mult *= math.max(0.1, 1 - st.schoolTaken)
			elseif sid == "Vulnerable" then
				mult *= 1.25
			end
		end
	end

	return math.clamp(mult, 0.01, 3.5)
end

local function getAliveEnemies(mods, state, me)
	local enemies = {}
	for id, c in pairs(state.combatants) do
		if c.team ~= me.team and not c.isPet and mods.CombatSim.isAlive(c) then
			local hp = c.hp or 0
			local shield = tonumber(c.shield) or 0
			local ehp = math.max(1, hp + shield)
			local isBoss = isBossCombatant(mods, c, id)
			local evades = false
			for _, stEntry in ipairs(c.statuses or {}) do
				local sid = (type(stEntry) == "table" and stEntry.id) or stEntry
				local stDef = type(sid) == "string" and mods.Statuses[sid]
				if stDef and stDef.evadesNext then
					evades = true
					break
				end
			end
			table.insert(enemies, {
				id = id,
				combatant = c,
				name = c.name or c.enemyId or id,
				hp = hp,
				shield = shield,
				effectiveHp = ehp,
				isBoss = isBoss,
				evades = evades,
			})
		end
	end
	return enemies
end

local function evaluateAttackEntry(mods, state, me, entry, aliveEnemies)
	local base = entry.info.directDamage or 0
	if base <= 0 then
		return {
			totalDamage = 0,
			tacticalScore = 0,
			killCount = 0,
			wipesAll = false,
			killsBoss = false,
			bestEnemy = nil,
			bestEnemyDamage = 0,
			bestMult = 1,
		}
	end

	local atkSchool = entry.ability.school or me.school
	local isAoe = (entry.ability.targetKind == "AllEnemies")
	local totalEnemies = #aliveEnemies

	if isAoe then
		local totalDmg = 0
		local killCount = 0
		local killsBoss = false
		local overkill = 0
		for _, e in ipairs(aliveEnemies) do
			local mult = getElementMultiplier(mods, atkSchool, e.combatant, me)
			local dmg = base * mult
			totalDmg += math.min(dmg, e.effectiveHp * 1.15)
			overkill += math.max(0, dmg - e.effectiveHp)
			if not e.evades and dmg >= e.effectiveHp * 0.98 then
				killCount += 1
				if e.isBoss then
					killsBoss = true
				end
			end
		end
		local tactical = totalDmg - (overkill * 0.35)
		if killCount > 0 then
			tactical += killCount * 35
		end
		return {
			totalDamage = totalDmg > 0 and totalDmg or base,
			tacticalScore = tactical,
			killCount = killCount,
			wipesAll = (totalEnemies > 0 and killCount >= totalEnemies),
			killsBoss = killsBoss,
			bestEnemy = aliveEnemies[1],
			bestEnemyDamage = totalDmg,
			bestMult = 1,
			enemyCount = totalEnemies,
		}
	end

	local bestScore = -math.huge
	local bestEnemy = nil
	local bestDmg = 0
	local bestMult = 1
	local anyKill = false
	local killsBoss = false

	for _, e in ipairs(aliveEnemies) do
		local mult = getElementMultiplier(mods, atkSchool, e.combatant, me)
		local dmg = base * mult
		local canKill = (not e.evades) and (dmg >= e.effectiveHp * 0.98)
		if canKill then
			anyKill = true
			if e.isBoss then
				killsBoss = true
			end
		end

		local capped = math.min(dmg, e.effectiveHp * 1.15)
		local overkill = math.max(0, dmg - e.effectiveHp)
		local s = capped - (overkill * 0.65)
		if canKill then
			s += 60
		end
		if e.evades and (entry.ability.energyCost or 0) <= 1 then
			s += 30
		end
		if s > bestScore then
			bestScore = s
			bestEnemy = e
			bestDmg = dmg
			bestMult = mult
		end
	end

	return {
		totalDamage = bestDmg > 0 and bestDmg or base,
		tacticalScore = bestEnemy and bestScore or base,
		killCount = anyKill and 1 or 0,
		wipesAll = (totalEnemies == 1 and anyKill),
		killsBoss = killsBoss,
		bestEnemy = bestEnemy,
		bestEnemyDamage = bestDmg,
		bestMult = bestMult,
		enemyCount = totalEnemies,
	}
end

local function pickCheapestLethal(list)
	table.sort(list, function(a, b)
		local ca = a.entry.ability.energyCost or 0
		local cb = b.entry.ability.energyCost or 0
		if ca ~= cb then
			return ca < cb
		end
		return a.eval.tacticalScore > b.eval.tacticalScore
	end)
	return list[1].entry
end

local function isUsefulPowerUp(pu, handDamageSchools, targetSchool)
	local s = pu.info.powerUpSchool
	if not s then
		return true
	end
	if targetSchool and s == targetSchool then
		return true
	end
	return handDamageSchools[s] == true
end

local function pickAttackEntry(mods, state, me, usableEntries)
	local powerUps = {}
	local damagers = {}
	local handDamageSchools = {}
	local aliveEnemies = getAliveEnemies(mods, state, me)

	for _, entry in ipairs(usableEntries) do
		if entry.info.directDamage > 0 and not entry.info.preventsAction then
			entry._eval = evaluateAttackEntry(mods, state, me, entry, aliveEnemies)
			table.insert(damagers, entry)
			if entry.ability.school then
				handDamageSchools[entry.ability.school] = true
			end
		end
		if entry.info.isAttackPowerUp then
			table.insert(powerUps, entry)
		end
	end

	-- 1. Lethal Finish Override: immediately finish the fight / boss / free minion kill instead of wasting turns buffing or saving
	if #damagers > 0 then
		local wipes, bossKills, freeKills, singleKills = {}, {}, {}, {}
		for _, d in ipairs(damagers) do
			if d._eval.wipesAll then
				table.insert(wipes, { entry = d, eval = d._eval })
			elseif d._eval.killsBoss then
				table.insert(bossKills, { entry = d, eval = d._eval })
			elseif d._eval.killCount > 0 then
				local netCost = (d.ability.energyCost or 0) - (d.info.gainEnergyAmount or 0)
				if netCost <= 0 then
					table.insert(freeKills, { entry = d, eval = d._eval })
				end
				table.insert(singleKills, { entry = d, eval = d._eval })
			end
		end
		if #wipes > 0 then
			return pickCheapestLethal(wipes), nil
		end
		if #bossKills > 0 then
			return pickCheapestLethal(bossKills), nil
		end
		if #freeKills > 0 then
			return pickCheapestLethal(freeKills), nil
		end
		if #singleKills > 0 and not hasAliveBoss(mods, state, me) then
			return pickCheapestLethal(singleKills), nil
		end
	end

	-- 2. Smart Boss Pip Saver: save pips for 4+ pip boss nukes, stacking matching 0-cost/safe buffs first
	if hasAliveBoss(mods, state, me) then
		local maxCap = mods.CombatSim.maxEnergy(me) or 99
		local allReady = collectEntries(mods, state, me, true)
		local bossFinisher = nil
		for _, entry in ipairs(allReady) do
			local cost = entry.ability.energyCost or 0
			if entry.info.directDamage > 0 and not entry.info.preventsAction and cost >= CombatAuto.SavePipMinCost and cost <= maxCap then
				if not bossFinisher or entry.info.directDamage > bossFinisher.info.directDamage then
					bossFinisher = entry
				end
			end
		end

		if bossFinisher then
			local finisherCost = bossFinisher.ability.energyCost or 0
			local safePowerUps = {}
			for _, pu in ipairs(powerUps) do
				if isUsefulPowerUp(pu, handDamageSchools, bossFinisher.ability.school) then
					local puCost = pu.ability.energyCost or 0
					local netCost = puCost - (pu.info.gainEnergyAmount or 0)
					if netCost <= 0 or ((me.energy or 0) - netCost) >= finisherCost then
						table.insert(safePowerUps, pu)
					end
				end
			end

			if #safePowerUps > 0 then
				table.sort(safePowerUps, function(a, b)
					local aPure = (a.info.directDamage == 0) and 1 or 0
					local bPure = (b.info.directDamage == 0) and 1 or 0
					if aPure ~= bPure then
						return aPure > bPure
					end
					local aMatch = (a.info.powerUpSchool == bossFinisher.ability.school) and 1 or 0
					local bMatch = (b.info.powerUpSchool == bossFinisher.ability.school) and 1 or 0
					if aMatch ~= bMatch then
						return aMatch > bMatch
					end
					return (a.ability.energyCost or 0) < (b.ability.energyCost or 0)
				end)
				return safePowerUps[1], nil
			end

			if bossFinisher.payable then
				return bossFinisher, nil
			end

			-- Cannot afford the 4+ pip card yet and no safe power-ups to play -> save (pass turn)
			return nil, bossFinisher
		end
	end

	-- 3. Stack useful buffs (0-cost / matching school in hand) when no instant kill is available
	local usefulPowerUps = {}
	for _, pu in ipairs(powerUps) do
		if isUsefulPowerUp(pu, handDamageSchools, nil) and ((pu.ability.energyCost or 0) <= 1 or #damagers == 0) then
			table.insert(usefulPowerUps, pu)
		end
	end
	if #usefulPowerUps > 0 then
		table.sort(usefulPowerUps, function(a, b)
			local aPure = (a.info.directDamage == 0) and 1 or 0
			local bPure = (b.info.directDamage == 0) and 1 or 0
			if aPure ~= bPure then
				return aPure > bPure
			end
			local aMatch = (a.info.powerUpSchool and handDamageSchools[a.info.powerUpSchool]) and 1 or 0
			local bMatch = (b.info.powerUpSchool and handDamageSchools[b.info.powerUpSchool]) and 1 or 0
			if aMatch ~= bMatch then
				return aMatch > bMatch
			end
			return (a.ability.energyCost or 0) < (b.ability.energyCost or 0)
		end)
		return usefulPowerUps[1], nil
	end

	if #damagers > 0 then
		table.sort(damagers, function(a, b)
			local aScore = (a._eval and a._eval.tacticalScore) or a.info.directDamage
			local bScore = (b._eval and b._eval.tacticalScore) or b.info.directDamage
			if math.abs(aScore - bScore) > 0.5 then
				return aScore > bScore
			end
			local aAoe = (a.ability.targetKind == "AllEnemies" and #aliveEnemies >= 2) and 1 or 0
			local bAoe = (b.ability.targetKind == "AllEnemies" and #aliveEnemies >= 2) and 1 or 0
			if aAoe ~= bAoe then
				return aAoe > bAoe
			end
			return (a.ability.energyCost or 0) < (b.ability.energyCost or 0)
		end)
		return damagers[1], nil
	end

	return nil, nil
end

local function getCombatantDebuffCount(Statuses, c)
	local count = 0
	for _, entry in ipairs(c.statuses or {}) do
		local sid = (type(entry) == "table" and entry.id) or entry
		local st = type(sid) == "string" and Statuses[sid]
		if st and not st.cleanseProof and (
			st.isDot == true
			or hasStatusTag(st, "Debuff")
			or hasStatusTag(st, "Curse")
			or hasStatusTag(st, "DoT")
			or hasStatusTag(st, "Control")
		) then
			count += 1
		end
	end
	return count
end

local function getTeamHealthInfo(mods, state, me, lowThreshold)
	local CombatSim = mods.CombatSim
	local Statuses = mods.Statuses
	local lowestRatio = 1
	local lowestId = nil
	local hurtCount = 0
	local multiHurtCount = 0
	local lowCount = 0
	local revivableCount = 0
	local hasDebuff = false
	local debuffedId = nil
	local bestDebuffScore = -1
	local debuffedCount = 0
	local unshieldedId = nil
	local bestShieldScore = math.huge
	local threshold = lowThreshold or 0.50

	for id, c in pairs(state.combatants) do
		if c.team == me.team and not c.isPet then
			if CombatSim.revivable(c) then
				revivableCount += 1
			elseif CombatSim.isAlive(c) then
				local maxHp = (c.derived and c.derived.maxHp) or c.maxHp or 100
				local ratio = (c.hp or maxHp) / math.max(1, maxHp)
				if ratio < lowestRatio or (ratio == lowestRatio and id == me.id) then
					lowestRatio = ratio
					lowestId = id
				end
				if ratio < 0.99 then
					hurtCount += 1
				end
				if ratio < 0.85 then
					multiHurtCount += 1
				end
				if ratio <= threshold then
					lowCount += 1
				end

				local shieldVal = tonumber(c.shield) or 0
				local shieldRank = shieldVal * 1000 + ratio
				if shieldRank < bestShieldScore then
					bestShieldScore = shieldRank
					unshieldedId = id
				end

				local debuffs = getCombatantDebuffCount(Statuses, c)
				if debuffs > 0 then
					hasDebuff = true
					debuffedCount += 1
					local debuffScore = debuffs * 10 + (1 - ratio) + (id == me.id and 0.01 or 0)
					if debuffScore > bestDebuffScore then
						bestDebuffScore = debuffScore
						debuffedId = id
					end
				end
			end
		end
	end

	return {
		lowestRatio = lowestRatio,
		lowestId = lowestId,
		hurtCount = hurtCount,
		multiHurtCount = multiHurtCount,
		lowCount = lowCount,
		revivableCount = revivableCount,
		hasDebuff = hasDebuff,
		debuffedId = debuffedId,
		debuffedCount = debuffedCount,
		unshieldedId = unshieldedId,
	}
end

local function pickEmergencyHealEntry(mods, state, me, entries, threshold)
	local healthInfo = getTeamHealthInfo(mods, state, me, threshold)
	if healthInfo.revivableCount == 0 and healthInfo.lowestRatio > threshold then
		return nil
	end

	local needTeammate = (healthInfo.lowestId ~= nil and healthInfo.lowestId ~= me.id)
	local candidates = {}

	for _, entry in ipairs(entries) do
		local info = entry.info
		if info.healScore > 0 then
			local canTargetNeed = false
			if healthInfo.revivableCount > 0 then
				canTargetNeed = info.revivesAlly == true
			elseif needTeammate then
				canTargetNeed = info.healsTeammates == true
			else
				canTargetNeed = info.healsSelf == true
			end

			if canTargetNeed then
				local score = info.healScore
				score += (info.directDamage == 0) and 2000 or 500
				if entry.ability.targetKind == "AllAllies" and (healthInfo.lowCount >= 2 or healthInfo.hurtCount >= 2) then
					score += 600
				end
				if healthInfo.revivableCount > 0 and info.revivesAlly then
					score += 5000
				end
				table.insert(candidates, { entry = entry, score = score })
			end
		end
	end

	if #candidates == 0 then
		return nil
	end
	table.sort(candidates, function(a, b)
		return a.score > b.score
	end)
	return candidates[1].entry
end

local function pickSupportEntry(mods, state, me, entries)
	local healthInfo = getTeamHealthInfo(mods, state, me)
	local needsHeal = (healthInfo.lowestRatio < 0.99)
	local candidates = {}

	for _, entry in ipairs(entries) do
		if entry.info.isSupport then
			local info = entry.info
			local ab = entry.ability
			local score = 0

			-- 1. Revive downed party members first
			if healthInfo.revivableCount > 0 and info.revivesAlly then
				score += 20000
			end

			-- 2. Cleanse whenever self or any teammate has a debuff
			if info.hasCleanse and healthInfo.hasDebuff then
				score += 8000
				if ab.targetKind == "AllAllies" and healthInfo.debuffedCount >= 2 then
					score += 600
				end
			end

			-- 3. Heal the lowest-HP player when anyone needs healing
			if info.healScore > 0 and needsHeal then
				score += 4000 + info.healScore
				if ab.targetKind == "AllAllies" and (healthInfo.multiHurtCount >= 2 or healthInfo.hurtCount >= 2) then
					score += 500
				end
			end

			-- 4. Always use shields & defensive buffs (especially when no player needs healing)
			if info.shieldScore > 0 then
				score += 2500 + info.shieldScore
			end
			if info.hasDefenseBuff then
				score += 2000
			end

			-- 5. Energy & offensive buffs
			if info.hasEnergyGain then
				score += 1000
			end
			if info.isAttackPowerUp then
				score += 800
			end

			if ab.targetKind == "AllAllies" and score > 0 then
				score += 40
			end

			-- Do not waste pure heals if everyone is full HP and no debuff needs cleansing
			if score > 0 then
				table.insert(candidates, { entry = entry, score = score })
			end
		end
	end

	if #candidates == 0 then
		return nil
	end
	table.sort(candidates, function(a, b)
		return a.score > b.score
	end)
	return candidates[1].entry
end

local function pickTargetId(mods, state, me, ability, info, preferMode)
	local CombatSim = mods.CombatSim
	local targetKind = ability.targetKind
	local mode = preferMode or CombatAuto.Style

	if targetKind == "SingleEnemy" or (targetKind == "SingleAny" and mode == "Attack") then
		local bestEnemy = nil
		local bestScore = nil
		local bestMeta = nil
		local atkSchool = ability.school or me.school
		local directDmg = (info and info.directDamage) or 0
		for id, c in pairs(state.combatants) do
			if c.team ~= me.team and not c.isPet and CombatSim.isAlive(c) then
				local hp = c.hp or 0
				local shield = tonumber(c.shield) or 0
				local maxHp = (c.derived and c.derived.maxHp) or hp
				local isBoss = isBossCombatant(mods, c, id)
				local mult = getElementMultiplier(mods, atkSchool, c, me)
				local projDmg = directDmg * mult
				local canKill = (directDmg > 0) and (projDmg >= (hp + shield) * 0.98)
				local score
				if CombatAuto.TargetPriority == "Highest HP" then
					score = -(hp + shield) / math.max(0.05, mult)
				elseif CombatAuto.TargetPriority == "Boss First" then
					score = (isBoss and -10000000 or 0) - maxHp + ((hp + shield) / math.max(0.05, mult) * 0.01)
				elseif CombatAuto.TargetPriority == "Lowest HP" then
					score = hp + shield
				else
					-- Smart Effective: picks easiest kill / most effective element against 2-3 enemies
					score = (hp + shield) / math.max(0.05, mult)
					if canKill then
						score -= 100000 - math.max(0, projDmg - (hp + shield))
					end
				end
				if not bestScore or score < bestScore then
					bestScore = score
					bestEnemy = id
					bestMeta = {
						name = c.name or c.enemyId or id,
						mult = mult,
						isKill = canKill,
					}
				end
			end
		end
		return bestEnemy, bestMeta
	end

	if targetKind == "SingleAlly" or (targetKind == "SingleAny" and mode == "Support") then
		local healthInfo = getTeamHealthInfo(mods, state, me)
		local pickedId = nil
		if info.revivesAlly and healthInfo.revivableCount > 0 then
			for id, c in pairs(state.combatants) do
				if c.team == me.team and not c.isPet and CombatSim.revivable(c) then
					pickedId = id
					break
				end
			end
		elseif info.hasCleanse and healthInfo.debuffedId and (info.healScore == 0 or healthInfo.lowestRatio >= 0.99) then
			pickedId = healthInfo.debuffedId
		elseif info.healScore > 0 and healthInfo.lowestId then
			pickedId = healthInfo.lowestId
		elseif info.shieldScore > 0 and (healthInfo.unshieldedId or healthInfo.lowestId) then
			pickedId = healthInfo.unshieldedId or healthInfo.lowestId
		else
			pickedId = healthInfo.lowestId or me.id
		end
		local ally = pickedId and state.combatants[pickedId]
		local allyName = (pickedId == me.id and "me") or (ally and ally.name) or pickedId
		return pickedId, { name = allyName, mult = 1, isKill = false }
	end

	return nil, nil
end

local function tryAutoDiscard(mods, state, me)
	local turnKey = tostring(state.round or 0) .. ":" .. tostring(state.turnIndex or 0)
	if CombatAuto.LastDiscardTurnKey == turnKey then
		return false
	end
	local hand = me.hand or {}
	if #hand == 0 then
		return false
	end

	local toDiscard = {}
	for slot, abilityId in ipairs(hand) do
		local ab = mods.Abilities[abilityId]
		if ab then
			local info = analyzeAbility(mods, ab, me.energy or 0)
			local isBrick = false
			if CombatAuto.Style == "Attack" then
				isBrick = (info.directDamage == 0 and not info.isAttackPowerUp)
			else
				isBrick = (not info.isSupport)
			end
			if isBrick or not mods.CombatSim.canPay(me, ab) then
				table.insert(toDiscard, { abilityId = abilityId, slot = slot })
				if #toDiscard >= 2 then
					break
				end
			end
		end
	end

	if #toDiscard == 0 then
		return false
	end

	CombatAuto.LastDiscardTurnKey = turnKey
	mods.Net.fireServer("SubmitAction", {
		kind = mods.Enums.ActionKind.Discard,
		cards = toDiscard,
		targetIds = {},
		seen = mods.CombatUI.shownHandVersion(),
	})
	setCombatStatus("DISCARD · " .. tostring(#toDiscard) .. " BRICKS")
	return true
end

local function runCombatStep()
	if not CombatAuto.Enabled or CombatAuto.Busy then
		return
	end
	if (os.clock() - CombatAuto.LastActionAt) < 0.45 then
		return
	end

	local mods = getGameMods()
	if not mods then
		setCombatStatus("ERR · " .. tostring(GameModsError or "MODS"))
		return
	end

	local state, myId, snapStatus = getCombatSnapshot(mods)
	if not state or not myId then
		if snapStatus == "ENEMY TURN" then
			setCombatStatus("WAIT · ENEMY TURN")
		elseif snapStatus == "BUSY / ANIM" then
			setCombatStatus("WAIT · ANIMATING")
		elseif snapStatus == "SYNCING" then
			setCombatStatus("WAIT · SYNCING STATE")
		end
		return
	end

	local me = state.combatants[myId]
	local entries = collectEntries(mods, state, me, false)

	local chosen
	local savingForCard = nil
	local usedEmergencyHeal = false
	if CombatAuto.AutoHeal then
		chosen = pickEmergencyHealEntry(mods, state, me, entries, CombatAuto.HealThreshold)
		if chosen then
			usedEmergencyHeal = true
		end
	end

	if not chosen then
		if CombatAuto.Style == "Attack" then
			chosen, savingForCard = pickAttackEntry(mods, state, me, entries)
		else
			chosen = pickSupportEntry(mods, state, me, entries)
		end
	end

	CombatAuto.Busy = true
	local ok, err = pcall(function()
		local CombatUI = mods.CombatUI
		if chosen then
			local targetMode = usedEmergencyHeal and "Support" or CombatAuto.Style
			local targetId, targetMeta = pickTargetId(mods, state, me, chosen.ability, chosen.info, targetMode)
			local used = CombatUI.use(chosen.id, chosen.slot)
			if used and CombatUI.isAiming() then
				if targetId then
					CombatUI.aimAt(targetId)
				end
				if CombatUI.isAiming() then
					local aimable = CombatUI.aimableNow()
					if aimable and aimable[1] then
						CombatUI.aimAt(aimable[1])
					else
						CombatUI.stopAiming()
					end
				end
			elseif not used then
				-- Direct SubmitAction fallback if CombatUI.use refused due to UI/split-VM state
				local tk = chosen.ability.targetKind
				local needsTarget = (tk == "SingleEnemy" or tk == "SingleAlly" or tk == "SingleAny")
				local targets = (needsTarget and targetId) and { targetId } or {}
				mods.Net.fireServer("SubmitAction", {
					kind = mods.Enums.ActionKind.Ability,
					abilityId = chosen.id,
					slot = (chosen.slot and chosen.slot > 0) and chosen.slot or nil,
					fromTalents = (chosen.slot == -1) and true or nil,
					targetIds = targets,
				})
				CombatAuto.LastActionAt = os.clock() + 0.85
			end
			local cardName = chosen.ability.name or chosen.id
			local ev = chosen._eval
			if usedEmergencyHeal then
				local who = (targetMeta and targetMeta.name) and (" -> " .. tostring(targetMeta.name)) or ""
				setCombatStatus("HEAL · " .. cardName .. who)
			elseif chosen.ability.targetKind == "AllEnemies" then
				local cnt = (ev and ev.enemyCount) or 1
				local tag = (ev and ev.wipesAll) and "KILL AOE · " or "AOE · "
				setCombatStatus(string.format("%s%s (x%d)", tag, cardName, cnt))
			elseif targetMeta and targetMeta.name then
				local tag = targetMeta.isKill and "KILL · " or "CAST · "
				local multNote = ""
				if targetMeta.mult and math.abs(targetMeta.mult - 1) >= 0.05 then
					multNote = string.format(" (%.2fx)", targetMeta.mult)
				end
				setCombatStatus(tag .. cardName .. " -> " .. tostring(targetMeta.name) .. multNote)
			else
				setCombatStatus("CAST · " .. cardName)
			end
		elseif savingForCard then
			if mods.CombatSim.mayPass(me) then
				CombatUI.passTurn()
				if CombatUI.canAct() then
					mods.Net.fireServer("SubmitAction", { kind = mods.Enums.ActionKind.Pass, targetIds = {} })
				end
				setCombatStatus("SAVING PIPS · " .. (savingForCard.ability.name or savingForCard.id))
			else
				setCombatStatus("SAVING PIPS · WAIT")
			end
		elseif CombatAuto.AutoDiscard and tryAutoDiscard(mods, state, me) then
			return
		elseif CombatAuto.AutoPass and mods.CombatSim.mayPass(me) then
			CombatUI.passTurn()
			if CombatUI.canAct() then
				mods.Net.fireServer("SubmitAction", { kind = mods.Enums.ActionKind.Pass, targetIds = {} })
			end
			setCombatStatus("PASSED · NO MATCH")
		else
			setCombatStatus("WAITING · NO MATCH")
		end
	end)
	if CombatAuto.LastActionAt < os.clock() then
		CombatAuto.LastActionAt = os.clock()
	end
	CombatAuto.Busy = false

	if not ok then
		setCombatStatus("ERR · " .. tostring(err))
	end
end

-- Auto Trivia Solver, Live Combat State & Boss Discovery Hooks
local triviaLookup = {}
local function rebuildTriviaLookup(mods)
	table.clear(triviaLookup)
	for _, entry in ipairs(mods.Trivia or {}) do
		if type(entry.q) == "string" and type(entry.a) == "string" then
			triviaLookup[entry.q] = entry.a
			triviaLookup[string.lower((string.gsub(entry.q, "%s+", " ")))] = entry.a
		end
	end
end

task.spawn(function()
	local mods = getGameMods()
	if not mods or not State.Alive then
		return
	end

	rebuildTriviaLookup(mods)

	trackConnection(mods.Net.onClientEvent("CombatStarted", function(data)
		if not State.Alive or type(data) ~= "table" then
			return
		end
		if type(data.state) == "table" then
			LiveCombat.State = data.state
			LiveCombat.MyId = findMyCombatantId(data.state)
		end
		if type(data.boss) == "table" and type(data.boss.id) == "string" then
			LiveBossIds[data.boss.id] = true
			if mods.BossEnemyIds then
				mods.BossEnemyIds[data.boss.id] = true
			end
		end
	end))

	trackConnection(mods.Net.onClientEvent("CombatEvents", function(data)
		if not State.Alive or type(data) ~= "table" then
			return
		end
		if type(data.state) == "table" then
			LiveCombat.State = data.state
			LiveCombat.MyId = LiveCombat.MyId or findMyCombatantId(data.state)
		end
		if data.ended then
			LiveCombat.State = nil
			LiveCombat.TurnActorId = nil
		end
	end))

	trackConnection(mods.Net.onClientEvent("HandDealt", function(data)
		if not State.Alive or type(data) ~= "table" or not LiveCombat.State then
			return
		end
		local myId = LiveCombat.MyId or findMyCombatantId(LiveCombat.State)
		if myId and LiveCombat.State.combatants and LiveCombat.State.combatants[myId] and type(data.hand) == "table" then
			LiveCombat.State.combatants[myId].hand = table.clone(data.hand)
		end
	end))

	trackConnection(mods.Net.onClientEvent("TurnChanged", function(data)
		if not State.Alive or type(data) ~= "table" then
			return
		end
		LiveCombat.TurnActorId = data.secondsRemaining and data.actorId or nil
	end))

	local function clearLiveCombat()
		LiveCombat.State = nil
		LiveCombat.MyId = nil
		LiveCombat.TurnActorId = nil
	end
	trackConnection(mods.Net.onClientEvent("CombatEnded", clearLiveCombat))
	trackConnection(mods.Net.onClientEvent("ArenaCleared", clearLiveCombat))
	trackConnection(mods.Net.onClientEvent("ArenaExited", clearLiveCombat))

	trackConnection(mods.Net.onClientEvent("TriviaAsk", function(payload)
		if not State.Alive or not CombatAuto.AutoTrivia or type(payload) ~= "table" then
			return
		end
		task.delay(0.35, function()
			if not State.Alive or not CombatAuto.AutoTrivia then
				return
			end
			if payload.choosing then
				mods.Net.fireServer("TriviaVote", { choice = 1 })
				setCombatStatus("TRIVIA · VOTED TOPIC")
				return
			end
			local q = tostring(payload.question or "")
			local answer = triviaLookup[q] or triviaLookup[string.lower((string.gsub(q, "%s+", " ")))]
			if answer and type(payload.options) == "table" then
				for idx, opt in ipairs(payload.options) do
					if opt == answer or string.lower(tostring(opt)) == string.lower(answer) then
						mods.Net.fireServer("TriviaVote", { choice = idx })
						setCombatStatus("TRIVIA · " .. tostring(answer))
						return
					end
				end
			end
		end)
	end))
end)

