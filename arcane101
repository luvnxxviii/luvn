GeneralTab:AddSection("Protection")

local antiAfkStatus

local function updateAntiAfkReadout()
	if not antiAfkStatus then
		return
	end
	if not AntiAFK.Enabled then
		antiAfkStatus:Set("PAUSED · " .. tostring(AntiAFK.BlockedCount) .. " blocked")
		Window:SetStatus("ANTI-AFK · PAUSED")
	else
		local elapsed = math.floor(os.clock() - AntiAFK.StartedAt)
		antiAfkStatus:Set(string.format("%02dm %02ds · %d blocked", math.floor(elapsed / 60), elapsed % 60, AntiAFK.BlockedCount))
		Window:SetStatus("ANTI-AFK · ACTIVE")
	end
end

local function setAntiAfkEnabled(enabled)
	AntiAFK.Enabled = enabled
	if AntiAFK.IdledConn then
		pcall(function()
			AntiAFK.IdledConn:Disconnect()
		end)
		AntiAFK.IdledConn = nil
	end
	if enabled then
		AntiAFK.StartedAt = os.clock()
		AntiAFK.IdledConn = trackConnection(LocalPlayer.Idled:Connect(function()
			if not State.Alive or not AntiAFK.Enabled then
				return
			end
			sendVirtualNudge()
			AntiAFK.BlockedCount += 1
			updateAntiAfkReadout()
		end))
	end
	updateAntiAfkReadout()
end

