end)

local function buildMinigameRun(mods, gameName)
	local sys = mods.MinigamesSys
	if gameName == "PotionMatch" then
		return 4.2, { brewed = 120, moves = 8, best = 12 }
	elseif gameName == "GhostMaze" then
		return 6.2, { snacks = 12 }
	elseif gameName == "TowerTopple" then
		return 7.0, { shots = 3, down = sys.towerBlocks() }
	elseif gameName == "PetCannon" then
		return 9.2, { shots = 5, score = 15 }
	elseif gameName == "PetDance" then
		return 15.2, { played = 5, passed = 5 }
	elseif gameName == "SnackCatch" then
		return 20.0, { score = 72 }
	elseif gameName == "BeatBubbles" then
		local n = sys.beatNotes()
		local song = sys.beatSong()
		return song * 0.95, { great = n, good = 0, ok = 0, miss = 0 }
	end
	-- Fallback for newly added minigames using live spec table
	local okSpec, spec = pcall(sys.spec, gameName)
	if okSpec and type(spec) == "table" then
		local waitTime = math.max(5, math.min(25, (spec.SECONDS or 15) * 0.45))
		return waitTime, { score = (spec.PERFECT or 100), played = (spec.ROUNDS or 5), passed = (spec.ROUNDS or 5) }
	end
	return 8.0, {}
end

local function playCarnivalOnce(gameName)
	local mods = getGameMods()
	if not mods then
		setCarnivalStatus("ERR · MODULES NOT READY")
		return false
	end

	local spots = mods.NewLandsSpots
	local booth = spots and spots.booths and spots.booths[gameName]
	if booth and booth.stand and booth.stand.p then
		teleportToPosition(booth.stand.p)
		task.wait(0.25)
	end

	setCarnivalStatus("STARTING · " .. gameName)
	local okStart, startRes = pcall(function()
		return mods.Net.func("MinigameStart"):InvokeServer({ game = gameName, difficulty = "Normal" })
	end)
	if not okStart or type(startRes) ~= "table" or not startRes.ok then
		local reason = type(startRes) == "table" and tostring(startRes.reason) or "Failed"
		setCarnivalStatus("BLOCKED · " .. reason)
		return false
	end

	local waitSec, resultPayload = buildMinigameRun(mods, gameName)
	local startedAt = os.clock()
	while State.Alive and (os.clock() - startedAt) < waitSec do
		setCarnivalStatus(string.format("%s · %.1fs", gameName, waitSec - (os.clock() - startedAt)))
		task.wait(0.25)
		if not CarnivalAuto.Farming and not State.Alive then
			return false
		end
	end

	if not State.Alive then
		return false
	end

	local okEnd, endRes = pcall(function()
		return mods.Net.func("MinigameEnd"):InvokeServer({ game = gameName, result = resultPayload })
	end)
	if okEnd and type(endRes) == "table" and endRes.ok ~= false then
		CarnivalAuto.RunsCompleted += 1
		setCarnivalStatus("DONE (" .. tostring(CarnivalAuto.RunsCompleted) .. ") · " .. tostring(endRes.grade or "OK"))
		return true
	end
	local reason = type(endRes) == "table" and tostring(endRes.reason) or "Rejected"
	setCarnivalStatus("END ERR · " .. reason)
	return false
end

