				return
			end
			local cand, plan = findBestUpgradePlan(mods, profile)
			if not cand or not plan then
				upgradeReadyCard:Set("No ready armor/charm/pet (maxed or need fuel/gold)")
				setGearStatus("NO READY UPGRADE")
				return
			end
			pcall(function()
