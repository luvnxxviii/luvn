				}, TweenSmooth)
			end

			local function selectValue(opt, silent)
				current = opt
				valueLabel.Text = tostring(opt)
				for name, btn in pairs(optionBtns) do
					local active = (name == opt)
					tween(btn, {
						BackgroundColor3 = active and Theme.Accent or Theme.Bg,
						BackgroundTransparency = active and 0 or 0.35,
						TextColor3 = active and Theme.AccentText or Theme.TextSecondary,
					})
				end
				if not silent and callback then
					task.spawn(callback, opt)
				end
			end

			local function rebuildOptions(newOptions)
				options = newOptions or {}
				for _, child in ipairs(listHolder:GetChildren()) do
					if child:IsA("TextButton") then
						child:Destroy()
					end
				end
				table.clear(optionBtns)

				local visibleRows = math.min(#options, 5)
				listHeight = (visibleRows * rowH) + (math.max(0, visibleRows - 1) * 4) + (listPad * 2)
				expandedHeight = headerH + listHeight + 2
				listHolder.Size = UDim2.new(1, -16, 0, listHeight)

				for idx, opt in ipairs(options) do
					local optBtn = create("TextButton", {
						LayoutOrder = idx,
						Size = UDim2.new(1, 0, 0, rowH),
						BackgroundColor3 = Theme.Bg,
						BackgroundTransparency = 0.35,
						Text = "  " .. tostring(opt),
						Font = Enum.Font.GothamMedium,
						TextSize = 11,
						TextColor3 = Theme.TextSecondary,
						TextXAlignment = Enum.TextXAlignment.Left,
						AutoButtonColor = false,
						Parent = listHolder,
					}, {
						create("UICorner", { CornerRadius = UDim.new(0, 7) }),
					})

					optionBtns[opt] = optBtn

					trackConnection(optBtn.MouseEnter:Connect(function()
						if current ~= opt then
							tween(optBtn, { BackgroundTransparency = 0, TextColor3 = Theme.TextPrimary })
						end
					end))
					trackConnection(optBtn.MouseLeave:Connect(function()
						if current ~= opt then
							tween(optBtn, { BackgroundTransparency = 0.35, TextColor3 = Theme.TextSecondary })
						end
					end))
					trackConnection(optBtn.MouseButton1Click:Connect(function()
						selectValue(opt, false)
						setExpanded(false)
					end))
				end

				if expanded then
					card.Size = UDim2.new(1, 0, 0, expandedHeight)
				end
			end

			rebuildOptions(options)

			trackConnection(topBtn.MouseEnter:Connect(function()
				tween(card, { BackgroundColor3 = Theme.SurfaceHover })
			end))
			trackConnection(topBtn.MouseLeave:Connect(function()
				tween(card, { BackgroundColor3 = Theme.Surface })
			end))
			trackConnection(topBtn.MouseButton1Click:Connect(function()
				setExpanded(not expanded)
			end))

			selectValue(current, true)

			return {
				Set = function(_, opt, silent)
					selectValue(opt, silent)
				end,
				SetOptions = function(_, newOptions, newDefault)
					rebuildOptions(newOptions)
					local target = newDefault
					if not target or not optionBtns[target] then
						target = optionBtns[current] and current or newOptions[1]
					end
					if target ~= nil then
						selectValue(target, true)
					end
				end,
				Get = function()
					return current
				end,
			}
		end

		return tabObj
	end

	return Window
end

--// Shared Arcane 101 Module Loader (Auto-Discovers Live Game Data)
local GameMods
local GameModsError = nil
local LiveBossIds = {}

local function safeRequire(inst)
	if not inst then
		return nil
	end
	local ok, mod = pcall(require, inst)
	if ok then
		return mod
	end
	return nil
end

local function countKeys(tbl)
	local n = 0
	if type(tbl) == "table" then
		for _ in pairs(tbl) do
			n += 1
		end
	end
	return n
end

local function getGameMods(forceReload)
	if GameMods and not forceReload then
		return GameMods
	end
	local ok, result = pcall(function()
		local Campaign = ReplicatedStorage:WaitForChild("Campaign", 5)
		local playerScripts = LocalPlayer:WaitForChild("PlayerScripts", 5)
		local client = playerScripts:WaitForChild("CampaignClient", 5)

		local Areas = safeRequire(Campaign.Data:FindFirstChild("Areas")) or {}
		local Enemies = safeRequire(Campaign.Data:FindFirstChild("Enemies"))
		local Carnival = safeRequire(Campaign.Data:FindFirstChild("Carnival")) or {}
		local Version = safeRequire(Campaign.Shared:FindFirstChild("Version"))
		local Build = safeRequire(Campaign.Shared:FindFirstChild("Build"))

		local bossEnemyIds = {}
		for k, v in pairs(LiveBossIds) do
			bossEnemyIds[k] = v
		end
		for _, area in pairs(Areas) do
			if type(area) == "table" and type(area.boss) == "table" then
				if type(area.boss.enemyId) == "string" then
					bossEnemyIds[area.boss.enemyId] = true
				end
				if type(area.boss.with) == "table" then
					for _, subId in ipairs(area.boss.with) do
						if type(subId) == "string" then
							bossEnemyIds[subId] = true
						end
					end
				end
				if type(area.boss.pair) == "table" then
					for _, subId in ipairs(area.boss.pair) do
						if type(subId) == "string" then
							bossEnemyIds[subId] = true
						end
					end
				end
			end
		end
		if type(Enemies) == "table" then
			for id, e in pairs(Enemies) do
				if type(e) == "table" and (e.isBoss == true or e.boss == true or e.kind == "Boss" or e.tier == "Boss") then
					bossEnemyIds[id] = true
				end
			end
		end

		local Abilities = require(Campaign.Data.Abilities)
		local Statuses = require(Campaign.Data.Statuses)
		local Items = safeRequire(Campaign.Data:FindFirstChild("Items")) or {}
		local Encounters = safeRequire(Campaign.Data:FindFirstChild("Encounters")) or {}
		local Trivia = safeRequire(Campaign.Data:FindFirstChild("Trivia")) or {}
		local NewLandsSpots = safeRequire(Campaign.Data:FindFirstChild("NewLandsSpots")) or {}

		local rawNet = require(Campaign.Shared.Net)
		-- Game's Net.getProfile() leaves its in-flight waiter lock wedged forever if a caller thread is cancelled (e.g. Unload).
		-- Replace it in mods.Net with a detached InvokeServer wrapper + timeout + ProfileChanged cache.
		local profCache, profCacheAt = nil, -math.huge
		local profInFlight = nil
		trackConnection(rawNet.onClientEvent("ProfileChanged", function(p)
			if type(p) == "table" and (p.equipped ~= nil or p.inventory ~= nil or p.decks ~= nil) then
				profCache = p
				profCacheAt = os.clock()
			end
		end))
		local function fetchProfileSafe()
			if profCache ~= nil and (os.clock() - profCacheAt) < 0.5 then
				return profCache
			end
			if not profInFlight then
				local job = { done = false, ok = false, res = nil }
				profInFlight = job
				task.spawn(function()
					local okP, resP = pcall(function()
						return rawNet.func("GetProfile"):InvokeServer()
					end)
					job.ok = okP and type(resP) == "table"
					job.res = job.ok and resP or nil
					if job.ok then
						profCache = resP
						profCacheAt = os.clock()
					end
					job.done = true
					if profInFlight == job then
						profInFlight = nil
					end
				end)
			end
			local job = profInFlight
			local t0 = os.clock()
			while job and not job.done and (os.clock() - t0) < 3.0 do
				task.wait(0.05)
			end
			if job and job.ok then
				return job.res
			end
			return profCache
		end
		local safeNet = setmetatable({
			getProfile = fetchProfileSafe,
			peekProfile = function()
				if not profCache and not profInFlight then
					task.spawn(fetchProfileSafe)
				end
				return profCache
			end,
		}, { __index = rawNet })

		return {
			Campaign = Campaign,
			Net = safeNet,
			Enums = require(Campaign.Shared.Enums),
			Abilities = Abilities,
			Statuses = Statuses,
			Enemies = Enemies or {},
			Items = Items,
			Encounters = Encounters,
			Trivia = Trivia,
			Carnival = Carnival,
			NewLandsSpots = NewLandsSpots,
			BossEnemyIds = bossEnemyIds,
			VersionId = (type(Version) == "table" and Version.id) or (Build and tostring(Build)) or "?",
			Stats = {
				Abilities = countKeys(Abilities),
				Bosses = countKeys(bossEnemyIds),
				Trivia = #Trivia,
				Encounters = countKeys(Encounters),
				Items = countKeys(Items),
			},
			CombatSim = require(Campaign.Systems.CombatSim),
			CombatMath = safeRequire(Campaign.Systems:FindFirstChild("CombatMath")),
			CardTiers = safeRequire(Campaign.Systems:FindFirstChild("CardTiers")),
			Deck = safeRequire(Campaign.Systems:FindFirstChild("Deck")),
			Loadout = safeRequire(Campaign.Systems:FindFirstChild("Loadout")),
			Inventory = safeRequire(Campaign.Systems:FindFirstChild("Inventory")),
			CharacterStats = safeRequire(Campaign.Systems:FindFirstChild("CharacterStats")),
			LevelGate = safeRequire(Campaign.Systems:FindFirstChild("LevelGate")),
			Talents = safeRequire(Campaign.Systems:FindFirstChild("Talents")),
			TalentPaths = safeRequire(Campaign.Data:FindFirstChild("TalentPaths")),
			TalentDefs = safeRequire(Campaign.Data:FindFirstChild("Talents")),
			Trainers = safeRequire(Campaign.Data:FindFirstChild("Trainers")),
			SeraphTrade = safeRequire(Campaign.Systems:FindFirstChild("SeraphTrade")),
			Upgrade = safeRequire(Campaign.Systems:FindFirstChild("Upgrade")),
			WeaponUpgrade = safeRequire(Campaign.Systems:FindFirstChild("WeaponUpgrade")),
			Reforge = safeRequire(Campaign.Systems:FindFirstChild("Reforge")),
			Trade = safeRequire(Campaign.Systems:FindFirstChild("Trade")),
			Hatch = safeRequire(Campaign.Systems:FindFirstChild("Hatch")),
			PetLevels = safeRequire(Campaign.Systems:FindFirstChild("PetLevels")),
			Shop = safeRequire(Campaign.Systems:FindFirstChild("Shop")),
			Schools = safeRequire(Campaign.Shared:FindFirstChild("Schools")),
			StatsMod = safeRequire(Campaign.Shared:FindFirstChild("Stats")),
			Constants = safeRequire(Campaign.Shared:FindFirstChild("Constants")),
			Areas = Areas,
			BossChests = safeRequire(Campaign.Data:FindFirstChild("BossChests")) or {},
			Recipes = safeRequire(Campaign.Data:FindFirstChild("Recipes")) or {},
			MountDrops = safeRequire(Campaign.Data:FindFirstChild("MountDrops")) or {},
			Seraph = safeRequire(Campaign.Data:FindFirstChild("Seraph")) or {},
			RetiredItems = safeRequire(Campaign.Data:FindFirstChild("RetiredItems")) or {},
			Quests = safeRequire(Campaign.Data:FindFirstChild("Quests")) or {},
			Races = safeRequire(Campaign.Data:FindFirstChild("Races")) or {},
			MinigamesSys = safeRequire(Campaign.Systems:FindFirstChild("Minigames")),
			CombatUI = require(client.UI.CombatUI),
			Place = safeRequire(client:FindFirstChild("Place")),
			Vfx = safeRequire(client.Effects and client.Effects:FindFirstChild("Vfx")),
			Cinema = safeRequire(client.Effects and client.Effects:FindFirstChild("Cinema")),
		}
	end)
	if ok and result then
		GameMods = result
		GameModsError = nil
		return GameMods
	end
	GameModsError = tostring(result)
	return nil
end

