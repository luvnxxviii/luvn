local function priorityOptionMatches(opt, kind, hpRatio)
	if opt == "Heal (Always)" then
		return kind == "ShortRest"
	elseif opt == "Heal (Below HP%)" then
		return kind == "ShortRest" and hpRatio <= DungeonAuto.RestThreshold
	elseif opt == "Loot" then
		return kind == "Scavenge"
	elseif opt == "Fight" then
		return kind == "Fight"
	elseif opt == "Events" then
		return kind == "Dialogue" or kind == "StatCheck" or kind == "Quest"
	elseif opt == "Shop" then
		return kind == "Shop" or kind == "Merchant"
	elseif opt == "Continue" then
		return kind == "Continue"
	end
	return false
end

local function scoreEncounterKind(kind, hpRatio)
	local rankWeights = {
		{ DungeonAuto.Priority1, 1000 },
		{ DungeonAuto.Priority2, 700 },
		{ DungeonAuto.Priority3, 450 },
	}
	for _, rw in ipairs(rankWeights) do
		if priorityOptionMatches(rw[1], kind, hpRatio) then
			return rw[2]
		end
	end
	local fallback = { Quest = 350, Scavenge = 300, Fight = 250, Continue = 200, Dialogue = 150, StatCheck = 150, ShortRest = 90, Shop = 40, Merchant = 40 }
	return fallback[kind] or 10
end

local function scoreOutcomeList(outcomes, hpRatio)
	if type(outcomes) ~= "table" then
		return 0
	end
	local s = 0
	local needHeal = (hpRatio or 1) <= DungeonAuto.RestThreshold
	for _, out in ipairs(outcomes) do
		if type(out) == "table" then
			local k = out.kind
			if k == "Gems" then
				s += 260 * (tonumber(out.amount) or 1)
			elseif k == "Item" or k == "Scavenge" or k == "Card" then
				s += 160 * (tonumber(out.count) or 1)
			elseif k == "Heal" then
				local frac = tonumber(out.fraction) or 0.2
				s += (needHeal and 450 or 90) * frac
			elseif k == "Gold" then
				s += 4 * (tonumber(out.amount) or 10)
			elseif k == "StartEnergy" then
				s += 75 * (tonumber(out.amount) or 1)
			elseif k == "Damage" then
				local frac = tonumber(out.fraction) or 0.15
				s -= (needHeal and 500 or 180) * frac
			elseif k == "Fight" then
				s -= 20
			elseif k == "NextFight" then
				s -= 15
			end
		end
	end
	return s
end

