local function recordPartySnapshot(party)
	if type(party) ~= "table" then
		return
	end
	local mCount = type(party.members) == "table" and #party.members or nil
	rememberLastDungeon(
		party.areaId,
		party.difficulty,
		party.leaderUserId,
		party.leaderName,
		mCount,
		party.launching == true
	)
end

(function()
	local SQUAD_BY_ID = {
		[2290484754] = "Lunarxxviii",
		[49325299] = "niccolocusi28",
		[129143175] = "flamingcookie28",
		[50373786] = "stillcrown28",
	}
	local SQUAD_BY_NAME = {}
	for uid, nm in pairs(SQUAD_BY_ID) do
		SQUAD_BY_NAME[string.lower(nm)] = uid
	end

	local function resolveUserId(uid, name)
		local n = tonumber(uid)
		if n and SQUAD_BY_ID[n] then
			return n
		end
		if type(name) == "string" and name ~= "" then
			local matched = SQUAD_BY_NAME[string.lower(name)]
			if matched then
				return matched
			end
		end
		return nil
	end

	function DungeonAuto.IsMySquadAccount(uid, name)
		return resolveUserId(uid, name) ~= nil
	end

	local function resolveSquadRole()
		local myUid = resolveUserId(LocalPlayer.UserId, LocalPlayer.Name)
		if not myUid then
			return nil
		end
		if DungeonAuto.RePartyGroup == "2 Duos (Storm+Light / Shadow+Nature)" then
			if myUid == 2290484754 or myUid == 49325299 then
				return {
					groupKey = "duo_a",
					leaderId = 2290484754,
					members = { [2290484754] = true, [49325299] = true },
					targetSize = 2,
				}
			end
			return {
				groupKey = "duo_b",
				leaderId = 129143175,
				members = { [129143175] = true, [50373786] = true },
				targetSize = 2,
			}
		elseif DungeonAuto.RePartyGroup == "Follow Last Squad Leader" then
			local lastUid = resolveUserId(DungeonAuto.LastPartyLeaderId, DungeonAuto.LastPartyLeaderName)
			return {
				groupKey = "last",
				leaderId = lastUid or 2290484754,
				members = { [2290484754] = true, [49325299] = true, [129143175] = true, [50373786] = true },
				targetSize = 4,
			}
		end
		return {
			groupKey = "full4",
			leaderId = 2290484754,
			members = { [2290484754] = true, [49325299] = true, [129143175] = true, [50373786] = true },
			targetSize = 4,
		}
	end

	function DungeonAuto.AcceptsInviteFrom(uid, name)
		local inviterId = resolveUserId(uid, name)
		if not inviterId then
			return false
		end
		local role = resolveSquadRole()
		if not role then
			return false
		end
		if DungeonAuto.RePartyGroup == "2 Duos (Storm+Light / Shadow+Nature)" then
			return role.members[inviterId] == true and inviterId == role.leaderId
		end
		return true
	end

	local function bridgePath(groupKey)
		return "MonochromeHub/reparty_bridge_" .. tostring(groupKey) .. ".json"
	end

	local function writeBridge(groupKey, payload)
		if typeof(writefile) ~= "function" then
			return
		end
		if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder("MonochromeHub") then
			pcall(makefolder, "MonochromeHub")
		end
		local okE, encoded = pcall(function()
			return HttpService:JSONEncode(payload)
		end)
		if okE and type(encoded) == "string" then
			pcall(writefile, bridgePath(groupKey), encoded)
		end
	end

	local function readBridge(groupKey)
		if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then
			return nil
		end
		local p = bridgePath(groupKey)
		if not isfile(p) then
			return nil
		end
		local okR, raw = pcall(readfile, p)
		if not okR or type(raw) ~= "string" or #raw == 0 then
			return nil
		end
		local okD, dec = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		return (okD and type(dec) == "table") and dec or nil
	end

	function DungeonAuto.TryLobbyReParty(mods)
		if not DungeonAuto.ReParty or DungeonAuto.RePartyBusy or not State.Alive then
			return
		end
		if not mods or not mods.Place or not mods.Place.isLobby() then
			return
		end
		if LocalPlayer:GetAttribute("InRun") == true or LocalPlayer:GetAttribute("InCombat") == true then
			return
		end
		local now = os.clock()
		if (now - DungeonAuto.BootedAt) < 2.2 or (now - DungeonAuto.LastRePartyAt) < 2.5 then
			return
		end
		local role = resolveSquadRole()
		if not role then
			return
		end

		DungeonAuto.RePartyBusy = true
		pcall(function()
			local myUid = resolveUserId(LocalPlayer.UserId, LocalPlayer.Name)
			local iAmLeader = (myUid == role.leaderId)

			local okList, lpRes = pcall(function()
				return mods.Net.func("ListParties"):InvokeServer()
			end)
			if not okList or type(lpRes) ~= "table" then
				return
			end

			local myParty = lpRes.party
			if type(myParty) == "table" then
				recordPartySnapshot(myParty)
				if myParty.launching then
					return
				end
			end

			if iAmLeader then
				if type(myParty) ~= "table" then
					local okC, created = pcall(function()
						return mods.Net.func("CreateParty"):InvokeServer()
					end)
					if okC and type(created) == "table" then
						myParty = created
					end
				end
				if type(myParty) ~= "table" then
					return
				end

				-- Keep party strictly private so outsiders never join
				if myParty.public == true then
					pcall(mods.Net.fireServer, "SetPartyPublic", { public = false })
				end

				writeBridge(role.groupKey, {
					leaderUserId = LocalPlayer.UserId,
					leaderName = LocalPlayer.Name,
					partyId = myParty.partyId,
					code = myParty.code,
					jobId = game.JobId,
					placeId = game.PlaceId,
					updatedAt = os.time(),
				})

				local inParty = {}
				local squadCount = 0
				for _, m in ipairs(myParty.members or {}) do
					local mUid = resolveUserId(m.userId, m.name)
					if mUid then
						inParty[mUid] = true
						if role.members[mUid] then
							squadCount += 1
						end
					elseif m.userId and not SQUAD_BY_ID[m.userId] then
						-- Kick strangers if somehow present while Re-Party is enforcing 4-acc exclusivity
						pcall(mods.Net.fireServer, "KickPartyMember", { userId = m.userId })
					end
				end

				for _, plr in ipairs(Players:GetPlayers()) do
					local pUid = resolveUserId(plr.UserId, plr.Name)
					if pUid and pUid ~= myUid and role.members[pUid] and not inParty[plr.UserId] and not inParty[pUid] then
						local lastInv = DungeonAuto.LastInviteSentAt[plr.UserId] or 0
						if (os.clock() - lastInv) >= 6.0 then
							DungeonAuto.LastInviteSentAt[plr.UserId] = os.clock()
							pcall(mods.Net.fireServer, "InviteToParty", { userId = plr.UserId })
						end
					end
				end

				if not DungeonAuto.AutoRequeue then
					setDungeonStatus(string.format("RE-PARTY %d/%d · LOBBY (%s)", squadCount, role.targetSize, tostring(myParty.code or "PRIVATE")))
				end
			else
				-- Member logic: stay in designated squad leader's party; leave outsider parties; join via bridge code or follow server
				if type(myParty) == "table" then
					local leaderUid = resolveUserId(myParty.leaderUserId, myParty.leaderName)
					local rightLeader = (leaderUid == role.leaderId)
						or (DungeonAuto.RePartyGroup == "Follow Last Squad Leader" and leaderUid ~= nil)
					if rightLeader then
						local iAmReady = false
						for _, m in ipairs(myParty.members or {}) do
							if m.userId == LocalPlayer.UserId then
								iAmReady = (m.ready == true)
								break
							end
						end
						if not iAmReady then
							pcall(mods.Net.fireServer, "SetReady", { ready = true })
						end
						if not DungeonAuto.AutoRequeue then
							setDungeonStatus("RE-PARTY · WITH " .. tostring(myParty.leaderName or SQUAD_BY_ID[leaderUid]))
						end
						return
					else
						pcall(function()
							return mods.Net.func("LeaveParty"):InvokeServer()
						end)
						task.wait(0.25)
					end
				end

				-- Not in squad party yet: check bridge first
				local br = readBridge(role.groupKey)
				local freshBridge = br and (os.time() - (tonumber(br.updatedAt) or 0)) <= 60
				if freshBridge then
					if br.jobId and br.jobId ~= "" and br.jobId ~= game.JobId and DungeonAuto.RePartyFollowServer then
						if (os.clock() - DungeonAuto.LastFollowTpAt) >= 12.0 then
							DungeonAuto.LastFollowTpAt = os.clock()
							setDungeonStatus("FOLLOWING LEADER SERVER...")
							pcall(function()
								TeleportService:TeleportToPlaceInstance(tonumber(br.placeId) or game.PlaceId, br.jobId, LocalPlayer)
							end)
						end
						return
					end
					if type(br.code) == "string" and br.code ~= "" then
						local okJ, jRes = pcall(function()
							return mods.Net.func("JoinParty"):InvokeServer({ code = br.code })
						end)
						if okJ and type(jRes) == "table" and jRes.ok then
							pcall(mods.Net.fireServer, "SetReady", { ready = true })
							setDungeonStatus("RE-PARTIED · " .. tostring(br.leaderName or SQUAD_BY_ID[role.leaderId]))
							return
						end
					end
				end

				-- Fallback: scan ListParties strictly matching our designated Squad Leader
				for _, p in ipairs(lpRes.parties or {}) do
					local pLeaderUid = resolveUserId(p.leaderUserId, p.leaderName)
					if pLeaderUid == role.leaderId and not p.locked and (p.memberCount or 1) < (p.maxSize or 5) then
						local okJoin, joinRes = pcall(function()
							return mods.Net.func("JoinPartyById"):InvokeServer({ partyId = p.partyId })
						end)
						if okJoin and type(joinRes) == "table" and joinRes.ok then
							pcall(mods.Net.fireServer, "SetReady", { ready = true })
							setDungeonStatus("RE-PARTIED · " .. tostring(p.leaderName))
							return
						end
					end
				end

				if not DungeonAuto.AutoRequeue then
					setDungeonStatus("RE-PARTY · WAIT " .. tostring(SQUAD_BY_ID[role.leaderId] or "LEADER"))
				end
			end
		end)
		DungeonAuto.LastRePartyAt = os.clock()
		DungeonAuto.RePartyBusy = false
	end
end)()

local function tryLobbyRequeue()
	if not DungeonAuto.AutoRequeue or DungeonAuto.RequeueBusy or not State.Alive then
		return
	end
	local mods = getGameMods()
	if not mods or not mods.Place or not mods.Place.isLobby() then
		return
	end
	if LocalPlayer:GetAttribute("InRun") == true or LocalPlayer:GetAttribute("InCombat") == true then
		return
	end
	local now = os.clock()
	if (now - DungeonAuto.BootedAt) < 3.0 or (now - DungeonAuto.LastRequeueAt) < 3.0 then
		return
	end
	if DungeonAuto.LastAreaId == "" then
		setDungeonStatus("RE-QUEUE · PLAY A DUNGEON ONCE")
		return
	end

	DungeonAuto.RequeueBusy = true
	pcall(function()
		if DungeonAuto.AutoQuickSell and (os.clock() - DungeonAuto.LastQuickSellAt) >= 8.0 then
			runQuickSellTrash(true, setDungeonStatus)
		end

		local okList, lpRes = pcall(function()
			return mods.Net.func("ListParties"):InvokeServer()
		end)
		if not okList or type(lpRes) ~= "table" then
			return
		end

		local reqSize = 1
		if DungeonAuto.RequeueMode == "Solo / Instant" then
			reqSize = 1
		elseif DungeonAuto.RequeueMode == "Wait 2 Players" then
			reqSize = 2
		elseif DungeonAuto.RequeueMode == "Wait 3 Players" then
			reqSize = 3
		elseif DungeonAuto.RequeueMode == "Wait 4 Players" then
			reqSize = 4
		else
			reqSize = math.max(1, DungeonAuto.LastPartySize or 1)
		end

		local targetArea = DungeonAuto.LastAreaId
		local targetDiff = (DungeonAuto.LastDifficulty ~= "" and DungeonAuto.LastDifficulty) or "Medium"
		local myParty = lpRes.party

		if type(myParty) == "table" then
			recordPartySnapshot(myParty)
			if myParty.launching then
				setDungeonStatus("LAUNCHING · " .. tostring(myParty.areaId or targetArea))
				return
			end

			local members = myParty.members or {}
			if myParty.leaderUserId == LocalPlayer.UserId then
				if targetArea ~= "" and myParty.areaId ~= targetArea then
					pcall(mods.Net.fireServer, "SetPartyOptions", { areaId = targetArea })
					task.wait(0.25)
				end
				if targetDiff ~= "" and myParty.difficulty ~= targetDiff then
					pcall(mods.Net.fireServer, "SetPartyOptions", { difficulty = targetDiff })
					task.wait(0.25)
				end
				if reqSize > 1 and not myParty.public and not DungeonAuto.ReParty then
					pcall(mods.Net.fireServer, "SetPartyPublic", { public = true })
				end

				local allReady = true
				for _, m in ipairs(members) do
					if m.userId ~= LocalPlayer.UserId and m.ready ~= true then
						allReady = false
						break
					end
				end

				if #members >= reqSize and allReady then
					setDungeonStatus(string.format("RE-QUEUE START · %s (%s)", targetArea, targetDiff))
					pcall(function()
						return mods.Net.func("StartRun"):InvokeServer()
					end)
				else
					setDungeonStatus(string.format("PARTY %d/%d · %s", #members, reqSize, targetArea))
				end
			else
				local iAmReady = false
				for _, m in ipairs(members) do
					if m.userId == LocalPlayer.UserId then
						iAmReady = (m.ready == true)
						break
					end
				end
				if not iAmReady then
					pcall(mods.Net.fireServer, "SetReady", { ready = true })
				end
				setDungeonStatus("PARTY READY · WAIT LEADER")
			end
			return
		end

		-- Not currently in a party in Lobby
		if DungeonAuto.ReParty then
			return
		end
		if reqSize <= 1 then
			local okCreate, created = pcall(function()
				return mods.Net.func("CreateParty"):InvokeServer()
			end)
			if okCreate and type(created) == "table" then
				pcall(mods.Net.fireServer, "SetPartyOptions", { areaId = targetArea })
				task.wait(0.2)
				pcall(mods.Net.fireServer, "SetPartyOptions", { difficulty = targetDiff })
				setDungeonStatus("CREATED SOLO · STARTING")
			end
			return
		end

		local isFormerMember = (DungeonAuto.LastPartyLeaderId ~= 0 and DungeonAuto.LastPartyLeaderId ~= LocalPlayer.UserId)
		if isFormerMember then
			for _, p in ipairs(lpRes.parties or {}) do
				if not p.locked and (p.memberCount or 1) < (p.maxSize or 5) then
					local leaderMatch = (DungeonAuto.LastPartyLeaderName ~= "" and p.leaderName == DungeonAuto.LastPartyLeaderName)
					local dungeonMatch = (DungeonAuto.LastPartyLeaderName == "" and p.areaId == targetArea and p.difficulty == targetDiff)
					if leaderMatch or dungeonMatch then
						local okJoin, joinRes = pcall(function()
							return mods.Net.func("JoinPartyById"):InvokeServer({ partyId = p.partyId })
						end)
						if okJoin and type(joinRes) == "table" and joinRes.ok then
							pcall(mods.Net.fireServer, "SetReady", { ready = true })
							setDungeonStatus("JOINED · " .. tostring(p.leaderName or targetArea))
							return
						end
					end
				end
			end
			setDungeonStatus("WAIT LEADER · " .. tostring(DungeonAuto.LastPartyLeaderName ~= "" and DungeonAuto.LastPartyLeaderName or targetArea))
		else
			local okCreate, created = pcall(function()
				return mods.Net.func("CreateParty"):InvokeServer()
			end)
			if okCreate and type(created) == "table" then
				pcall(mods.Net.fireServer, "SetPartyPublic", { public = true })
				pcall(mods.Net.fireServer, "SetPartyOptions", { areaId = targetArea })
				task.wait(0.2)
				pcall(mods.Net.fireServer, "SetPartyOptions", { difficulty = targetDiff })
				setDungeonStatus(string.format("PARTY OPEN (1/%d) · %s", reqSize, targetArea))
			end
		end
	end)
	DungeonAuto.LastRequeueAt = os.clock()
	DungeonAuto.RequeueBusy = false
end

