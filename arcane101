				BorderSizePixel = 0,
				Parent = card,
			}, {
				create("UICorner", { CornerRadius = UDim.new(1, 0) }),
			})

			local pct = (current - minVal) / math.max(0.0001, maxVal - minVal)
			local fill = create("Frame", {
				Size = UDim2.fromScale(pct, 1),
				BackgroundColor3 = Theme.Accent,
				BorderSizePixel = 0,
				Parent = trackBg,
			}, {
