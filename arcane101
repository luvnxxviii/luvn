local function countChestsInInventory(mods, profile)
	if type(profile) ~= "table" or type(profile.inventory) ~= "table" then
		return 0
	end
	local total = 0
	for _, item in ipairs(profile.inventory) do
		local def = mods.Items[item.defId]
		if def and (def.category == mods.Enums.ItemCategory.Chest or def.chest ~= nil) then
			total += (item.count or 1)
		end
	end
	return total
end

local function openAllChestsSafe(silentWhenEmpty)
	local mods = getGameMods()
	if not mods then
		return
	end
	local ok, profile = pcall(mods.Net.getProfile)
	if not ok or type(profile) ~= "table" then
		return
	end
	local count = countChestsInInventory(mods, profile)
	if count > 0 then
		pcall(function()
			mods.Net.fireServer("OpenAllChests", {})
		end)
		setDungeonStatus("OPENING · " .. tostring(count) .. " CHESTS")
		if DungeonAuto.AutoQuickSell then
			task.delay(0.75, function()
				if State.Alive and DungeonAuto.AutoQuickSell then
					runQuickSellTrash(true, setDungeonStatus)
				end
			end)
		end
	elseif not silentWhenEmpty then
		setDungeonStatus("NO CHESTS TO OPEN")
	end
end

