local function priorityOptionMatches(opt, kind, hpRatio)
	if opt == "Heal (Always)" then
		return kind == "ShortRest"
	elseif opt == "Heal (Below HP%)" then
		return kind == "ShortRest" and hpRatio <= DungeonAuto.RestThreshold
	elseif opt == "Loot" then
		return kind == "Scavenge"
	elseif opt == "Fight" then
		return kind == "Fight"
	elseif opt == "Events" then
		return kind == "Dialogue" or kind == "StatCheck" or kind == "Quest"
	elseif opt == "Shop" then
		return kind == "Shop" or kind == "Merchant"
	elseif opt == "Continue" then
		return kind == "Continue"
	end
	return false
end

local function scoreEncounterKind(kind, hpRatio)
	local rankWeights = {
		{ DungeonAuto.Priority1, 1000 },
		{ DungeonAuto.Priority2, 700 },
		{ DungeonAuto.Priority3, 450 },
	}
	for _, rw in ipairs(rankWeights) do
		if priorityOptionMatches(rw[1], kind, hpRatio) then
			return rw[2]
		end
	end
	local fallback = { Scavenge = 300, Fight = 250, Continue = 200, Quest = 180, Dialogue = 150, StatCheck = 150, ShortRest = 90, Shop = 40, Merchant = 40 }
	return fallback[kind] or 10
end

local function scoreOutcomeList(outcomes, hpRatio)
	if type(outcomes) ~= "table" then
		return 0
	end
	local s = 0
	local needHeal = (hpRatio or 1) <= DungeonAuto.RestThreshold
	for _, out in ipairs(outcomes) do
		if type(out) == "table" then
			local k = out.kind
			if k == "Gems" then
				s += 260 * (tonumber(out.amount) or 1)
			elseif k == "Item" or k == "Scavenge" or k == "Card" then
				s += 160 * (tonumber(out.count) or 1)
			elseif k == "Heal" then
				local frac = tonumber(out.fraction) or 0.2
				s += (needHeal and 450 or 90) * frac
			elseif k == "Gold" then
				s += 4 * (tonumber(out.amount) or 10)
			elseif k == "StartEnergy" then
				s += 75 * (tonumber(out.amount) or 1)
			elseif k == "Damage" then
				local frac = tonumber(out.fraction) or 0.15
				s -= (needHeal and 500 or 180) * frac
			elseif k == "Fight" then
				s -= 20
			elseif k == "NextFight" then
				s -= 15
			end
		end
	end
	return s
end

local function pickBestChoiceForOffer(offer, def, runState, hpRatio)
	local choices = (type(offer) == "table" and type(offer.choices) == "table" and offer.choices)
		or (type(def) == "table" and type(def.choices) == "table" and def.choices)
	if not choices or #choices == 0 then
		return 1
	end

	local bestStats = (type(runState) == "table" and type(runState.bestStats) == "table" and runState.bestStats) or {}
	local bestChoiceIdx, bestChoiceScore = 1, -math.huge

	for idx, ch in ipairs(choices) do
		if type(ch) == "table" and not ch.locked and not ch.disabled then
			local score = 10 - (idx * 0.1)
			if ch.outcomes then
				score += scoreOutcomeList(ch.outcomes, hpRatio)
			end
			if ch.success or ch.failure then
				local p = tonumber(ch.chance) or 0.5
				if type(ch.stat) == "string" and tonumber(bestStats[ch.stat]) then
					p = math.clamp(p + tonumber(bestStats[ch.stat]) * 0.1, 0.1, 0.95)
				end
				score += p * scoreOutcomeList(ch.success, hpRatio) + (1 - p) * scoreOutcomeList(ch.failure, hpRatio)
			end
			if type(ch.cost) == "table" and tonumber(ch.cost.gold) then
				score -= tonumber(ch.cost.gold) * 2
			end
			if score > bestChoiceScore then
				bestChoiceScore = score
				bestChoiceIdx = idx
			end
		end
	end
	return bestChoiceIdx
end

local function pickBestEncounterOffer(mods, offers, hpRatio)
	if type(offers) ~= "table" or #offers == 0 then
		return
	end
	local ratio = hpRatio or DungeonAuto.CurrentHpRatio or 1
	local bestIdx, bestScore = 1, -math.huge
	for idx, offer in ipairs(offers) do
		if not offer.locked and not offer.disabled then
			local def = mods.Encounters and mods.Encounters[offer.id]
			local kind = offer.kind or (def and def.kind) or ""
			local score = scoreEncounterKind(kind, ratio)
			if score > bestScore then
				bestScore = score
				bestIdx = idx
			end
		end
	end
	local picked = offers[bestIdx]
	if picked then
		local def = mods.Encounters and mods.Encounters[picked.id]
		local choiceIdx = pickBestChoiceForOffer(picked, def, DungeonAuto.RunState, ratio)
		mods.Net.fireServer("PickEncounter", { offerIndex = bestIdx, choiceIndex = choiceIdx })
		DungeonAuto.PendingOffers = nil
		setDungeonStatus(string.format("PICKED · %s (c%d)", tostring(picked.id or bestIdx), choiceIdx))
	end
end

