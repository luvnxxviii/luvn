local function discoverCarnivalMinigames(mods)
	local found = {}
	local seen = {}
	if mods then
		for _, def in pairs(mods.Carnival or {}) do
			if type(def) == "table" and type(def.game) == "string" and not seen[def.game] then
				seen[def.game] = true
				table.insert(found, def.game)
			end
		end
		for name, _ in pairs((mods.NewLandsSpots and mods.NewLandsSpots.booths) or {}) do
			if name ~= "SnackStall" and not seen[name] then
				seen[name] = true
				table.insert(found, name)
			end
		end
	end
	if #found == 0 then
		return { "PotionMatch", "GhostMaze", "TowerTopple", "PetCannon", "PetDance", "SnackCatch" }
	end
	table.sort(found)
	return found
end

