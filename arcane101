local function pickBestChoiceForOffer(offer, def, runState, hpRatio, offerIdx)
	local choices = (type(offer) == "table" and type(offer.choices) == "table" and offer.choices)
		or (type(def) == "table" and type(def.choices) == "table" and def.choices)
	if not choices or #choices == 0 then
		return 1
	end

	local bestStats = (type(runState) == "table" and type(runState.bestStats) == "table" and runState.bestStats) or {}
	local bestChoiceIdx, bestChoiceScore = nil, -math.huge

	for idx, ch in ipairs(choices) do
		if type(ch) == "table" and not ch.locked and not ch.disabled and not isRunUiChoiceLocked(offerIdx, idx) then
			local score = 10 - (idx * 0.1)
			if ch.outcomes then
				score += scoreOutcomeList(ch.outcomes, hpRatio)
			end
			if ch.success or ch.failure then
				local p = tonumber(ch.chance) or 0.5
				if type(ch.stat) == "string" and tonumber(bestStats[ch.stat]) then
					p = math.clamp(p + tonumber(bestStats[ch.stat]) * 0.1, 0.1, 0.95)
				end
				score += p * scoreOutcomeList(ch.success, hpRatio) + (1 - p) * scoreOutcomeList(ch.failure, hpRatio)
			end
			if type(ch.cost) == "table" and tonumber(ch.cost.gold) then
				score -= tonumber(ch.cost.gold) * 2
			end
			if score > bestChoiceScore then
				bestChoiceScore = score
				bestChoiceIdx = idx
			end
		end
	end
	return bestChoiceIdx or 1
end

local function pickBestEncounterOffer(mods, offers, hpRatio)
	if type(offers) ~= "table" or #offers == 0 then
		return
	end
	local ratio = hpRatio or DungeonAuto.CurrentHpRatio or 1
	local bestIdx, bestScore = 1, -math.huge
	for idx, offer in ipairs(offers) do
		if not offer.locked and not offer.disabled then
			local def = mods.Encounters and mods.Encounters[offer.id]
			local kind = offer.kind or (def and def.kind) or ""
			local score = scoreEncounterKind(kind, ratio)
			local oid = string.lower(tostring(offer.id or ""))
			local oname = string.lower(tostring(offer.name or ""))
			if DungeonAuto.PrioritizeQuests and (kind == "Quest" or offer.quest ~= nil or string.find(oid, "seraph", 1, true) ~= nil or string.find(oname, "fallen light", 1, true) ~= nil) then
				score += 2000
			end
			if score > bestScore then
				bestScore = score
				bestIdx = idx
			end
		end
	end
	local picked = offers[bestIdx]
	if picked then
		local def = mods.Encounters and mods.Encounters[picked.id]
		local choiceIdx = pickBestChoiceForOffer(picked, def, DungeonAuto.RunState, ratio, bestIdx)
		local btn = findRunUiChoiceButton(bestIdx, choiceIdx)
		local firedUi = btn and btn:GetAttribute("Locked") ~= true and fireGuiButton(btn)
		if not firedUi then
			pcall(function()
				mods.Net.fireServer("PickEncounter", { offerIndex = bestIdx, choiceIndex = choiceIdx })
			end)
		end
		DungeonAuto.PendingOffers = nil
		setDungeonStatus(string.format("PICKED · %s (c%d)", tostring(picked.id or bestIdx), choiceIdx))
	end
end

