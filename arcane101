	renderFeed = function(forceFetch)
		if not State.Alive or not feedContainer or not feedContainer.Parent then
			return
		end
		local mods, profile, stock = fetchStockAndProfile(forceFetch)
		for _, child in ipairs(feedContainer:GetChildren()) do
