			end)
			local nm = tostring(cand.def.name or cand.item.defId)
			upgradeReadyCard:Set(string.format("%s T%d→T%d (%dg, %d fuel)", nm, plan.tier, plan.nextTier, plan.goldCost, #plan.consume))
			setGearStatus("UPGRADED · " .. nm .. " T" .. tostring(plan.nextTier))
		end,
	})

	GearTab:AddButton({
		Title = "Upgrade All Ready Armor/Charms",
		Callback = function()
			if LocalPlayer:GetAttribute("InRun") == true then
				setGearStatus("EXIT RUN TO UPGRADE")
				return
			end
			local mods = getGameMods()
			if not mods or not mods.Upgrade then
				return
			end
			local count, lastMsg = 0, nil
			for _ = 1, 12 do
				local okP, profile = pcall(mods.Net.getProfile)
				if not okP or type(profile) ~= "table" then
					break
				end
				local cand, plan = findBestUpgradePlan(mods, profile)
				if not cand or not plan then
					break
				end
				pcall(function()
					mods.Net.fireServer("UpgradeItem", { uid = cand.item.uid, fuelUids = plan.consume })
				end)
				count += 1
				lastMsg = string.format("%s T%d", tostring(cand.def.name or cand.item.defId), plan.nextTier)
				task.wait(0.28)
			end
			if count > 0 then
				upgradeReadyCard:Set(string.format("Upgraded %d tier(s) · Last: %s", count, tostring(lastMsg)))
				setGearStatus("UPGRADED · " .. tostring(count) .. " TIERS")
			else
				upgradeReadyCard:Set("No ready armor/charm/pet upgrades")
				setGearStatus("NO READY UPGRADES")
			end
		end,
	})

	local function refBestWeak(goldOnly)
		if LocalPlayer:GetAttribute("InRun") == true then
			setGearStatus("EXIT RUN TO REFORGE")
			return
		end
		local mods = getGameMods()
		if not mods or not mods.Reforge then
			return
		end
		local okP, profile = pcall(mods.Net.getProfile)
		if not okP or type(profile) ~= "table" then
			return
		end
		local rolls = scanEquippedReforgeRolls(mods, profile, goldOnly)
		local target = nil
		for _, r in ipairs(rolls) do
			if r.canPay and (r.negCnt > 0 or r.unrolled or r.avgPctOfMax < 55) then
				target = r
				break
			end
		end
		if not target then
			local firstBlocked = rolls[1]
			if firstBlocked and not firstBlocked.canPay then
				upgradeReadyCard:Set(string.format("%s: %s", firstBlocked.name, tostring(firstBlocked.reason or "No funds")))
				setGearStatus("REFORGE BLOCKED · " .. tostring(firstBlocked.reason or "?"))
			else
				upgradeReadyCard:Set(goldOnly and "Gold rolls clean or none <55%" or "All equipped rolls clean (+55%+)!")
				setGearStatus("REFORGE · NO WEAK TARGET")
			end
			return
		end
		local seenSig = mods.Reforge.signature(target.item.rolledStats)
		pcall(function()
			mods.Net.fireServer("ReforgeItem", { uid = target.item.uid, seen = seenSig })
		end)
		local costStr = target.price and string.format("%d %s", target.price.amount, target.isGems and "gems" or "gold") or "?"
		upgradeReadyCard:Set(string.format("Reforged %s (was %d%%, %s)", target.name, target.unrolled and 0 or target.avgPctOfMax, costStr))
		setGearStatus("REFORGED · " .. target.name)
	end

