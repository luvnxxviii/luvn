local function calculateSmartMarketPrice(ovr, rarity, pot)
    local floor = getMarketFloorEstimate(ovr, rarity)
    if pot and pot >= 80 then
        floor = math.floor(floor * 1.35)
    end
    if State.SmartSellStrategy == "Fast Competitive Undercut (Recommended)" then
        floor = math.floor(floor * 0.95)
    end
    return math.max(1000, floor)
end

local function smartSellBenchCards()
    local data = getReplicaData()
    local activeListings = (data and data.listings) and #data.listings or 0
    local maxSlots = 10
    local availableSlots = maxSlots - activeListings
    
    if availableSlots <= 0 then
        return 0, 0, "Market listing slots are full (10/10 active)."
    end
    
    local cards = collectionController:getCards() or {}
    local listedCount = 0
    local totalExpectedCoins = 0
    
    for _, card in ipairs(cards) do
        if listedCount >= availableSlots then break end
        
        local id = card.id
        local ovr = card.overall or 0
        local pot = card.max or ovr
        local rarity = tostring(card.rarity or "common"):lower()
        
        local inSquad = collectionController:isInAnyPreset(id)
        local inTraining = collectionController:isTraining(id)
        
        if not inSquad and not inTraining then
            local scopeMatches = false
            if State.SmartSellScope == "All Unassigned Bench Cards" then
                scopeMatches = true
            elseif State.SmartSellScope == "Cards with Potential <= 74" then
                scopeMatches = (pot <= 74)
            elseif State.SmartSellScope == "Rare Quality & Above" then
                scopeMatches = (rarity == "rare" or rarity == "epic" or rarity == "legendary")
            end
            
            if scopeMatches then
                local optimalPrice = calculateSmartMarketPrice(ovr, rarity, pot)
                local ok = net.market.listCard:Request(id, optimalPrice)
                if ok then
                    listedCount = listedCount + 1
                    totalExpectedCoins = totalExpectedCoins + optimalPrice
                    task.wait(0.4)
                end
            end
        end
    end
    
    return listedCount, totalExpectedCoins, nil
end

