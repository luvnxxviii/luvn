-- Fast Match Re-Queue Executor
local isRequeueing = false
local function executeFastQueue(triggerSource)
    if isRequeueing or not State.IsRunning then return end
    if not (State.AutoTournament or State.AutoQueue) then return end
    isRequeueing = true
    
    task.spawn(function()
        if State.SkipMatchResultScreen then
            fastDismissPostMatchScreens()
        end
        
        -- Brief delay to let the server cleanly finalize the completed match session
        task.wait(State.FastRequeueDelay)
        
        local attempts = 0
        local queued = false
        
        while attempts < 10 and State.IsRunning and not queued do
            attempts = attempts + 1
            
            -- If match has already started or matchmaking search is active, break
            if matchController:isInMatch() then break end
            local mm = interfaceController and interfaceController:get("matchmaking")
            if mm and typeof(mm.isSearching) == "function" and mm:isSearching() then 
                queued = true
                break 
            end
            
            if State.AutoTournament then
                pcall(function()
                    net.tournaments.join:Request(State.SelectedTournamentId)
                end)
                TourneyStatusParagraph:SetDesc(string.format("⚡ Fast-Queue: Entering %s (Attempt %d)...", State.SelectedTournamentName, attempts))
                
                local ok, res = net.matchmaking.startSearch:Request(State.SelectedTournamentId)
                if ok then
                    queued = true
                    TourneyStatusParagraph:SetDesc(string.format("✅ Fast-Queued for %s! Waiting for opponent...", State.SelectedTournamentName))
                    Fluent:Notify({
                        Title = "⚡ Fast-Queued!",
                        Content = string.format("Instantly queued for %s!", State.SelectedTournamentName),
                        Duration = 3
                    })
                    break
                else
                    task.wait(0.35)
                end
            elseif State.AutoQueue then
                local ok, res = net.matchmaking.startSearch:Request(nil)
                if ok then
                    queued = true
                    Fluent:Notify({
                        Title = "⚡ Fast-Queued!",
                        Content = "Instantly queued for regular match!",
                        Duration = 3
                    })
                    break
                else
                    task.wait(0.35)
                end
            else
                break
            end
        end
        
        task.wait(0.8)
        isRequeueing = false
    end)
end

