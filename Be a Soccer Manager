-- SQUAD BENCHMARK ENGINE
local function getSquadBenchmarks()
    local benchmarks = {
        goalkeeper = {minOvr = 999, minPot = 999, avgOvr = 0, count = 0, starterNames = {}},
        defender = {minOvr = 999, minPot = 999, avgOvr = 0, count = 0, starterNames = {}},
        attacker = {minOvr = 999, minPot = 999, avgOvr = 0, count = 0, starterNames = {}}
    }
    
    pcall(function()
        local squad = collectionController:getSquad()
        local currentPreset = squad and squad.presets and squad.presets[squad.selected or 1]
        if currentPreset and currentPreset.slots then
            for _, cardId in ipairs(currentPreset.slots) do
                if cardId and cardId ~= "" then
                    local card = collectionController:getCard(cardId)
                    if card and card.position and benchmarks[card.position] then
                        local b = benchmarks[card.position]
                        local ovr = card.overall or 50
                        local pot = card.max or ovr
                        
                        b.count = b.count + 1
                        b.avgOvr = b.avgOvr + ovr
                        table.insert(b.starterNames, card.name or "Starter")
                        
                        if ovr < b.minOvr then b.minOvr = ovr end
                        if pot < b.minPot then b.minPot = pot end
                    end
                end
            end
            
            for _, pos in pairs(benchmarks) do
                if pos.count > 0 then
                    pos.avgOvr = math.floor(pos.avgOvr / pos.count)
                else
                    pos.minOvr = 50
                    pos.minPot = 55
                end
            end
        end
    end)
    
    return benchmarks
end

-- DYNAMIC FAIR MARKET FLOOR ESTIMATOR
local function getMarketFloorEstimate(ovr, rarity)
    local floor = 2000
    if ovr >= 85 then floor = 105000
    elseif ovr >= 82 then floor = 70000
    elseif ovr >= 80 then floor = 48000
    elseif ovr >= 75 then floor = 26000
    elseif ovr >= 72 then floor = 17000
    elseif ovr >= 70 then floor = 10500
    elseif ovr >= 66 then floor = 7200
    elseif ovr >= 62 then floor = 3800
    elseif ovr >= 58 then floor = 2000
    end
    
    if rarity == "rare" then floor = math.floor(floor * 1.25)
    elseif rarity == "epic" then floor = math.floor(floor * 1.60)
    elseif rarity == "legendary" then floor = math.floor(floor * 2.20)
    end
    
    return floor
end

-- CARD INTELLIGENCE EVALUATOR (For Squad Upgrades)
local function evaluateCardForSquad(card, price, benchmarks)
    if not card or not card.position then return false, "Invalid card" end
    local pos = card.position
    local b = benchmarks[pos] or {minOvr = 60, minPot = 65}
    local stats = card.stats or {}
    local ovr = card.overall or 0
    local maxPot = card.max or ovr
    local rarity = tostring(card.rarity or "common"):lower()
    
    -- 0. STRICT GATES
    if State.IgnoreCommons and (rarity == "common") then
        return false, "Common cards rejected (Rare+ only)"
    end
    
    if State.SnipeMinPotential > 0 and maxPot < State.SnipeMinPotential then
        return false, string.format("Potential (%d) < floor (%d)", maxPot, State.SnipeMinPotential)
    end
    
    -- 1. POSITIONAL KEY STAT AVERAGE CHECK
    local keyStatAvg = 0
    local statWellDistributed = false
    
    if pos == "attacker" then
        local shoot = stats.shooting or 0
        local pace = stats.speed or 0
        local pass = stats.passing or 0
        keyStatAvg = math.floor((shoot * 0.50) + (pace * 0.30) + (pass * 0.20))
        statWellDistributed = (shoot >= (ovr - 5)) and (pace >= (ovr - 8))
    elseif pos == "defender" then
        local def = stats.defending or 0
        local pace = stats.speed or 0
        local pass = stats.passing or 0
        keyStatAvg = math.floor((def * 0.50) + (pace * 0.30) + (pass * 0.20))
        statWellDistributed = (def >= (ovr - 5)) and (pace >= (ovr - 12))
    elseif pos == "goalkeeper" then
        local gk = stats.goalkeeping or 0
        keyStatAvg = gk
        statWellDistributed = (gk >= (ovr - 3))
    end
    
    -- 2. SQUAD UPGRADE CHECK
    local ovrUpgrade = ovr - b.minOvr
    local potUpgrade = maxPot - b.minPot
    local isDirectOvrUpgrade = (ovrUpgrade > 0)
    local isHighPotUpgrade = (potUpgrade >= 3)
    
    -- 3. VALUE EVALUATION
    local tierFloor = getMarketFloorEstimate(ovr, rarity)
    local isBargainPrice = (price <= (tierFloor * 0.65))
    
    local shouldBuy = false
    local reason = ""
    
    if State.SniperMode == "Smart Squad Upgrade" then
        if (isDirectOvrUpgrade or isHighPotUpgrade) then
            if not State.RequireStatOptimization or statWellDistributed then
                shouldBuy = true
                reason = isDirectOvrUpgrade and string.format("+%d OVR Upgrade in %s", ovrUpgrade, pos:upper()) or string.format("+%d POT Wonderkid in %s", potUpgrade, pos:upper())
            else
                reason = "Positional stats not optimized"
            end
        else
            reason = "Doesn't improve current starter"
        end
    elseif State.SniperMode == "Pure Bargains / Flip" then
        if isBargainPrice and (ovr >= State.SnipeMinOvr) then
            shouldBuy = true
            reason = string.format("Undervalued Steal (Worth ~%d)", tierFloor)
        else
            reason = "Price not a bargain"
        end
    elseif State.SniperMode == "Hybrid (Upgrade + Bargains)" then
        if (isDirectOvrUpgrade and (not State.RequireStatOptimization or statWellDistributed)) then
            shouldBuy = true
            reason = string.format("Squad +%d OVR Upgrade (%s)", ovrUpgrade, pos:upper())
        elseif (isHighPotUpgrade and maxPot >= State.SnipeMinPotential) then
            shouldBuy = true
            reason = string.format("Wonderkid (+%d POT | Max %d)", potUpgrade, maxPot)
        elseif (isBargainPrice and maxPot >= 75) then
            shouldBuy = true
            reason = "Bargain Snipe below floor"
        else
            reason = "Neither upgrade nor bargain"
        end
    end
    
    return shouldBuy, reason
end

