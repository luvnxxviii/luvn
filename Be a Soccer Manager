-- Helper: Safe Replica Data Getter
local function getReplicaData()
    local pd = playerDataController:get()
    return pd and pd.replica and pd.replica.Data
end

-- Helper: Safe Opponent Inspection
local function inspectOpponent()
    local data = getReplicaData()
    if not data or not data.activeMatch then
        return nil, "No active match found! You must be inside a match."
    end
    
    local match = data.activeMatch
    local ownerSide = match.ownerSide or "home"
    local oppSide = (ownerSide == "home") and "away" or "home"
    local opp = match[oppSide]
    if not opp then return nil, "No opponent data found." end
    
    local playersList = {}
    for _, p in ipairs(opp.players or {}) do
        table.insert(playersList, string.format("[%s] %s (OVR %d)", p.position or "N/A", p.name or "Player", p.overall or 0))
    end
    
    return {
        name = opp.displayName or "Unknown",
        club = opp.club and opp.club.name or "Unknown Club",
        formation = opp.formation or "Default",
        fans = opp.fans or 0,
        players = playersList
    }
end

