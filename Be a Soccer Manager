                            local roiPercent = math.floor((netProfit / buyPrice) * 100)
                            
                            -- Profitability Check
                            if netProfit >= State.FlipperMinNetProfit and roiPercent >= State.FlipperMinRoiPercent then
                                local bought, buyErr = net.market.buyListing:Request(item.id)
                                if bought then
                                    playNotificationSound()
                                    State.TotalFlips = State.TotalFlips + 1
                                    State.TotalProjectedProfit = State.TotalProjectedProfit + netProfit
                                    
                                    -- Calculate undercut resale price
                                    local resellPrice = math.floor(estimatedFloor * (1 - (State.FlipperUndercutPercent / 100)))
                                    resellPrice = math.max(buyPrice + 500, resellPrice)
                                    
                                    -- Relist card immediately onto market
                                    task.wait(0.6)
                                    local relisted = net.market.listCard:Request(card.id, resellPrice)
                                    
                                    local statusMsg = relisted and string.format("🔄 FLIPPED: %s (%d OVR) Bought $%s -> Listed $%s (Net Profit: +$%s | +%d%%)",
                                        name, ovr, formatCoins(buyPrice), formatCoins(resellPrice), formatCoins(netProfit), roiPercent)
                                        or string.format("✅ Bought %s for $%s (Listing pending)", name, formatCoins(buyPrice))
                                    
                                    appendFlipperFeed(statusMsg)
                                    Fluent:Notify({
                                        Title = "💰 Profitable Flip Executed!",
                                        Content = string.format("%s (%d OVR)\nBought: $%s | Relisted: $%s\nProfit: +$%s coins",
                                            name, ovr, formatCoins(buyPrice), formatCoins(resellPrice), formatCoins(netProfit)),
                                        Duration = 6
                                    })
                                    task.wait(1.5)
                                    break -- Move to next scan cycle
                                end
                            end
                        end
                    end
                end
            end)
            State.IsFlipping = false
        end
    end
end)

