-- Training Grinder Loop
task.spawn(function()
    while State.IsRunning do
        task.wait(3.5)
        if State.AutoCollectTraining or State.AutoStartTraining then
            pcall(function()
                local training = collectionController:getTraining()
                local serverTime = workspace:GetServerTimeNow()
                
                if training and training.slots then
                    for index = 1, (training.unlocked or 1) do
                        local slot = training.slots[index]
                        
                        -- Collect
                        if State.AutoCollectTraining and slot and slot.cardId and slot.cardId ~= "" then
                            if serverTime >= (slot.endsAt or 0) then
                                net.training.collect:Request(index)
                                task.wait(0.5)
                            end
                        end
                        
                        -- Start
                        if State.AutoStartTraining and (not slot or slot.cardId == "" or slot.cardId == nil) then
                            local avail = collectionController:getAvailableCards()
                            local candidate = nil
                            for _, c in ipairs(avail or {}) do
                                if not collectionController:isInSquad(c.id) and not collectionController:isInAnyPreset(c.id) then
                                    candidate = c
                                    break
                                end
                            end
                            if candidate then
                                net.training.start:Request(index, candidate.id, State.TrainingDrill)
                                task.wait(0.5)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

