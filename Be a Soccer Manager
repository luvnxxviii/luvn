                    search = "",
                    position = State.SnipePosition
                }, 0)
                
                if ok and data and data.items then
                    for _, item in ipairs(data.items) do
                        if not State.AutoSnipe or not State.IsRunning then break end
                        
                        local price = item.price or 999999999
                        local card = item.card
                        local ovr = card and card.overall or 0
                        local maxPot = card and (card.max or card.overall) or 0
                        local name = card and card.name or "Player"
                        
                        local withinBudget = (price <= State.SnipeMaxPrice) and ((currentMoney - price) >= State.SnipeReserveBalance)
                        
