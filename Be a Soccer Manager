                    if card and card.overall and card.overall <= State.MaxOvrToSell then
                        if not collectionController:isInAnyPreset(card.id) and not collectionController:isTraining(card.id) then
                            net.cards.quickSell:Request(card.id)
                            task.wait(0.3)
                        end
                    end
                end
            end)
        end
    end
end)

