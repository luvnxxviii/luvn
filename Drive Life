local function sendAntiAfkPulse(reason)
    if not antiAfkEnabled then return end
    disableInternalIdledConnections()
    pcall(function()
        local cam = workspace.CurrentCamera
        local cf = (cam and cam.CFrame) or CFrame.new()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.zero, cf)
    end)
    antiAfkPulses = antiAfkPulses + 1
    if antiAfkStatus and antiAfkStatus.Parent then
        antiAfkStatus.Text = string.format("%s • %d pulse%s", reason or "Active", antiAfkPulses, antiAfkPulses == 1 and "" or "s")
        antiAfkStatus.TextColor3 = C_GREEN
    end
end

