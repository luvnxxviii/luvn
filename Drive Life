-- Helper to find active race gates (supports Street Races & Playlist Race dynamic tracks)
local function getActiveRaceGates()
    local RaceInfo_m
    pcall(function()
        RaceInfo_m = require(ReplicatedStorage:WaitForChild("RaceInfo"))
    end)

    -- 1. Check workspace.Track (used by Playlist Races)
    local track = workspace:FindFirstChild("Track")
    if track and RaceInfo_m then
        if track:FindFirstChild("FinishLine") then
            local gates, finish = RaceInfo_m.Gates(track)
            if gates and #gates > 0 and finish then
                return gates, finish, track.Name
            end
        end
        for _, c in ipairs(track:GetChildren()) do
            if c:FindFirstChild("FinishLine") then
                local gates, finish = RaceInfo_m.Gates(c)
                if gates and #gates > 0 and finish then
                    return gates, finish, c.Name
                end
            end
        end
    end

    -- 2. Check selected race folder in workspace.Races
    local raceFolder = workspace:FindFirstChild("Races") and workspace.Races:FindFirstChild(selectedRace)
    if raceFolder and RaceInfo_m and raceFolder:FindFirstChild("FinishLine") then
        local gates, finish = RaceInfo_m.Gates(raceFolder)
        if gates and #gates > 0 and finish then
            return gates, finish, raceFolder.Name
        end
    end

    -- 3. Check any folder in workspace.Races that has FinishLine
    local races = workspace:FindFirstChild("Races")
    if races and RaceInfo_m then
        for _, rf in ipairs(races:GetChildren()) do
            if rf:FindFirstChild("FinishLine") then
                local gates, finish = RaceInfo_m.Gates(rf)
                if gates and #gates > 0 and finish then
                    return gates, finish, rf.Name
                end
            end
        end
    end

    -- 4. Fallback: manual checkpoint collection
    local targetFolder = (track and track:FindFirstChild("FinishLine") and track) or raceFolder
    if targetFolder then
        local checkpoints = {}
        for _, c in ipairs(targetFolder:GetChildren()) do
            if c.Name:match("^Checkpoint%d+$") then
                local num = tonumber(c.Name:match("%d+"))
                table.insert(checkpoints, { part = c, num = num })
            end
        end
        table.sort(checkpoints, function(a, b) return a.num < b.num end)
        local rawGates = {}
        for _, cp in ipairs(checkpoints) do
            table.insert(rawGates, cp.part)
        end
        local finish = targetFolder:FindFirstChild("FinishLine")
        if #rawGates > 0 and finish then
            return rawGates, finish, targetFolder.Name
        end
    end

    return nil, nil, nil
end

local function executeCalibratedRaceTraversal()
    local gates, finish, trackName = getActiveRaceGates()
    if not gates or #gates == 0 or not finish then
        if raceStatusLabel then
            raceStatusLabel.Text = "Status: No active race track or checkpoints found"
            raceStatusLabel.TextColor3 = Color3.fromRGB(241, 196, 15)
        end
        return false, "No gates found"
    end

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local car = hum and hum.SeatPart and hum.SeatPart:FindFirstAncestorOfClass("Model")
    local mover = (car and car.PrimaryPart) or (char and char:FindFirstChild("HumanoidRootPart"))
    if not mover then
        if raceStatusLabel then
            raceStatusLabel.Text = "Status: Sit in a vehicle or spawn character first"
            raceStatusLabel.TextColor3 = C_RED
        end
        return false, "No vehicle"
    end

    -- Zero-contact enforcement: prevent wall & car impact impulses
    local collParts = {}
    if car then
        for _, p in ipairs(car:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                table.insert(collParts, p)
                p.CanCollide = false
            end
        end
    end

    local cruiseSpeed = 195 -- studs/s (~133 mph, legal server pacing, beats all AI rivals)
    local totalGates = #gates
    local raceFinished = false

    local raceEvents = ReplicatedStorage:FindFirstChild("RaceEvents")
    local connFinish
    if raceEvents and raceEvents:FindFirstChild("PlayerFinished") then
        connFinish = raceEvents.PlayerFinished.OnClientEvent:Connect(function()
            raceFinished = true
        end)
    end

    local function cleanup()
        if connFinish then connFinish:Disconnect() end
        for _, p in ipairs(collParts) do
            pcall(function() p.CanCollide = true end)
        end
    end

    if raceStatusLabel then
        raceStatusLabel.Text = string.format("Traversing %s • %d Gates (Zero Contact)...", tostring(trackName), totalGates)
        raceStatusLabel.TextColor3 = C_ACCENT
    end

    -- Sequentially glide through all checkpoints
    for idx, gate in ipairs(gates) do
        if not raceAutoRunning or raceFinished then break end

        -- Elevated +2.8 studs: cleanly clears other cars' hoods/bumpers and guardrail tops
        local targetPos = gate.Position + Vector3.new(0, 2.8, 0)
        local startPos = mover.Position
        local dist = (targetPos - startPos).Magnitude

        if raceStatusLabel then
            raceStatusLabel.Text = string.format("Gate %d/%d (%s) • %d st/s • Clean (No Contact)", idx, totalGates, gate.Name, cruiseSpeed)
        end

        local glideStart = os.clock()
        local duration = dist / cruiseSpeed
        local dir = dist > 0.1 and (targetPos - startPos).Unit or Vector3.new(0, 0, 1)

        while os.clock() - glideStart < duration do
            if not raceAutoRunning or raceFinished then break end
            local alpha = math.clamp((os.clock() - glideStart) / duration, 0, 1)
            local curPos = startPos:Lerp(targetPos, alpha)
            local lookCF = CFrame.lookAt(curPos, curPos + dir * 5)

            if car and car.PrimaryPart then
                car:SetPrimaryPartCFrame(lookCF)
            else
                mover.CFrame = lookCF
            end

            for _, p in ipairs(collParts) do
                p.AssemblyLinearVelocity = dir * cruiseSpeed
                p.AssemblyAngularVelocity = Vector3.zero
            end

            RunService.Heartbeat:Wait()
        end

        -- Trigger checkpoint gate contact
        pcall(function()
            if firetouchinterest then
                firetouchinterest(mover, gate, 0)
                task.wait(0.015)
                firetouchinterest(mover, gate, 1)
            end
        end)
    end

    -- Finish Line crossing (guarantees 1st place)
    if raceAutoRunning and not raceFinished and finish then
        local finishPos = finish.Position + Vector3.new(0, 2.8, 0)
        local startPos = mover.Position
        local dist = (finishPos - startPos).Magnitude
        local glideStart = os.clock()
        local duration = dist / cruiseSpeed
        local dir = dist > 0.1 and (finishPos - startPos).Unit or Vector3.new(0, 0, 1)

        if raceStatusLabel then
            raceStatusLabel.Text = "Crossing Finish Line (1st Place)..."
            raceStatusLabel.TextColor3 = C_GREEN
        end

        while os.clock() - glideStart < duration do
            if not raceAutoRunning or raceFinished then break end
            local alpha = math.clamp((os.clock() - glideStart) / duration, 0, 1)
            local curPos = startPos:Lerp(finishPos, alpha)
            local lookCF = CFrame.lookAt(curPos, curPos + dir * 5)

            if car and car.PrimaryPart then
                car:SetPrimaryPartCFrame(lookCF)
            else
                mover.CFrame = lookCF
            end

            for _, p in ipairs(collParts) do
                p.AssemblyLinearVelocity = dir * cruiseSpeed
                p.AssemblyAngularVelocity = Vector3.zero
            end

            RunService.Heartbeat:Wait()
        end

        pcall(function()
            if firetouchinterest then
                firetouchinterest(mover, finish, 0)
                task.wait(0.015)
                firetouchinterest(mover, finish, 1)
            end
        end)
    end

    cleanup()

    if raceStatusLabel then
        raceStatusLabel.Text = "Race Complete! 1st Place • 0 Contact • 3 Stars"
        raceStatusLabel.TextColor3 = C_GREEN
    end
    return true
end

