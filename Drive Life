local function disableInternalIdledConnections()
    pcall(function()
        local gc = getconnections or get_signal_cons
        if gc then
            for _, conn in ipairs(gc(player.Idled)) do
                if conn.Disable then
                    conn:Disable()
                elseif conn.Disconnect then
                    conn:Disconnect()
                end
            end
        end
    end)
end
