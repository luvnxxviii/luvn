local function toggleComputer(targetApp)
    local OS = getOSModule()
    if not OS then
        warn("[DriveLifeHub] Could not find Office OS module.")
        return
    end

    -- Notify server remote
    local rf = ReplicatedStorage:FindFirstChild("OfficeRemote")
    if rf then
        task.spawn(function()
            pcall(function() rf:InvokeServer("computer") end)
        end)
    end

    if OS.IsOpen and OS.IsOpen() then
        if targetApp then
            pcall(function() OS.OpenApp(targetApp) end)
        else
            OS.Close()
        end
    else
        -- Open computer directly without sitting on chair!
        OS.Open({ framed = false })
        if targetApp then
            task.wait(0.15)
            pcall(function() OS.OpenApp(targetApp) end)
        end
    end
end

