local function sellAndDeliverToCollector(slot)
    local Net = getNet()
    if not Net then return false, "No Net" end

    local s = Net.State()
    local bay = s.bays and s.bays[slot]
    if not bay or not bay.car then
        return false, "No car in slot " .. tostring(slot)
    end

    local carName = tostring(bay.display or bay.car or slot)

    -- If project car, make sure it is on a bay with a car lift to allow fixing wheels/suspension
    if bay.kind == "project" then
        local lifts = s.lifts or {}
        if not lifts[slot] then
            for liftSlot, _ in pairs(lifts) do
                if not (s.bays and s.bays[liftSlot]) then
                    Net.Call("moveBay", slot, liftSlot)
                    task.wait(0.4)
                    slot = liftSlot
                    s = Net.State()
                    bay = s.bays and s.bays[slot]
                    break
                end
            end
        end

        -- Restore all faults
        Net.Call("restore", slot, "all")
        task.wait(0.3)
    end

    -- Repair care to 100% and prep
    Net.Call("repair", slot)
    Net.Call("prepAll", slot, {})
    task.wait(0.4)

    -- Start sell mission to highest paying buyer: "collector" (+30%)
    -- Fallbacks: "dealer" (+15%), then "private"
    local sellRes = Net.Call("sell", slot, "collector")
    if not (sellRes and sellRes.ok) then
        sellRes = Net.Call("sell", slot, "dealer")
    end
    if not (sellRes and sellRes.ok) then
        sellRes = Net.Call("sell", slot, "private")
    end

    if not sellRes or not sellRes.ok then
        return false, (type(sellRes) == "table" and sellRes.message) or "Could not start sale"
    end

    task.wait(0.8)
    s = Net.State()
    local m = s.mission
    if not m or not m.dest then
        return false, "Sell mission did not initialize"
    end

    -- Deliver car to buyer destination ring
    local dest = Vector3.new(m.dest[1], m.dest[2] + 2, m.dest[3])
    local car = workspace.Vehicles:FindFirstChild(player.Name .. " - Business")
    local seat = car and car:FindFirstChild("DriveSeat", true)
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")

    if seat and hum and seat.Occupant ~= hum then
        seat:Sit(hum)
        task.wait(0.4)
    end

    pcall(function() player:RequestStreamAroundAsync(dest) end)
    if car and car.PrimaryPart then
        car:SetPrimaryPartCFrame(CFrame.new(dest))
        for _, p in ipairs(car:GetDescendants()) do
            if p:IsA("BasePart") then
                p.AssemblyLinearVelocity = Vector3.zero
                p.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end

    -- Hold still inside ring for 2.5s for server validation
    for i = 1, 10 do
        task.wait(0.25)
        if car and car.PrimaryPart then
            car.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
        end
    end

    Net.Call("go")
    refreshBusiness()
    local priceEarned = m.price or 0
    local buyerName = tostring(m.destName or m.buyer or "Collector")
    return true, string.format("Sold %s to %s for $%s", carName, buyerName, tostring(priceEarned))
end

local boardCache = {
    checkedAt = 0,
    untakenCount = 0,
    nextRefresh = 0,
    bestOffer = nil
}

local function checkContractBoard(force)
    local now = os.clock()
    if not force and (now - boardCache.checkedAt < 2.5) then
        return boardCache.untakenCount, boardCache.nextRefresh, boardCache.bestOffer
    end

    local Net = getNet()
    if not Net then return 0, 0, nil end

    local b = Net.Call("board")
    local offers = b and b.offers or {}
    local boardInfo = b and b.state and b.state.board
    local nextRefresh = (boardInfo and tonumber(boardInfo.next)) or 0

    local untaken = 0
    local best = nil
    local maxProfit = 0

    for _, o in ipairs(offers) do
        if not o.taken then
            untaken = untaken + 1
            local profit = (type(o.fee) == "table" and tonumber(o.fee[2])) or tonumber(o.fee) or 0
            if profit > maxProfit then
                maxProfit = profit
                best = o
            end
        end
    end

    boardCache.checkedAt = now
    boardCache.untakenCount = untaken
    boardCache.nextRefresh = nextRefresh
    boardCache.bestOffer = best

    return untaken, nextRefresh, best
end

local function runOneContract()
    local Net = getNet()
    if not Net then return false, "No Net" end

    local s = Net.State()
    local m = s.mission
    local slots = getBaySlots(s)

    -- If not already in an active contract delivery, check if car slots are full
    if not m and slots.isFull then
        local msg = string.format("All bays full (%d/%d) • Cannot take contract", slots.occupied, slots.total)
        contractsToggle.SetStatus(msg, Color3.fromRGB(241, 196, 15))
        return false, msg
    end

    -- If not already in mission, find and take highest-paying contract
    local maxProfit = 0
    local best = nil
    if not m then
        setAutoStatus("Scanning contract board...", C_ACCENT)
        contractsToggle.SetStatus("Scanning contract board...", C_ACCENT)

        local b = Net.Call("board")
        local offers = b and b.offers or {}
        local boardInfo = b and b.state and b.state.board
        local nextRefresh = (boardInfo and tonumber(boardInfo.next)) or 0
        local untakenCount = 0

        for _, o in ipairs(offers) do
            if not o.taken then
                untakenCount = untakenCount + 1
                local profit = (type(o.fee) == "table" and tonumber(o.fee[2])) or tonumber(o.fee) or 0
                if profit > maxProfit then
                    maxProfit = profit
                    best = o
                end
            end
        end

        boardCache.checkedAt = os.clock()
        boardCache.untakenCount = untakenCount
        boardCache.nextRefresh = nextRefresh
        boardCache.bestOffer = best

        if untakenCount == 0 or not best then
            return false, "board_empty", nextRefresh
        end

        contractsToggle.SetStatus("Accepting: " .. tostring(best.display) .. " (+$" .. tostring(maxProfit) .. ")...", C_ACCENT)
        local takeRes = Net.Call("take", best.slot)
        if not takeRes or not takeRes.ok then
            return false, "Could not take contract"
        end

        task.wait(0.8)
        s = Net.State()
        m = s.mission
    end

    if not m then
        return false, "Mission did not initialize"
    end

    local pickup = m.pickup and Vector3.new(m.pickup[1], m.pickup[2] + 2, m.pickup[3])
    local dest = m.dest and Vector3.new(m.dest[1], m.dest[2] + 2, m.dest[3])

    if pickup and not m.away then
        setAutoStatus("Retrieving car at pickup point...", Color3.fromRGB(241, 196, 15))
        contractsToggle.SetStatus("Retrieving car at pickup point...", Color3.fromRGB(241, 196, 15))
        pcall(function() player:RequestStreamAroundAsync(pickup) end)

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if root then
            root.Anchored = true
            root.CFrame = CFrame.new(pickup)
            task.wait(0.8)
            root.Anchored = false
        end

        local car = workspace.Vehicles:FindFirstChild(player.Name .. " - Business")
        local seat = car and car:FindFirstChild("DriveSeat", true)
        if seat and hum then
            seat:Sit(hum)
            task.wait(0.5)
        end
    end

    if dest then
        setAutoStatus("Delivering vehicle to office garage...", Color3.fromRGB(52, 152, 219))
        contractsToggle.SetStatus("Delivering vehicle to office garage...", Color3.fromRGB(52, 152, 219))
        pcall(function() player:RequestStreamAroundAsync(dest) end)

        local car = workspace.Vehicles:FindFirstChild(player.Name .. " - Business")
        if car and car.PrimaryPart then
            car:SetPrimaryPartCFrame(CFrame.new(dest))
            for _, p in ipairs(car:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.AssemblyLinearVelocity = Vector3.zero
                    p.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
        task.wait(2.5)
    end

    Net.Call("go")

    -- Clean up, restore & repair all bays
    for slot = 1, 6 do
        Net.Call("restore", slot)
        Net.Call("repair", slot)
        Net.Call("prepAll", slot, {})
    end

    refreshBusiness()

    -- If contract resulted in a car stored in the garage, sell to highest buyer (the Collector)
    s = Net.State()
    local soldMsg = nil
    if s and s.bays then
        for sSlot, bayData in pairs(s.bays) do
            if bayData and bayData.car and bayData.kind ~= "service" and (not autoAuctionsActive or bayData.kind ~= "project") then
                contractsToggle.SetStatus("Delivering " .. tostring(bayData.display or bayData.car) .. " to Collector (+30%)...", C_ACCENT)
                local okSell, sold, msg = pcall(sellAndDeliverToCollector, sSlot)
                if okSell and sold then
                    soldMsg = msg
                end
                break
            end
        end
    end

    setAutoStatus("Contract completed & profit collected!", C_GREEN)
    contractsToggle.SetStatus(soldMsg or ("Delivered " .. tostring(best and best.display or "Vehicle") .. " (+$" .. tostring(maxProfit) .. ")"), C_GREEN)
    return true
end

local function runAuctionCycle()
    local Net = getNet()
    if not Net then return false, "No Net" end

    -- Check if car slots are full before bidding
    local slots = getBaySlots()
    if slots.isFull then
        local msg = string.format("All bays full (%d/%d) • Bidding paused", slots.occupied, slots.total)
        auctionsToggle.SetStatus(msg, Color3.fromRGB(241, 196, 15))
        return false, msg
    end

    local res = Net.Call("auctions")
    local lots = res and (res.lots or (res.auctions and res.auctions.lots))
    if not lots or #lots == 0 then
        return false, "No active auction lots"
    end

    local leaderstats = player:FindFirstChild("leaderstats")
    local cashObj = leaderstats and (leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Money"))
    local cash = cashObj and cashObj.Value or 999999999

    local bestLot = nil
    local bestProfit = 0
    local bestNextBid = 0
    local bestMaxBid = 0
    local bestFixCost = 0
    local minAffordableGap = 0
    local unaffordableCandidate = nil

    for _, lot in ipairs(lots) do
        -- Skip if we are currently the leading bidder
        local amLeading = (lot.you == true) or (lot.leader == player.Name)
        if not amLeading then
            local step = tonumber(lot.step) or 2000
            local price = tonumber(lot.price) or 0
            local nextBid = price + step
            local worth = tonumber(lot.worth) or 0
            local maxBid = math.min(nextBid + 2 * step, worth)

            -- Compute complete restoration fee for this car
            local fixCost = tonumber(lot.fixKnown) or (tonumber(lot.fixSeen) or 0)
            if lot.faults and type(lot.faults) == "table" then
                local faultSum = 0
                for _, f in ipairs(lot.faults) do
                    faultSum = faultSum + (tonumber(f.cost) or 0)
                end
                fixCost = math.max(fixCost, faultSum)
            end

            -- Total required: Max possible bid + complete restoration & repair fees
            local totalNeeded = maxBid + fixCost
            local estProfit = worth - nextBid - fixCost

            -- Must have enough cash left over to pay for BOTH the car AND all restoration fees!
            if cash >= totalNeeded and estProfit >= 10000 then
                if estProfit > bestProfit then
                    bestProfit = estProfit
                    bestLot = lot
                    bestNextBid = nextBid
                    bestMaxBid = maxBid
                    bestFixCost = fixCost
                end
            elseif estProfit >= 10000 and (cash < totalNeeded) then
                if not unaffordableCandidate or totalNeeded < minAffordableGap then
                    minAffordableGap = totalNeeded
                    unaffordableCandidate = lot
                end
            end
        end
    end

    if bestLot then
        local statusTxt = string.format("Bidding %s ($%d bid + $%d fix reserve)...", tostring(bestLot.display), bestNextBid, bestFixCost)
        auctionsToggle.SetStatus(statusTxt, C_ACCENT)
        local bidRes = Net.Call("bid", bestLot.tier, bestNextBid, bestMaxBid)
        if bidRes and bidRes.ok then
            local msg = string.format("Leading: %s @ $%d (+$%d profit | $%d fix reserved)", tostring(bestLot.display), bestNextBid, bestProfit, bestFixCost)
            setAutoStatus(msg, C_GREEN)
            auctionsToggle.SetStatus(msg, C_GREEN)
            return true, msg
        else
            local errMsg = (type(bidRes) == "table" and bidRes.message) or "Bid failed"
            auctionsToggle.SetStatus(errMsg, Color3.fromRGB(241, 196, 15))
            return false, errMsg
        end
    end

    if unaffordableCandidate then
        local msg = string.format("Need $%d for %s (Bid + Full Fix) • Cash: $%d", minAffordableGap, tostring(unaffordableCandidate.display), cash)
        auctionsToggle.SetStatus(msg, Color3.fromRGB(241, 196, 15))
        return false, msg
    end

    return false, "Watching lots (no profitable lots within full restoration budget)"
end

local function fixAllBays()
    local Net = getNet()
    if not Net then return false, "No Net" end
    local s = Net.State()
    if not s or not s.bays then return false, "No bays" end

    local leaderstats = player:FindFirstChild("leaderstats")
    local cashObj = leaderstats and (leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Money"))
    local cash = cashObj and cashObj.Value or 0

    local fixedAny = false
    local actions = {}

    for slot, bay in pairs(s.bays) do
        if bay and bay.car then
            local carName = tostring(bay.display or bay.car or slot)
            if bay.kind == "project" then
                -- Try restoring all faults on project car
                local resAll = Net.Call("restore", slot, "all")
                if resAll and resAll.ok then
                    fixedAny = true
                    table.insert(actions, carName .. " (Restored)")
                else
                    -- Restore individual faults player can afford
                    if bay.faults then
                        for _, fault in ipairs(bay.faults) do
                            if not fault.fixed then
                                local cost = tonumber(fault.cost) or 0
                                if cash >= cost then
                                    local resOne = Net.Call("restore", slot, fault.id)
                                    if resOne and resOne.ok then
                                        fixedAny = true
                                        cash = cash - cost
                                        table.insert(actions, carName .. " (" .. tostring(fault.label or fault.id) .. ")")
                                    end
                                end
                            end
                        end
                    end
                end
            elseif bay.kind == "service" then
                -- Customer service vehicle: wash, paint, plate, rims
                local spec = bay.spec or {}
                local picks = {
                    wash = (spec.washed ~= false),
                    paint = spec.paint,
                    plate = spec.plate,
                    rims = spec.rims
                }
                local resPrep = Net.Call("prepAll", slot, picks)
                if resPrep and resPrep.ok then
                    fixedAny = true
                    table.insert(actions, carName .. " (Prepped & Washed)")
                end
            else
                -- Contract or other vehicle
                Net.Call("repair", slot)
                Net.Call("prepAll", slot, {})
                fixedAny = true
                table.insert(actions, carName .. " (Repaired)")
            end
        end
    end

    if fixedAny then
        return true, table.concat(actions, ", ")
    else
        return false, "All vehicles inside business in top condition"
    end
end

