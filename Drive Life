-- ======================================================================
-- AUTOMATIC DISTANCE-BASED SPEED CALIBRATION & SAFE SKY CRUISE
-- Auto-calculates flight speed based on distance to office / delivery
-- Guarantees total travel time respects the server's anti-cheat limit
-- Lands with 0% impact damage using raycasted ground & tire clearance
-- ======================================================================
local function calculateTransitCalibration(startPos, targetPos, missionObj)
    local airDist = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(startPos.X, 0, startPos.Z)).Magnitude

    -- In Drive Life: Road distance is approx 1.35x to 1.5x Euclidean air distance.
    -- The server enforces MAX_SPEED = 260 studs/s along roads (ReplicatedStorage.Office.MAX_SPEED).
    -- By targeting a safe road speed of 180 studs/s, we guarantee transit can NEVER trigger "too quick".
    local roadDist = (missionObj and tonumber(missionObj.dist)) or (airDist * 1.45)
    local minSafeDuration = math.max(10, roadDist / 180)
    local calibratedSpeed = math.clamp(airDist / minSafeDuration, 75, 140)

    return calibratedSpeed, minSafeDuration, roadDist, airDist
end

local function glideVehicleTo(car, targetPos, maxSpeed, onProgress, missionObj)
    if not car or not car.PrimaryPart then return false end

    local startPos = car.PrimaryPart.Position
    local calSpeed, minSafeDuration, roadDist, totalDist = calculateTransitCalibration(startPos, targetPos, missionObj)
    maxSpeed = maxSpeed or calSpeed

    if totalDist < 25 then
        car:SetPrimaryPartCFrame(CFrame.new(targetPos))
        return true
    end

    -- High-altitude cruise: 750 studs Y (highest mountain/tree in map is Y=592)
    local cruiseY = math.max(startPos.Y + 250, targetPos.Y + 250, 750)
    local dirXZ = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(startPos.X, 0, startPos.Z)).Unit
    local velocity = Vector3.new(dirXZ.X * maxSpeed, 0, dirXZ.Z * maxSpeed)

    -- Phase 1: Straight vertical ascent into high clear airspace (clears local trees/roofs)
    local liftStart = car.PrimaryPart.Position
    local liftSteps = 16
    for i = 1, liftSteps do
        local alpha = i / liftSteps
        local smoothed = math.sin(alpha * math.pi / 2)
        local currentY = liftStart.Y + (cruiseY - liftStart.Y) * smoothed
        local lookPos = Vector3.new(liftStart.X + dirXZ.X * 10, currentY, liftStart.Z + dirXZ.Z * 10)
        car:SetPrimaryPartCFrame(CFrame.lookAt(Vector3.new(liftStart.X, currentY, liftStart.Z), lookPos))
        for _, p in ipairs(car:GetDescendants()) do
            if p:IsA("BasePart") then
                p.AssemblyLinearVelocity = Vector3.new(0, 15, 0)
                p.AssemblyAngularVelocity = Vector3.zero
            end
        end
        task.wait(0.04)
    end

    -- Phase 2: High-altitude cruise calibrated automatically by distance
    local curPos = car.PrimaryPart.Position
    local remaining = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(curPos.X, 0, curPos.Z)).Magnitude
    local lastTime = os.clock()

    while remaining > 35 do
        local dt = os.clock() - lastTime
        lastTime = os.clock()
        dt = math.clamp(dt, 0.01, 0.1)

        local stepDist = maxSpeed * dt
        curPos = curPos + Vector3.new(dirXZ.X * stepDist, 0, dirXZ.Z * stepDist)
        remaining = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(curPos.X, 0, curPos.Z)).Magnitude

        local targetLook = curPos + Vector3.new(dirXZ.X * 10, 0, dirXZ.Z * 10)
        car:SetPrimaryPartCFrame(CFrame.lookAt(curPos, targetLook))

        for _, part in ipairs(car:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = velocity
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end

        if onProgress then
            local etaSecs = math.ceil(remaining / maxSpeed)
            onProgress(remaining, totalDist, etaSecs)
        end

        task.wait(0.03)
    end

    -- Phase 3: Safe Feathered Landing (Raycast ground + Tire clearance = 0% Damage)
    pcall(function() player:RequestStreamAroundAsync(targetPos) end)

    local rayOrigin = Vector3.new(targetPos.X, targetPos.Y + 25, targetPos.Z)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = { car, player.Character }
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local groundHit = workspace:Raycast(rayOrigin, Vector3.new(0, -50, 0), rayParams)
    local groundY = groundHit and groundHit.Position.Y or targetPos.Y

    -- Calculate exact tire clearance to prevent ground clipping or drop impact
    local lowestPartY = math.huge
    for _, p in ipairs(car:GetDescendants()) do
        if p:IsA("BasePart") then
            local bottom = p.Position.Y - (p.Size.Y / 2)
            if bottom < lowestPartY then
                lowestPartY = bottom
            end
        end
    end
    local tireOffset = math.clamp(car.PrimaryPart.Position.Y - lowestPartY, 0.8, 3.5)
    local safeLandingPos = Vector3.new(targetPos.X, groundY + tireOffset + 0.12, targetPos.Z)

    -- Decelerate descent gently with feathered cushion
    local descentStart = car.PrimaryPart.Position
    local descentSteps = 24
    for i = 1, descentSteps do
        local alpha = i / descentSteps
        local smoothed = 1 - math.cos(alpha * math.pi / 2) -- Soft feathering near ground
        local currentPos = descentStart:Lerp(safeLandingPos, smoothed)
        local targetLook = currentPos + Vector3.new(dirXZ.X * 5, 0, dirXZ.Z * 5)
        car:SetPrimaryPartCFrame(CFrame.lookAt(currentPos, targetLook))

        for _, part in ipairs(car:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
        task.wait(0.04)
    end

    -- Final settle: 0 velocity cushion resting softly on wheels
    car:SetPrimaryPartCFrame(CFrame.new(safeLandingPos))
    for _, part in ipairs(car:GetDescendants()) do
        if part:IsA("BasePart") then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end

    return true
end

-- ======================================================================
-- RING HANDOVER WAITER WITH ANTI-CHEAT TIME LOCK
-- Enforces server minimum road duration + mandatory 6s hold (t.STILL = 6)
-- ======================================================================
local function waitForRingHandover(statusCallback, minSafeDuration, legStartTime)
    local Net = getNet()
    local waitStart = os.clock()
    legStartTime = legStartTime or waitStart
    minSafeDuration = minSafeDuration or 0
    local confirmed = false

    -- 1. If car reached ring faster than minimum server time, hold safely in ring until time clears
    local legElapsed = os.clock() - legStartTime
    if legElapsed < minSafeDuration then
        while os.clock() - legStartTime < minSafeDuration do
            local left = math.max(0, math.ceil(minSafeDuration - (os.clock() - legStartTime)))
            if statusCallback then
                statusCallback(string.format("Calibrating safe transit... (%ds left)", left))
            end
            task.wait(0.5)
        end
    end

    -- 2. Keep vehicle stationary inside ring. In Drive Life: t.STILL = 6 (requires 6s still hold)
    waitStart = os.clock()
    for i = 1, 16 do
        task.wait(0.5)
        local elapsed = os.clock() - waitStart
        if statusCallback then
            statusCallback(string.format("Parking in ring... (%ds / 7s)", math.floor(elapsed)))
        end
        local s = Net and Net.State()
        if not (s and s.mission) then
            confirmed = true
            break
        end
        if elapsed >= 7.5 then
            break
        end
    end

    task.wait(0.8)
    if Net then
        Net.Call("go")
    end
    refreshBusiness()
    return confirmed
end

local function runOneCustomer()
    local Net = getNet()
    if not Net then return false, "No Net" end
    local s = Net.State()
    local slots = getBaySlots(s)

    -- 1. Check if there is already a customer car waiting in a bay that needs to be returned
    local targetBay = nil
    local custData = nil

    if #slots.serviceBays > 0 then
        targetBay = slots.serviceBays[1]
        custData = s.bays and s.bays[targetBay]
    end

    -- 2. If no service car in bay, check capacity before taking a new customer from the door
    if not targetBay then
        if slots.isFull then
            local msg = string.format("All bays full (%d/%d) • Cannot take customer", slots.occupied, slots.total)
            customersToggle.SetStatus(msg, Color3.fromRGB(241, 196, 15))
            return false, msg
        end

        local cust = s.cust and s.cust.door and s.cust.door[1]
        if not cust then
            return false, "No customers at door"
        end

        local cName = tostring(cust.name or cust.who or "Client")
        setAutoStatus("Taking client: " .. cName, C_ACCENT)
        customersToggle.SetStatus("Accepting client " .. cName .. "...", C_ACCENT)

        local takeRes = Net.Call("custTake", cust.id)
        if not takeRes or not takeRes.ok then
            return false, "Failed to take customer"
        end

        task.wait(0.6)
        s = Net.State()
        if s.bays then
            for bId, b in pairs(s.bays) do
                if b.who == cust.who or b.name == cust.name or (b.car and b.car == cust.car) then
                    targetBay = bId
                    custData = b
                    break
                end
            end
        end
        if not targetBay then
            targetBay = slots.freeSlots[1] or "B1"
            custData = cust
        end
    end

    if not targetBay or not custData then
        return false, "No target bay found"
    end

    local cName = tostring(custData.name or custData.who or "Client")
    customersToggle.SetStatus("Prepping & washing order in " .. tostring(targetBay) .. "...", Color3.fromRGB(241, 196, 15))
    local spec = custData.spec or custData.order or {}
    local picks = {
        wash = (spec.wash == true or spec.washed == true),
        paint = spec.paint,
        plate = spec.plate,
        rims = spec.rims
    }
    Net.Call("prepAll", targetBay, picks)
    task.wait(0.2)
    Net.Call("restore", targetBay)
    Net.Call("repair", targetBay)
    task.wait(0.5)

    customersToggle.SetStatus("Starting delivery mission...", Color3.fromRGB(52, 152, 219))
    local retRes = Net.Call("custReturn", targetBay)
    task.wait(0.8)

    s = Net.State()
    local m = s.mission
    if m and m.dest then
        local dest = Vector3.new(m.dest[1], m.dest[2] + 2, m.dest[3])
        local car = workspace.Vehicles:FindFirstChild(player.Name .. " - Business")
        local seat = car and car:FindFirstChild("DriveSeat", true)
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")

        if seat and hum and seat.Occupant ~= hum then
            seat:Sit(hum)
            task.wait(0.5)
        end

        local legStart = os.clock()
        local calSpeed, minSafeDuration = calculateTransitCalibration(car.PrimaryPart.Position, dest, m)
        pcall(function() player:RequestStreamAroundAsync(dest) end)
        glideVehicleTo(car, dest, calSpeed, function(left, total, eta)
            local statusStr = string.format("Delivering order: %d studs left (ETA: %ds, calibrated)...", math.floor(left), eta)
            customersToggle.SetStatus(statusStr, C_GREEN)
            setAutoStatus(statusStr, C_GREEN)
        end, m)
        waitForRingHandover(function(txt)
            customersToggle.SetStatus(txt, C_GREEN)
            setAutoStatus(txt, C_GREEN)
        end, minSafeDuration, legStart)
    end

    setAutoStatus("Client order completed successfully!", C_GREEN)
    customersToggle.SetStatus("Order fulfilled for " .. cName, C_GREEN)
    return true
end

