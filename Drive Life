local function getBusinessCar()
    local vehFolder = workspace:FindFirstChild("Vehicles")
    if not vehFolder then return nil end
    local car = vehFolder:FindFirstChild(player.Name .. " - Business")
        or vehFolder:FindFirstChild(player.Name .. " - Service")
        or vehFolder:FindFirstChild(player.Name .. " - Project")
        or vehFolder:FindFirstChild(player.Name .. " - Auction")
    if car then return car end

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
        local m = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if m and isMissionOrRaceCar(m) then
            return m
        end
    end

    for _, v in ipairs(vehFolder:GetChildren()) do
        if isMissionOrRaceCar(v) and (v.Name:find(player.Name, 1, true) or v:GetAttribute("Owner") == player.Name) then
            return v
        end
    end
    return nil
end

local function resolveBayKey(slot, s)
    s = s or (getNet() and getNet().State())
    local num = tonumber(tostring(slot):match("%d+"))
    local strSlot = num and ("B" .. num) or tostring(slot)
    if s and s.bays then
        if s.bays[strSlot] then return strSlot end
        if s.bays[slot] then return slot end
        if num and s.bays[num] then return num end
    end
    return strSlot
end

local function callBayAction(action, slot, arg2, arg3)
    local Net = getNet()
    if not Net then return nil end

    local targetSlot = resolveBayKey(slot)

    local function invoke(s)
        if arg3 ~= nil then
            return Net.Call(action, s, arg2, arg3)
        elseif arg2 ~= nil then
            return Net.Call(action, s, arg2)
        else
            return Net.Call(action, s)
        end
    end

    local res
    for attempt = 1, 3 do
        res = invoke(targetSlot)
        if res and res.ok then
            return res
        end
        if type(res) == "table" and res.message == "One moment..." then
            task.wait(1.1)
        else
            break
        end
    end

    return res
end

-- ======================================================================
-- BUYER SPECIFICATION CUSTOMIZATION (PAINT, RIMS, WASH, PLATE, REPAIRS)
-- Extracts exact spec values (HEX paint, rim finish ID, plate, wash)
-- that are still needed according to ReplicatedStorage.Office
-- ======================================================================
local function getWantedPicks(slot, bayData)
    local picks = {}
    local Net = getNet()
    local s = Net and Net.State()
    local targetSlot = resolveBayKey(slot, s)

    if s and s.bays and s.bays[targetSlot] then
        bayData = s.bays[targetSlot]
    end
    if not bayData then
        return picks, nil
    end

    local spec = bayData.spec or bayData.order or bayData.collectorSpec or bayData.wanted or bayData.prep
    local look = bayData.look or {}

    if spec and type(spec) == "table" then
        -- 1. Paint (exact 6-char HEX string from spec.paint)
        if spec.paint then
            local wantedPaint = type(spec.paint) == "table" and (spec.paint.hex or spec.paint.id or spec.paint[1]) or tostring(spec.paint)
            if wantedPaint and string.upper(tostring(look.paint or "")) ~= string.upper(tostring(wantedPaint)) then
                picks.paint = tostring(wantedPaint)
            end
        end

        -- 2. Rims (exact finish id from spec.rims, only if bayData.rimsOk is true)
        if spec.rims and bayData.rimsOk ~= false then
            local wantedRims = type(spec.rims) == "table" and (spec.rims.id or spec.rims[1]) or tostring(spec.rims)
            if wantedRims and tostring(look.rims or "stock") ~= tostring(wantedRims) then
                picks.rims = tostring(wantedRims)
            end
        end

        -- 3. Plate (exact text from spec.plate)
        if spec.plate then
            local wantedPlate = type(spec.plate) == "table" and (spec.plate.text or spec.plate.plate or spec.plate[1]) or tostring(spec.plate)
            if wantedPlate and tostring(look.plate or "") ~= tostring(wantedPlate) then
                picks.plate = tostring(wantedPlate)
            end
        end

        -- 4. Wash (boolean)
        local wantsWash = (spec.washed ~= false and spec.wash ~= false and spec.clean ~= false)
        if wantsWash and look.washed ~= true then
            picks.wash = true
        end
    end

    return picks, spec
end

-- Multi-Bay Deliverable Car Detection & Readiness Evaluator
-- Supports targetKind: "contract" (strictly contract cars, ignores auction/project), "project" (only project cars), or nil (all deliverable)
local function getAllDeliverableBayCars(s, targetKind)
    if not s or not s.bays then return {} end
    local maxBays = tonumber(s.bayCount) or (s.garage and s.garage.bays and #s.garage.bays) or 6
    local candidates = {}
    local now = os.clock()

    local leaderstats = player:FindFirstChild("leaderstats")
    local cashObj = leaderstats and (leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Money"))
    local cash = cashObj and cashObj.Value or 0

    local checkedSlots = {}
    local function checkSlot(slotKey)
        if checkedSlots[slotKey] then return end
        checkedSlots[slotKey] = true

        local bayData = s.bays[slotKey]
        if not bayData or type(bayData) ~= "table" then return end
        if not (bayData.car or bayData.display or bayData.model or bayData.state or bayData.kind) then return end
        if bayData.kind == "service" then return end -- Service cars belong to client order flow

        -- Target kind filtering
        if targetKind == "contract" then
            if bayData.kind == "project" then return end -- Strictly ignore auction project cars
        elseif targetKind == "project" then
            if bayData.kind ~= "project" then return end -- Strictly only auction project cars
        end

        local faultCount = 0
        local totalFixCost = 0
        if bayData.faults and type(bayData.faults) == "table" then
            for _, f in ipairs(bayData.faults) do
                if type(f) == "table" and f.state ~= "fixed" and f.fixed ~= true then
                    faultCount = faultCount + 1
                    totalFixCost = totalFixCost + (tonumber(f.cost) or 0)
                end
            end
        end

        local isReady = (faultCount == 0)
        local canAffordFix = isReady or (cash >= totalFixCost)
        local onCooldown = (slotSellCooldown[tostring(slotKey)] and slotSellCooldown[tostring(slotKey)] > now)

        table.insert(candidates, {
            slot = slotKey,
            data = bayData,
            isReady = isReady,
            faultCount = faultCount,
            totalFixCost = totalFixCost,
            canAffordFix = canAffordFix,
            onCooldown = onCooldown,
            cooldownUntil = slotSellCooldown[tostring(slotKey)] or 0
        })
    end

    -- Check numbered bays 1 .. maxBays
    for i = 1, maxBays do
        checkSlot("B" .. i)
    end
    -- Fallback for any other keys in s.bays
    for k, _ in pairs(s.bays) do
        checkSlot(k)
    end

    -- Sort candidates:
    -- 1. Not on cooldown > on cooldown
    -- 2. Fully ready (0 faults / restored) > Needs fix
    -- 3. Can afford fix > cannot afford fix
    -- 4. Fewer faults
    table.sort(candidates, function(a, b)
        if a.onCooldown ~= b.onCooldown then
            return not a.onCooldown
        end
        if a.isReady ~= b.isReady then
            return a.isReady
        end
        if a.canAffordFix ~= b.canAffordFix then
            return a.canAffordFix
        end
        if a.faultCount ~= b.faultCount then
            return a.faultCount < b.faultCount
        end
        return tostring(a.slot) < tostring(b.slot)
    end)

    return candidates
end

local function getDeliverableContractCar(s)
