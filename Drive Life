    local xp = xpVal and tonumber(xpVal.Value) or 0
    local sessionCash = tonumber(player:GetAttribute("ShiftEarned")) or (sessVal and tonumber(sessVal.Value)) or 0
    local totalCash = totVal and tonumber(totVal.Value) or 0

    local levelNum = 1
    local payMult = 1
    local nextLvlXP = nil

    pcall(function()
        local cmj = ReplicatedStorage:FindFirstChild("CarMechanicJob")
        if cmj then
            local getLvl = require(cmj.Client.getMechanicLevel)
