local function createToggle(parent, titleText, descText, defaultState, pos, size, onToggle)
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = Color3.fromRGB(20, 23, 28)
    frame.BorderSizePixel = 0
    frame.Position = pos or UDim2.new(0, 0, 0, 0)
    frame.Size = size or UDim2.new(1, 0, 0, 46)
    frame.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = defaultState and C_GREEN or C_STROKE
    stroke.Thickness = 1
    stroke.Parent = frame

    local tLabel = Instance.new("TextLabel")
    tLabel.Text = titleText
    tLabel.Font = Enum.Font.GothamBold
    tLabel.TextSize = 12
    tLabel.TextColor3 = C_TEXT
    tLabel.TextXAlignment = Enum.TextXAlignment.Left
    tLabel.Position = UDim2.new(0, 12, 0, 7)
    tLabel.Size = UDim2.new(1, -85, 0, 16)
    tLabel.BackgroundTransparency = 1
    tLabel.Parent = frame

    local dLabel = Instance.new("TextLabel")
    dLabel.Text = descText
    dLabel.Font = Enum.Font.Gotham
    dLabel.TextSize = 10
    dLabel.TextColor3 = C_MUTED
    dLabel.TextXAlignment = Enum.TextXAlignment.Left
    dLabel.Position = UDim2.new(0, 12, 0, 24)
    dLabel.Size = UDim2.new(1, -85, 0, 14)
    dLabel.BackgroundTransparency = 1
    dLabel.Parent = frame

    local switchBtn = Instance.new("TextButton")
    switchBtn.Text = defaultState and "ON" or "OFF"
    switchBtn.Font = Enum.Font.GothamBold
    switchBtn.TextSize = 11
    switchBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    switchBtn.BackgroundColor3 = defaultState and C_GREEN or Color3.fromRGB(45, 50, 60)
    switchBtn.Position = UDim2.new(1, -64, 0.5, -13)
    switchBtn.Size = UDim2.fromOffset(52, 26)
    switchBtn.Parent = frame

    local switchCorner = Instance.new("UICorner")
    switchCorner.CornerRadius = UDim.new(0, 13)
    switchCorner.Parent = switchBtn

    local state = defaultState

    local function updateVisuals()
        if state then
            switchBtn.Text = "ON"
            switchBtn.BackgroundColor3 = C_GREEN
            stroke.Color = C_GREEN
        else
            switchBtn.Text = "OFF"
            switchBtn.BackgroundColor3 = Color3.fromRGB(45, 50, 60)
            stroke.Color = C_STROKE
        end
    end

    switchBtn.MouseButton1Click:Connect(function()
        state = not state
        updateVisuals()
        if onToggle then
            onToggle(state)
        end
    end)

    return {
        Frame = frame,
        GetState = function() return state end,
        SetState = function(val)
            state = val
            updateVisuals()
            if onToggle then onToggle(state) end
        end,
        SetStatus = function(txt, col)
            dLabel.Text = tostring(txt)
            dLabel.TextColor3 = col or C_MUTED
        end
    }
end

