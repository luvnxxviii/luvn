            continue
        end

        local Net = getNet()
        if not Net then continue end
        local s = Net.State()
        local slots = getBaySlots(s)
        local hasActiveMission = s and s.mission ~= nil

        -- -------------------------------------------------------------
        -- PRIORITY 1: AUTO CONTRACTS
        -- (Must finish all board contracts first. Yields only when board has 0 untaken offers)
        -- -------------------------------------------------------------
        local contractsHasWork = false
        local nextBoardTime = 0
        local untakenContracts = 0

        if autoContractsActive then
            if hasActiveMission and not (s.mission.buyer or s.mission.destName) then
                contractsHasWork = true
            elseif slots.isFull then
                contractsToggle.SetStatus(string.format("Bays full (%d/%d) • Contracts paused", slots.occupied, slots.total), Color3.fromRGB(241, 196, 15))
                contractsHasWork = false
            else
                local untaken, nextRefresh = checkContractBoard()
                untakenContracts = untaken
                nextBoardTime = nextRefresh
                local serverTime = workspace:GetServerTimeNow()
                local secsLeft = math.max(0, math.floor(nextBoardTime - serverTime))
                local timeStr = string.format("%d:%02d", secsLeft // 60, secsLeft % 60)

                if untaken > 0 then
                    contractsHasWork = true
                else
                    contractsToggle.SetStatus(string.format("Board cleared (0 left) • Yielding to Auctions • Next in %s", timeStr), Color3.fromRGB(52, 152, 219))
                    contractsHasWork = false
                end
            end
        end

        if contractsHasWork then
            -- CONTRACTS RUNS! Priority 2 (Auctions) and Priority 3 (Customers) yield.
            if autoAuctionsActive then
                auctionsToggle.SetStatus("Queued (Priority 2) • Waiting for Contracts to finish board", C_MUTED)
            end
            if autoCustomersActive then
                customersToggle.SetStatus("Queued (Priority 3) • Waiting for Contracts to finish", C_MUTED)
            end

            missionBusy = true
            local ok, success, code, extra = pcall(runOneContract)
            missionBusy = false
            boardCache.checkedAt = 0 -- refresh board state immediately

            if ok and success then
                task.wait(1.5)
            else
                task.wait(2.5)
            end
            continue
        end

        -- -------------------------------------------------------------
        -- PRIORITY 2: AUTO AUCTIONS
        -- (Runs when Contracts has cleared the board or is disabled)
        -- -------------------------------------------------------------
        local auctionsHasWork = false
        local projectBay = (slots.projectBays and slots.projectBays[1])

        if autoAuctionsActive then
            if projectBay then
                auctionsHasWork = true
            elseif not slots.isFull then
                auctionsHasWork = true
            else
                auctionsToggle.SetStatus(string.format("Bays full (%d/%d) • Bidding paused", slots.occupied, slots.total), Color3.fromRGB(241, 196, 15))
                auctionsHasWork = false
            end
        end

        if auctionsHasWork then
            -- Sub-step A: If a won project car is in a garage bay, restore and sell to Collector (+30%)
            if projectBay then
                if autoCustomersActive then
                    customersToggle.SetStatus("Queued (Priority 3) • Waiting for Auction car delivery", C_MUTED)
                end

                missionBusy = true
                auctionsToggle.SetStatus("Fixing & delivering won car to Collector (+30%)...", C_ACCENT)
                local ok, sold, msg = pcall(sellAndDeliverToCollector, projectBay)
                missionBusy = false

                if ok and sold then
                    auctionsToggle.SetStatus(tostring(msg), C_GREEN)
                    task.wait(2)
                else
                    auctionsToggle.SetStatus("Sale: " .. tostring(msg), Color3.fromRGB(241, 196, 15))
                    task.wait(3.5)
