-- ======================================================================
-- PRIORITY AUTOMATION COORDINATOR (1: CONTRACTS > 2: AUCTIONS > 3: CUSTOMERS)
-- ======================================================================
task.spawn(function()
    while hubAlive do
        task.wait(0.7)

        -- Mutex: wait if player is physically on the road / delivering
        if missionBusy then
            continue
        end

        -- Idle if none of the 3 main business toggles are active
        if not (autoContractsActive or autoAuctionsActive or autoCustomersActive) then
            continue
        end

        local Net = getNet()
        if not Net then continue end
        local s = Net.State()
        local slots = getBaySlots(s)
        local hasActiveMission = s and s.mission ~= nil

        -- -------------------------------------------------------------
        -- PRIORITY 1: AUTO CONTRACTS (BATCH RETRIEVAL -> CUSTOMIZE -> DELIVER)
        -- -------------------------------------------------------------
        local contractsHasWork = false
        local nextBoardTime = 0
        local untakenContracts = 0

        if autoContractsActive then
            if hasActiveMission and (s.mission.buyer or s.mission.destName or s.mission.kind == "sell") then
                contractsHasWork = "deliver_sale_in_progress"
            elseif hasActiveMission and not (s.mission.buyer or s.mission.destName) then
                contractsHasWork = "retrieve_in_progress"
            else
                local untaken, nextRefresh = checkContractBoard()
                untakenContracts = untaken
                nextBoardTime = nextRefresh

                -- Check if any deliverable contract car is inside the business bays
                -- (Excludes auction project cars so Auto Contracts solely focuses on contracts!)
                local deliverSlot, deliverData = getDeliverableContractCar(s)

                if deliverSlot and deliverData then
                    -- Deliverable contract car detected! Customize to buyer spec and deliver to Collector (+30%)!
                    contractsHasWork = "deliver_bay_car"
                elseif not slots.isFull and untaken > 0 then
                    -- Bays open and contracts available on board -> retrieve next contract
                    contractsHasWork = "retrieve_next"
                elseif untaken == 0 and not deliverSlot then
                    -- Board cleared & garage bays empty of contract cars -> yield to Priority 2 (Auctions)
                    local serverTime = workspace:GetServerTimeNow()
                    local secsLeft = math.max(0, math.floor(nextBoardTime - serverTime))
                    local timeStr = string.format("%d:%02d", secsLeft // 60, secsLeft % 60)
                    contractsToggle.SetStatus(string.format("Board cleared (0 left) • Yielding to Auctions • New in %s", timeStr), Color3.fromRGB(52, 152, 219))
                    contractsHasWork = false
                end
            end
        end

        if contractsHasWork == "deliver_sale_in_progress" then
            if autoAuctionsActive then auctionsToggle.SetStatus("Queued (Priority 2) • Waiting for Contracts delivery", C_MUTED) end
            if autoCustomersActive then customersToggle.SetStatus("Queued (Priority 3) • Waiting for Contracts delivery", C_MUTED) end

            contractsToggle.SetStatus("Delivering active sale car to Collector (+30%)...", C_ACCENT)
            setAutoStatus("Delivering active sale car to Collector...", C_ACCENT)
            missionBusy = true
            local okSell, sold, msg = pcall(sellAndDeliverToCollector, s.mission.slot or "B1")
            missionBusy = false

            if okSell and sold then
                contractsToggle.SetStatus("Sold to Collector (+30%)!", C_GREEN)
                setAutoStatus("Sold to Collector (+30%)", C_GREEN)
                task.wait(2)
            else
                contractsToggle.SetStatus("Sale: " .. tostring(msg), Color3.fromRGB(241, 196, 15))
                task.wait(3)
            end
            continue
        elseif contractsHasWork == "retrieve_next" or contractsHasWork == "retrieve_in_progress" then
            if autoAuctionsActive then auctionsToggle.SetStatus("Queued (Priority 2) • Waiting for Contracts batch", C_MUTED) end
            if autoCustomersActive then customersToggle.SetStatus("Queued (Priority 3) • Waiting for Contracts batch", C_MUTED) end

            contractsToggle.SetStatus(string.format("Filling Garage (%d/%d bays) • Retrieving contract car...", slots.occupied, slots.total), C_ACCENT)
            missionBusy = true
            local ok, success, code, extra = pcall(runOneContract)
            missionBusy = false
            boardCache.checkedAt = 0

            task.wait(1.5)
            continue
        elseif contractsHasWork == "deliver_bay_car" then
            if autoAuctionsActive then auctionsToggle.SetStatus("Queued (Priority 2) • Waiting for Contracts delivery", C_MUTED) end
            if autoCustomersActive then customersToggle.SetStatus("Queued (Priority 3) • Waiting for Contracts delivery", C_MUTED) end

            local deliverCandidates = getAllDeliverableBayCars(s, "contract")
            local soldAny = false
            for _, cand in ipairs(deliverCandidates) do
                if not cand.onCooldown then
                    local targetSlot = cand.slot
                    local targetData = cand.data
                    local carName = tostring(targetData.display or targetData.car or targetSlot)

                    -- 1. Customize to buyer's requested spec (paint, rims, wash, plate, restore faults, repair)
                    contractsToggle.SetStatus("Customizing " .. carName .. " in " .. tostring(targetSlot) .. " to Buyer Spec...", Color3.fromRGB(241, 196, 15))
                    setAutoStatus("Customizing " .. carName .. " in " .. tostring(targetSlot) .. " to buyer specifications...", Color3.fromRGB(241, 196, 15))
                    local okCust, custSuccess, custDesc, actualSlot = pcall(customizeCarToBuyerSpec, targetSlot, targetData)
                    actualSlot = (okCust and custSuccess and actualSlot) or targetSlot

                    -- 2. Deliver to The Collector (+30%)
                    contractsToggle.SetStatus("Delivering " .. carName .. " in " .. tostring(actualSlot) .. " to Collector (+30%)...", C_ACCENT)
                    setAutoStatus("Delivering " .. carName .. " to Collector...", C_ACCENT)
                    missionBusy = true
                    local okSell, sold, msg = pcall(sellAndDeliverToCollector, actualSlot, true)
                    missionBusy = false

                    if okSell and sold then
                        contractsToggle.SetStatus("Sold " .. carName .. " in " .. tostring(actualSlot) .. " to Collector (+30%)! (" .. tostring(custDesc) .. ")", C_GREEN)
                        setAutoStatus("Sold " .. carName .. " to Collector (+30%)", C_GREEN)
                        soldAny = true
                        task.wait(2)
                        break
                    else
                        slotSellCooldown[tostring(actualSlot)] = os.clock() + 25
                        contractsToggle.SetStatus(tostring(actualSlot) .. " Sale: " .. tostring(msg) .. " • Trying next bay...", Color3.fromRGB(241, 196, 15))
                        task.wait(1)
                    end
                end
            end
            if soldAny then
                continue
            end
        end

        -- -------------------------------------------------------------
        -- PRIORITY 2: AUTO AUCTIONS
        -- (Runs when Contracts has cleared the board or is disabled)
        -- -------------------------------------------------------------
        local auctionsHasWork = false
        local deliverableAuctionCars = getAllDeliverableBayCars(s, "project")
        local projectCand = deliverableAuctionCars[1]
        local projectBay = projectCand and projectCand.slot

        if autoAuctionsActive then
            if projectBay then
                auctionsHasWork = true
            elseif not slots.isFull then
                auctionsHasWork = true
            else
                auctionsToggle.SetStatus(string.format("Bays full (%d/%d) • Bidding paused", slots.occupied, slots.total), Color3.fromRGB(241, 196, 15))
                auctionsHasWork = false
            end
        end

        if auctionsHasWork then
            -- Sub-step A: If a won project car is in a garage bay, restore and sell to Collector (+30%)
            if projectBay then
                if autoCustomersActive then
                    customersToggle.SetStatus("Queued (Priority 3) • Waiting for Auction car delivery", C_MUTED)
                end

                missionBusy = true
                auctionsToggle.SetStatus("Fixing & delivering won car in " .. tostring(projectBay) .. " to Collector (+30%)...", C_ACCENT)
                local ok, sold, msg = pcall(sellAndDeliverToCollector, projectBay)
                missionBusy = false

                if ok and sold then
                    auctionsToggle.SetStatus(tostring(msg), C_GREEN)
                    task.wait(2)
                else
                    slotSellCooldown[tostring(projectBay)] = os.clock() + 25
                    auctionsToggle.SetStatus(tostring(projectBay) .. " Sale: " .. tostring(msg), Color3.fromRGB(241, 196, 15))
                    task.wait(2)
                end
                continue
            end

            -- Sub-step B: Evaluate and bid on auction lots
            local okBid, bidSuccess, bidMsg = pcall(runAuctionCycle)
            if okBid and bidSuccess then
                -- Successfully placed a bid or leading lot
                task.wait(3.5)
                continue
            else
                -- No profitable lot or already leading all lots!
                -- If Customers is active, yield so it can serve clients while waiting on auction lots
                if autoCustomersActive then
                    auctionsToggle.SetStatus(tostring(bidMsg) .. " • Yielding to Customers", Color3.fromRGB(241, 196, 15))
                end
            end
        end

        -- -------------------------------------------------------------
        -- PRIORITY 3: AUTO CUSTOMERS
        -- (Runs when Contracts has no board offers AND Auctions has no car to deliver or bids to place)
        -- -------------------------------------------------------------
        if autoCustomersActive then
            local hasDoorCust = s and s.cust and s.cust.door and #s.cust.door > 0
            local hasServiceBay = #slots.serviceBays > 0

            if hasServiceBay or (hasDoorCust and not slots.isFull) then
                missionBusy = true
                local ok, res = pcall(runOneCustomer)
                missionBusy = false
                task.wait(2)
                continue
            elseif slots.isFull and not hasServiceBay then
                customersToggle.SetStatus(string.format("Bays full (%d/%d) • Client work paused", slots.occupied, slots.total), Color3.fromRGB(241, 196, 15))
            else
                customersToggle.SetStatus("Watching office door for clients...", C_MUTED)
            end
        end
    end
end)

