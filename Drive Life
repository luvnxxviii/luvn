-- Helper to find active race gates (supports Street Races, Playlist Races, Reverse tracks)
local function getActiveRaceGates()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local car = hum and hum.SeatPart and hum.SeatPart:FindFirstAncestorOfClass("Model")
    local mover = (car and car.PrimaryPart) or (char and char:FindFirstChild("HumanoidRootPart"))
    local myPos = mover and mover.Position or Vector3.zero

    -- Collect all candidate race folders across workspace
    local candidates = {}
    local function checkFolder(parent)
        if not parent then return end
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("Folder") or obj:IsA("Model") then
                local cp1 = obj:FindFirstChild("Checkpoint1")
                local finish = obj:FindFirstChild("FinishLine")
                if cp1 or finish then
                    table.insert(candidates, obj)
                end
            end
        end
        if parent:FindFirstChild("Checkpoint1") or parent:FindFirstChild("FinishLine") then
            table.insert(candidates, parent)
        end
    end

    checkFolder(workspace:FindFirstChild("Track"))
    checkFolder(workspace:FindFirstChild("Races"))
    checkFolder(workspace)

    -- Find the candidate whose start or checkpoints are closest to the player's current vehicle
    local bestFolder = nil
    local bestDist = math.huge

    for _, f in ipairs(candidates) do
        local cp1 = f:FindFirstChild("Checkpoint1")
        local finish = f:FindFirstChild("FinishLine")
        local start = f:FindFirstChild("StartCircle") or f:FindFirstChild("StartPos1") or cp1
        if start and start:IsA("BasePart") then
            local dist = (start.Position - myPos).Magnitude
            if dist < bestDist then
                bestDist = dist
                bestFolder = f
            end
        elseif cp1 and cp1:IsA("BasePart") then
            local dist = (cp1.Position - myPos).Magnitude
            if dist < bestDist then
                bestDist = dist
                bestFolder = f
            end
        end
    end

    if not bestFolder then
        return nil, nil, nil
    end

    -- Gather all track curve waypoints (following natural road spline)
    local waypoints = {}
    for _, c in ipairs(bestFolder:GetChildren()) do
        if c.Name:match("^Checkpoint%d+$") and c:IsA("BasePart") then
            local num = tonumber(c.Name:match("%d+"))
            table.insert(waypoints, {
                part = c,
                num = num,
                isGate = (c:GetAttribute("DLFill") ~= true)
            })
        end
    end
    table.sort(waypoints, function(a, b) return a.num < b.num end)

    local finish = bestFolder:FindFirstChild("FinishLine")

    -- Detect forward vs reverse track orientation
    if #waypoints > 1 then
        local cp1 = waypoints[1].part
        local cpLast = waypoints[#waypoints].part

        local distToCp1 = cp1 and (cp1.Position - myPos).Magnitude or math.huge
        local distToCpLast = cpLast and (cpLast.Position - myPos).Magnitude or math.huge

        if distToCpLast < distToCp1 and distToCpLast < 200 then
            -- Reverse track direction! Sort descending (N down to 1)
            table.sort(waypoints, function(a, b) return a.num > b.num end)
        else
            -- Forward track direction! Sort ascending (1 up to N)
            table.sort(waypoints, function(a, b) return a.num < b.num end)
        end
    end

    return waypoints, finish, bestFolder.Name
end

local function executeCalibratedRaceTraversal()
    local waypoints, finish, trackName = getActiveRaceGates()
    if not waypoints or #waypoints == 0 or not finish then
        if raceStatusLabel then
            raceStatusLabel.Text = "Status: No active race track or checkpoints found"
            raceStatusLabel.TextColor3 = Color3.fromRGB(241, 196, 15)
        end
        return false, "No gates found"
    end

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local car = hum and hum.SeatPart and hum.SeatPart:FindFirstAncestorOfClass("Model")
    if not car or not car.PrimaryPart then
        if raceStatusLabel then
            raceStatusLabel.Text = "Status: Sit in a vehicle first"
            raceStatusLabel.TextColor3 = C_RED
        end
        return false, "No vehicle"
    end

    local cruiseSpeed = 180 -- studs/s (~124 mph, smooth centerline curve navigation, legal lap pacing)
    local raceFinished = false

    local raceEvents = ReplicatedStorage:FindFirstChild("RaceEvents")
    local connFinish
    if raceEvents and raceEvents:FindFirstChild("PlayerFinished") then
        connFinish = raceEvents.PlayerFinished.OnClientEvent:Connect(function()
            raceFinished = true
        end)
    end

    local function cleanup()
        if connFinish then connFinish:Disconnect() end
        for _, p in ipairs(car:GetDescendants()) do
            if p:IsA("BasePart") then
                p.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end

    -- 1. COUNTDOWN SYNCHRONIZATION (WAIT FIRMLY UNTIL GREEN LIGHT / GO!)
    local HttpService = game:GetService("HttpService")
    local function getPhase()
        local attr = ReplicatedStorage:GetAttribute("DLTrackRace")
        if type(attr) == "string" and attr ~= "" then
            local s, d = pcall(function() return HttpService:JSONDecode(attr) end)
            if s and type(d) == "table" and d.phase then
                return tostring(d.phase):lower()
            end
        end
        return nil
    end

    local curPhase = getPhase()
    if curPhase ~= "racing" then
        local raceStartedFired = false
        local connStarted
        if raceEvents and raceEvents:FindFirstChild("RaceStarted") then
            connStarted = raceEvents.RaceStarted.OnClientEvent:Connect(function()
                raceStartedFired = true
            end)
        end

        local waitStart = os.clock()
        while raceAutoRunning and not raceStartedFired and (os.clock() - waitStart < 35) do
            local p = getPhase()
            if p == "racing" then break end

            local pg = player:FindFirstChild("PlayerGui")
            local isCountdownGui = false
            if pg then
                local preRace = pg:FindFirstChild("DLPreRace")
                local raceStart = pg:FindFirstChild("DLRaceStart")
                if (preRace and preRace.Enabled) or (raceStart and raceStart.Enabled) then
                    isCountdownGui = true
                end
            end

            if raceStatusLabel then
                local labelPhase = p or (isCountdownGui and "countdown" or "grid")
                raceStatusLabel.Text = string.format("Holding grid • [%s] Waiting for GO!...", labelPhase:upper())
                raceStatusLabel.TextColor3 = Color3.fromRGB(241, 196, 15)
            end

            -- Firmly anchor car on starting line during countdown
            for _, bp in ipairs(car:GetDescendants()) do
                if bp:IsA("BasePart") then
                    bp.AssemblyLinearVelocity = Vector3.zero
                    bp.AssemblyAngularVelocity = Vector3.zero
                end
            end

            if not p and not isCountdownGui and (os.clock() - waitStart > 3.0) then
                break
            end

            task.wait(0.15)
        end
        if connStarted then connStarted:Disconnect() end
        task.wait(0.4) -- Safety buffer after GO! so game grid barriers drop
    end

    if not raceAutoRunning then
        cleanup()
        return false
    end

    -- 2. FIND CLOSEST NODE AHEAD OF VEHICLE
    local myPos = car.PrimaryPart.Position
    local startIdx = 1
    local minDist = math.huge
    for i, wp in ipairs(waypoints) do
        local d = (wp.part.Position - myPos).Magnitude
        if d < minDist then
            minDist = d
            startIdx = i
        end
    end

    -- 3. TRAVERSE ALONG TRACK CENTERLINE (ZERO WALL & CAR CONTACT)
    local lapNumber = 1
    while raceAutoRunning and not raceFinished do
        for idx = startIdx, #waypoints do
            if not raceAutoRunning or raceFinished then break end
            local node = waypoints[idx]
            local targetPos = node.part.Position + Vector3.new(0, 1.2, 0)
            local startP = car.PrimaryPart.Position
            local dist = (targetPos - startP).Magnitude
            local dur = dist / cruiseSpeed
            local t0 = os.clock()
            local dir = dist > 0.1 and (targetPos - startP).Unit or Vector3.new(0, 0, 1)

            -- Drift angle calculation (High-score slides while floating to checkpoints)
            local driftAngle = 0
            local driftSide = 1
            if autoDriftActive then
                if waypoints[idx + 1] then
                    local nextP = waypoints[idx + 1].part.Position
                    local nextDir = (nextP - targetPos).Unit
                    local crossY = dir.X * nextDir.Z - dir.Z * nextDir.X
                    if math.abs(crossY) > 0.015 then
                        driftSide = crossY > 0 and -1 or 1
                    end
                else
                    driftSide = (idx % 2 == 0) and 1 or -1
                end
                driftAngle = 38 * driftSide
            end

            if raceStatusLabel then
                local modeTag = autoDriftActive and string.format("Drifting %d°", math.abs(driftAngle)) or "Clean Line"
                raceStatusLabel.Text = string.format("Lap %d • Node %d/%d (%s) • %s • 180 st/s", lapNumber, idx, #waypoints, node.part.Name, modeTag)
                raceStatusLabel.TextColor3 = autoDriftActive and Color3.fromRGB(155, 89, 182) or C_ACCENT
            end

            while os.clock() - t0 < dur do
                if not raceAutoRunning or raceFinished then break end
                local alpha = math.clamp((os.clock() - t0) / dur, 0, 1)
                local curPos = startP:Lerp(targetPos, alpha)
                local baseCF = CFrame.lookAt(curPos, curPos + dir * 5)
                local lookCF = autoDriftActive and (baseCF * CFrame.Angles(0, math.rad(driftAngle), math.rad(driftSide * 3))) or baseCF
                car:SetPrimaryPartCFrame(lookCF)

                for _, p in ipairs(car:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.AssemblyLinearVelocity = dir * cruiseSpeed
                        p.AssemblyAngularVelocity = autoDriftActive and Vector3.new(0, math.rad(driftSide * 15), 0) or Vector3.zero
                    end
                end
                RunService.Heartbeat:Wait()
            end

            if node.isGate then
                pcall(function()
                    if firetouchinterest then
                        firetouchinterest(car.PrimaryPart, node.part, 0)
                        task.wait(0.01)
                        firetouchinterest(car.PrimaryPart, node.part, 1)
                    end
                end)
            end
        end

        -- Finish line crossing
        if raceAutoRunning and not raceFinished and finish then
            local targetPos = finish.Position + Vector3.new(0, 1.2, 0)
            local startP = car.PrimaryPart.Position
            local dist = (targetPos - startP).Magnitude
            local dur = dist / cruiseSpeed
            local t0 = os.clock()
            local dir = dist > 0.1 and (targetPos - startP).Unit or Vector3.new(0, 0, 1)

            if raceStatusLabel then
                raceStatusLabel.Text = "Crossing Finish Line (1st Place)..."
                raceStatusLabel.TextColor3 = C_GREEN
            end

            local finishDrift = autoDriftActive and 35 or 0
            while os.clock() - t0 < dur do
                if not raceAutoRunning or raceFinished then break end
                local alpha = math.clamp((os.clock() - t0) / dur, 0, 1)
                local curPos = startP:Lerp(targetPos, alpha)
                local baseCF = CFrame.lookAt(curPos, curPos + dir * 5)
                local lookCF = autoDriftActive and (baseCF * CFrame.Angles(0, math.rad(finishDrift), 0)) or baseCF
                car:SetPrimaryPartCFrame(lookCF)

                for _, p in ipairs(car:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.AssemblyLinearVelocity = dir * cruiseSpeed
                        p.AssemblyAngularVelocity = autoDriftActive and Vector3.new(0, math.rad(15), 0) or Vector3.zero
                    end
                end
                RunService.Heartbeat:Wait()
            end

            pcall(function()
                if firetouchinterest then
                    firetouchinterest(car.PrimaryPart, finish, 0)
                    task.wait(0.01)
                    firetouchinterest(car.PrimaryPart, finish, 1)
                end
            end)
        end

        lapNumber = lapNumber + 1
        startIdx = 1
        task.wait(0.3)
        if not hum or not hum.SeatPart or raceFinished then break end
    end

    cleanup()
    if raceStatusLabel then
        raceStatusLabel.Text = "Race Complete! 1st Place • 0 Contact • 3/3 Stars"
        raceStatusLabel.TextColor3 = C_GREEN
    end
    return true
end

