local function getNet()
    local ps = player:FindFirstChild("PlayerScripts")
    local off = ps and ps:FindFirstChild("Office")
    local netMod = off and off:FindFirstChild("Net")
    if netMod and netMod:IsA("ModuleScript") then
        local ok, res = pcall(require, netMod)
        if ok and res then return res end
    end
    return nil
end

local function getBaySlots(s)
    if not s or not s.bayCount then
        local Net = getNet()
        if Net then s = Net.State() end
    end
    s = s or {}

    local maxBays = tonumber(s.bayCount) or (s.garage and s.garage.bays and #s.garage.bays) or 3
    local bays = s.bays or {}
    local occupied = 0
    local freeSlots = {}
    local occupiedSlots = {}
    local serviceBays = {}
    local projectBays = {}

    for i = 1, maxBays do
        local slotId = "B" .. i
        local bayData = bays[slotId]
        if bayData and (bayData.car or bayData.kind or bayData.state) then
            occupied = occupied + 1
            table.insert(occupiedSlots, slotId)
            if bayData.kind == "service" then
                table.insert(serviceBays, slotId)
            elseif bayData.kind == "project" then
                table.insert(projectBays, slotId)
            end
        else
            table.insert(freeSlots, slotId)
        end
    end

    local isFull = (occupied >= maxBays)
    return {
        total = maxBays,
        occupied = occupied,
        free = #freeSlots,
        isFull = isFull,
        freeSlots = freeSlots,
        occupiedSlots = occupiedSlots,
        serviceBays = serviceBays,
        projectBays = projectBays
    }
end

local function refreshBusiness()
    local rf = ReplicatedStorage:FindFirstChild("OfficeRemote")
    if rf and rf:IsA("RemoteFunction") then
        local res = rf:InvokeServer("state")
        if res and res.state then
            local s = res.state
            local slots = getBaySlots(s)
            local bayStr = slots.isFull 
                and string.format("Bays: %d/%d (FULL ⚠️)", slots.occupied, slots.total)
                or string.format("Bays: %d/%d (%d Open ✅)", slots.occupied, slots.total, slots.free)

            bizInfoLabel.Text = string.format(
                "Name: %s\nLevel: %d  |  Office Level: %d  |  %s\nTotal Earned: $%s  |  Status: %s",
                tostring(s.name or "Office"),
                tonumber(s.level) or 0,
                tonumber(s.officeLevel) or 0,
                bayStr,
                tostring(s.earned or 0),
                s.ready and "Ready" or "Active"
            )
            return
        end
    end
    bizInfoLabel.Text = "Could not fetch office data. Ensure you have an active business office."
end

