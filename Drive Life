local raceControlsCard = createCard(pageRacing, "Race Teleports & Actions", 135)

local function teleportToRace()
    local raceFolder = workspace:FindFirstChild("Races") and workspace.Races:FindFirstChild(selectedRace)
    if raceFolder and raceFolder:FindFirstChild("StartCircle") then
        local targetCF = raceFolder.StartCircle.CFrame + Vector3.new(0, 4, 0)
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
            local car = hum.SeatPart:FindFirstAncestorOfClass("Model")
            if car and car.PrimaryPart then
                car:SetPrimaryPartCFrame(targetCF)
            else
                hum.SeatPart.CFrame = targetCF
            end
        elseif char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = targetCF
        end
    end
end

