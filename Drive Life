local raceAutoCard = createCard(pageRacing, "Race Auto-Finish (Checkpoints)", 105)
local autoWinRunning = false
local autoWinBtn

local function runAutoCheckpoints()
    if autoWinRunning then
        autoWinRunning = false
        autoWinBtn.Text = "🏆 Auto-Win Race (Run Checkpoints)"
        autoWinBtn.BackgroundColor3 = Color3.fromRGB(241, 196, 15)
        return
    end

    autoWinRunning = true
    autoWinBtn.Text = "⏹ Stop Auto-Win"
    autoWinBtn.BackgroundColor3 = C_RED

    task.spawn(function()
        local raceFolder = workspace:FindFirstChild("Races") and workspace.Races:FindFirstChild(selectedRace)
        if not raceFolder then
            autoWinRunning = false
            autoWinBtn.Text = "🏆 Auto-Win Race (Run Checkpoints)"
            autoWinBtn.BackgroundColor3 = Color3.fromRGB(241, 196, 15)
            return
        end

        local checkpoints = {}
        for _, c in ipairs(raceFolder:GetChildren()) do
            if c.Name:match("^Checkpoint%d+$") then
                local num = tonumber(c.Name:match("%d+"))
                table.insert(checkpoints, { part = c, num = num })
            end
        end
        table.sort(checkpoints, function(a, b) return a.num < b.num end)

        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local mover = hum and hum.SeatPart or (char and char:FindFirstChild("HumanoidRootPart"))

        for _, cp in ipairs(checkpoints) do
            if not autoWinRunning then break end
            if mover and mover.Parent then
                local car = hum and hum.SeatPart and hum.SeatPart:FindFirstAncestorOfClass("Model")
                local targetCF = cp.part.CFrame + Vector3.new(0, 2, 0)
                if car and car.PrimaryPart then
                    car:SetPrimaryPartCFrame(targetCF)
                else
                    mover.CFrame = targetCF
                end
            end
            task.wait(0.35)
        end

        if autoWinRunning and raceFolder:FindFirstChild("FinishLine") then
            local targetCF = raceFolder.FinishLine.CFrame + Vector3.new(0, 2, 0)
            local car = hum and hum.SeatPart and hum.SeatPart:FindFirstAncestorOfClass("Model")
            if car and car.PrimaryPart then
                car:SetPrimaryPartCFrame(targetCF)
            elseif mover then
                mover.CFrame = targetCF
            end
        end

        autoWinRunning = false
        autoWinBtn.Text = "🏆 Auto-Win Race (Run Checkpoints)"
        autoWinBtn.BackgroundColor3 = Color3.fromRGB(241, 196, 15)
    end)
end

autoWinBtn = createButton(raceAutoCard, "🏆 Auto-Win Race (Run Checkpoints)", Color3.fromRGB(241, 196, 15), UDim2.new(0, 14, 0, 32), UDim2.new(0.96, 0, 0, 32), runAutoCheckpoints)

