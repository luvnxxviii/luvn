-- Hook Jobs3d.Run so even if native workorder runs, it auto-completes with 1.0 PERFECT score without camera lock
pcall(function()
    local cmj = ReplicatedStorage:FindFirstChild("CarMechanicJob")
    local jobsMod = cmj and require(cmj:WaitForChild("Jobs"))
    local jobs3d = cmj and require(cmj.Client.mechanicTasks.jobs3d)
    if jobs3d and jobsMod and not jobs3d._dlHubHooked then
        local origRun = jobs3d.Run
        jobs3d._dlHubHooked = true
        jobs3d.Run = function(jobId, ctx)
            if not autoMechanicActive then
                return origRun(jobId, ctx)
            end
            local jobDef = jobsMod.BY_ID[jobId]
            if not jobDef or not ctx or not ctx.progress then
                return origRun(jobId, ctx)
            end
            local startClock = os.clock()
            local totalSteps = #jobDef.steps
            local minDur = (tonumber(jobDef.seconds) or 30) * (tonumber(jobsMod.MIN_SHARE) or 0.85) + 0.5
            local stepWait = math.clamp((minDur * 0.65) / math.max(1, totalSteps), 0.45, 2.2)

            for i, step in ipairs(jobDef.steps) do
                if not autoMechanicActive or (ctx.alive and not ctx.alive()) then
                    return false
                end
                ensureAtMechanicWorkshop(false)
                local score = (step.kind == "mini") and 1.0 or nil
                setMechOrderStatus(string.format("[%s] Step %d/%d: %s (100%% PERFECT)", jobDef.name, i, totalSteps, tostring(step.label or step.action)), C_ACCENT)
                ctx.progress(i, score)
                task.wait(stepWait)
            end

            while autoMechanicActive and (not ctx.alive or ctx.alive()) do
                local elapsed = os.clock() - startClock
                local rem = minDur - elapsed
                if rem <= 0 then break end
                ensureAtMechanicWorkshop(false)
                setMechOrderStatus(string.format("[%s] Finishing up... %.1fs left (Calibrated)", jobDef.name, rem), C_GREEN)
                task.wait(math.min(0.5, rem))
            end
            return true
        end
    end
end)

local function ensureMechanicShiftStarted()
    local curShift = player:GetAttribute("JobShift")

    -- Clear conflicting shifts (e.g. Office Garage road mission)
    if curShift and curShift ~= "" and curShift ~= "Mechanic" then
        setMechOrderStatus("Ending conflicting shift (" .. tostring(curShift) .. ")...", Color3.fromRGB(241, 196, 15))
        if curShift == "Office Garage" then
            local rf = ReplicatedStorage:FindFirstChild("OfficeRemote")
            if rf then
                pcall(function() rf:InvokeServer("cancel") end)
            end
        end
        for _, rName in ipairs({ "BusRemote", "TowRemote", "PizzaRemote" }) do
            local rem = ReplicatedStorage:FindFirstChild(rName)
            if rem and rem:IsA("RemoteEvent") then
                pcall(function() rem:FireServer("end") end)
                pcall(function() rem:FireServer("stop") end)
                pcall(function() rem:FireServer("leave") end)
            end
        end
        task.wait(0.6)
    end

    -- Stop any stuck client 3D camera/minigame loop so camera stays free
    stopNativeMechanicClientLoop()

    local cmj = ReplicatedStorage:FindFirstChild("CarMechanicJob")
    local remotes = cmj and cmj:FindFirstChild("Remotes")
    local onJobStarted = remotes and remotes:FindFirstChild("onJobStarted")
    if not onJobStarted then
        return false, "CarMechanicJob remotes not found"
    end

    if player:GetAttribute("JobShift") ~= "Mechanic" then
        setMechOrderStatus("Starting Mechanic shift...", C_ACCENT)
        onJobStarted:FireServer()
        local t0 = os.clock()
        while player:GetAttribute("JobShift") ~= "Mechanic" and (os.clock() - t0 < 3.0) do
            task.wait(0.15)
        end
    else
        -- Ensure server table t_1[player] is initialized
        onJobStarted:FireServer()
    end

    updateJobStatus()
    return player:GetAttribute("JobShift") == "Mechanic", "Shift state: " .. tostring(player:GetAttribute("JobShift"))
end

local function checkAndBuyMechanicUpgrades()
    local upgMod = ReplicatedStorage:FindFirstChild("MechanicUpgrades")
    local upgRem = ReplicatedStorage:FindFirstChild("MechanicUpgradesRemote")
    if not upgMod or not upgRem then return false end

    local ok, MechanicUpgrades = pcall(require, upgMod)
    if not ok or not MechanicUpgrades or not MechanicUpgrades.LIST then return false end

    local st = getMechanicStats()
    local leaderstats = player:FindFirstChild("leaderstats")
    local cashObj = leaderstats and (leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Money"))
    local cash = cashObj and tonumber(cashObj.Value) or 0

    local boughtAny = false
    for _, item in ipairs(MechanicUpgrades.LIST) do
        local curTier = MechanicUpgrades.Tier(player, item.key)
        local nextLevelData = item.levels and item.levels[curTier + 1]
        if nextLevelData then
            local reqLvl = tonumber(nextLevelData.level) or 1
            local price = tonumber(nextLevelData.price) or 0
            if st.level >= reqLvl and cash >= price then
                local okBuy, resBuy = pcall(function()
                    return upgRem:InvokeServer("buy", item.key)
                end)
                if okBuy and (resBuy == true or (type(resBuy) == "table" and resBuy.ok)) then
                    boughtAny = true
                    cash = cash - price
                    autoMechUpgradesToggle.SetStatus("Purchased: " .. tostring(nextLevelData.name) .. " ($" .. tostring(price) .. ")", C_GREEN)
                    task.wait(0.3)
                end
            end
        end
    end
    return boughtAny
end

local function runOneMechanicOrder()
    local cmj = ReplicatedStorage:FindFirstChild("CarMechanicJob")
    local remotes = cmj and cmj:FindFirstChild("Remotes")
    if not cmj or not remotes then
        return false, "CarMechanicJob not found"
    end

    local Jobs_m = require(cmj:WaitForChild("Jobs"))
    local jobOrderRem = remotes:FindFirstChild("jobOrder")
    local jobStepRem = remotes:FindFirstChild("jobStep")
    local jobDoneRem = remotes:FindFirstChild("jobDone")
    if not jobOrderRem or not jobStepRem or not jobDoneRem then
        return false, "Mechanic remotes missing"
    end

    -- 1. Ensure player is physically inside the Mechanic Workshop (server checks <= 120 studs)
    if not ensureAtMechanicWorkshop(false) then
        return false, "Could not reach Mechanic Workshop"
    end

    -- 2. Ensure Mechanic Shift is active on server
    local shiftOk, shiftErr = ensureMechanicShiftStarted()
    if not shiftOk then
        return false, shiftErr or "Could not start Mechanic shift"
    end

    -- 3. Request new customer repair order from server
    setMechOrderStatus("Requesting customer work order...", C_ACCENT)
    local orderStartClock = os.clock()
    local okOrder, order = pcall(function()
        return jobOrderRem:InvokeServer()
    end)

    if not okOrder or type(order) ~= "table" or not order.job then
        -- Retry once after firing onJobStarted
        remotes.onJobStarted:FireServer()
        task.wait(0.4)
        orderStartClock = os.clock()
        okOrder, order = pcall(function()
            return jobOrderRem:InvokeServer()
        end)
    end

    if not okOrder or type(order) ~= "table" or not order.job then
        return false, "No order returned by server"
    end

    local jobDef = Jobs_m.BY_ID[order.job]
    if not jobDef or not jobDef.steps then
        return false, "Unknown job ID: " .. tostring(order.job)
    end

    local customerName = tostring(order.customer or "Customer")
    local carName = tostring(order.car or "Vehicle")
    local jobName = tostring(jobDef.name or order.job)
    local moodName = tostring(order.mood or "Normal")
    mechComboStreak = tonumber(order.combo) or mechComboStreak

    local tags = {}
    if order.special then table.insert(tags, "🌟 2X SPECIAL") end
    if (tonumber(order.rushLeft) or 0) > 0 then table.insert(tags, "⚡ RUSH HOUR") end
    if order.regular then table.insert(tags, "💎 REGULAR") end
    local tagStr = #tags > 0 and (" [" .. table.concat(tags, " • ") .. "]") or ""

    -- Park visual car in Bay 1 for visual feedback (non-blocking, no camera hijack)
    spawnVisualBayCar(carName)

    -- 4. Calculate server anti-cheat timing requirements:
    -- Server check A: jobDone requires (os.clock() - issuedAt) >= jobDef.seconds * Jobs_m.MIN_SHARE (0.85)
    -- Server check B: jobStep requires (os.clock() - firstStepAt) >= sum_{2..i}(mini ? 0.4 : 0.2) for 1.0 PERFECT score
    local minShare = tonumber(Jobs_m.MIN_SHARE) or 0.85
    local minRequiredDuration = (tonumber(jobDef.seconds) or 30) * minShare + 0.45
    local totalSteps = #jobDef.steps
    local stepInterval = math.clamp((minRequiredDuration * 0.72) / math.max(1, totalSteps), 0.50, 2.50)

    -- 5. Execute all steps sequentially (1 .. totalSteps) with 1.0 PERFECT minigame scores
    for stepIdx, stepInfo in ipairs(jobDef.steps) do
        if not hubAlive then return false, "Hub closed" end

        ensureAtMechanicWorkshop(false)

        local stepLabel = tostring(stepInfo.label or stepInfo.action or ("Step " .. stepIdx))
        local isMini = (stepInfo.kind == "mini")
        local statusTxt = string.format(
            "%s — %s (%s)%s • Step %d/%d: %s",
            carName,
            jobName,
            customerName,
            tagStr,
            stepIdx,
            totalSteps,
            stepLabel
        )
        setMechOrderStatus(statusTxt, isMini and Color3.fromRGB(46, 204, 113) or C_ACCENT)
        if autoMechanicActive then
            autoMechanicToggle.SetStatus(string.format("Step %d/%d: %s (%s)", stepIdx, totalSteps, stepLabel, carName), C_ACCENT)
        end

        if isMini then
            jobStepRem:FireServer(stepIdx, 1.0)
        else
            jobStepRem:FireServer(stepIdx)
        end

        task.wait(stepInterval)
    end

    -- 6. Hold until server MIN_SHARE duration clears so jobDone never triggers "fast"
    while hubAlive do
        local elapsed = os.clock() - orderStartClock
        local remaining = minRequiredDuration - elapsed
        if remaining <= 0 then
            break
        end
        ensureAtMechanicWorkshop(false)
        local waitTxt = string.format(
            "%s — %s (%s)%s • Finalizing (%ds left, 100%% PERFECT)...",
            carName,
            jobName,
            customerName,
            tagStr,
            math.ceil(remaining)
        )
        setMechOrderStatus(waitTxt, C_GREEN)
        if autoMechanicActive then
            autoMechanicToggle.SetStatus(string.format("Finalizing %s (%ds left)...", jobName, math.ceil(remaining)), C_GREEN)
        end
        task.wait(math.min(0.4, remaining))
    end

    -- 7. Invoke jobDone to settle order and collect payout
    local settleRes = nil
    for attempt = 1, 24 do
        if not hubAlive then break end
        ensureAtMechanicWorkshop(false)

        local okDone, res = pcall(function()
            return jobDoneRem:InvokeServer()
        end)

        if okDone and type(res) == "table" then
            if res.ok then
                settleRes = res
                break
            elseif res.why == "fast" then
                setMechOrderStatus(string.format("Syncing server completion clock... (attempt %d)", attempt), Color3.fromRGB(241, 196, 15))
                task.wait(0.45)
            elseif res.why == "away" then
                ensureAtMechanicWorkshop(true)
                task.wait(0.3)
            elseif res.why == "steps" then
                -- Self-heal: re-send all steps with safe spacing if any packet was dropped
                setMechOrderStatus("Re-syncing repair steps with workshop server...", Color3.fromRGB(241, 196, 15))
                ensureAtMechanicWorkshop(true)
                for sIdx, sInfo in ipairs(jobDef.steps) do
                    if sInfo.kind == "mini" then
                        jobStepRem:FireServer(sIdx, 1.0)
                    else
                        jobStepRem:FireServer(sIdx)
                    end
                    task.wait(0.45)
                end
                task.wait(0.3)
            else
                task.wait(0.4)
            end
        else
            task.wait(0.4)
        end
    end

    cleanupVisualBayCar()

    if settleRes and settleRes.ok then
        mechCarsFixedSession = mechCarsFixedSession + 1
        local payEarned = tonumber(settleRes.pay) or 0
        local gradeWord = tostring(settleRes.word or "PERFECT")
        local stars = tonumber(settleRes.stars) or 5
        mechComboStreak = (gradeWord == "PERFECT") and math.min((tonumber(settleRes.combo) or 0) + 1, 4) or 0

        mechLastReceipt = string.format("+$%d • %s (%d★) • %s (%s)", payEarned, gradeWord, stars, jobName, carName)
        refreshMechanicTelemetry()

        local doneMsg = string.format("Completed %s on %s! Earned +$%d (%s %d★)", jobName, carName, payEarned, gradeWord, stars)
        setMechOrderStatus(doneMsg, C_GREEN)
        if autoMechanicActive then
            autoMechanicToggle.SetStatus(doneMsg, C_GREEN)
        end

        if autoMechUpgradesActive then
            pcall(checkAndBuyMechanicUpgrades)
        end
        return true, doneMsg
    end

    return false, "Order settlement timed out"
end

