            local nextData = sysSettings.levels["Level" .. (levelNum + 1)]
            nextLvlXP = nextData and tonumber(nextData.requiredXP) or nil
        end
    end)

    return {
        level = levelNum,
        xp = xp,
        nextXP = nextLvlXP,
        payMult = payMult,
        sessionCash = sessionCash,
        totalCash = totalCash
    }
end

