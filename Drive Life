local function getBusinessCar()
    local vehFolder = workspace:FindFirstChild("Vehicles")
    if not vehFolder then return nil end
    local car = vehFolder:FindFirstChild(player.Name .. " - Business")
        or vehFolder:FindFirstChild(player.Name .. " - Service")
        or vehFolder:FindFirstChild(player.Name .. " - Project")
        or vehFolder:FindFirstChild(player.Name .. " - Auction")
        or vehFolder:FindFirstChild(player.Name)
    if car then return car end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
        return hum.SeatPart:FindFirstAncestorOfClass("Model")
    end
    for _, v in ipairs(vehFolder:GetChildren()) do
        if v.Name:find(player.Name) then
            return v
        end
    end
    return nil
end

local function callBayAction(action, slot, arg2, arg3)
    local Net = getNet()
    if not Net then return nil end

    local function invoke(s)
        if arg3 ~= nil then
            return Net.Call(action, s, arg2, arg3)
        elseif arg2 ~= nil then
            return Net.Call(action, s, arg2)
        else
            return Net.Call(action, s)
        end
    end

    local res = invoke(slot)
    if res and res.ok then return res end

    -- Try numeric slot if passed string like "B2"
    local num = tonumber(tostring(slot):match("%d+"))
    if num and num ~= slot then
        local resNum = invoke(num)
        if resNum and resNum.ok then return resNum end
    end

    -- Try string format "B" .. num if passed numeric
    if type(slot) == "number" then
        local strSlot = "B" .. slot
        local resStr = invoke(strSlot)
        if resStr and resStr.ok then return resStr end
    end

    return res
end

-- ======================================================================
-- BUYER SPECIFICATION CUSTOMIZATION (PAINT, RIMS, WASH, PLATE, REPAIRS)
-- Extracts what the buyer wants (e.g. Silver paint, Gold rims, Clean)
-- ======================================================================
local function getWantedPicks(slot, bayData)
    local picks = { wash = true }
    local Net = getNet()
    local s = Net and Net.State()

    -- Resolve bayData if not provided or incomplete
    if not bayData and s and s.bays then
        local num = tonumber(tostring(slot):match("%d+"))
        bayData = s.bays[slot] or (num and s.bays[num]) or (num and s.bays["B" .. num])
    end

    local spec = bayData and (bayData.spec or bayData.order or bayData.collectorSpec or bayData.wanted or bayData.prep)

    -- Try Office.MakeSpec if no spec present
    if (not spec or not next(spec)) and ReplicatedStorage:FindFirstChild("Office") then
        pcall(function()
            local Office_m = require(ReplicatedStorage.Office)
            if Office_m and Office_m.MakeSpec then
                local carId = bayData and (bayData.car or bayData.display or bayData.model)
                spec = Office_m.MakeSpec(carId, "collector")
            end
        end)
    end

    if spec then
        -- Direct spec extraction
        if spec.paint then
            if type(spec.paint) == "table" then
                picks.paint = spec.paint.id or spec.paint.word or spec.paint.name or spec.paint[1]
            else
                picks.paint = tostring(spec.paint)
            end
        end

        if spec.rims then
            if type(spec.rims) == "table" then
                picks.rims = spec.rims.id or spec.rims.word or spec.rims.name or spec.rims[1]
            else
                picks.rims = tostring(spec.rims)
            end
        end

        if spec.plate then
            if type(spec.plate) == "table" then
                picks.plate = spec.plate.text or spec.plate.plate or spec.plate[1]
            else
                picks.plate = tostring(spec.plate)
            end
        end

        if spec.wash ~= nil or spec.clean ~= nil or spec.washed ~= nil then
            picks.wash = (spec.wash ~= false and spec.clean ~= false and spec.washed ~= false)
        else
            picks.wash = true
        end

        -- Parse via Office.SpecLines if available for extra accuracy
        pcall(function()
            local Office_m = require(ReplicatedStorage.Office)
            if Office_m and Office_m.SpecLines then
                local lines = Office_m.SpecLines(spec, bayData and bayData.look)
                for _, line in ipairs(lines or {}) do
                    if line.kind == "paint" and line.id then
                        picks.paint = line.id
                    elseif line.kind == "rims" and line.id then
                        picks.rims = line.id
                    elseif line.kind == "plate" and line.text then
                        picks.plate = line.text
                    elseif line.kind == "wash" then
                        picks.wash = true
                    end
                end
            end
        end)
    end

    -- Scrape active PREP UI in PlayerGui if open or visible (matches user's screen)
    pcall(function()
        local pg = player:FindFirstChild("PlayerGui")
        if not pg then return end
        for _, desc in ipairs(pg:GetDescendants()) do
            if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                local txt = desc.Text or ""
                local lower = txt:lower()

                -- Check for paint: e.g. "Silver paint" or "Pick a Silver paint to meet the spec" or "PICK SILVER"
                local paintMatch = txt:match("([%a%s]+)%s+[Pp]aint") or txt:match("Pick a%s+([%a%s]+)%s+paint") or txt:match("^PICK%s+([%a%s]+)")
                if paintMatch and not picks.paint then
                    local pClean = paintMatch:gsub("^%s+", ""):gsub("%s+$", "")
                    if pClean ~= "" and pClean:lower() ~= "pick" and pClean:lower() ~= "done" then
                        picks.paint = pClean:lower()
                    end
                end

                -- Check for rims: e.g. "Gold rims" or "Pick a Gold rim"
                local rimsMatch = txt:match("([%a%s]+)%s+[Rr]ims") or txt:match("Pick a%s+([%a%s]+)%s+rim")
                if rimsMatch and not picks.rims then
                    local rClean = rimsMatch:gsub("^%s+", ""):gsub("%s+$", "")
                    if rClean ~= "" then
                        picks.rims = rClean:lower()
                    end
                end

                -- Check for wash: "Clean" or "Wash"
                if lower == "clean" or lower:find("clean") or lower:find("wash zone") then
                    picks.wash = true
                end
            end
        end
    end)

    return picks, spec
end

-- Detects any deliverable car in the business bays (contract, repo, lease, project)
local function getDeliverableBayCar(s)
    if not s or not s.bays then return nil end
    local maxBays = tonumber(s.bayCount) or 6
    for i = 1, maxBays do
        local slotCandidates = { "B" .. i, i, tostring(i) }
        for _, candidate in ipairs(slotCandidates) do
            local bayData = s.bays[candidate]
            if bayData and (bayData.car or bayData.display or bayData.model or bayData.state or bayData.kind) then
                if bayData.kind ~= "service" then
                    return candidate, bayData
                end
            end
        end
    end
    -- Fallback: iterate all keys in s.bays
    for slotKey, bayData in pairs(s.bays) do
        if type(bayData) == "table" and (bayData.car or bayData.display or bayData.model or bayData.state or bayData.kind) then
            if bayData.kind ~= "service" then
                return slotKey, bayData
            end
        end
    end
    return nil
end

local function customizeCarToBuyerSpec(slot, bayData)
    local Net = getNet()
    if not Net then return false, "No Net" end
    local s = Net.State()

    local numSlot = tonumber(tostring(slot):match("%d+"))
    local strSlot = "B" .. (numSlot or slot)
    bayData = bayData or (s.bays and (s.bays[slot] or (numSlot and s.bays[numSlot]) or s.bays[strSlot]))
    if not bayData or not (bayData.car or bayData.display or bayData.model) then
        return false, "No car in bay " .. tostring(slot)
    end

    local carName = tostring(bayData.display or bayData.car or slot)

    -- If car needs rim/suspension work, move to a bay with a lift
    local lifts = s.lifts or {}
    if not (lifts[slot] or (numSlot and lifts[numSlot]) or lifts[strSlot]) then
        for liftSlot, _ in pairs(lifts) do
            local numLift = tonumber(tostring(liftSlot):match("%d+"))
            if not (s.bays and (s.bays[liftSlot] or (numLift and s.bays[numLift]))) then
                callBayAction("moveBay", slot, liftSlot)
                task.wait(0.4)
                slot = liftSlot
                s = Net.State()
                numSlot = tonumber(tostring(slot):match("%d+"))
                strSlot = "B" .. (numSlot or slot)
                bayData = s.bays and (s.bays[slot] or (numSlot and s.bays[numSlot]) or s.bays[strSlot])
                break
            end
        end
    end

    -- 1. Restore all mechanical faults (rims, engine, exhaust, suspension, bodywork)
    callBayAction("restore", slot, "all")
    task.wait(0.25)

    -- 2. Repair care to 100%
    callBayAction("repair", slot)
    task.wait(0.25)

    -- 3. Extract buyer's wanted customization picks
    local wantedPicks, spec = getWantedPicks(slot, bayData)

    -- 4. If interactive PREP UI buttons are visible on screen, click any "PICK ..." buttons
    pcall(function()
        local pg = player:FindFirstChild("PlayerGui")
        if not pg then return end
        for _, btn in ipairs(pg:GetDescendants()) do
            if btn:IsA("TextButton") and btn.Visible then
                local bText = btn.Text or ""
                if bText:match("^PICK%s+") then
                    if firesignal then
                        firesignal(btn.MouseButton1Click)
                        firesignal(btn.Activated)
                    end
                end
            end
        end
    end)

    -- 5. Apply all customizations: Paint, Rims, Plate, Wash
    local prepRes = callBayAction("prepAll", slot, wantedPicks)
    task.wait(1.5)

    local details = {}
    if wantedPicks.paint then table.insert(details, "Paint: " .. tostring(wantedPicks.paint)) end
    if wantedPicks.rims then table.insert(details, "Rims: " .. tostring(wantedPicks.rims)) end
    if wantedPicks.wash then table.insert(details, "Clean") end
    if wantedPicks.plate then table.insert(details, "Plate: " .. tostring(wantedPicks.plate)) end

    local desc = #details > 0 and table.concat(details, ", ") or "Buyer Spec"
    return true, desc, slot
end

local function sellAndDeliverToCollector(slot)
    local Net = getNet()
    if not Net then return false, "No Net" end

    local s = Net.State()
    local m = s and s.mission

    -- If a sell mission is already active, deliver it directly!
    if m and m.dest and (m.buyer or m.destName or m.kind == "sell") then
        local carName = tostring(m.display or m.car or "Vehicle")
        local dest = Vector3.new(m.dest[1], m.dest[2] + 2, m.dest[3])
        local car = getBusinessCar()
        local seat = car and car:FindFirstChild("DriveSeat", true)
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")

        if seat and hum and seat.Occupant ~= hum then
            seat:Sit(hum)
            task.wait(0.5)
        end

        local legStart = os.clock()
        local calSpeed, minSafeDuration = calculateTransitCalibration(car.PrimaryPart.Position, dest, m)
        pcall(function() player:RequestStreamAroundAsync(dest) end)
        glideVehicleTo(car, dest, calSpeed, function(left, total, eta)
            local statusStr = string.format("Delivering to Collector: %d studs left (ETA: %ds, calibrated)...", math.floor(left), eta)
            contractsToggle.SetStatus(statusStr, C_ACCENT)
            auctionsToggle.SetStatus(statusStr, C_ACCENT)
            setAutoStatus(statusStr, C_ACCENT)
        end, m)

        waitForRingHandover(function(txt)
            contractsToggle.SetStatus(txt, C_ACCENT)
            auctionsToggle.SetStatus(txt, C_ACCENT)
            setAutoStatus(txt, C_ACCENT)
        end, minSafeDuration, legStart)
        local priceEarned = m.price or 0
        local buyerName = tostring(m.destName or m.buyer or "Collector")
        return true, string.format("Sold %s to %s for $%s", carName, buyerName, tostring(priceEarned))
    end

    local numSlot = tonumber(tostring(slot):match("%d+"))
    local strSlot = "B" .. (numSlot or slot)
    local bay = s.bays and (s.bays[slot] or (numSlot and s.bays[numSlot]) or s.bays[strSlot])
    if not bay or not (bay.car or bay.display or bay.model) then
        return false, "No car in slot " .. tostring(slot)
    end

    local carName = tostring(bay.display or bay.car or slot)

    -- Fully customize to buyer's requested spec (paint, rims, wash, restore, repair)
    local okCust, custSuccess, custDesc, actualSlot = pcall(customizeCarToBuyerSpec, slot, bay)
    if okCust and custSuccess and actualSlot then
        slot = actualSlot
    end
    task.wait(1.5)

    -- Start sell mission to highest paying buyer: "collector" (+30%)
    -- Retry if server returns "One moment..." due to transaction cooldown
    local sellRes
    for attempt = 1, 4 do
        sellRes = callBayAction("sell", slot, "collector")
        if not (sellRes and sellRes.ok) then
            sellRes = callBayAction("sell", slot, "dealer")
        end
        if not (sellRes and sellRes.ok) then
            sellRes = callBayAction("sell", slot, "private")
        end

        if sellRes and sellRes.ok then
            break
        end

        if type(sellRes) == "table" and sellRes.message == "One moment..." then
            contractsToggle.SetStatus("Server busy (" .. tostring(sellRes.message) .. "), waiting to sell...", Color3.fromRGB(241, 196, 15))
            task.wait(1.8)
        else
            break
        end
    end

    if not sellRes or not sellRes.ok then
        return false, (type(sellRes) == "table" and sellRes.message) or "Could not start sale"
    end

    task.wait(1.0)
    s = Net.State()
    m = s.mission
    if not m or not m.dest then
        return false, "Sell mission did not initialize"
    end

    -- Deliver car to buyer destination ring safely
    local dest = Vector3.new(m.dest[1], m.dest[2] + 2, m.dest[3])
    local car = getBusinessCar()
    local seat = car and car:FindFirstChild("DriveSeat", true)
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")

    if seat and hum and seat.Occupant ~= hum then
        seat:Sit(hum)
        task.wait(0.5)
    end

    local legStart = os.clock()
    local calSpeed, minSafeDuration = calculateTransitCalibration(car.PrimaryPart.Position, dest, m)
    pcall(function() player:RequestStreamAroundAsync(dest) end)
    glideVehicleTo(car, dest, calSpeed, function(left, total, eta)
        local statusStr = string.format("Delivering to Collector: %d studs left (ETA: %ds, calibrated)...", math.floor(left), eta)
        contractsToggle.SetStatus(statusStr, C_ACCENT)
        auctionsToggle.SetStatus(statusStr, C_ACCENT)
        setAutoStatus(statusStr, C_ACCENT)
    end, m)

    waitForRingHandover(function(txt)
        contractsToggle.SetStatus(txt, C_ACCENT)
        auctionsToggle.SetStatus(txt, C_ACCENT)
        setAutoStatus(txt, C_ACCENT)
    end, minSafeDuration, legStart)
    local priceEarned = m.price or 0
    local buyerName = tostring(m.destName or m.buyer or "Collector")
    return true, string.format("Sold %s to %s for $%s", carName, buyerName, tostring(priceEarned))
end

