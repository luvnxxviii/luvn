local function isSpecFullyMet(bayData)
    if not bayData or bayData.kind == "project" then
        return true
    end
    local ok, met = pcall(function()
        local Office_m = require(ReplicatedStorage.Office)
        return Office_m.SpecMet(bayData.spec, bayData.look)
    end)
    if ok then
        return met == true
    end
    local picks = getWantedPicks(nil, bayData)
    return next(picks) == nil
end

local function getBayWaitLeft(bayData)
    if not bayData or not bayData.look then return 0, nil end
    local ok, wLeft, wWord = pcall(function()
        local Office_m = require(ReplicatedStorage.Office)
        return Office_m.WaitLeft(bayData.look)
    end)
    if ok and tonumber(wLeft) then
        return tonumber(wLeft), wWord
    end
    return 0, nil
end

local function customizeCarToBuyerSpec(slot, bayData)
    local Net = getNet()
    if not Net then return false, "No Net" end
    local s = Net.State()

    slot = resolveBayKey(slot, s)
    bayData = (s and s.bays and s.bays[slot]) or bayData
    if not bayData or not (bayData.car or bayData.display or bayData.model) then
        return false, "No car in bay " .. tostring(slot)
    end

    -- If car needs rim work and current bay has no lift, move to an open bay with a lift
    local lifts = s.lifts or {}
    local numSlot = tonumber(tostring(slot):match("%d+"))
    local strSlot = "B" .. (numSlot or slot)
    if not (lifts[slot] or (numSlot and lifts[numSlot]) or lifts[strSlot]) then
        for liftSlot, _ in pairs(lifts) do
            local resolvedLift = resolveBayKey(liftSlot, s)
            if not (s.bays and s.bays[resolvedLift]) then
                callBayAction("moveBay", slot, resolvedLift)
                task.wait(0.5)
                s = Net.State()
                slot = resolvedLift
                bayData = s and s.bays and s.bays[slot]
                break
            end
        end
    end

    -- 1. Restore mechanical faults ONLY if it is a project car with unfixed faults
    if bayData and bayData.kind == "project" and type(bayData.faults) == "table" then
        local hasUnfixed = false
        for _, f in ipairs(bayData.faults) do
            if type(f) == "table" and f.state ~= "fixed" and f.fixed ~= true then
                hasUnfixed = true
                break
            end
        end
        if hasUnfixed then
            callBayAction("restore", slot, "all")
            task.wait(0.6)
            s = Net.State()
            bayData = (s and s.bays and s.bays[slot]) or bayData
        end
    end

    -- 2. Repair care ONLY if care < 95% (Collector requires >= 95%)
    local currentCare = tonumber(bayData and bayData.care) or 100
    if currentCare < 95 then
        callBayAction("repair", slot)
        task.wait(0.6)
        s = Net.State()
        bayData = (s and s.bays and s.bays[slot]) or bayData
    end

    -- 3. Apply buyer's wanted customization picks ONLY for items not yet matching spec
    local wantedPicks, spec = getWantedPicks(slot, bayData)
    if bayData and bayData.kind ~= "project" and (not isSpecFullyMet(bayData)) and next(wantedPicks) ~= nil then
        for prepTry = 1, 3 do
            local prepRes = callBayAction("prepAll", slot, wantedPicks)
            task.wait(0.8)
            s = Net.State()
            bayData = (s and s.bays and s.bays[slot]) or bayData
            if (prepRes and prepRes.ok) or isSpecFullyMet(bayData) then
                break
            end
            wantedPicks = getWantedPicks(slot, bayData)
            if next(wantedPicks) == nil then
                break
            end
            task.wait(0.8)
        end
    end

    -- 4. Wait if paint is drying or rims are fitting (WaitLeft > 0)
    local waitSec, waitWord = getBayWaitLeft(bayData)
    while waitSec > 0 and hubAlive do
        local wMsg = string.format("%s in %s (%ds left)...", tostring(waitWord or "PREPPING"), tostring(slot), waitSec)
        contractsToggle.SetStatus(wMsg, Color3.fromRGB(241, 196, 15))
        setAutoStatus(wMsg, Color3.fromRGB(241, 196, 15))
        task.wait(1.0)
        s = Net.State()
        bayData = (s and s.bays and s.bays[slot]) or bayData
        waitSec, waitWord = getBayWaitLeft(bayData)
    end

    local details = {}
    if spec and spec.paint then table.insert(details, "Paint: " .. tostring(spec.paint)) end
    if spec and spec.rims then table.insert(details, "Rims: " .. tostring(spec.rims)) end
    if spec and (spec.washed ~= false) then table.insert(details, "Clean") end
    if spec and spec.plate then table.insert(details, "Plate: " .. tostring(spec.plate)) end

    local desc = #details > 0 and table.concat(details, ", ") or "Buyer Spec"
    return true, desc, slot
end

local function sellAndDeliverToCollector(slot, skipCustomize)
    local Net = getNet()
    if not Net then return false, "No Net" end

    local s = Net.State()
    local m = s and s.mission

    -- If a sell mission is already active, deliver it directly!
    if m and m.dest and (m.buyer or m.destName or m.kind == "sell") then
        local carName = tostring(m.display or m.car or "Vehicle")
        local dest = Vector3.new(m.dest[1], m.dest[2] + 2, m.dest[3])
        local car = getBusinessCar()
        local seat = car and car:FindFirstChild("DriveSeat", true)
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")

        if seat and hum and seat.Occupant ~= hum then
            if hum.Sit and hum.SeatPart ~= seat then
                hum.Sit = false
                task.wait(0.1)
            end
            seat:Sit(hum)
            task.wait(0.5)
        end

        local legStart = os.clock()
        local calSpeed, minSafeDuration = calculateTransitCalibration(car.PrimaryPart.Position, dest, m)
        pcall(function() player:RequestStreamAroundAsync(dest) end)
        glideVehicleTo(car, dest, calSpeed, function(left, total, eta)
            local statusStr = string.format("Delivering to Collector: %d studs left (ETA: %ds, calibrated)...", math.floor(left), eta)
            contractsToggle.SetStatus(statusStr, C_ACCENT)
            auctionsToggle.SetStatus(statusStr, C_ACCENT)
            setAutoStatus(statusStr, C_ACCENT)
        end, m)

        waitForRingHandover(function(txt)
            contractsToggle.SetStatus(txt, C_ACCENT)
            auctionsToggle.SetStatus(txt, C_ACCENT)
            setAutoStatus(txt, C_ACCENT)
        end, minSafeDuration, legStart)
        local priceEarned = m.price or 0
        local buyerName = tostring(m.destName or m.buyer or "Collector")
        return true, string.format("Sold %s to %s for $%s", carName, buyerName, tostring(priceEarned))
    end

    slot = resolveBayKey(slot, s)
    local bay = s and s.bays and s.bays[slot]
    if not bay or not (bay.car or bay.display or bay.model) then
        return false, "No car in slot " .. tostring(slot)
    end

    local carName = tostring(bay.display or bay.car or slot)

    -- Customize to buyer's requested spec if not already customized
    if not skipCustomize or not isSpecFullyMet(bay) or (tonumber(bay.care) or 100) < 95 then
        local okCust, custSuccess, custDesc, actualSlot = pcall(customizeCarToBuyerSpec, slot, bay)
        if okCust and custSuccess and actualSlot then
            slot = actualSlot
        end
        task.wait(0.6)
    end

    s = Net.State()
    bay = s and s.bays and s.bays[slot]
    local officeLvl = tonumber(s and s.officeLevel) or 1

    -- Choose highest unlocked buyer for the player's Office Level:
    -- Level >= 7: strictly "collector" (+30%)
    -- Level 3..6: "dealer" (+15%)
    -- Level 1..2: "private" (+0%)
    local preferredBuyer = (officeLvl >= 7 and "collector") or (officeLvl >= 3 and "dealer") or "private"

    local sellRes
    for attempt = 1, 5 do
        s = Net.State()
        bay = s and s.bays and s.bays[slot]
        if bay and preferredBuyer ~= "private" then
            if (tonumber(bay.care) or 100) < 95 then
                callBayAction("repair", slot)
                task.wait(0.5)
            end
            if not isSpecFullyMet(bay) then
                local picks = getWantedPicks(slot, bay)
                if next(picks) ~= nil then
                    callBayAction("prepAll", slot, picks)
                    task.wait(0.8)
                end
            end
        end

        sellRes = callBayAction("sell", slot, preferredBuyer)
        if sellRes and sellRes.ok then
            break
        end

        local errMsg = type(sellRes) == "table" and tostring(sellRes.message or "") or ""
        if errMsg == "One moment..." or errMsg:lower():find("moment") then
            contractsToggle.SetStatus("Server busy (" .. errMsg .. "), retrying Collector...", Color3.fromRGB(241, 196, 15))
            task.wait(1.4)
        else
            -- Re-run customization once and retry preferred buyer
            pcall(customizeCarToBuyerSpec, slot, bay)
            task.wait(1.0)
            sellRes = callBayAction("sell", slot, preferredBuyer)
            if sellRes and sellRes.ok then
                break
            end
            -- Only fall back if collector/dealer is genuinely locked or walked away
            if preferredBuyer == "collector" then
                sellRes = callBayAction("sell", slot, "dealer")
            end
            if not (sellRes and sellRes.ok) and officeLvl < 7 then
                sellRes = callBayAction("sell", slot, "private")
            end
            break
        end
    end

    if not sellRes or not sellRes.ok then
        local errMsg = (type(sellRes) == "table" and sellRes.message) or "Could not start sale"
        slotSellCooldown[tostring(slot)] = os.clock() + 25
        local num = tonumber(tostring(slot):match("%d+"))
        if num then slotSellCooldown["B" .. num] = os.clock() + 25 end
        return false, errMsg
    end

    slotSellCooldown[tostring(slot)] = nil
    local num = tonumber(tostring(slot):match("%d+"))
    if num then slotSellCooldown["B" .. num] = nil end

    task.wait(1.0)
    s = Net.State()
    m = s.mission
    if not m or not m.dest then
        return false, "Sell mission did not initialize"
    end

    -- Deliver car to buyer destination ring safely
    local dest = Vector3.new(m.dest[1], m.dest[2] + 2, m.dest[3])
    local car = getBusinessCar()
    local seat = car and car:FindFirstChild("DriveSeat", true)
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")

    if seat and hum and seat.Occupant ~= hum then
        if hum.Sit and hum.SeatPart ~= seat then
            hum.Sit = false
            task.wait(0.1)
        end
        seat:Sit(hum)
        task.wait(0.5)
    end

    local legStart = os.clock()
    local calSpeed, minSafeDuration = calculateTransitCalibration(car.PrimaryPart.Position, dest, m)
    pcall(function() player:RequestStreamAroundAsync(dest) end)
    glideVehicleTo(car, dest, calSpeed, function(left, total, eta)
        local statusStr = string.format("Delivering to Collector: %d studs left (ETA: %ds, calibrated)...", math.floor(left), eta)
        contractsToggle.SetStatus(statusStr, C_ACCENT)
        auctionsToggle.SetStatus(statusStr, C_ACCENT)
        setAutoStatus(statusStr, C_ACCENT)
    end, m)

    waitForRingHandover(function(txt)
        contractsToggle.SetStatus(txt, C_ACCENT)
        auctionsToggle.SetStatus(txt, C_ACCENT)
        setAutoStatus(txt, C_ACCENT)
    end, minSafeDuration, legStart)
    local priceEarned = m.price or 0
    local buyerName = tostring(m.destName or m.buyer or "Collector")
    return true, string.format("Sold %s to %s for $%s", carName, buyerName, tostring(priceEarned))
end

local boardCache = {
    checkedAt = 0,
    untakenCount = 0,
    nextRefresh = 0,
    bestOffer = nil
}

local function checkContractBoard(force)
    local now = os.clock()
    if not force and (now - boardCache.checkedAt < 2.5) then
        return boardCache.untakenCount, boardCache.nextRefresh, boardCache.bestOffer
    end

    local Net = getNet()
    if not Net then return 0, 0, nil end

    local b = Net.Call("board")
    local offers = b and b.offers or {}
    local boardInfo = b and b.state and b.state.board
    local nextRefresh = (boardInfo and tonumber(boardInfo.next)) or 0

    local untaken = 0
    local best = nil
    local maxProfit = 0

    for _, o in ipairs(offers) do
        if not o.taken then
            untaken = untaken + 1
            local tier = tostring(o.tier or o.rarity or "common"):lower()
            if contractRarityAllowed[tier] ~= false then
                local profit = (type(o.fee) == "table" and tonumber(o.fee[2])) or tonumber(o.fee) or 0
                if profit > maxProfit then
                    maxProfit = profit
                    best = o
                end
            end
        end
    end

    boardCache.checkedAt = now
    boardCache.untakenCount = untaken
    boardCache.nextRefresh = nextRefresh
    boardCache.bestOffer = best

    return untaken, nextRefresh, best
end

local function runOneContract()
    local Net = getNet()
    if not Net then return false, "No Net" end

    local s = Net.State()
    local m = s.mission
    local slots = getBaySlots(s)

    -- If not already in an active contract delivery, check if car slots are full
    if not m and slots.isFull then
        local msg = string.format("All bays full (%d/%d) • Cannot take contract", slots.occupied, slots.total)
        contractsToggle.SetStatus(msg, Color3.fromRGB(241, 196, 15))
        return false, msg
    end

    -- If not already in mission, find and take highest-paying contract
    local maxProfit = 0
    local best = nil
    if not m then
        setAutoStatus("Scanning contract board...", C_ACCENT)
        contractsToggle.SetStatus("Scanning contract board...", C_ACCENT)

        local b = Net.Call("board")
        local offers = b and b.offers or {}
        local boardInfo = b and b.state and b.state.board
        local nextRefresh = (boardInfo and tonumber(boardInfo.next)) or 0
        local untakenCount = 0

        for _, o in ipairs(offers) do
            if not o.taken then
                untakenCount = untakenCount + 1
                local tier = tostring(o.tier or o.rarity or "common"):lower()
                if contractRarityAllowed[tier] ~= false then
                    local profit = (type(o.fee) == "table" and tonumber(o.fee[2])) or tonumber(o.fee) or 0
                    if profit > maxProfit then
                        maxProfit = profit
                        best = o
                    end
                end
            end
        end

        boardCache.checkedAt = os.clock()
        boardCache.untakenCount = untakenCount
        boardCache.nextRefresh = nextRefresh
        boardCache.bestOffer = best

        if untakenCount == 0 or not best then
            if untakenCount > 0 and not best then
                contractsToggle.SetStatus("No offers matching allowed contract rarities", Color3.fromRGB(241, 196, 15))
            end
            return false, "board_empty", nextRefresh
        end

        contractsToggle.SetStatus("Accepting: " .. tostring(best.display) .. " (+$" .. tostring(maxProfit) .. ")...", C_ACCENT)
        local takeRes = Net.Call("take", best.slot)
        if not takeRes or not takeRes.ok then
            return false, "Could not take contract"
        end

        task.wait(0.8)
        s = Net.State()
        m = s.mission
    end

    if not m then
        return false, "Mission did not initialize"
    end

    local pickup = m.pickup and Vector3.new(m.pickup[1], m.pickup[2] + 2, m.pickup[3])
    local dest = m.dest and Vector3.new(m.dest[1], m.dest[2] + 2, m.dest[3])

    if pickup and not m.away then
        setAutoStatus("Retrieving car at pickup point...", Color3.fromRGB(241, 196, 15))
        contractsToggle.SetStatus("Retrieving car at pickup point...", Color3.fromRGB(241, 196, 15))
        pcall(function() player:RequestStreamAroundAsync(pickup) end)

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if root then
            root.Anchored = true
            root.CFrame = CFrame.new(pickup)
            task.wait(0.8)
            root.Anchored = false
        end

        local car = getBusinessCar()
        local seat = car and car:FindFirstChild("DriveSeat", true)
        if seat and hum then
            if hum.Sit and hum.SeatPart ~= seat then
                hum.Sit = false
                task.wait(0.1)
            end
            seat:Sit(hum)
            task.wait(0.6)
        end
    end

    if dest then
        local car = getBusinessCar()
        local seat = car and car:FindFirstChild("DriveSeat", true)
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")

        if seat and hum and seat.Occupant ~= hum then
            if hum.Sit and hum.SeatPart ~= seat then
                hum.Sit = false
                task.wait(0.1)
            end
            seat:Sit(hum)
            task.wait(0.5)
        end

        local legStart = os.clock()
        local calSpeed, minSafeDuration = calculateTransitCalibration(car.PrimaryPart.Position, dest, m)
        pcall(function() player:RequestStreamAroundAsync(dest) end)
        glideVehicleTo(car, dest, calSpeed, function(left, total, eta)
            local statusStr = string.format("Retrieving vehicle: %d studs left (ETA: %ds, calibrated)...", math.floor(left), eta)
            contractsToggle.SetStatus(statusStr, Color3.fromRGB(52, 152, 219))
            setAutoStatus(statusStr, Color3.fromRGB(52, 152, 219))
        end, m)
        waitForRingHandover(function(txt)
            contractsToggle.SetStatus(txt, Color3.fromRGB(52, 152, 219))
            setAutoStatus(txt, Color3.fromRGB(52, 152, 219))
        end, minSafeDuration, legStart)
    end

    local carName = tostring(best and best.display or "Vehicle")
    setAutoStatus("Car retrieved to garage: " .. carName, C_GREEN)
    contractsToggle.SetStatus("Retrieved to garage: " .. carName .. " (+$" .. tostring(maxProfit) .. ")", C_GREEN)
    return true, "retrieved", carName, maxProfit
end

local function runAuctionCycle()
    local Net = getNet()
    if not Net then return false, "No Net" end

    -- Check if car slots are full before bidding
    local slots = getBaySlots()
    if slots.isFull then
        local msg = string.format("All bays full (%d/%d) • Bidding paused", slots.occupied, slots.total)
        auctionsToggle.SetStatus(msg, Color3.fromRGB(241, 196, 15))
        return false, msg
    end

    local res = Net.Call("auctions")
    local lots = res and (res.lots or (res.auctions and res.auctions.lots))
    if not lots or #lots == 0 then
        return false, "No active auction lots"
    end

    local leaderstats = player:FindFirstChild("leaderstats")
    local cashObj = leaderstats and (leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Money"))
    local cash = cashObj and cashObj.Value or 999999999

    local bestLot = nil
    local bestProfit = 0
    local bestNextBid = 0
    local bestMaxBid = 0
    local bestFixCost = 0
    local minAffordableGap = 0
    local unaffordableCandidate = nil

    for _, lot in ipairs(lots) do
        -- Check rarity filter (Common, Rare, Epic, Legendary)
        local tier = tostring(lot.tier or lot.rarity or "common"):lower()
        if auctionRarityAllowed[tier] == false then
            continue
        end

        -- Skip if we are currently the leading bidder
        local amLeading = (lot.you == true) or (lot.leader == player.Name) or (lot.aiLeads == false and lot.you == true)
        if not amLeading then
            local step = tonumber(lot.step) or 2000
            local price = tonumber(lot.price) or 0
            local nextBid = price + step
            local worth = tonumber(lot.worth) or 0
            local collectorRev = math.floor(worth * 1.3) -- Collector pays +30% when restored
            local maxBid = math.min(nextBid + 2 * step, collectorRev)

            -- Check preliminary viability before inspecting full vehicle report
            local estMinFix = tonumber(lot.fixKnown) or (tonumber(lot.fixSeen) or 0)
            local prelimProfit = collectorRev - nextBid - estMinFix
            local prelimNeeded = maxBid + estMinFix

            if prelimProfit >= 8000 and cash >= prelimNeeded then
                -- Full Vehicle Report Inspection:
                -- If hidden faults exist and not yet reported, check the full report to reveal exact costs
                if (tonumber(lot.hidden) or 0) > 0 and not lot.reported then
                    local repCost = tonumber(lot.report) or 0
                    if cash >= (prelimNeeded + repCost) then
                        auctionsToggle.SetStatus("Checking full report for " .. tostring(lot.display) .. " ($" .. repCost .. ")...", C_ACCENT)
                        local repRes = Net.Call("report", lot.tier)
                        if repRes and repRes.auctions and repRes.auctions.lots then
                            for _, updatedLot in ipairs(repRes.auctions.lots) do
                                if updatedLot.key == lot.key or updatedLot.tier == lot.tier then
                                    lot = updatedLot
                                    break
                                end
                            end
                        end
                    end
                end

                -- Compute exact full restoration fee from unlocked vehicle report
                local fixCost = tonumber(lot.fixKnown)
                if not fixCost or fixCost == 0 then
                    local faultSum = 0
                    if lot.faults and type(lot.faults) == "table" then
                        for _, f in ipairs(lot.faults) do
                            faultSum = faultSum + (tonumber(f.cost) or 0)
                        end
                    end
                    fixCost = math.max(faultSum, tonumber(lot.fixSeen) or 0)
                end

                -- Total required: Max possible bid + complete restoration & repair fees
                local totalNeeded = maxBid + fixCost
                local actualProfit = collectorRev - nextBid - fixCost

                -- Must have enough cash left over to pay for BOTH the car AND all restoration fees!
                if cash >= totalNeeded and actualProfit >= 8000 then
                    if actualProfit > bestProfit then
                        bestProfit = actualProfit
                        bestLot = lot
                        bestNextBid = nextBid
                        bestMaxBid = maxBid
                        bestFixCost = fixCost
                    end
                elseif actualProfit >= 8000 and (cash < totalNeeded) then
                    if not unaffordableCandidate or totalNeeded < minAffordableGap then
                        minAffordableGap = totalNeeded
                        unaffordableCandidate = lot
                    end
                end
            end
        end
    end

    if bestLot then
        local statusTxt = string.format("Bidding %s ($%d bid + $%d fix reserve)...", tostring(bestLot.display), bestNextBid, bestFixCost)
        auctionsToggle.SetStatus(statusTxt, C_ACCENT)
        local bidRes = Net.Call("bid", bestLot.tier, bestNextBid, bestMaxBid)
        if bidRes and bidRes.ok then
            local msg = string.format("Leading: %s @ $%d (+$%d profit | $%d fix reserved)", tostring(bestLot.display), bestNextBid, bestProfit, bestFixCost)
            setAutoStatus(msg, C_GREEN)
            auctionsToggle.SetStatus(msg, C_GREEN)
            return true, msg
        else
            local errMsg = (type(bidRes) == "table" and bidRes.message) or "Bid failed"
            auctionsToggle.SetStatus(errMsg, Color3.fromRGB(241, 196, 15))
            return false, errMsg
        end
    end

    if unaffordableCandidate then
        local msg = string.format("Need $%d for %s (Bid + Full Fix) • Cash: $%d", minAffordableGap, tostring(unaffordableCandidate.display), cash)
        auctionsToggle.SetStatus(msg, Color3.fromRGB(241, 196, 15))
        return false, msg
    end

    return false, "Watching lots (no profitable lots within full restoration budget)"
end

local function fixAllBays()
    local Net = getNet()
    if not Net then return false, "No Net" end
    local s = Net.State()
    if not s or not s.bays then return false, "No bays" end

    local leaderstats = player:FindFirstChild("leaderstats")
    local cashObj = leaderstats and (leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Money"))
    local cash = cashObj and cashObj.Value or 0

    local fixedAny = false
    local actions = {}

    for slot, bay in pairs(s.bays) do
        if bay and bay.car then
            local carName = tostring(bay.display or bay.car or slot)
            if bay.kind == "project" then
                -- Only restore auction project cars if Auto Auctions is actively toggled ON!
                if autoAuctionsActive then
                    local resAll = Net.Call("restore", slot, "all")
                    if resAll and resAll.ok then
                        fixedAny = true
                        table.insert(actions, carName .. " (Restored)")
                    else
                        -- Restore individual faults player can afford
                        if bay.faults then
                            for _, fault in ipairs(bay.faults) do
                                if not fault.fixed then
                                    local cost = tonumber(fault.cost) or 0
                                    if cash >= cost then
                                        local resOne = Net.Call("restore", slot, fault.id)
                                        if resOne and resOne.ok then
                                            fixedAny = true
                                            cash = cash - cost
                                            table.insert(actions, carName .. " (" .. tostring(fault.label or fault.id) .. ")")
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            elseif bay.kind == "service" then
                -- Customer service vehicle: wash, paint, plate, rims
                local spec = bay.spec or {}
                local picks = {
                    wash = (spec.washed ~= false),
                    paint = spec.paint,
                    plate = spec.plate,
                    rims = spec.rims
                }
                local resPrep = Net.Call("prepAll", slot, picks)
                if resPrep and resPrep.ok then
                    fixedAny = true
                    table.insert(actions, carName .. " (Prepped & Washed)")
                end
            else
                -- Contract or other vehicle
                callBayAction("restore", slot, "all")
                callBayAction("repair", slot)
                local wantedPicks = getWantedPicks(slot, bay)
                callBayAction("prepAll", slot, wantedPicks)
                fixedAny = true
                table.insert(actions, carName .. " (Restored, Repaired & Prepped)")
            end
        end
    end

    if fixedAny then
        return true, table.concat(actions, ", ")
    else
        return false, "All vehicles inside business in top condition"
    end
end

