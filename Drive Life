local function isMissionOrRaceCar(model)
    if not model or not model:IsA("Model") then return false end
    if model:GetAttribute("DLBizCar") or model:GetAttribute("DLJobVehicle") then
        return true
    end
    local name = model.Name
    if name:find("%- Business$") or name:find("%- Service$") or name:find("%- Project$") or name:find("%- Auction$") then
        return true
    end
    if model:FindFirstAncestor("Track") or model:FindFirstAncestor("Races") or workspace:FindFirstChild("DLTrackRace") then
        return true
    end
    return false
end

local function isOwnedPersonalCar(model)
    if not model or not model:IsA("Model") then return false end
    if isMissionOrRaceCar(model) then
        return false
    end
    local name = model.Name
    if name == player.Name .. " - Vehicle" or name == player.Name or name:find(player.Name, 1, true) then
        return true
    end
    if model:GetAttribute("Owner") == player.Name then
        return true
    end
    return false
end

local isEjecting = false
local function ejectFromPersonalCar(seat, model)
    if isEjecting then return end
    isEjecting = true

    local carName = (model and model.Name) or "Personal Vehicle"
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")

    -- 1. Unbind driving inputs & destroy A-Chassis Interface in PlayerGui so WASD doesn't control the car!
    pcall(function()
        local CAS = game:GetService("ContextActionService")
        local actions = {
            "Throttle", "Brake", "Steer", "Left", "Right", "Accelerate", "Decelerate",
            "PBrake", "Handbrake", "Clutch", "ShiftUp", "ShiftDown", "MouseSteer", "MouseThrottle"
        }
        for _, act in ipairs(actions) do
            CAS:UnbindAction(act)
        end
    end)

    local pgui = player:FindFirstChild("PlayerGui")
    if pgui then
        for _, g in ipairs(pgui:GetChildren()) do
            if g.Name == "A-Chassis Interface" or g.Name:find("A%-Chassis") then
                pcall(function() g:Destroy() end)
            end
        end
    end

    -- 2. Zero out vehicle seat throttles & steering
    if seat and seat:IsA("VehicleSeat") then
        pcall(function()
            seat.Throttle = 0
            seat.Steer = 0
            seat.ThrottleFloat = 0
            seat.SteerFloat = 0
            seat.Disabled = true
        end)
    end

    -- 3. Sever any SeatWeld connecting character to seat
    if seat then
        for _, c in ipairs(seat:GetChildren()) do
            if c:IsA("Weld") or c:IsA("WeldConstraint") or c.Name == "SeatWeld" then
                if (c.Part0 and c.Part0:IsDescendantOf(char)) or (c.Part1 and c.Part1:IsDescendantOf(char)) then
                    pcall(function() c:Destroy() end)
                end
            end
        end
    end
    if char then
        for _, c in ipairs(char:GetDescendants()) do
            if c:IsA("Weld") or c:IsA("WeldConstraint") then
                if c.Part0 == seat or c.Part1 == seat then
                    pcall(function() c:Destroy() end)
                end
            end
        end
    end

    -- 4. Trigger standard Roblox seat dismount (Jump state) then stand up
    if hum then
        hum.Jump = true
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        task.wait(0.05)
        hum.Sit = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end

    -- 5. Restore camera subject to Humanoid
    pcall(function()
        local cam = workspace.CurrentCamera
        if cam and hum then
            cam.CameraSubject = hum
            cam.CameraType = Enum.CameraType.Custom
        end
    end)

    -- 6. Reposition character safely outside the car so proximity/collision doesn't re-seat
    if root then
        local rightOffset = (root.CFrame.RightVector * 6) + Vector3.new(0, 3, 0)
        root.CFrame = root.CFrame + rightOffset
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    setAutoStatus("Auto-Ejected from personal vehicle (" .. carName .. ") to prevent script breakage!", Color3.fromRGB(241, 196, 15))

    task.delay(0.8, function()
        if seat and seat.Parent then
            pcall(function()
                seat.Disabled = false
            end)
        end
        isEjecting = false
    end)
end

local function checkPlayerSeat()
    if not autoEjectOwnedActive then return end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if not hum.Sit or not hum.SeatPart then
        -- Character is standing on foot! Clean up any lingering vehicle driving interfaces so WASD controls only character!
        local pgui = player:FindFirstChild("PlayerGui")
        if pgui then
            local aci = pgui:FindFirstChild("A-Chassis Interface")
            if aci then
                pcall(function() aci:Destroy() end)
                pcall(function()
                    local CAS = game:GetService("ContextActionService")
                    CAS:UnbindAction("Throttle")
                    CAS:UnbindAction("Brake")
                    CAS:UnbindAction("Steer")
                    CAS:UnbindAction("Left")
                    CAS:UnbindAction("Right")
                    CAS:UnbindAction("Accelerate")
                    CAS:UnbindAction("Decelerate")
                    CAS:UnbindAction("PBrake")
                    CAS:UnbindAction("Handbrake")
                    CAS:UnbindAction("Clutch")
                    CAS:UnbindAction("ShiftUp")
                    CAS:UnbindAction("ShiftDown")
                end)
            end
        end
        return
    end

    local seat = hum.SeatPart
    if not seat or not seat:IsA("VehicleSeat") then return end

    local model = seat:FindFirstAncestorOfClass("Model")
    if model and isOwnedPersonalCar(model) then
        ejectFromPersonalCar(seat, model)
    end
end

local function setupAutoEjectChar(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end

    hum:GetPropertyChangedSignal("SeatPart"):Connect(checkPlayerSeat)
    hum.Seated:Connect(function(active)
        if active then
            checkPlayerSeat()
        end
    end)
    checkPlayerSeat()
end

if player.Character then
    task.spawn(setupAutoEjectChar, player.Character)
end
player.CharacterAdded:Connect(function(c)
    task.spawn(setupAutoEjectChar, c)
end)

