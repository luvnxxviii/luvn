-- Master Hands-Off Automation Loop (Playlist Continue, Retry, Skip Intros, Car Select, Auto-Race)
task.spawn(function()
    local vim = game:GetService("VirtualInputManager")

    local function sendKey(keyCode)
        pcall(function()
            vim:SendKeyEvent(true, keyCode, false, game)
            task.wait(0.08)
            vim:SendKeyEvent(false, keyCode, false, game)
        end)
    end

    local function clickGui(btn)
        if not btn then return false end
        pcall(function()
            if firesignal then
                firesignal(btn.MouseButton1Click)
                firesignal(btn.Activated)
            end
        end)
        pcall(function()
            if btn.AbsolutePosition and btn.AbsoluteSize then
                local cx = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
                local cy = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2
                vim:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                task.wait(0.05)
                vim:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
            end
        end)
        return true
    end

    while hubAlive do
        task.wait(0.6)
        if (autoContinueActive or autoRetryActive) and not raceAutoRunning then
            local pg = player:FindFirstChild("PlayerGui")

            -- 1. DETECT RESULTS / PODIUM SCREEN
            local isResults = false
            if pg then
                local endCard = pg:FindFirstChild("DLRaceEndCard")
                local raceResults = pg:FindFirstChild("DLRaceResults")
                local raceUI = pg:FindFirstChild("RaceUI")
                local arrivalGuard = pg:FindFirstChild("DLArrivalGuard")

                if (endCard and endCard.Enabled) or
                   (raceResults and raceResults.Enabled) or
                   (raceUI and raceUI.Enabled and raceUI:FindFirstChild("Results") and raceUI.Results.Visible) or
                   (arrivalGuard and arrivalGuard.Enabled and arrivalGuard:FindFirstChild("Shade") and arrivalGuard.Shade.Visible) then
                    isResults = true
                end
            end

            if isResults then
                if autoContinueActive then
                    if raceStatusLabel then
                        raceStatusLabel.Text = "Status: Results screen • Advancing to next race..."
                        raceStatusLabel.TextColor3 = C_GREEN
                    end
                    local contBtn = nil
                    if pg:FindFirstChild("DLRaceEndCard") then
                        contBtn = pg.DLRaceEndCard:FindFirstChild("Primary", true)
                    end
                    if not contBtn and pg:FindFirstChild("DLRaceResults") then
                        contBtn = pg.DLRaceResults:FindFirstChild("Continue", true)
                    end
                    if not contBtn and pg:FindFirstChild("RaceUI") then
                        contBtn = pg.RaceUI:FindFirstChild("Continue", true)
                    end
                    if contBtn then clickGui(contBtn) end
                    sendKey(Enum.KeyCode.Return)
                    task.wait(1.5)
                elseif autoRetryActive then
                    if raceStatusLabel then
                        raceStatusLabel.Text = "Status: Results screen • Retrying race..."
                        raceStatusLabel.TextColor3 = C_ACCENT
                    end
                    local retryBtn = nil
                    if pg:FindFirstChild("DLRaceEndCard") then
                        retryBtn = pg.DLRaceEndCard:FindFirstChild("Retry", true)
                    end
                    if not retryBtn and pg:FindFirstChild("DLArrivalGuard") then
                        retryBtn = pg.DLArrivalGuard:FindFirstChild("Retry", true)
                    end
                    if retryBtn then clickGui(retryBtn) end
                    local raceEvents = ReplicatedStorage:FindFirstChild("RaceEvents")
                    if raceEvents and raceEvents:FindFirstChild("RaceRetry") then
                        pcall(function() raceEvents.RaceRetry:FireServer() end)
                    end
                    sendKey(Enum.KeyCode.R)
                    sendKey(Enum.KeyCode.Return)
                    task.wait(1.5)
                end
            end

            -- 2. DETECT TRACK LOBBY & SELECT / CONFIRM CAR
            local lobbyGui = pg and pg:FindFirstChild("DLTrackLobby")
            if lobbyGui and lobbyGui.Enabled then
                if raceStatusLabel then
                    raceStatusLabel.Text = "Status: Track Lobby • Confirming car..."
                    raceStatusLabel.TextColor3 = C_ACCENT
                end
                local selectBtn = nil
                for _, b in ipairs(lobbyGui:GetDescendants()) do
                    if (b:IsA("TextButton") or b:IsA("ImageButton")) and b.Visible then
                        local txt = b:IsA("TextButton") and b.Text:upper() or ""
                        if txt:find("SELECT") or txt:find("READY") or txt:find("KEEP") or b.Name == "Select" or b.Name == "Ready" then
                            selectBtn = b
                            break
                        end
                    end
                end
                if selectBtn then clickGui(selectBtn) end
                sendKey(Enum.KeyCode.Return)
                task.wait(1.0)
            end

            -- 3. DETECT CINEMATIC / STORY INTRO SKIP
            if pg then
                for _, g in ipairs(pg:GetChildren()) do
                    if g:IsA("ScreenGui") and g.Enabled and g.Name ~= "DLTrackLobby" and g.Name ~= "DLRaceResults" and g.Name ~= "DLRaceHUD" and g.Name ~= "DLRaceEndCard" and g.Name ~= "DriveLifeHub_UI" then
                        for _, btn in ipairs(g:GetDescendants()) do
                            if btn:IsA("TextButton") and btn.Visible and btn.Text ~= "" then
                                local t = btn.Text:upper()
                                if t:find("SKIP") or t:find("NEXT") or t:find("CONTINUE") then
                                    clickGui(btn)
                                    sendKey(Enum.KeyCode.Return)
                                    sendKey(Enum.KeyCode.Space)
                                    break
                                end
                            end
                        end
                    end
                end
            end

            -- 4. DETECT LIVE RACE & RUN CALIBRATED TRAVERSAL
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.SeatPart then
                local raceLive = false
                if pg then
                    local rUI = pg:FindFirstChild("RaceUI")
                    local dlHud = pg:FindFirstChild("DLRaceHUD")
                    local dlCtrl = pg:FindFirstChild("DLRaceControls")
                    if (rUI and rUI.Enabled and rUI:FindFirstChild("RaceHud") and rUI.RaceHud.Visible) or
                       (dlHud and dlHud.Enabled) or
                       (dlCtrl and dlCtrl.Enabled) then
                        raceLive = true
                    end
                end

                if raceLive then
                    local gates, finish, trackName = getActiveRaceGates()
                    if gates and #gates > 0 and finish then
                        raceAutoRunning = true
                        autoWinBtn.Text = "⏹ Stop Current Run"
                        autoWinBtn.BackgroundColor3 = C_RED

                        executeCalibratedRaceTraversal()

                        raceAutoRunning = false
                        autoWinBtn.Text = "🏆 Auto-Win Current Race (Calibrated Traversal)"
                        autoWinBtn.BackgroundColor3 = Color3.fromRGB(241, 196, 15)
                        task.wait(2.0)
                    end
                end
            end
        end
    end
end)

