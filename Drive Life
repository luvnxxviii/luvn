local function getMechanicStats()
    local mjFolder = player:FindFirstChild("mechanicJob")
    local xpVal = mjFolder and mjFolder:FindFirstChild("XP_Value")
    local sessVal = mjFolder and mjFolder:FindFirstChild("SessionEarnedMoney")
